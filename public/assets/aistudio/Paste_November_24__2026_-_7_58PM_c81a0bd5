        for (let i = 0; i < 1e5; i++) s += i;
        if (s < 0) console.log(s);
      },
    },
    {
      name: 'Math.sqrt × 1e5',
      fn: () => {
        let s = 0;
        for (let i = 0; i < 1e5; i++) s += Math.sqrt(i);
        if (s < 0) console.log(s);
      },
    },
    {
      name: 'JSON round-trip 1e3',
      fn: () => {
        for (let i = 0; i < 1e3; i++) {
          JSON.parse(JSON.stringify({ a: i, b: [1, 2, 3] }));
        }
      },
    },
    {
      name: 'Sort 1e4',
      fn: () => {
        const a = Array.from({ length: 1e4 }, () => Math.random());
        a.sort((x, y) => x - y);
      },
    },
  ];
}

export default function BenchmarkMatrix() {
  const [results, setResults] = useState<BenchmarkResult[]>([]);
  const [running, setRunning] = useState(false);

  async function runAll() {
    setRunning(true);
    setResults([]);
    const tasks = buildTasks();
    const out: BenchmarkResult[] = [];

    for (const task of tasks) {
      task.fn(); // calentamiento JIT
      const t0 = performance.now();
      const iterations = 5;
      for (let i = 0; i < iterations; i++) task.fn();
      const t1 = performance.now();
      const durationMs = (t1 - t0) / iterations;
      out.push({
        name: task.name,
        durationMs,
        opsPerSec: 1000 / durationMs,
        timestamp: Date.now(),
      });
      setResults([...out]);
      await new Promise((r) => setTimeout(r, 0));
    }
    setRunning(false);
  }

  return (
    <div className="space-y-3 rounded-lg border border-white/10 bg-black/40 p-4">
      <div className="flex items-center justify-between">
        <h3 className="text-sm font-semibold text-white/80">
          Matriz de benchmark
        </h3>
        <button
          onClick={() => void runAll()}
          disabled={running}
          className="rounded bg-indigo-600 px-3 py-1 text-xs text-white hover:bg-indigo-500 disabled:opacity-40"
        >
          {running ? 'Ejecutando…' : 'Ejecutar'}
        </button>
      </div>

      {results.length === 0 ? (
        <p className="text-xs text-white/40">
          Sin resultados. Ejecuta la batería.
        </p>
      ) : (
        <table className="w-full text-xs">
          <thead className="text-white/50">
            <tr>
              <th className="text-left">Tarea</th>
              <th className="text-right">ms</th>
              <th className="text-right">ops/s</th>
            </tr>
          </thead>
          <tbody className="font-mono text-white/80">
            {results.map((r) => (
              <tr key={r.name} className="border-t border-white/5">
                <td className="py-1">{r.name}</td>
                <td className="text-right">{r.durationMs.toFixed(3)}</td>
                <td className="text-right">{r.opsPerSec.toFixed(0)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  );
}
