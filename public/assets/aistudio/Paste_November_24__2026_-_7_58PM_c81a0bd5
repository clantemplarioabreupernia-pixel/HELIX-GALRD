import { useMemo, useRef, useState } from 'react';
import type { SignalSample, SignalProcessingResult } from '../types';
import { audioEngine } from '../lib/audioEngine';

const SAMPLE_COUNT = 512;

function generateSignal(
  kind: 'sine' | 'square' | 'chirp',
  freq: number
): SignalSample[] {
  const out: SignalSample[] = [];
  for (let i = 0; i < SAMPLE_COUNT; i++) {
    const t = i / SAMPLE_COUNT;
    let a: number;
    if (kind === 'sine') a = Math.sin(2 * Math.PI * freq * t);
    else if (kind === 'square') a = Math.sign(Math.sin(2 * Math.PI * freq * t));
    else a = Math.sin(2 * Math.PI * (freq + 4 * t) * t);
    out.push({ t, amplitude: a });
  }
  return out;
}

// Filtro paso-bajo IIR de un polo
function lowPass(input: SignalSample[], alpha: number): SignalSample[] {
  let prev = 0;
  return input.map(({ t, amplitude }) => {
    prev = prev + alpha * (amplitude - prev);
    return { t, amplitude: prev };
  });
}

function computeSNR(signal: SignalSample[], noise: SignalSample[]): number {
  let sp = 0;
  let np = 0;
  const n = Math.min(signal.length, noise.length);
  for (let i = 0; i < n; i++) {
    sp += signal[i].amplitude ** 2;
    np += (signal[i].amplitude - noise[i].amplitude) ** 2;
  }
  if (np === 0) return Infinity;
  return 10 * Math.log10(sp / np);
}

export default function SignalProcessorLab() {
  const [kind, setKind] = useState<'sine' | 'square' | 'chirp'>('sine');
  const [freq, setFreq] = useState(8);
  const [alpha, setAlpha] = useState(0.15);
  const [result, setResult] = useState<SignalProcessingResult | null>(null);
  const startRef = useRef(0);

  const input = useMemo(() => generateSignal(kind, freq), [kind, freq]);

  function process() {
    startRef.current = performance.now();
    const output = lowPass(input, alpha);
    const snr = computeSNR(input, output);
    const latencyMs = performance.now() - startRef.current;

    setResult({ input, output, snr, latencyMs });
    audioEngine.playTone(freq * 55, 180);
  }

  const points = (samples: SignalSample[]) =>
    samples
      .map(({ t, amplitude }) => `${t * 100},${50 - amplitude * 40}`)
      .join(' ');

  return (
    <div className="space-y-3 rounded-lg border border-white/10 bg-black/40 p-4">
      <h3 className="text-sm font-semibold text-white/80">
        Laboratorio de procesamiento de señal
      </h3>

      <div className="grid grid-cols-3 gap-2 text-xs">
        <label className="space-y-1">
          <span className="text-white/60">Tipo</span>
          <select
            value={kind}
            onChange={(e) => setKind(e.target.value as typeof kind)}
            className="w-full rounded bg-white/5 px-2 py-1 text-white"
          >
            <option value="sine">Seno</option>
            <option value="square">Cuadrada</option>
            <option value="chirp">Chirp</option>
          </select>
        </label>
        <label className="space-y-1">
          <span className="text-white/60">Frecuencia</span>
          <input
            type="number"
            min={1}
            max={40}
            value={freq}
            onChange={(e) => setFreq(Number(e.target.value))}
            className="w-full rounded bg-white/5 px-2 py-1 text-white"
          />
        </label>
        <label className="space-y-1">
          <span className="text-white/60">α filtro</span>
          <input
            type="number"
            step={0.01}
            min={0.01}
            max={0.99}
