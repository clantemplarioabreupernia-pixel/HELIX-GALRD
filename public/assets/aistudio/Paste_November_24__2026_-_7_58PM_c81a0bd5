import BenchmarkMatrix from './components/BenchmarkMatrix';
import MotherCodeViewer from './components/MotherCodeViewer';
import type { LatticeVector, NavSection } from './types';

function buildVectors(count: number): LatticeVector[] {
  const out: LatticeVector[] = [];
  for (let i = 0; i < count; i++) {
    const angle = (i / count) * Math.PI * 2;
    const r = 0.4 + (i % 5) * 0.15;
    out.push({
      id: `v${i}`,
      position: [Math.cos(angle) * r, Math.sin(angle) * r, 0],
      magnitude: 0.3 + (i % 3) * 0.2,
      phase: angle,
    });
  }
  return out;
}

export default function App() {
  const [section, setSection] = useState<NavSection>('lattice');
  const vectors = useMemo(() => buildVectors(12), []);

  return (
