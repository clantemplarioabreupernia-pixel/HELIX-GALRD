import { useEffect, useRef, useState } from 'react';

const W = 80;
const H = 60;

function randomGrid(): Uint8Array {
  const g = new Uint8Array(W * H);
  for (let i = 0; i < g.length; i++) g[i] = Math.random() > 0.7 ? 1 : 0;
  return g;
}

function step(grid: Uint8Array): Uint8Array {
  const next = new Uint8Array(W * H);
  for (let y = 0; y < H; y++) {
    for (let x = 0; x < W; x++) {
      let n = 0;
      for (let dy = -1; dy <= 1; dy++) {
        for (let dx = -1; dx <= 1; dx++) {
          if (dx === 0 && dy === 0) continue;
          const nx = (x + dx + W) % W;
          const ny = (y + dy + H) % H;
          n += grid[ny * W + nx];
        }
      }
      const alive = grid[y * W + x];
      next[y * W + x] = alive
        ? n === 2 || n === 3
          ? 1
          : 0
        : n === 3
          ? 1
          : 0;
    }
  }
  return next;
}

export default function BioPixelEngine() {
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const gridRef = useRef<Uint8Array>(randomGrid());
  const [running, setRunning] = useState(true);
  const [generation, setGeneration] = useState(0);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    canvas.width = W;
    canvas.height = H;
    const imageData = ctx.createImageData(W, H);

    let raf = 0;
    let last = 0;
    const tick = (t: number) => {
      if (running && t - last > 100) {
        gridRef.current = step(gridRef.current);
        setGeneration((g) => g + 1);
        last = t;
      }
      const g = gridRef.current;
      for (let i = 0; i < g.length; i++) {
        const v = g[i];
        imageData.data[i * 4] = v ? 180 : 10;
        imageData.data[i * 4 + 1] = v ? 255 : 10;
        imageData.data[i * 4 + 2] = v ? 200 : 20;
        imageData.data[i * 4 + 3] = 255;
      }
      ctx.putImageData(imageData, 0, 0);
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
    return () => cancelAnimationFrame(raf);
  }, [running]);

  return (
    <div className="space-y-3 rounded-lg border border-white/10 bg-black/40 p-4">
      <h3 className="text-sm font-semibold text-white/80">Motor BioPixel</h3>
      <canvas
        ref={canvasRef}
        className="w-full rounded bg-black/60"
        style={{ imageRendering: 'pixelated' }}
      />
      <div className="flex items-center justify-between text-xs text-white/60">
        <span>
          Generación:{' '}
          <span className="font-mono text-white/90">{generation}</span>
        </span>
        <div className="space-x-2">
          <button
            onClick={() => {
              gridRef.current = randomGrid();
              setGeneration(0);
            }}
            className="rounded bg-white/10 px-3 py-1 hover:bg-white/20"
          >
            Reiniciar
          </button>
          <button
            onClick={() => setRunning((r) => !r)}
            className="rounded bg-indigo-600 px-3 py-1 text-white hover:bg-indigo-500"
          >
            {running ? 'Pausar' : 'Reanudar'}
          </button>
        </div>
      </div>
    </div>
  );
}
