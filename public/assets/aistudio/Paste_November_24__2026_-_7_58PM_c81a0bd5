                : 'bg-white/5 text-white/80'
            }`}
          >
            <span className="mr-2 text-white/40">
              {m.role === 'user' ? 'Tú' : 'Asesor'}:
            </span>
            {m.content}
          </div>
        ))}
        {loading && <p className="text-white/40">Consultando…</p>}
        {error && <p className="text-red-400">Error: {error}</p>}
      </div>

      <div className="flex gap-2">
        <input
          value={input}
          onChange={(e) => setInput(e.target.value)}
          onKeyDown={(e) => {
            if (e.key === 'Enter') void send();
          }}
          placeholder="Consulta técnica…"
          className="flex-1 rounded bg-white/5 px-3 py-2 text-sm text-white placeholder-white/30 outline-none"
