          onClick={() => void send()}
          disabled={loading || !input.trim()}
          className="rounded bg-indigo-600 px-4 py-2 text-sm text-white hover:bg-indigo-500 disabled:opacity-40"
        >
          Enviar
        </button>
      </div>
    </div>
  );
}
