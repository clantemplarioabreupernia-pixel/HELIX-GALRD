### 📄 `src/components/AnnealingEngine.tsx`

**DECISIÓN: ARREGLAR** — era `QuantumAnnealer`. Renombrado. Usa función de energía Rastrigin 2D con mínimo global real.

```tsx
import { useEffect, useRef, useState } from 'react';
import type { AnnealingConfig, AnnealingState } from '../types';
import { audioEngine } from '../lib/audioEngine';

const DEFAULT_CONFIG: AnnealingConfig = {
  temperature: 100,
  coolingRate: 0.995,
  iterations: 2000,
};

// Función Rastrigin 2D — mínimo global en (0,0) → E = 0
function energy(x: number, y: number): number {
  const A = 10;
  return (
    A * 2 +
    (x * x - A * Math.cos(2 * Math.PI * x)) +
    (y * y - A * Math.cos(2 * Math.PI * y))
  );
}

export default function AnnealingEngine() {
  const [config, setConfig] = useState<AnnealingConfig>(DEFAULT_CONFIG);
  const [state, setState] = useState<AnnealingState>({
    config: DEFAULT_CONFIG,
    energy: 0,
    step: 0,
    running: false,
    history: [],
  });
  const cancelRef = useRef<{ cancel: boolean }>({ cancel: false });

  useEffect(() => () => {
    cancelRef.current.cancel = true;
  }, []);

  function run() {
    cancelRef.current = { cancel: false };
    const token = cancelRef.current;

    let x = (Math.random() - 0.5) * 10;
    let y = (Math.random() - 0.5) * 10;
    let currentEnergy = energy(x, y);
    let T = config.temperature;
    const history: number[] = [currentEnergy];

    setState((s) => ({
      ...s,
      running: true,
      step: 0,
      energy: currentEnergy,
      history: [...history],
    }));

    const tick = () => {
      if (token.cancel) return;

      for (let i = 0; i < 50; i++) {
        const nx = x + (Math.random() - 0.5) * 0.5;
        const ny = y + (Math.random() - 0.5) * 0.5;
        const nE = energy(nx, ny);
        const dE = nE - currentEnergy;

        if (dE < 0 || Math.random() < Math.exp(-dE / T)) {
          x = nx;
          y = ny;
          currentEnergy = nE;
        }
        T *= config.coolingRate;
        history.push(currentEnergy);
      }

      setState((s) => ({
        ...s,
        energy: currentEnergy,
        step: history.length,
        history: history.slice(-500),
      }));

      if (history.length < config.iterations && T > 1e-3) {
        requestAnimationFrame(tick);
      } else {
        setState((s) => ({ ...s, running: false }));
        audioEngine.playTone(440, 120);
      }
    };

    requestAnimationFrame(tick);
  }

  function stop() {
    cancelRef.current.cancel = true;
    setState((s) => ({ ...s, running: false }));
  }

  const maxE = Math.max(...state.history, 1);
  const points = state.history
    .map(
      (e, i) =>
        `${(i / Math.max(state.history.length - 1, 1)) * 100},${
          100 - (e / maxE) * 100
        }`
    )
    .join(' ');

  return (
    <div className="space-y-3 rounded-lg border border-white/10 bg-black/40 p-4">
