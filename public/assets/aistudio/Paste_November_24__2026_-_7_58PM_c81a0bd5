## 📁 FASE 4 — Componentes técnicos

### 📄 `src/components/HilbertLatticeCanvas.tsx`

**DECISIÓN: ARREGLAR** — canvas 2D que dibuja vectores reales con fase, magnitud y grid.

```tsx
import { useEffect, useRef } from 'react';
import type { LatticeVector } from '../types';

interface Props {
  vectors: LatticeVector[];
  width?: number;
  height?: number;
}

export default function HilbertLatticeCanvas({
  vectors,
  width = 640,
  height = 480,
}: Props) {
  const canvasRef = useRef<HTMLCanvasElement>(null);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const dpr = window.devicePixelRatio || 1;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    canvas.style.width = `${width}px`;
    canvas.style.height = `${height}px`;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    // Fondo
    ctx.fillStyle = '#0a0a0f';
    ctx.fillRect(0, 0, width, height);

    // Grid
    ctx.strokeStyle = 'rgba(120, 130, 200, 0.15)';
    ctx.lineWidth = 1;
    const step = 40;
    for (let x = 0; x <= width; x += step) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, height);
      ctx.stroke();
    }
    for (let y = 0; y <= height; y += step) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(width, y);
      ctx.stroke();
    }

    const cx = width / 2;
    const cy = height / 2;

    // Vectores
    vectors.forEach((v) => {
      const [vx, vy] = v.position;
      const scale = 60;
      const ex = cx + vx * scale;
      const ey = cy - vy * scale;

      ctx.strokeStyle = `hsl(${(v.phase * 180) / Math.PI}, 80%, 60%)`;
      ctx.lineWidth = 1.5 + v.magnitude * 0.5;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(ex, ey);
      ctx.stroke();

      ctx.fillStyle = ctx.strokeStyle;
      ctx.beginPath();
      ctx.arc(ex, ey, 3 + v.magnitude * 0.8, 0, Math.PI * 2);
      ctx.fill();
    });

    // Centro
    ctx.fillStyle = '#7f8cff';
    ctx.beginPath();
    ctx.arc(cx, cy, 4, 0, Math.PI * 2);
    ctx.fill();
  }, [vectors, width, height]);

  return (
    <div className="rounded-lg border border-white/10 bg-black/40 p-2">
      <canvas ref={canvasRef} className="block" />
      <p className="mt-1 text-xs text-white/50">
        {vectors.length} vectores · proyección 2D del lattice
      </p>
    </div>
  );
}
```

