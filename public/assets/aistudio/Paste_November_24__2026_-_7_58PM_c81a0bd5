### 📄 `server.ts`

**DECISIÓN: ARREGLAR** — valida la API key, elimina `placeholder_key`, usa `gemini-2.0-flash`.

```ts
import express from 'express';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { GoogleGenAI } from '@google/genai';
import dotenv from 'dotenv';

dotenv.config();

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const PORT = Number(process.env.PORT ?? 3000);
const NODE_ENV = process.env.NODE_ENV ?? 'development';

const app = express();
app.use(express.json({ limit: '1mb' }));

// --- Validación estricta (elimina "placeholder_key") ---
function getGenAIClient(): GoogleGenAI {
  const apiKey = process.env.GEMINI_API_KEY;
  if (!apiKey || apiKey.trim().length === 0) {
    throw new Error(
      'GEMINI_API_KEY no configurada. Definir en .env o como variable de entorno.'
    );
  }
  return new GoogleGenAI({ apiKey });
}

app.post('/api/advisor', async (req, res) => {
  const { messages } = req.body as {
    messages?: Array<{ role: string; content: string }>;
  };

  if (!Array.isArray(messages) || messages.length === 0) {
    return res.status(400).json({ error: 'Se requiere un array "messages" no vacío.' });
  }

  try {
    const ai = getGenAIClient();

    const contents = messages.map((m) => ({
      role: m.role === 'assistant' ? 'model' : 'user',
      parts: [{ text: m.content }],
    }));

    const response = await ai.models.generateContent({
      model: 'gemini-2.0-flash',
      contents,
      config: {
        systemInstruction:
          'Eres un asesor técnico de la suite Aether Simulation. Respondes con precisión técnica, sin marketing ni afirmaciones exageradas.',
        temperature: 0.4,
      },
    });

    const text = response.text ?? '';
    return res.json({ reply: text });
  } catch (err) {
    const message = err instanceof Error ? err.message : 'Error desconocido';
    const status = message.includes('GEMINI_API_KEY') ? 503 : 500;
    return res.status(status).json({ error: message });
  }
});

app.get('/api/health', (_req, res) => {
  res.json({
    status: 'ok',
    env: NODE_ENV,
    geminiConfigured: Boolean(process.env.GEMINI_API_KEY),
  });
});

// --- Producción: servir el build estático ---
if (NODE_ENV === 'production') {
  app.use(express.static(path.join(__dirname, 'dist')));
  app.get('*', (_req, res) => {
    res.sendFile(path.join(__dirname, 'dist', 'index.html'));
  });
} else {
  // --- Desarrollo: Vite en modo middleware ---
  const { createServer } = await import('vite');
  const vite = await createServer({
    server: { middlewareMode: true },
    appType: 'spa',
  });
  app.use(vite.middlewares);
}

app.listen(PORT, () => {
  console.log(`[aether-sim] servidor en http://localhost:${PORT} (${NODE_ENV})`);
});
