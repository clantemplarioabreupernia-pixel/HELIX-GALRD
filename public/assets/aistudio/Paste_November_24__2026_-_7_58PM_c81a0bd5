### 📄 `src/lib/audioEngine.ts`

**DECISIÓN: CREAR** — wrapper limpio de la Web Audio API. `Math.random()` aquí es legítimo (síntesis de ruido blanco DSP, no una métrica).

```ts
// =============================================================================
// AudioEngine — Wrapper de la Web Audio API
// Autor: Javier Alberto Abreu Molina · Apache-2.0
// =============================================================================

export class AudioEngine {
  private ctx: AudioContext | null = null;
  private activeNodes = new Set<AudioNode>();

  private ensureContext(): AudioContext {
    if (!this.ctx) {
      this.ctx = new AudioContext();
    }
    if (this.ctx.state === 'suspended') {
      void this.ctx.resume();
    }
    return this.ctx;
  }

  playTone(frequencyHz: number, durationMs: number, gainDb = -12): void {
    const ctx = this.ensureContext();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();

    osc.type = 'sine';
    osc.frequency.value = frequencyHz;

    const linearGain = Math.pow(10, gainDb / 20);
    gain.gain.setValueAtTime(linearGain, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + durationMs / 1000);

    osc.connect(gain).connect(ctx.destination);
    osc.start();
    osc.stop(ctx.currentTime + durationMs / 1000);

    this.activeNodes.add(osc);
    osc.onended = () => this.activeNodes.delete(osc);
  }

  playSweep(startHz: number, endHz: number, durationMs: number): void {
    const ctx = this.ensureContext();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();

    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(startHz, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(endHz, ctx.currentTime + durationMs / 1000);

    gain.gain.setValueAtTime(0.2, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + durationMs / 1000);

    osc.connect(gain).connect(ctx.destination);
    osc.start();
    osc.stop(ctx.currentTime + durationMs / 1000);

    this.activeNodes.add(osc);
    osc.onended = () => this.activeNodes.delete(osc);
  }

  playNoise(durationMs: number, gainDb = -20): void {
    const ctx = this.ensureContext();
    const bufferSize = Math.floor(ctx.sampleRate * (durationMs / 1000));
    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) {
      data[i] = Math.random() * 2 - 1;
    }

    const src = ctx.createBufferSource();
    src.buffer = buffer;

    const gain = ctx.createGain();
    gain.gain.value = Math.pow(10, gainDb / 20);

    src.connect(gain).connect(ctx.destination);
    src.start();

    this.activeNodes.add(src);
    src.onended = () => this.activeNodes.delete(src);
  }

  stopAll(): void {
    this.activeNodes.forEach((node) => {
      try {
        (node as OscillatorNode).stop?.();
      } catch {
        /* nodo ya detenido */
      }
    });
    this.activeNodes.clear();
  }

  close(): void {
    this.stopAll();
    if (this.ctx) {
      void this.ctx.close();
      this.ctx = null;
    }
  }
}

export const audioEngine = new AudioEngine();
```

