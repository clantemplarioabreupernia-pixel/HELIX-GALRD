```python
#!/usr/bin/env python3
"""
Real Z3-based verifier for Collatz trajectories.

Reads JSON payload from stdin:
    { "n": <int>, "trajectory": [<int>, ...] }

Writes JSON result to stdout:
    { "verified": bool,
      "method": "z3-trajectory" | "z3-search" | "basic",
      "message": str,
      "counterexample"?: int,
      "elapsedMs": number }

Requirements:
    pip install z3-solver
"""

from __future__ import annotations

import json
import sys
import time
from typing import Any

try:
    from z3 import (  # type: ignore
        BitVec,
        BitVecVal,
        BoolVal,
        If,
        LShR,
        Not,
        Or,
        Solver,
        sat,
    )
    Z3_AVAILABLE = True
except ImportError:
    Z3_AVAILABLE = False


MAX_SEARCH_BOUND = 1000
MAX_SEARCH_STEPS = 100
Z3_TIMEOUT_MS = 5000


def verify_trajectory(n: int, trajectory: list[int]) -> dict[str, Any]:
    """Use Z3 to prove each step of the given trajectory satisfies the Collatz map."""
    if not trajectory or trajectory[0] != n or trajectory[-1] != 1:
        return {
            "verified": False,
            "method": "z3-trajectory",
            "message": "trajectory must start at n and end at 1",
        }

    if not Z3_AVAILABLE:
        # Fallback: direct arithmetic validation (no Z3).
        for i in range(1, len(trajectory)):
            prev = trajectory[i - 1]
            cur = trajectory[i]
            expected = prev // 2 if prev % 2 == 0 else 3 * prev + 1
            if cur != expected:
                return {
                    "verified": False,
                    "method": "basic",
                    "message": f"step {i}: expected {expected}, got {cur}",
                }
        return {
            "verified": True,
            "method": "basic",
            "message": f"basic arithmetic: all {len(trajectory) - 1} steps valid "
                       f"(install z3-solver for formal verification)",
        }

    s = Solver()
    width = 128
    prev = BitVecVal(trajectory[0], width)

    for i in range(1, len(trajectory)):
        cur = BitVecVal(trajectory[i], width)
        even_next = LShR(prev, 1)
        odd_next = 3 * prev + 1
        s.add(cur == If(prev & 1 == 0, even_next, odd_next))
        prev = cur

    result = s.check()
    if result == sat:
        return {
            "verified": True,
            "method": "z3-trajectory",
            "message": f"Z3 (SAT): all {len(trajectory) - 1} steps satisfy the Collatz map.",
        }
    return {
        "verified": False,
        "method": "z3-trajectory",
        "message": f"Z3 ({result}): trajectory is not a valid Collatz path.",
    }


def search_counterexample(bound: int, max_steps: int) -> dict[str, Any]:
    """Use Z3 to search for n in [1, bound] that does not reach 1 within max_steps."""
    if not Z3_AVAILABLE:
        return {
            "verified": False,
            "method": "basic",
            "message": "z3-solver not installed; search skipped",
        }

    s = Solver()
    n = BitVec("n", 64)
    s.add(n >= 1, n <= bound)

    cur = n
    reached = BoolVal(False)
    for _ in range(max_steps):
        reached = Or(reached, cur == 1)
        cur = If(cur & 1 == 0, LShR(cur, 1), 3 * cur + 1)

    s.add(Not(reached))
    s.set("timeout", Z3_TIMEOUT_MS)

    result = s.check()
    if result == sat:
        m = s.model()
        return {
            "verified": False,
            "method": "z3-search",
            "message": f"Z3 (SAT): found n that does not reach 1 within {max_steps} steps.",
            "counterexample": m[n].as_long(),
        }
    if result == "unknown":
        return {
            "verified": False,
            "method": "z3-search",
            "message": "Z3 returned unknown (timeout).",
        }
    return {
        "verified": True,
        "method": "z3-search",
        "message": f"Z3 (UNSAT): no n in [1, {bound}] fails to reach 1 within {max_steps} steps.",
    }


def main() -> None:
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError as e:
        json.dump({
            "verified": False,
            "method": "basic",
            "message": f"invalid JSON on stdin: {e}",
            "elapsedMs": 0,
        }, sys.stdout)
        return

    n = int(payload["n"])
    trajectory = [int(x) for x in payload["trajectory"]]

    t0 = time.time()

    traj_result = verify_trajectory(n, trajectory)
    search_result = search_counterexample(MAX_SEARCH_BOUND, MAX_SEARCH_STEPS)

    elapsed_ms = (time.time() - t0) * 1000.0

    verified = bool(traj_result.get("verified")) and bool(search_result.get("verified"))
    method = traj_result.get("method", "basic")
    message = f"{traj_result['message']} | {search_result['message']}"

    out: dict[str, Any] = {
        "verified": verified,
        "method": method,
        "message": message,
        "elapsedMs": elapsed_ms,
    }
    if "counterexample" in search_result:
        out["counterexample"] = search_result["counterexample"]

    json.dump(out, sys.stdout)


if __name__ == "__main__":
    main()
