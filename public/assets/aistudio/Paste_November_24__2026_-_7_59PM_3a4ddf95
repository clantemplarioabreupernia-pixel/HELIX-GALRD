import { useCallback, useRef } from 'react';

/**
 * Emits short Web Audio pulses whose frequency and duration
 * are derived from the given trajectory. Real Web Audio API; no fake metrics.
 */
export function useAudioPulse() {
  const ctxRef = useRef<AudioContext | null>(null);

  const ensureCtx = useCallback((): AudioContext | null => {
    if (typeof window === 'undefined') return null;
    const Ctor = window.AudioContext || (window as any).webkitAudioContext;
    if (!Ctor) return null;
    if (!ctxRef.current) ctxRef.current = new Ctor();
    if (ctxRef.current.state === 'suspended') void ctxRef.current.resume();
    return ctxRef.current;
  }, []);

  const playTrajectory = useCallback(
    (trajectory: number[], options?: { maxPulses?: number; durationMs?: number }) => {
      const ctx = ensureCtx();
      if (!ctx) return;

      const maxPulses = options?.maxPulses ?? 64;
      const baseDuration = (options?.durationMs ?? 60) / 1000;

      const step = Math.max(1, Math.floor(trajectory.length / maxPulses));
      const maxVal = Math.max(...trajectory, 1);
      const minVal = Math.max(1, Math.min(...trajectory));

      let t = ctx.currentTime + 0.02;

      for (let i = 0; i < trajectory.length; i += step) {
        const v = trajectory[i];
        // Map value logarithmically to frequency in [110, 880] Hz.
        const logMin = Math.log2(minVal);
        const logMax = Math.log2(maxVal);
        const norm = (Math.log2(Math.max(1, v)) - logMin) / Math.max(1e-9, logMax - logMin);
        const freq = 110 * Math.pow(2, norm * 3);

        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, t);

        // Short attack/release envelope.
        const dur = baseDuration;
        gain.gain.setValueAtTime(0.0001, t);
        gain.gain.exponentialRampToValueAtTime(0.15, t + 0.005);
        gain.gain.exponentialRampToValueAtTime(0.0001, t + dur);

        osc.connect(gain).connect(ctx.destination);
        osc.start(t);
        osc.stop(t + dur + 0.02);

        t += dur * 0.6;
      }
    },
    [ensureCtx],
  );

  const stop = useCallback(() => {
    if (ctxRef.current && ctxRef.current.state !== 'closed') {
      void ctxRef.current.close();
      ctxRef.current = null;
    }
  }, []);

  return { playTrajectory, stop };
}
