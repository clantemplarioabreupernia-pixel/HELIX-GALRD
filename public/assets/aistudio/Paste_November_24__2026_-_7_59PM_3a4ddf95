## 📄 ARCHIVO 20: `collatz_visualizer.glsl`

Standalone shader for external tools / ShaderToy-style use. Same math as
`src/components/shaders/fragment.glsl`.

```glsl
precision highp float;

varying vec2 vUv;
uniform float uTime;
uniform float uSeed;
uniform float uIntensity;

float hash(vec2 p) {
  p = fract(p * vec2(123.34, 456.21));
  p += dot(p, p + 45.32);
  return fract(p.x * p.y);
}

float noise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  float a = hash(i);
  float b = hash(i + vec2(1.0, 0.0));
  float c = hash(i + vec2(0.0, 1.0));
  float d = hash(i + vec2(1.0, 1.0));
  vec2 u = f * f * (3.0 - 2.0 * f);
  return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
}

void main() {
  vec2 uv = vUv;
  float s = 1.0 + mod(uSeed, 17.0);
  vec2 p = uv * s + vec2(uTime * 0.05, -uTime * 0.03);

  float n = noise(p * 3.0);
  n += 0.5 * noise(p * 7.0);
  n += 0.25 * noise(p * 13.0);
  n /= 1.75;

  vec3 cold = vec3(0.03, 0.09, 0.18);
  vec3 warm = vec3(0.13, 0.83, 0.93);
  vec3 accent = vec3(0.96, 0.32, 0.58);

  float band = smoothstep(0.35, 0.65, n + 0.15 * sin(uv.y * 12.0 + uTime));
  vec3 col = mix(cold, warm, band);

  float diag = smoothstep(0.0, 0.02, abs(uv.y - (1.0 - uv.x)));
  col = mix(col, accent, diag * uIntensity * 0.6);

  float vig = smoothstep(1.2, 0.2, length(uv - 0.5));
  col *= vig;

  gl_FragColor = vec4(col, 1.0);
}
