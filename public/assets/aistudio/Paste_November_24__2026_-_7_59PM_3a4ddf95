import { useState } from 'react';
import { computeCollatzResult } from './utils/collatz';
import type { CollatzResult, VerificationResult } from './types';
import GLSLCanvas from './components/GLSLCanvas';
import TrajectoryChart from './components/TrajectoryChart';
import EntropyChart from './components/EntropyChart';
import { useAudioPulse } from './hooks/useAudioPulse';

function Stat({ label, value }: { label: string; value: string }) {
  return (
    <div className="bg-slate-900/60 border border-slate-800 rounded-md px-3 py-2">
      <div className="text-xs text-slate-500">{label}</div>
      <div className="text-lg font-mono">{value}</div>
    </div>
  );
}

export default function App() {
  const [input, setInput] = useState('27');
  const [result, setResult] = useState<CollatzResult | null>(null);
  const [verification, setVerification] = useState<VerificationResult | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [busy, setBusy] = useState(false);

  const audio = useAudioPulse();

  const run = () => {
    setError(null);
    setVerification(null);
    const n = Number(input);
    if (!Number.isFinite(n) || !Number.isInteger(n) || n < 1) {
      setError('Introduce un entero positivo.');
      setResult(null);
      return;
    }
    try {
      setResult(computeCollatzResult(n));
    } catch (e) {
      setError(e instanceof Error ? e.message : String(e));
      setResult(null);
    }
  };

  const verify = async () => {
    if (!result) return;
    setBusy(true);
    setError(null);
    try {
      const res = await fetch('/api/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ n: result.start, trajectory: result.trajectory }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data: VerificationResult = await res.json();
      setVerification(data);
    } catch (e) {
      setError(e instanceof Error ? e.message : String(e));
    } finally {
      setBusy(false);
    }
  };

  // Seed and intensity are derived from real trajectory data.
  // Previously seed was the last value (=1 always); now it varies with input.
  const seed = result ? result.maxValue : 1;
  const intensity = result
    ? Math.min(1, Math.log10(result.maxValue / result.start + 1))
    : 0.2;

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100">
      <div className="max-w-5xl mx-auto p-6 space-y-6">
        <header className="space-y-1">
