```go
// Package main implements a standalone Collatz accelerator.
// No artificial delays, no lockOSThread, no fake metrics.
package main

import (
	"fmt"
	"os"
	"strconv"
	"time"
)

const finalState = uint64(1)

// CollatzEngine holds the state of a single trajectory computation.
type CollatzEngine struct {
	Number uint64
	Steps  int
}

// Run computes the Collatz trajectory of n and prints real elapsed time.
// If verbose is true, it also prints the maximum value and its step.
func (ce *CollatzEngine) Run(n uint64, verbose bool) {
	ce.Number = n
	ce.Steps = 0

	start := time.Now()

	var maxValue uint64 = n
	var maxStep int = 0

	for ce.Number != finalState {
		if ce.Number%2 == 0 {
			ce.Number /= 2
		} else {
			// Guard against uint64 overflow for very large n.
			if ce.Number > (^uint64(0)-1)/3 {
				fmt.Fprintf(os.Stderr, "[collatz] overflow detected at n=%d\n", ce.Number)
				return
			}
			ce.Number = 3*ce.Number + 1
		}
		ce.Steps++
		if ce.Number > maxValue {
			maxValue = ce.Number
			maxStep = ce.Steps
		}
	}

	elapsed := time.Since(start)
	if verbose {
		fmt.Printf("[collatz] n=%d steps=%d max=%d maxStep=%d elapsed=%v\n",
			n, ce.Steps, maxValue, maxStep, elapsed)
	} else {
		fmt.Printf("%d %d %v\n", ce.Steps, maxValue, elapsed)
	}
}

func main() {
	if len(os.Args) < 2 {
		// Default demo value, matching the classic example n=27.
		engine := &CollatzEngine{}
		engine.Run(27, true)
		return
	}

	n, err := strconv.ParseUint(os.Args[1], 10, 64)
	if err != nil || n < 1 {
		fmt.Fprintln(os.Stderr, "usage: collatz_accelerator <positive integer>")
		os.Exit(1)
	}

	engine := &CollatzEngine{}
	engine.Run(n, true)
}
