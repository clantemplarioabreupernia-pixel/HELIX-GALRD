import { useEffect, useRef } from 'react';

interface Props {
  values: number[];
  className?: string;
}

export default function EntropyChart({ values, className }: Props) {
  const ref = useRef<HTMLCanvasElement>(null);

  useEffect(() => {
    const canvas = ref.current;
    if (!canvas || values.length === 0) return;

    const dpr = window.devicePixelRatio || 1;
    const W = canvas.clientWidth;
    const H = canvas.clientHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;

    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const N = values.length;
    const barW = Math.max(1, W / N);
    for (let i = 0; i < N; i++) {
      const h = values[i] * (H - 8);
      const x = (i / N) * W;
      // hue from 190 (cyan) to 310 (magenta), lightness follows entropy
      const hue = 190 + values[i] * 120;
      ctx.fillStyle = `hsla(${hue}, 80%, 60%, 0.85)`;
      ctx.fillRect(x, H - h - 4, barW, h);
    }
  }, [values]);

  return <canvas ref={ref} className={className} />;
}
