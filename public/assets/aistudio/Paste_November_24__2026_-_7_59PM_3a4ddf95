import type { CollatzResult, TrajectoryPoint } from '../types';

const HARD_STEP_CAP = 10_000_000;

/**
 * Computes the full Collatz trajectory for a positive integer n.
 * Returns the sequence [n, ..., 1].
 */
export function computeCollatzTrajectory(n: number): number[] {
  if (!Number.isFinite(n) || !Number.isInteger(n) || n < 1) {
    throw new Error('n must be a positive integer');
  }
  if (n > Number.MAX_SAFE_INTEGER) {
    throw new Error('n exceeds MAX_SAFE_INTEGER; use the Go accelerator for larger values');
  }

  const trajectory: number[] = [n];
  let current = n;
  let steps = 0;

  while (current !== 1) {
    current = current % 2 === 0 ? current / 2 : 3 * current + 1;
    trajectory.push(current);
    if (++steps > HARD_STEP_CAP) {
      throw new Error('trajectory exceeded step cap');
    }
  }
  return trajectory;
}

/**
 * Shannon entropy (bits) of the binary representation of a non-negative integer.
 * Range: [0, 1] for any single value. 0 for value 0.
 *
 * For value 0 we return 0 (no bits, no entropy).
 * For value 1 we return 0 (single bit, deterministic).
 * For any value with equal 0s and 1s we return 1 (max uncertainty for 1 bit of info).
 */
export function calculateBitEntropy(value: number): number {
  const n = Math.abs(Math.floor(value));
  if (n === 0) return 0;

  let ones = 0;
  let length = 0;
  let v = n;
  while (v > 0) {
    ones += v & 1;
    length += 1;
    v = Math.floor(v / 2);
  }
  const zeros = length - ones;

  let h = 0;
  for (const count of [ones, zeros]) {
    if (count === 0) continue;
    const p = count / length;
    h -= p * Math.log2(p);
  }
  return h;
}

/**
 * Full pipeline: trajectory + entropy per step + aggregate metrics.
 * Real elapsed time is measured with performance.now() when available,
 * falling back to Date.now() in Node environments.
 */
export function computeCollatzResult(n: number): CollatzResult {
  const now = typeof performance !== 'undefined' ? () => performance.now() : () => Date.now();

  const t0 = now();
  const trajectory = computeCollatzTrajectory(n);

  const points: TrajectoryPoint[] = trajectory.map((value, step) => ({
    step,
    value,
    entropy: calculateBitEntropy(value),
  }));

  const t1 = now();

  let maxValue = trajectory[0];
  let maxValueStep = 0;
  for (let i = 1; i < trajectory.length; i++) {
    if (trajectory[i] > maxValue) {
      maxValue = trajectory[i];
      maxValueStep = i;
    }
  }

  const totalEntropy = points.reduce((acc, p) => acc + p.entropy, 0);
  const averageEntropy = points.length > 0 ? totalEntropy / points.length : 0;

  return {
    start: n,
    steps: trajectory.length - 1,
    maxValue,
    maxValueStep,
    totalTimeMs: t1 - t0,
    trajectory,
    points,
    totalEntropy,
    averageEntropy,
  };
}
