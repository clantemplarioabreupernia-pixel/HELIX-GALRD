import { useEffect, useRef } from 'react';

interface Props {
  trajectory: number[];
  className?: string;
}

export default function TrajectoryChart({ trajectory, className }: Props) {
  const ref = useRef<HTMLCanvasElement>(null);

  useEffect(() => {
    const canvas = ref.current;
    if (!canvas || trajectory.length < 2) return;

    const dpr = window.devicePixelRatio || 1;
    const W = canvas.clientWidth;
    const H = canvas.clientHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;

    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const max = Math.max(...trajectory);
    const N = trajectory.length;

    // Horizontal grid lines
    ctx.strokeStyle = 'rgba(120,160,220,0.12)';
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = (H / 4) * i;
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(W, y);
      ctx.stroke();
    }

    // Trajectory line, log-scaled Y for readability on large peaks
    const logMax = Math.log10(max + 1);
    const grad = ctx.createLinearGradient(0, 0, W, 0);
    grad.addColorStop(0, '#38bdf8');
    grad.addColorStop(1, '#f472b6');
    ctx.strokeStyle = grad;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    for (let i = 0; i < N; i++) {
      const x = (i / (N - 1)) * W;
      const logV = Math.log10(trajectory[i] + 1);
      const y = H - (logV / Math.max(1e-9, logMax)) * (H - 8) - 4;
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.stroke();
  }, [trajectory]);

  return <canvas ref={ref} className={className} />;
}
