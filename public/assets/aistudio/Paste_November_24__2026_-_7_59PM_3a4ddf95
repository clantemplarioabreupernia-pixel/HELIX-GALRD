import express from 'express';
import { spawn } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
app.use(express.json({ limit: '16mb' }));

interface VerifyBody {
  n?: number;
  trajectory?: number[];
}

app.post('/api/verify', (req, res) => {
  const body = req.body as VerifyBody;
  const n = body.n;
  const trajectory = body.trajectory;

  if (typeof n !== 'number' || !Array.isArray(trajectory)) {
    res.status(400).json({ error: 'n (number) and trajectory (array) required' });
    return;
  }

  const py = spawn('python3', [path.join(__dirname, 'collatz_formal_guard.py')], {
    stdio: ['pipe', 'pipe', 'pipe'],
  });

  let stdout = '';
  let stderr = '';
  py.stdout.on('data', (d) => (stdout += d.toString()));
  py.stderr.on('data', (d) => (stderr += d.toString()));

  py.on('error', (err) => {
    res.status(500).json({
      verified: false,
      method: 'basic',
      message: `failed to spawn python3: ${err.message}`,
      elapsedMs: 0,
    });
  });

  py.on('close', (code) => {
    if (code !== 0) {
      res.status(500).json({
        verified: false,
        method: 'basic',
        message: stderr || `python3 exited with code ${code}`,
        elapsedMs: 0,
      });
      return;
    }
    try {
      const parsed = JSON.parse(stdout);
      res.json(parsed);
    } catch {
      res.status(500).json({
        verified: false,
        method: 'basic',
        message: `invalid JSON from verifier: ${stdout.slice(0, 200)}`,
        elapsedMs: 0,
      });
    }
  });

  py.stdin.write(JSON.stringify({ n, trajectory }));
  py.stdin.end();
});

app.get('/api/health', (_req, res) => {
  res.json({ status: 'ok' });
});

const PORT = Number(process.env.PORT) || 3000;
app.listen(PORT, () => {
  console.log(`omega-collatz server on http://localhost:${PORT}`);
});
