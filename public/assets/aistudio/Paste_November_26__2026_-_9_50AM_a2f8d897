			return
		}
		if _, err := conn.Write(frame); err != nil {
			return
		}
	}
}

func leerWS(conn net.Conn) {
	hdr := make([]byte, 2)
	for {
		if _, err := io.ReadFull(conn, hdr); err != nil {
			return
		}
		b0, b1 := hdr, hdr
		if (b0 & 0x0F) == 0x8 {
			return
		}
		plen := int(b1 & 0x7F)
		if plen == 126 {
			ext := make([]byte, 2)
			io.ReadFull(conn, ext)
			plen = int(binary.BigEndian.Uint16(ext))
		}
		mask := make([]byte, 4)
		if (b1 & 0x80) != 0 {
			io.ReadFull(conn, mask)
		}
		data := make([]byte, plen)
		if _, err := io.ReadFull(conn, data); err != nil {
			return
		}
		if (b1 & 0x80) != 0 {
			for i := 0; i < plen; i++ {
				data[i] ^= mask[i%4]
			}
		}
		ctrl.Lock()
		for _, part := range strings.Split(string(data), "|") {
			clave, valorStr, ok := strings.Cut(part, ":")
			if ok {
				if v, err := strconv.ParseFloat(valorStr, 64); err == nil {
					switch clave {
					case "F":
						ctrl.Freq = v
					case "A":
						ctrl.Amp = v
					case "E":
						ctrl.Elast = v
					case "V":
						ctrl.Visc = v
					case "P":
						ctrl.Paso = v
					}
				}
			}
		}
		ctrl.Unlock()
	}
}

