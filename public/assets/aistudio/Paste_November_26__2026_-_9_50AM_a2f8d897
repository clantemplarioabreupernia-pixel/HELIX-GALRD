	if vds < (vgs - vth) {
		// Región Lineal
		return (mu * cox * wL * ((vgs-vth)*vds - 0.5*math.Pow(vds, 2))) * 1e6
	}
	// Región de Saturación (brillo estable)
	return (0.5 * mu * cox * wL * math.Pow(vgs-vth, 2) * (1 + lambdaC*vds)) * 1e6
}

func main() {
	fmt.Println("=== NÚCLEO FÍSICO HELIX: RENDERIZADO NANOMÉTRICO (QLED + TFT) ===")

