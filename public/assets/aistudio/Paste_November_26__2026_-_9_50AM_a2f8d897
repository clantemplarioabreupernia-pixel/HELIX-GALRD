import numpy as np
import matplotlib.pyplot as plt

# ==========================================
# 1. CONSTANTES FÍSICAS FUNDAMENTALES
# ==========================================
h = 6.62607015e-34      # Constante de Planck (J·s)
c = 2.99792458e8        # Velocidad de la luz (m/s)
e = 1.60217663e-19      # Carga del electrón (C)
m0 = 9.1093837e-31      # Masa en reposo del electrón (kg)
eps0 = 8.8541878e-12    # Permitividad del vacío (F/m)

# ==========================================
# 2. MODELO DE PUNTOS CUÁNTICOS (ECUACIÓN DE BRUS)
# Material: Seleniuro de Cadmio (CdSe)
# ==========================================
Eg_J = 1.74 * e         # Energía de banda prohibida en Joules (1.74 eV)
me = 0.13 * m0          # Masa efectiva del electrón
mh = 0.45 * m0          # Masa efectiva del hueco
eps_r = 9.3             # Permitividad relativa del CdSe

def calcular_longitud_onda(radio_nm):
    R = radio_nm * 1e-9  # Convertir nm a metros
    # Término de confinamiento cuántico
    confinamiento = (h**2 / (8 * R**2)) * (1/me + 1/mh)
    # Término de atracción electrostática de Coulomb
    coulomb = (1.8 * e**2) / (4 * np.pi * eps0 * eps_r * R)
    
    E_total = Eg_J + confinamiento - coulomb
    lambda_m = (h * c) / E_total
    return lambda_m * 1e9  # Retornar en nanómetros

# Calcular curva para radios entre 1.1 nm y 3.5 nm
radios = np.linspace(1.1, 3.5, 200)
longitudes_onda = calcular_longitud_onda(radios)

# Subpíxeles RGB típicos (radios en nm)
r_azul, r_verde, r_rojo = 1.25, 2.29, 3.15
l_azul = calcular_longitud_onda(r_azul)
l_verde = calcular_longitud_onda(r_verde)
l_rojo = calcular_longitud_onda(r_rojo)

# Espectro de emisión Gaussiano (FWHM = 20 nm)
espectro_x = np.linspace(380, 750, 500)
sigma = 20 / (2 * np.sqrt(2 * np.log(2)))  # Desviación estándar para FWHM = 20 nm

