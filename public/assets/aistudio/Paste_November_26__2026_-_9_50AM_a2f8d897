const (
	h    = 6.62607015e-34
	c    = 2.99792458e8
	e    = 1.60217663e-19
	m0   = 9.1093837e-31
	eps0 = 8.85418781e-12
)

func calcularLongitudOnda(radioNm float64) float64 {
	Eg, me, mh, epsR := 1.74*e, 0.13*m0, 0.45*m0, 9.3
	R := radioNm * 1e-9
	confinamiento := (math.Pow(h, 2) / (8 * math.Pow(R, 2))) * (1/me + 1/mh)
	coulomb := (1.8 * math.Pow(e, 2)) / (4 * math.Pi * eps0 * epsR * R)
	return ((h * c) / (Eg + confinamiento - coulomb)) * 1e9
}

func longitudOndaARGB(lambda float64) (uint8, uint8, uint8) {
	g := func(x, mu, t1, t2 float64) float64 {
		t := t1
		if x >= mu {
			t = t2
		}
		return math.Exp(-0.5 * math.Pow((x-mu)*t, 2))
	}
	X := 1.056*g(lambda, 599.8, 0.0264, 0.0323) + 0.362*g(lambda, 442.0, 0.0624, 0.0374) - 0.065*g(lambda, 501.1, 0.0490, 0.0382)
	Y := 0.821*g(lambda, 568.8, 0.0213, 0.0247) + 0.286*g(lambda, 530.9, 0.0613, 0.0322)
	Z := 1.217*g(lambda, 437.0, 0.0845, 0.0278) + 0.681*g(lambda, 459.0, 0.0385, 0.0725)

	rLin := 3.2406*X - 1.5372*Y - 0.4986*Z
	gLin := -0.9689*X + 1.8758*Y + 0.0415*Z
	bLin := 0.0557*X - 0.2040*Y + 1.0570*Z

	toByte := func(v float64) uint8 {
		if v <= 0 {
			return 0
		}
		if v <= 0.0031308 {
			v = 12.92 * v
		} else {
			v = 1.055*math.Pow(v, 1.0/2.4) - 0.055
		}
		if v > 1.0 {
			v = 1.0
		}
		return uint8(math.Round(v * 255))
	}
	return toByte(rLin), toByte(gLin), toByte(bLin)
}

