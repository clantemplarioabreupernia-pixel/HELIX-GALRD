func (m *MallaBioPixeles) PasoSimulacion(tiempo, pasoTiempo, frecuenciaHz, amplitudSonora, impactoMovimiento float64) {
	omega := 2.0 * math.Pi * frecuenciaHz
	centroX, centroY := float64(m.Ancho)/2.0, float64(m.Alto)/2.0

	for y := 1; y < m.Alto-1; y++ {
		for x := 1; x < m.Ancho-1; x++ {
			idx := y*m.Ancho + x
			celda := &m.Celdas[idx]

			arriba := &m.Celdas[(y-1)*m.Ancho+x]
			abajo := &m.Celdas[(y+1)*m.Ancho+x]
			izquierda := &m.Celdas[y*m.Ancho+(x-1)]
			derecha := &m.Celdas[y*m.Ancho+(x+1)]

			distancia := math.Hypot(float64(x)-centroX, float64(y)-centroY)
			ondaSonora := amplitudSonora * math.Sin(omega*tiempo-distancia*0.42) * math.Exp(-distancia*0.035)
			ondaMovimiento := impactoMovimiento * math.Cos(distancia*0.6-tiempo*12.0) * math.Exp(-distancia*0.06)

			// Eje X
			lapUX := arriba.DesplazamientoX + abajo.DesplazamientoX + izquierda.DesplazamientoX + derecha.DesplazamientoX - 4.0*celda.DesplazamientoX
			lapVX := arriba.VelocidadX + abajo.VelocidadX + izquierda.VelocidadX + derecha.VelocidadX - 4.0*celda.VelocidadX
			esfuerzoX := m.Elasticidad*lapUX - 12.0*celda.DesplazamientoX + m.Viscosidad*lapVX
			celda.AceleracionX = (esfuerzoX + ondaSonora) / m.Densidad

			// Eje Y (recibe además el impulso vertical de pasos o aleteo)
			lapUY := arriba.DesplazamientoY + abajo.DesplazamientoY + izquierda.DesplazamientoY + derecha.DesplazamientoY - 4.0*celda.DesplazamientoY
			lapVY := arriba.VelocidadY + abajo.VelocidadY + izquierda.VelocidadY + derecha.VelocidadY - 4.0*celda.VelocidadY
			esfuerzoY := m.Elasticidad*lapUY - 12.0*celda.DesplazamientoY + m.Viscosidad*lapVY
			celda.AceleracionY = (esfuerzoY + ondaSonora + ondaMovimiento) / m.Densidad

			// Eje Z
			lapUZ := arriba.DesplazamientoZ + abajo.DesplazamientoZ + izquierda.DesplazamientoZ + derecha.DesplazamientoZ - 4.0*celda.DesplazamientoZ
			lapVZ := arriba.VelocidadZ + abajo.VelocidadZ + izquierda.VelocidadZ + derecha.VelocidadZ - 4.0*celda.VelocidadZ
			esfuerzoZ := m.Elasticidad*lapUZ - 12.0*celda.DesplazamientoZ + m.Viscosidad*lapVZ
			celda.AceleracionZ = (esfuerzoZ + ondaSonora) / m.Densidad
		}
	}

	for i := range m.Celdas {
		c := &m.Celdas[i]
		c.VelocidadX = (c.VelocidadX + c.AceleracionX*pasoTiempo) * 0.985
		c.DesplazamientoX += c.VelocidadX * pasoTiempo

		c.VelocidadY = (c.VelocidadY + c.AceleracionY*pasoTiempo) * 0.985
		c.DesplazamientoY += c.VelocidadY * pasoTiempo

		c.VelocidadZ = (c.VelocidadZ + c.AceleracionZ*pasoTiempo) * 0.985
		c.DesplazamientoZ += c.VelocidadZ * pasoTiempo

		c.sincronizarCaras()
	}
}

// RenderizarBuffer escribe 6 bytes por BioPíxel: Rojo, Verde, Azul, Alfa, AlturaViscoelastica y Glifo3Bits
func (m *MallaBioPixeles) RenderizarBuffer(buffer []byte) {
	const corrienteMaximaTFT = 195.0

	for i := range m.Celdas {
		bp := &m.Celdas[i]

		energiaVertical := math.Abs(bp.EnergiaArriba-bp.EnergiaAbajo) * 0.5
		profundidadZ := math.Tanh((bp.EnergiaFrente - bp.EnergiaFondo) * 8.0)
		energiaHorizontal := math.Tanh((bp.EnergiaDerecha - bp.EnergiaIzquierda) * 8.0)

		factorRojo := 1.0 - 0.16*profundidadZ
		factorVerde := 1.0 - 0.14*energiaHorizontal
		factorAzul := 1.0 + 0.16*profundidadZ

		lambdaRojo := calcularEcuacionBrus(bp.RadioRojo * factorRojo)
		lambdaVerde := calcularEcuacionBrus(bp.RadioVerde * factorVerde)
		lambdaAzul := calcularEcuacionBrus(bp.RadioAzul * factorAzul)

		voltajeCompuerta := math.Min(1.6+energiaVertical*18.0, 4.5)
		intensidad := math.Min(calcularCorrienteTFT(voltajeCompuerta, m.VoltajeDren)/corrienteMaximaTFT, 1.0)

		r1, g1, b1 := convertirEspectroCIE(lambdaRojo, intensidad)
		r2, g2, b2 := convertirEspectroCIE(lambdaVerde, intensidad)
		r3, g3, b3 := convertirEspectroCIE(lambdaAzul, intensidad)

		pos := i * 6
		buffer[pos+0] = codificarGamma(r1 + r2 + r3)
		buffer[pos+1] = codificarGamma(g1 + g2 + g3)
		buffer[pos+2] = codificarGamma(b1 + b2 + b3)
		buffer[pos+3] = 255

		alturaNormalizada := math.Max(0.0, math.Min(1.0, 0.5+bp.DesplazamientoY*2.5))
		buffer[pos+4] = uint8(alturaNormalizada * 255.0)
		buffer[pos+5] = bp.BitsPolaridad
	}
}

func calcularEcuacionBrus(radioNm float64) float64 {
	if radioNm < 1.35 {
		radioNm = 1.35
	}
	energiaBanda := 1.74 * cargaElectron
	masaElect := 0.13 * masaElectronReposo
	masaHueco := 0.45 * masaElectronReposo
	permitividadRel := 9.3

	radioMetros := radioNm * 1e-9
	confinamiento := (constantePlanck * constantePlanck / (8.0 * radioMetros * radioMetros)) * (1.0/masaElect + 1.0/masaHueco)
	coulomb := (1.8 * cargaElectron * cargaElectron) / (4.0 * math.Pi * permitividadVacio * permitividadRel * radioMetros)
	return ((constantePlanck * velocidadLuz) / (energiaBanda + confinamiento - coulomb)) * 1e9
}

func calcularCorrienteTFT(voltajeCompuerta, voltajeDrenador float64) float64 {
	const (
		movilidad       = 15e-4
		permitividadOx  = 3.9
		espesorOxido    = 10e-9
		relacionCanal   = 5.0
		voltajeUmbral   = 0.8
		modulacionCanal = 0.02
	)
	if voltajeCompuerta <= voltajeUmbral {
		return 0.0
	}
	capacitanciaOx := (permitividadVacio * permitividadOx) / espesorOxido
	if voltajeDrenador < (voltajeCompuerta - voltajeUmbral) {
		return (movilidad * capacitanciaOx * relacionCanal * ((voltajeCompuerta-voltajeUmbral)*voltajeDrenador - 0.5*voltajeDrenador*voltajeDrenador)) * 1e6
	}
	diferencia := voltajeCompuerta - voltajeUmbral
	return (0.5 * movilidad * capacitanciaOx * relacionCanal * diferencia * diferencia * (1.0 + modulacionCanal*voltajeDrenador)) * 1e6
}

func convertirEspectroCIE(longitudOnda, intensidad float64) (float64, float64, float64) {
	gauss := func(x, mu, t1, t2 float64) float64 {
		t := t1
		if x >= mu {
			t = t2
		}
		d := (x - mu) * t
		return math.Exp(-0.5 * d * d)
	}
	X := 1.056*gauss(longitudOnda, 599.8, 0.0264, 0.0323) + 0.362*gauss(longitudOnda, 442.0, 0.0624, 0.0374) - 0.065*gauss(longitudOnda, 501.1, 0.0490, 0.0382)
	Y := 0.821*gauss(longitudOnda, 568.8, 0.0213, 0.0247) + 0.286*gauss(longitudOnda, 530.9, 0.0613, 0.0322)
	Z := 1.217*gauss(longitudOnda, 437.0, 0.0845, 0.0278) + 0.681*gauss(longitudOnda, 459.0, 0.0385, 0.0725)

	return (3.2406*X - 1.5372*Y - 0.4986*Z) * intensidad,
		(-0.9689*X + 1.8758*Y + 0.0415*Z) * intensidad,
		(0.0557*X - 0.2040*Y + 1.0570*Z) * intensidad
}

func codificarGamma(valor float64) uint8 {
	if valor <= 0 {
		return 0
	}
	if valor <= 0.0031308 {
		valor = 12.92 * valor
	} else {
		valor = 1.055*math.Pow(valor, 1.0/2.4) - 0.055
	}
	if valor > 1.0 {
		valor = 1.0
	}
	return uint8(math.Round(valor * 255.0))
}
