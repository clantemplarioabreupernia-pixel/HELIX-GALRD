// Parámetros del Punto Cuántico (CdSe)
type PuntoCuantico struct {
	Nombre string
	Radio  float64 // en nanómetros
}

// Ecuación de Brus: Calcula la longitud de onda (nm) según el radio nanométrico
func calcularLongitudOnda(radioNm float64) float64 {
	Eg := 1.74 * e
	me := 0.13 * m0
	mh := 0.45 * m0
	epsR := 9.3

	R := radioNm * 1e-9
	confinamiento := (math.Pow(h, 2) / (8 * math.Pow(R, 2))) * (1/me + 1/mh)
	coulomb := (1.8 * math.Pow(e, 2)) / (4 * math.Pi * eps0 * epsR * R)

	energiaTotal := Eg + confinamiento - coulomb
	lambdaM := (h * c) / energiaTotal
	return lambdaM * 1e9
}

// Modelo del Transistor Nanométrico (TFT IGZO) -> Retorna corriente en µA
func corrienteTFT(vgs, vds float64) float64 {
	mu := 15e-4
	epsOx := 3.9
	tOx := 10e-9
	cox := (eps0 * epsOx) / tOx
	wL := 5.0
	vth := 0.8
	lambdaC := 0.02

	if vgs <= vth {
		return 0.0
