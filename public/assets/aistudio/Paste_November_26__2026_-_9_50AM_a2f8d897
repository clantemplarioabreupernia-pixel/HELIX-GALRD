package nanopixel

import "math"

const (
	h, c, e, m0, eps0 = 6.62607015e-34, 2.99792458e8, 1.60217663e-19, 9.1093837e-31, 8.85418781e-12
	CaraArriba, CaraAbajo, CaraDerecha, CaraIzquierda, CaraFrente, CaraFondo = 0, 1, 2, 3, 4, 5
)

type BioPixelCubico struct {
	BitsPolaridad          uint8
	Caras                  [6]float64
	Desplazamiento         [3]float64
	Velocidad              [3]float64
	Aceleracion            [3]float64
	RadioR, RadioG, RadioB float64
}

type MallaBioPixeles struct {
	Ancho, Alto                             int
	Celdas                                  []BioPixelCubico
	Densidad, Elasticidad, Viscosidad, Vds  float64
}

func NuevaMallaBioPixeles(ancho, alto int) *MallaBioPixeles {
	celdas := make([]BioPixelCubico, ancho*alto)
	for y := 0; y < alto; y++ {
		for x := 0; x < ancho; x++ {
			idx := y*ancho + x
			bits := uint8(((x % 2) << 0) | ((y % 2) << 1) | (((x + y) % 2) << 2))
			celdas[idx] = BioPixelCubico{BitsPolaridad: bits, RadioR: 3.35, RadioG: 2.29, RadioB: 1.88}
			celdas[idx].sincronizarCaras()
		}
	}
	return &MallaBioPixeles{Ancho: ancho, Alto: alto, Celdas: celdas, Densidad: 1050.0, Elasticidad: 180.0, Viscosidad: 4.5, Vds: 5.0}
}

func (bp *BioPixelCubico) sincronizarCaras() {
	signo := [3]float64{1.0, 1.0, 1.0}
	if (bp.BitsPolaridad & 0x01) != 0 { signo[0] = -1.0 }
	if (bp.BitsPolaridad & 0x02) != 0 { signo[1] = -1.0 }
	if (bp.BitsPolaridad & 0x04) != 0 { signo[2] = -1.0 }
	bp.Caras[CaraDerecha] = bp.Desplazamiento[0] * signo[0]
	bp.Caras[CaraIzquierda] = -bp.Caras[CaraDerecha]
	bp.Caras[CaraArriba] = bp.Desplazamiento[1] * signo[1]
	bp.Caras[CaraAbajo] = -bp.Caras[CaraArriba]
	bp.Caras[CaraFrente] = bp.Desplazamiento[2] * signo[2]
	bp.Caras[CaraFondo] = -bp.Caras[CaraFrente]
}

func (m *MallaBioPixeles) PasoSimulacion(t, dt, freqHz, amplitud, impactoPaso float64) {
	omega := 2.0 * math.Pi * freqHz
	cx, cy := float64(m.Ancho)/2.0, float64(m.Alto)/2.0
	for y := 1; y < m.Alto-1; y++ {
		for x := 1; x < m.Ancho-1; x++ {
			idx := y*m.Ancho + x
			celda := &m.Celdas[idx]
			iArr, iAba, iIzq, iDer := (y-1)*m.Ancho+x, (y+1)*m.Ancho+x, y*m.Ancho+(x-1), y*m.Ancho+(x+1)
			dist := math.Hypot(float64(x)-cx, float64(y)-cy)
			ondaSonora := amplitud * math.Sin(omega*t-dist*0.42) * math.Exp(-dist*0.035)
			ondaPaso := impactoPaso * math.Cos(dist*0.6-t*12.0) * math.Exp(-dist*0.06)
			for eje := 0; eje < 3; eje++ {
				lapU := m.Celdas[iArr].Desplazamiento[eje] + m.Celdas[iAba].Desplazamiento[eje] + m.Celdas[iIzq].Desplazamiento[eje] + m.Celdas[iDer].Desplazamiento[eje] - 4.0*celda.Desplazamiento[eje]
				lapV := m.Celdas[iArr].Velocidad[eje] + m.Celdas[iAba].Velocidad[eje] + m.Celdas[iIzq].Velocidad[eje] + m.Celdas[iDer].Velocidad[eje] - 4.0*celda.Velocidad[eje]
				esfuerzo := m.Elasticidad*lapU - 12.0*celda.Desplazamiento[eje] + m.Viscosidad*lapV
