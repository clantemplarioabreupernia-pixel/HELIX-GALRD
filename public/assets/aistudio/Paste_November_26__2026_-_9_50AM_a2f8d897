	}
	cox := (eps0 * epsOx) / tOx
	if vds < (vgs - vth) {
		return (mu * cox * wL * ((vgs-vth)*vds - 0.5*vds*vds)) * 1e6
	}
	diff := vgs - vth
	return (0.5 * mu * cox * wL * diff * diff * (1.0 + lambdaC*vds)) * 1e6
}

func espectroCIE(lambda, intensidad float64) (float64, float64, float64) {
	g := func(x, mu, t1, t2 float64) float64 {
		t := t1
