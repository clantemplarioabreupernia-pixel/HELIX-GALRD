@'
package nanopixel

import "math"

// Constantes físicas fundamentales (SI)
const (
	h    = 6.62607015e-34
	c    = 2.99792458e8
	e    = 1.60217663e-19
	m0   = 9.1093837e-31
	eps0 = 8.85418781e-12
)

// MaterialSemiconductor define las propiedades físicas base del nanocristal
type MaterialSemiconductor struct {
	EgEV float64 // Bandgap en bloque (eV)
	Me   float64 // Relación masa efectiva electrón (m_e* / m0)
	Mh   float64 // Relación masa efectiva hueco (m_h* / m0)
	EpsR float64 // Permitividad dieléctrica relativa
}

// Materiales predefinidos listos para inyectar
var (
	CdSe = MaterialSemiconductor{EgEV: 1.74, Me: 0.13, Mh: 0.45, EpsR: 9.3}  // Seleniuro de Cadmio
	InP  = MaterialSemiconductor{EgEV: 1.34, Me: 0.08, Mh: 0.60, EpsR: 12.5} // Fosfuro de Indio (sin cadmio)
)

// BioPixel representa un píxel completo compuesto por 3 subpíxeles nanométricos
type BioPixel struct {
	RadioR, RadioG, RadioB float64 // Radios físicos en nm
	VgsR, VgsG, VgsB       float64 // Voltajes de compuerta TFT (brillo)
	Vds                    float64 // Voltaje de alimentación del panel
	Material               MaterialSemiconductor
}

// ColorRGBA salida directa en memoria para el framebuffer de HELIX
type ColorRGBA struct {
	R, G, B, A uint8
}

// LongitudOndaBrus calcula la emisión exacta (nm) a partir del radio nanométrico
func (m MaterialSemiconductor) LongitudOndaBrus(radioNm float64) float64 {
	egJ := m.EgEV * e
	meKg := m.Me * m0
	mhKg := m.Mh * m0
	rM := radioNm * 1e-9

	confinamiento := (h * h / (8.0 * rM * rM)) * (1.0/meKg + 1.0/mhKg)
	coulomb := (1.8 * e * e) / (4.0 * math.Pi * eps0 * m.EpsR * rM)

	return ((h * c) / (egJ + confinamiento - coulomb)) * 1e9
}

// CorrienteTFT calcula la corriente de excitación (µA) del transistor IGZO del subpíxel
func CorrienteTFT(vgs, vds float64) float64 {
	const (
		mu      = 15e-4
		epsOx   = 3.9
		tOx     = 10e-9
		wL      = 5.0
		vth     = 0.8
		lambdaC = 0.02
	)
	if vgs <= vth {
		return 0.0
	}
	cox := (eps0 * epsOx) / tOx
	if vds < (vgs - vth) {
		return (mu * cox * wL * ((vgs-vth)*vds - 0.5*vds*vds)) * 1e6
	}
	diff := vgs - vth
	return (0.5 * mu * cox * wL * diff * diff * (1.0 + lambdaC*vds)) * 1e6
}

// EspectroARGB convierte longitud de onda (nm) e intensidad normalizada [0..1] a sRGB lineal
func EspectroARGB(lambda, intensidad float64) (float64, float64, float64) {
	g := func(x, mu, t1, t2 float64) float64 {
		t := t1
		if x >= mu {
			t = t2
		}
		d := (x - mu) * t
		return math.Exp(-0.5 * d * d)
	}

	X := 1.056*g(lambda, 599.8, 0.0264, 0.0323) + 0.362*g(lambda, 442.0, 0.0624, 0.0374) - 0.065*g(lambda, 501.1, 0.0490, 0.0382)
	Y := 0.821*g(lambda, 568.8, 0.0213, 0.0247) + 0.286*g(lambda, 530.9, 0.0613, 0.0322)
	Z := 1.217*g(lambda, 437.0, 0.0845, 0.0278) + 0.681*g(lambda, 459.0, 0.0385, 0.0725)

	r := (3.2406*X - 1.5372*Y - 0.4986*Z) * intensidad
	gr := (-0.9689*X + 1.8758*Y + 0.0415*Z) * intensidad
	b := (0.0557*X - 0.2040*Y + 1.0570*Z) * intensidad

	return r, gr, b
}

// Renderizar sintetiza el color final aditivo del BioPixel listo para escribir en el buffer de imagen
func (bp *BioPixel) Renderizar() ColorRGBA {
	// 1. Corriente máxima de referencia (a Vgs=4.5V, Vds=5.0V -> 195 µA) para normalizar brillo [0..1]
	const iMax = 195.0

	intR := math.Min(CorrienteTFT(bp.VgsR, bp.Vds)/iMax, 1.0)
	intG := math.Min(CorrienteTFT(bp.VgsG, bp.Vds)/iMax, 1.0)
	intB := math.Min(CorrienteTFT(bp.VgsB, bp.Vds)/iMax, 1.0)

	// 2. Calcular emisión cuántica de cada subpíxel
	lamR := bp.Material.LongitudOndaBrus(bp.RadioR)
	lamG := bp.Material.LongitudOndaBrus(bp.RadioG)
	lamB := bp.Material.LongitudOndaBrus(bp.RadioB)

	// 3. Suma aditiva óptica en espacio lineal
	r1, g1, b1 := EspectroARGB(lamR, intR)
	r2, g2, b2 := EspectroARGB(lamG, intG)
	r3, g3, b3 := EspectroARGB(lamB, intB)

	// 4. Aplicar curva gamma sRGB y empaquetar en 8 bits por canal
	return ColorRGBA{
		R: gammaEncode(r1 + r2 + r3),
		G: gammaEncode(g1 + g2 + g3),
		B: gammaEncode(b1 + b2 + b3),
		A: 255,
	}
}

func gammaEncode(v float64) uint8 {
	if v <= 0.0 {
		return 0
	}
	if v <= 0.0031308 {
		v = 12.92 * v
	} else {
		v = 1.055*math.Pow(v, 1.0/2.4) - 0.055
	}
	if v > 1.0 {
		v = 1.0
	}
	return uint8(math.Round(v * 255.0))
}
