@'
package nanopixel

import "math"

// Constantes físicas fundamentales (SI)
const (
	h    = 6.62607015e-34
	c    = 2.99792458e8
	e    = 1.60217663e-19
	m0   = 9.1093837e-31
	eps0 = 8.85418781e-12
)

// BioPixelViscoelastico representa un nodo de la pantalla líquida maleable
type BioPixelViscoelastico struct {
	// Estado mecánico (Cauchy)
	U   float64 // Desplazamiento/altura de la textura (m)
	Vel float64 // Velocidad vertical del fluido (m/s)
	Acc float64 // Aceleración (m/s²)

	// Estado cuántico base
	RadioBaseR float64 // nm
	RadioBaseG float64 // nm
	RadioBaseB float64 // nm
}

// PantallaLiquida modela el medio continuo viscoelástico con puntos cuánticos suspendidos
type PantallaLiquida struct {
	Ancho, Alto int
	Nodos       []BioPixelViscoelastico

	// Propiedades de Cauchy y su némesis viscoelástica
	Densidad    float64 // ρ (kg/m³) - ej. hidrogel/elastómero ~1050
	ModuloCorte float64 // G (Pa) - elasticidad que restaura la forma
	Viscosidad  float64 // η (Pa·s) - amortiguamiento viscoso (némesis)
	AcoplamientoQ float64 // Sensibilidad mecano-cuántica (deformación -> cambio de radio)
}

// NuevaPantallaLiquida inicializa la matriz maleable lista para recibir audio
func NuevaPantallaLiquida(ancho, alto int, densidad, elasticidad, viscosidad float64) *PantallaLiquida {
	nodos := make([]BioPixelViscoelastico, ancho*alto)
	for i := range nodos {
		nodos[i] = BioPixelViscoelastico{
			RadioBaseR: 3.35, // ~623 nm
			RadioBaseG: 2.29, // ~532 nm
			RadioBaseB: 1.88, // ~468 nm
		}
	}
	return &PantallaLiquida{
		Ancho:         ancho,
		Alto:          alto,
		Nodos:         nodos,
		Densidad:      densidad,
		ModuloCorte:   elasticidad,
		Viscosidad:    viscosidad,
		AcoplamientoQ: 0.18, // Factor de compresión del nanocristal bajo estrés
	}
}

// PasoSimulacion resuelve Cauchy + Tensor Viscoelástico + Emisión Cuántica para un instante dt
// frecuenciaHz y amplitudPa representan la onda musical impactando la pantalla
func (p *PantallaLiquida) PasoSimulacion(t, dt, frecuenciaHz, amplitudPa float64) {
	omega := 2.0 * math.Pi * frecuenciaHz
	cx, cy := float64(p.Ancho)/2.0, float64(p.Alto)/2.0

	// 1. Resolver Ecuación de Cauchy con tensor viscoelástico (Kelvin-Voigt)
	for y := 1; y < p.Alto-1; y++ {
		for x := 1; x < p.Ancho-1; x++ {
			idx := y*p.Ancho + x
			nodo := &p.Nodos[idx]

			// Laplaciano espacial de desplazamiento (∇²u) -> Tensión elástica de Cauchy
			uArriba := p.Nodos[(y-1)*p.Ancho+x].U
			uAbajo := p.Nodos[(y+1)*p.Ancho+x].U
			uIzq := p.Nodos[y*p.Ancho+(x-1)].U
			uDer := p.Nodos[y*p.Ancho+(x+1)].U
			laplacianoU := (uArriba + uAbajo + uIzq + uDer - 4.0*nodo.U)

			// Laplaciano de velocidad (∇²v) -> Disipación viscosa (Némesis)
			vArriba := p.Nodos[(y-1)*p.Ancho+x].Vel
			vAbajo := p.Nodos[(y+1)*p.Ancho+x].Vel
			vIzq := p.Nodos[y*p.Ancho+(x-1)].Vel
			vDer := p.Nodos[y*p.Ancho+(x+1)].Vel
			laplacianoV := (vArriba + vAbajo + vIzq + vDer - 4.0*nodo.Vel)

			// Esfuerzo total: σ = G·∇²u + η·∇²v
			esfuerzoViscoelastico := p.ModuloCorte*laplacianoU + p.Viscosidad*laplacianoV

			// Presión acústica musical (onda estacionaria radial desde el transductor)
			dist := math.Hypot(float64(x)-cx, float64(y)-cy)
			fuerzaMusical := amplitudPa * math.Sin(omega*t - dist*0.45) * math.Exp(-dist*0.04)

			// Aceleración de Cauchy: a = (∇·σ + f_acústica) / ρ
			nodo.Acc = (esfuerzoViscoelastico + fuerzaMusical) / p.Densidad
		}
	}

	// 2. Integración temporal (Euler simpléctico para estabilidad en fluidos/geles)
	for i := range p.Nodos {
		p.Nodos[i].Vel += p.Nodos[i].Acc * dt
		p.Nodos[i].U += p.Nodos[i].Vel * dt
	}
}

// ObtenerColorNodo calcula el color cuántico deformado por la onda acústica en (x, y)
func (p *PantallaLiquida) ObtenerColorNodo(x, y int) (uint8, uint8, uint8, float64) {
	nodo := p.Nodos[y*p.Ancho+x]

	// Deformación local normalizada (compresión/expansión de la textura líquida)
	deformacion := math.Tanh(nodo.U * 15.0) // [-1 .. 1]
	factorRadio := 1.0 - p.AcoplamientoQ*deformacion

	// El radio efectivo de los puntos cuánticos cambia con la presión de la onda
	lamR := calcularBrusCdSe(nodo.RadioBaseR * factorRadio)
	lamG := calcularBrusCdSe(nodo.RadioBaseG * factorRadio)
	lamB := calcularBrusCdSe(nodo.RadioBaseB * factorRadio)

	// La intensidad lumínica pulsa con la energía cinética local de la textura
	brillo := math.Min(0.35+math.Abs(deformacion)*0.85, 1.0)

	r1, g1, b1 := espectroCIE(lamR, brillo)
	r2, g2, b2 := espectroCIE(lamG, brillo)
	r3, g3, b3 := espectroCIE(lamB, brillo)

	return gammaByte(r1 + r2 + r3), gammaByte(g1 + g2 + g3), gammaByte(b1 + b2 + b3), nodo.U
}

func calcularBrusCdSe(radioNm float64) float64 {
	if radioNm < 1.2 {
		radioNm = 1.2
	}
	egJ, meKg, mhKg, epsR := 1.74*e, 0.13*m0, 0.45*m0, 9.3
	rM := radioNm * 1e-9
	conf := (h * h / (8.0 * rM * rM)) * (1.0/meKg + 1.0/mhKg)
	coul := (1.8 * e * e) / (4.0 * math.Pi * eps0 * epsR * rM)
	return ((h * c) / (egJ + conf - coul)) * 1e9
}

func espectroCIE(lambda, intensidad float64) (float64, float64, float64) {
	g := func(x, mu, t1, t2 float64) float64 {
		t := t1
		if x >= mu {
			t = t2
		}
		d := (x - mu) * t
		return math.Exp(-0.5 * d * d)
	}
	X := 1.056*g(lambda, 599.8, 0.0264, 0.0323) + 0.362*g(lambda, 442.0, 0.0624, 0.0374) - 0.065*g(lambda, 501.1, 0.0490, 0.0382)
	Y := 0.821*g(lambda, 568.8, 0.0213, 0.0247) + 0.286*g(lambda, 530.9, 0.0613, 0.0322)
	Z := 1.217*g(lambda, 437.0, 0.0845, 0.0278) + 0.681*g(lambda, 459.0, 0.0385, 0.0725)

	return (3.2406*X - 1.5372*Y - 0.4986*Z) * intensidad,
		(-0.9689*X + 1.8758*Y + 0.0415*Z) * intensidad,
		(0.0557*X - 0.2040*Y + 1.0570*Z) * intensidad
}

func gammaByte(v float64) uint8 {
	if v <= 0 {
		return 0
	}
	if v <= 0.0031308 {
		v = 12.92 * v
	} else {
		v = 1.055*math.Pow(v, 1.0/2.4) - 0.055
	}
	if v > 1.0 {
		v = 1.0
	}
	return uint8(math.Round(v * 255.0))
}
