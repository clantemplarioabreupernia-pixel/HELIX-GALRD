		fmt.Printf("  -> Subpíxel %s | Diámetro: %.2f nm | Emisión: %.2f nm\n", sp.Nombre, sp.Radio*2, lambda)
	}

	fmt.Println("\n[2] CONTROL DE INTENSIDAD POR TRANSISTOR TFT (Vds = 5.0V):")
	voltajesBrillo := []float64{1.5, 2.5, 3.5, 4.5}
