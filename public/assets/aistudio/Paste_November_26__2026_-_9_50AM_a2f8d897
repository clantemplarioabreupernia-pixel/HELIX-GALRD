package nanopixel

import "math"

// Caras del cubo interno (Dualidad espacial: positivo vs negativo)
const (
	CaraArriba    = 0 // +Y (Espacio)
	CaraAbajo     = 1 // -Y (Negativo / Reflejo)
	CaraDerecha   = 2 // +X
	CaraIzquierda = 3 // -X
	CaraFrente    = 4 // +Z (Proyección al observador)
	CaraFondo     = 5 // -Z (Profundidad holográfica)
)

// BioPixelCubico representa un píxel "vivo" procedural con 6 caras internas y dinámica viscoelástica
type BioPixelCubico struct {
	// Estado topológico de 3 bits (0..7): codifica la polaridad/paridad de los 3 ejes (X, Y, Z)
	BitsPolaridad uint8

	// Energía/Fase de las 6 caras internas (interferencia holográfica)
	Caras [6]float64

	// Dinámica viscoelástica de Cauchy (movimiento orgánico de tejido/fluido)
	Desplazamiento [3]float64 // Vector u = (ux, uy, uz)
	Velocidad      [3]float64 // Vector v = (vx, vy, vz)
	Aceleracion    [3]float64 // Vector a = (ax, ay, az)

	// Radios cuánticos base (nm)
	RadioR, RadioG, RadioB float64
}

// NuevoBioPixelCubico inicializa un cubo de 6 caras con simetría dual arriba/abajo
func NuevoBioPixelCubico(bitsPolaridad uint8) BioPixelCubico {
	bp := BioPixelCubico{
		BitsPolaridad: bitsPolaridad & 0x07, // Asegura estrictamente 3 bits (0..7)
		RadioR:        3.35,
		RadioG:        2.29,
		RadioB:        1.88,
	}
	bp.SincronizarCaras()
	return bp
}

// SincronizarCaras aplica el principio de simetría dual: lo de arriba refleja abajo en negativo
func (bp *BioPixelCubico) SincronizarCaras() {
	// Extraer signo de cada eje desde los 3 bits de estado
	signoX := 1.0
	if (bp.BitsPolaridad & 0x01) != 0 {
		signoX = -1.0
	}
	signoY := 1.0
	if (bp.BitsPolaridad & 0x02) != 0 {
		signoY = -1.0
	}
	signoZ := 1.0
	if (bp.BitsPolaridad & 0x04) != 0 {
		signoZ = -1.0
	}

	// El desplazamiento físico en cada eje alimenta la cara positiva y su reflejo negativo opuesto
	bp.Caras[CaraDerecha] = bp.Desplazamiento[0] * signoX
	bp.Caras[CaraIzquierda] = -bp.Caras[CaraDerecha]

	bp.Caras[CaraArriba] = bp.Desplazamiento[1] * signoY
	bp.Caras[CaraAbajo] = -bp.Caras[CaraArriba] // Arriba = -Abajo (reflejo dual)

	bp.Caras[CaraFrente] = bp.Desplazamiento[2] * signoZ
	bp.Caras[CaraFondo] = -bp.Caras[CaraFrente]
}

// ActualizarFisicaOrganica resuelve Cauchy + Viscoelasticidad ante un movimiento (ej. paso al caminar o vibración sonora)
func (bp *BioPixelCubico) ActualizarFisicaOrganica(dt, elasticidadG, viscosidadEta, densidad float64, fuerzaExterna [3]float64) {
	for eje := 0; eje < 3; eje++ {
		// Fuerza restauradora elástica (-G * u) y disipación viscosa (-η * v)
		fuerzaElastica := -elasticidadG * bp.Desplazamiento[eje]
		fuerzaViscosa := -viscosidadEta * bp.Velocidad[eje]

		// Ecuación de Cauchy: a = (F_elastica + F_viscosa + F_externa) / ρ
		bp.Aceleracion[eje] = (fuerzaElastica + fuerzaViscosa + fuerzaExterna[eje]) / densidad
		bp.Velocidad[eje] += bp.Aceleracion[eje] * dt
		bp.Desplazamiento[eje] += bp.Velocidad[eje] * dt
	}

	// Actualizar el estado holográfico de las 6 caras internas
	bp.SincronizarCaras()
}

// RenderizarHolografico sintetiza el color final combinando la interferencia de las 6 caras y la ecuación de Brus
func (bp *BioPixelCubico) RenderizarHolografico() (uint8, uint8, uint8) {
	// Interferencia constructiva/destructiva entre caras opuestas (profundidad óptica)
	energiaSuperficie := math.Abs(bp.Caras[CaraArriba]-bp.Caras[CaraAbajo]) * 0.5
	profundidadZ := math.Tanh((bp.Caras[CaraFrente] - bp.Caras[CaraFondo]) * 10.0)

	// La compresión/expansión del cubo modula el radio cuántico efectivo
	factorCuantico := 1.0 - 0.15*profundidadZ

	lamR := calcularBrusCdSe(bp.RadioR * factorCuantico)
	lamG := calcularBrusCdSe(bp.RadioG * factorCuantico)
	lamB := calcularBrusCdSe(bp.RadioB * factorCuantico)

	// Brillo modulado por la vibración interna del cubo vivo
	intensidad := math.Min(0.45+energiaSuperficie*2.5, 1.0)

	r1, g1, b1 := espectroCIE(lamR, intensidad)
	r2, g2, b2 := espectroCIE(lamG, intensidad)
	r3, g3, b3 := espectroCIE(lamB, intensidad)

	return gammaByte(r1 + r2 + r3), gammaByte(g1 + g2 + g3), gammaByte(b1 + b2 + b3)
}
