package nanopixel

import "math"

// Constantes físicas fundamentales (SI)
const (
	h    = 6.62607015e-34
	c    = 2.99792458e8
	e    = 1.60217663e-19
	m0   = 9.1093837e-31
	eps0 = 8.85418781e-12
)

// Caras internas del BioPíxel Cúbico (Dualidad: Espacio vs Negativo)
const (
	CaraArriba    = 0 // +Y
	CaraAbajo     = 1 // -Y (Reflejo negativo)
	CaraDerecha   = 2 // +X
	CaraIzquierda = 3 // -X
	CaraFrente    = 4 // +Z (Proyección)
	CaraFondo     = 5 // -Z (Profundidad holográfica)
)

// BioPixelCubico: Celda viva con 6 caras internas, 3 bits de polaridad y física continua
type BioPixelCubico struct {
	BitsPolaridad  uint8      // 3 bits (0..7) que definen la simetría de los 3 ejes
	Caras          [6]float64 // Energía holográfica de las 6 caras internas
	Desplazamiento [3]float64 // Vector u = (ux, uy, uz)
	Velocidad      [3]float64 // Vector v = (vx, vy, vz)
	Aceleracion    [3]float64 // Vector a = (ax, ay, az)
	RadioR, RadioG, RadioB float64 // Radios cuánticos base (nm)
}

// MallaBioPixeles: Pantalla líquida viscoelástica acoplada
type MallaBioPixeles struct {
	Ancho, Alto int
	Celdas      []BioPixelCubico
	Densidad    float64 // ρ (kg/m³)
	Elasticidad float64 // G (Pa) - Fuerza restauradora de Cauchy
	Viscosidad  float64 // η (Pa·s) - Amortiguamiento viscoso (Némesis)
	Vds         float64 // Voltaje de drenador del panel TFT (V)
}

func NuevaMallaBioPixeles(ancho, alto int) *MallaBioPixeles {
	celdas := make([]BioPixelCubico, ancho*alto)
	for y := 0; y < alto; y++ {
		for x := 0; x < ancho; x++ {
			idx := y*ancho + x
			// Patrón topológico de 3 bits alternando paridad espacial
			bits := uint8(((x % 2) << 0) | ((y % 2) << 1) | (((x + y) % 2) << 2))
			celdas[idx] = BioPixelCubico{
				BitsPolaridad: bits,
				RadioR:        3.35, // ~623 nm
				RadioG:        2.29, // ~532 nm
				RadioB:        1.88, // ~468 nm
			}
			celdas[idx].sincronizarCaras()
		}
	}
	return &MallaBioPixeles{
		Ancho:       ancho,
		Alto:        alto,
		Celdas:      celdas,
		Densidad:    1050.0,
		Elasticidad: 180.0,
		Viscosidad:  4.5,
		Vds:         5.0,
	}
}

// sincronizarCaras aplica la ley holográfica: lo de arriba refleja abajo en negativo
func (bp *BioPixelCubico) sincronizarCaras() {
	signo := [3]float64{1.0, 1.0, 1.0}
	if (bp.BitsPolaridad & 0x01) != 0 {
		signo[0] = -1.0
	}
	if (bp.BitsPolaridad & 0x02) != 0 {
		signo[1] = -1.0
	}
	if (bp.BitsPolaridad & 0x04) != 0 {
		signo[2] = -1.0
	}

	bp.Caras[CaraDerecha] = bp.Desplazamiento[0] * signo[0]
	bp.Caras[CaraIzquierda] = -bp.Caras[CaraDerecha]

	bp.Caras[CaraArriba] = bp.Desplazamiento[1] * signo[1]
	bp.Caras[CaraAbajo] = -bp.Caras[CaraArriba]

	bp.Caras[CaraFrente] = bp.Desplazamiento[2] * signo[2]
	bp.Caras[CaraFondo] = -bp.Caras[CaraFrente]
}

// PasoSimulacion resuelve Cauchy + Viscoelasticidad acoplada en toda la malla
func (m *MallaBioPixeles) PasoSimulacion(t, dt, freqHz, amplitud, impactoPaso float64) {
	omega := 2.0 * math.Pi * freqHz
	cx, cy := float64(m.Ancho)/2.0, float64(m.Alto)/2.0

	// 1. Calcular aceleraciones por acoplamiento con cubos vecinos (Laplaciano espacial)
	for y := 1; y < m.Alto-1; y++ {
		for x := 1; x < m.Ancho-1; x++ {
			idx := y*m.Ancho + x
			celda := &m.Celdas[idx]

			idxArriba := (y-1)*m.Ancho + x
			idxAbajo := (y+1)*m.Ancho + x
			idxIzq := y*m.Ancho + (x - 1)
			idxDer := y*m.Ancho + (x + 1)

			// Onda acústica musical + impulso mecánico (caminar/vibración)
			dist := math.Hypot(float64(x)-cx, float64(y)-cy)
			ondaSonora := amplitud * math.Sin(omega*t-dist*0.42) * math.Exp(-dist*0.035)
			ondaPaso := impactoPaso * math.Cos(dist*0.6-t*12.0) * math.Exp(-dist*0.06)

			for eje := 0; eje < 3; eje++ {
				lapU := m.Celdas[idxArriba].Desplazamiento[eje] +
					m.Celdas[idxAbajo].Desplazamiento[eje] +
					m.Celdas[idxIzq].Desplazamiento[eje] +
					m.Celdas[idxDer].Desplazamiento[eje] -
					4.0*celda.Desplazamiento[eje]

				lapV := m.Celdas[idxArriba].Velocidad[eje] +
					m.Celdas[idxAbajo].Velocidad[eje] +
					m.Celdas[idxIzq].Velocidad[eje] +
					m.Celdas[idxDer].Velocidad[eje] -
					4.0*celda.Velocidad[eje]

