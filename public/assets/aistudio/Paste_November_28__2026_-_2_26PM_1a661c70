## FASE 2 — MOTOR FÍSICO

### ⚙️ T05 — Cauchy Stress Engine

**Uso:** integrador físico con tensor de Cauchy y amortiguación exponencial.
**Fines:** núcleo reutilizable; sólo depende de T01–T04.
**Archivo:** `src/core/cauchy-stress-engine.ts`

```ts
// src/core/cauchy-stress-engine.ts
import type {
  EngineConfig,
  GeometryKind,
  MeshNode,
  SimulationMetrics,
} from './stress-types';
import { createZeroTensor6 } from './stress-types';
import { createVec3, type Vec3 } from './vector-math';
import { createGeometryGenerator } from '../geometry/generators';
import { injectImpulse } from '../physics/impulse-injector';

/**
 * CauchyStressEngine — 6-DoF Cauchy stress simulation on a structured 2D grid.
 *
 * Per step:
 *   1. Strain from central differences
 *   2. Isotropic Hooke's law (plane stress)
 *   3. Force = divergence of stress
 *   4. Damped semi-implicit Euler integration:
 *        v ← (v + F/m·dt) · exp(−λ·dt)
 *        u ← u + v·dt
 */
export class CauchyStressEngine {
  private config: EngineConfig;
  private nodes: MeshNode[] = [];
  private geometryKind: GeometryKind = 'plate';
  private time = 0;
  private stepCount = 0;

  constructor(config: Partial<EngineConfig> = {}) {
    this.config = {
      mesh: { gridSize: 24, spacing: 1, ...config.mesh },
      material: {
        youngsModulus: 200,
        poissonRatio: 0.3,
        nodeMass: 1,
        ...config.material,
      },
      integration: {
        dampingCoefficient: 0.8,
        ...config.integration,
      },
    };
    this.regenerateMesh('plate');
  }

  // ---- Public API ----------------------------------------------------

  get meshNodes(): ReadonlyArray<MeshNode> {
    return this.nodes;
  }
  get currentGeometry(): GeometryKind {
    return this.geometryKind;
  }
  get currentConfig(): Readonly<EngineConfig> {
    return this.config;
  }

  setDampingCoefficient(lambda: number): void {
    this.config.integration.dampingCoefficient = lambda;
  }

  regenerateMesh(kind: GeometryKind): void {
    this.geometryKind = kind;
    this.time = 0;
    this.stepCount = 0;

    const n = this.config.mesh.gridSize;
    const h = this.config.mesh.spacing;
    const generator = createGeometryGenerator(kind, n, h);

    this.nodes = [];
    for (let j = 0; j < n; j++) {
      for (let i = 0; i < n; i++) {
        const u = n > 1 ? i / (n - 1) : 0.5;
        const v = n > 1 ? j / (n - 1) : 0.5;
        const rest = generator.computeRestPosition(u, v, i, j);
        this.nodes.push({
          id: j * n + i,
          rest: { ...rest },
          position: { ...rest },
          velocity: createVec3(),
          force: createVec3(),
          stress: createZeroTensor6(),
          energy: 0,
        });
      }
    }
  }

  reset(): void {
    this.regenerateMesh(this.geometryKind);
  }

  /** Convenience wrapper around the standalone impulse injector. */
  applyImpulse(center: Vec3, impulse: Vec3, radius: number): number {
    return injectImpulse(this.nodes, center, impulse, radius);
  }

  step(dt: number): SimulationMetrics {
    const t0 = performance.now();
    const { gridSize: n, spacing: h } = this.config.mesh;
    const { youngsModulus: E, poissonRatio: nu, nodeMass: m } = this.config.material;
    const lambda = this.config.integration.dampingCoefficient;

    this.computeStressField(n, h, E, nu);
    this.computeForces(n, h);
    const { kinetic, maxStress, avgDisp } = this.integrateDamped(m, lambda, dt);

    this.time += dt;
    this.stepCount++;

    return {
      stepCount: this.stepCount,
      elapsedTimeSec: this.time,
      stepLatencyMs: performance.now() - t0,
      totalKineticEnergy: kinetic,
      maxStressMagnitude: maxStress,
      avgDisplacement: avgDisp,
    };
  }

  // ---- Internals -----------------------------------------------------

  private index(i: number, j: number): number {
    return j * this.config.mesh.gridSize + i;
  }

  private computeStressField(n: number, h: number, E: number, nu: number): void {
    const c1 = E / (1 - nu * nu);
    const c2 = E / (1 + nu);

    for (let j = 0; j < n; j++) {
      for (let i = 0; i < n; i++) {
        const nd = this.nodes[this.index(i, j)];
        const iL = Math.max(0, i - 1);
        const iR = Math.min(n - 1, i + 1);
        const jD = Math.max(0, j - 1);
        const jU = Math.min(n - 1, j + 1);
        const L = this.nodes[this.index(iL, j)];
        const R = this.nodes[this.index(iR, j)];
        const D = this.nodes[this.index(i, jD)];
        const U = this.nodes[this.index(i, jU)];
        const dx = (iR - iL) * h || h;
        const dy = (jU - jD) * h || h;

        const dudx = (R.position.x - L.position.x) / dx;
        const dudy = (U.position.x - D.position.x) / dy;
        const dvdx = (R.position.y - L.position.y) / dx;
        const dvdy = (U.position.y - D.position.y) / dy;
        const dwdx = (R.position.z - L.position.z) / dx;
        const dwdy = (U.position.z - D.position.z) / dy;

        const exx = dudx;
        const eyy = dvdy;
        const exy = 0.5 * (dudy + dvdx);
        const exz = 0.5 * dwdx;
        const eyz = 0.5 * dwdy;

        nd.stress.xx = c1 * (exx + nu * eyy);
        nd.stress.yy = c1 * (eyy + nu * exx);
        nd.stress.xy = c2 * exy;
        nd.stress.xz = c2 * exz;
        nd.stress.yz = c2 * eyz;
        nd.stress.zz = 0;
      }
    }
  }

  private computeForces(n: number, h: number): void {
    const inv2h = 1 / (2 * h);
    for (let j = 1; j < n - 1; j++) {
      for (let i = 1; i < n - 1; i++) {
        const nd = this.nodes[this.index(i, j)];
        const R = this.nodes[this.index(i + 1, j)];
        const L = this.nodes[this.index(i - 1, j)];
        const U = this.nodes[this.index(i, j + 1)];
        const D = this.nodes[this.index(i, j - 1)];

        nd.force.x =
          (R.stress.xx - L.stress.xx) * inv2h +
          (U.stress.xy - D.stress.xy) * inv2h;
        nd.force.y =
          (R.stress.xy - L.stress.xy) * inv2h +
          (U.stress.yy - D.stress.yy) * inv2h;
        nd.force.z =
          (R.stress.xz - L.stress.xz) * inv2h +
          (U.stress.yz - D.stress.yz) * inv2h;
      }
    }
  }

  private integrateDamped(
    m: number,
    lambda: number,
    dt: number,
  ): { kinetic: number; maxStress: number; avgDisp: number } {
    const damp = Math.exp(-lambda * dt);
    let kinetic = 0;
    let maxStress = 0;
    let sumDisp = 0;

    for (const nd of this.nodes) {
      nd.velocity.x = (nd.velocity.x + (nd.force.x / m) * dt) * damp;
      nd.velocity.y = (nd.velocity.y + (nd.force.y / m) * dt) * damp;
      nd.velocity.z = (nd.velocity.z + (nd.force.z / m) * dt) * damp;

      nd.position.x += nd.velocity.x * dt;
      nd.position.y += nd.velocity.y * dt;
      nd.position.z += nd.velocity.z * dt;

      const v2 =
        nd.velocity.x ** 2 + nd.velocity.y ** 2 + nd.velocity.z ** 2;
      kinetic += 0.5 * m * v2;

      const s2 = nd.stress.xx ** 2 + nd.stress.yy ** 2 + nd.stress.xy ** 2;
      const sm = Math.sqrt(s2);
      if (sm > maxStress) maxStress = sm;

      const dx = nd.position.x - nd.rest.x;
      const dy = nd.position.y - nd.rest.y;
      const dz = nd.position.z - nd.rest.z;
      sumDisp += Math.sqrt(dx * dx + dy * dy + dz * dz);

      nd.energy = 0.5 * m * v2 + 0.5 * s2;
    }

    return {
      kinetic,
      maxStress,
      avgDisp: this.nodes.length ? sumDisp / this.nodes.length : 0,
    };
  }
}
