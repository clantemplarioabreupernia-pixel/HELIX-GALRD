**Uso:** exponer la fuente Go como constante copiable.
**Fines:** distribución del motor en otro lenguaje.
**Archivo:** `src/export/go-source.ts`

```ts
// src/export/go-source.ts
export const GO_ENGINE_SOURCE = `// omega_cauchy.go — 6-DoF Cauchy stress engine
// Author: Javier Alberto Abreu Molina — Apache-2.0
package main

import "math"

type Vec3 struct{ X, Y, Z float64 }
type Stress struct{ XX, YY, ZZ, XY, YZ, XZ float64 }

type Node struct {
	Rest, Pos, Vel, Force Vec3
	Stress                Stress
}

type Config struct{ N int; H, Lam, E, Nu, M float64 }

type Engine struct {
	Cfg   Config
	Nodes []Node
	Time  float64
	Steps int
}

func NewEngine(cfg Config) *Engine {
	e := &Engine{Cfg: cfg}
	e.Nodes = make([]Node, cfg.N*cfg.N)
	c := float64(cfg.N-1) / 2
	for j := 0; j < cfg.N; j++ {
		for i := 0; i < cfg.N; i++ {
			p := Vec3{(float64(i) - c) * cfg.H, (float64(j) - c) * cfg.H, 0}
			e.Nodes[j*cfg.N+i] = Node{Rest: p, Pos: p}
		}
	}
	return e
}

func (e *Engine) Step(dt float64) {
	n, h := e.Cfg.N, e.Cfg.H
	E, nu, m, lam := e.Cfg.E, e.Cfg.Nu, e.Cfg.M, e.Cfg.Lam
	idx := func(i, j int) int { return j*n + i }
	c1 := E / (1 - nu*nu)
	c2 := E / (1 + nu)

	for j := 0; j < n; j++ {
		for i := 0; i < n; i++ {
			nd := &e.Nodes[idx(i, j)]
			iL, iR := max(0, i-1), min(n-1, i+1)
			jD, jU := max(0, j-1), min(n-1, j+1)
			L, R := e.Nodes[idx(iL, j)], e.Nodes[idx(iR, j)]
			D, U := e.Nodes[idx(i, jD)], e.Nodes[idx(i, jU)]
			dx := float64(iR-iL) * h
			dy := float64(jU-jD) * h
			if dx == 0 { dx = h }
			if dy == 0 { dy = h }
			exx := (R.Pos.X - L.Pos.X) / dx
			eyy := (U.Pos.Y - D.Pos.Y) / dy
			exy := 0.5 * ((U.Pos.X-D.Pos.X)/dy + (R.Pos.Y-L.Pos.Y)/dx)
			nd.Stress.XX = c1 * (exx + nu*eyy)
			nd.Stress.YY = c1 * (eyy + nu*exx)
			nd.Stress.XY = c2 * exy
		}
	}

	for j := 1; j < n-1; j++ {
		for i := 1; i < n-1; i++ {
			nd := &e.Nodes[idx(i, j)]
			R, L := e.Nodes[idx(i+1, j)], e.Nodes[idx(i-1, j)]
			U, D := e.Nodes[idx(i, j+1)], e.Nodes[idx(i, j-1)]
			inv := 1.0 / (2 * h)
			nd.Force.X = (R.Stress.XX-L.Stress.XX)*inv + (U.Stress.XY-D.Stress.XY)*inv
			nd.Force.Y = (R.Stress.XY-L.Stress.XY)*inv + (U.Stress.YY-D.Stress.YY)*inv
		}
	}

	damp := math.Exp(-lam * dt)
	for k := range e.Nodes {
		nd := &e.Nodes[k]
		nd.Vel.X = (nd.Vel.X + nd.Force.X/m*dt) * damp
		nd.Vel.Y = (nd.Vel.Y + nd.Force.Y/m*dt) * damp
		nd.Vel.Z = (nd.Vel.Z + nd.Force.Z/m*dt) * damp
		nd.Pos.X += nd.Vel.X * dt
		nd.Pos.Y += nd.Vel.Y * dt
		nd.Pos.Z += nd.Vel.Z * dt
	}
	e.Time += dt
	e.Steps++
}

func min(a, b int) int { if a < b { return a }; return b }
func max(a, b int) int { if a > b { return a }; return b }
`;
