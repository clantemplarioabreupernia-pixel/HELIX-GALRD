### 🔧 T04 — Geometry Generators

**Uso:** producir la posición de reposo de cada nodo en cada geometría.
**Fines:** desacoplar la definición de formas del motor y del render.
**Archivo:** `src/geometry/generators.ts`

```ts
// src/geometry/generators.ts
import { createVec3, type Vec3 } from '../core/vector-math';
import type { GeometryKind } from '../core/stress-types';

export interface GeometryGenerator {
  readonly kind: GeometryKind;
  computeRestPosition(u: number, v: number, i: number, j: number): Vec3;
}

class PlateGenerator implements GeometryGenerator {
  readonly kind = 'plate' as const;
  constructor(private gridSize: number, private spacing: number) {}
  computeRestPosition(_u: number, _v: number, i: number, j: number): Vec3 {
    const c = (this.gridSize - 1) / 2;
    return createVec3((i - c) * this.spacing, (j - c) * this.spacing, 0);
  }
}

class TorusGenerator implements GeometryGenerator {
  readonly kind = 'torus' as const;
  constructor(
    private majorRadius = 5.5,
    private minorRadius = 2.0,
  ) {}
  computeRestPosition(u: number, v: number): Vec3 {
    const theta = u * Math.PI * 2;
    const phi = v * Math.PI * 2;
    const r = this.majorRadius + this.minorRadius * Math.cos(phi);
    return createVec3(
      r * Math.cos(theta),
      r * Math.sin(theta),
      this.minorRadius * Math.sin(phi),
    );
  }
}

/**
 * Heart via implicit curve (x² + y² − 1)³ − x²y³ ≤ 0,
 * projected onto the surface by binary search along the ray.
 */
class HeartGenerator implements GeometryGenerator {
  readonly kind = 'heart' as const;
  private static isInside(x: number, y: number): boolean {
    const a = x * x + y * y - 1;
    return a * a * a - x * x * y * y * y <= 0;
  }
  computeRestPosition(u: number, v: number): Vec3 {
    let x = (u - 0.5) * 3;
    let y = (v - 0.5) * 3 + 0.25;
    if (!HeartGenerator.isInside(x, y)) {
      let lo = 0;
      let hi = 1;
      for (let k = 0; k < 14; k++) {
        const mid = (lo + hi) * 0.5;
        if (HeartGenerator.isInside(x * mid, y * mid)) lo = mid;
        else hi = mid;
      }
      x *= lo;
      y *= lo;
    }
    return createVec3(x * 3, y * 3, 0);
  }
}

export function createGeometryGenerator(
  kind: GeometryKind,
  gridSize: number,
  spacing: number,
): GeometryGenerator {
  switch (kind) {
    case 'plate':
      return new PlateGenerator(gridSize, spacing);
    case 'torus':
      return new TorusGenerator();
    case 'heart':
      return new HeartGenerator();
  }
}
```

