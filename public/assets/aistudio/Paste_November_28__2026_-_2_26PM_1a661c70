### 🎨 T08 — Point Cloud Renderer

**Uso:** envolver un array de `MeshNode` como `THREE.Points` coloreados.
**Fines:** aislar la lógica de actualización de la escena.
**Archivo:** `src/rendering/point-cloud.ts`

```ts
// src/rendering/point-cloud.ts
import * as THREE from 'three';
import type { MeshNode } from '../core/stress-types';
import { frobeniusNormInPlane } from '../core/stress-magnitude';
import { stressToColor } from './color-ramp';

export interface PointCloudOptions {
  pointSize?: number;
  sizeAttenuation?: boolean;
}

/**
 * Renders a node array as colored THREE.Points.
 * Color maps current in-plane stress magnitude via stressToColor.
 */
export class PointCloudRenderer {
  readonly object3D: THREE.Points;
  private positions: Float32Array;
  private colors: Float32Array;
  private geometry: THREE.BufferGeometry;
  private material: THREE.PointsMaterial;

  constructor(nodeCount: number, options: PointCloudOptions = {}) {
    const { pointSize = 0.22, sizeAttenuation = true } = options;
    this.positions = new Float32Array(nodeCount * 3);
    this.colors = new Float32Array(nodeCount * 3);
    this.geometry = new THREE.BufferGeometry();
    this.geometry.setAttribute(
      'position',
      new THREE.BufferAttribute(this.positions, 3),
    );
    this.geometry.setAttribute(
      'color',
      new THREE.BufferAttribute(this.colors, 3),
    );
    this.material = new THREE.PointsMaterial({
      size: pointSize,
      vertexColors: true,
      sizeAttenuation,
    });
    this.object3D = new THREE.Points(this.geometry, this.material);
  }

  resize(nodeCount: number): void {
    this.positions = new Float32Array(nodeCount * 3);
    this.colors = new Float32Array(nodeCount * 3);
    this.geometry.setAttribute(
      'position',
      new THREE.BufferAttribute(this.positions, 3),
    );
    this.geometry.setAttribute(
      'color',
      new THREE.BufferAttribute(this.colors, 3),
    );
  }

  update(nodes: ReadonlyArray<MeshNode>): void {
    let maxStress = 1e-6;
    for (const n of nodes) {
      const s = frobeniusNormInPlane(n.stress);
      if (s > maxStress) maxStress = s;
    }

    for (let k = 0; k < nodes.length; k++) {
      const n = nodes[k];
      this.positions[k * 3] = n.position.x;
      this.positions[k * 3 + 1] = n.position.y;
      this.positions[k * 3 + 2] = n.position.z;

      const t = frobeniusNormInPlane(n.stress) / maxStress;
      const { r, g, b } = stressToColor(t);
      this.colors[k * 3] = r;
      this.colors[k * 3 + 1] = g;
      this.colors[k * 3 + 2] = b;
    }

    (this.geometry.getAttribute('position') as THREE.BufferAttribute).needsUpdate = true;
    (this.geometry.getAttribute('color') as THREE.BufferAttribute).needsUpdate = true;
  }

  dispose(): void {
    this.geometry.dispose();
    this.material.dispose();
  }
}
```

