### 🧩 T21 — App

**Uso:** orquestar todas las herramientas anteriores.
**Fines:** punto de entrada de la aplicación.
**Archivo:** `src/App.tsx`

```tsx
// src/App.tsx
import { useCallback, useMemo, useRef, useState } from 'react';
import { CauchyStressEngine } from './core/cauchy-stress-engine';
import type { GeometryKind, SimulationMetrics } from './core/stress-types';
import { MetricsCollector } from './telemetry/metrics-collector';
import ThreeCanvas from './ui/ThreeCanvas';
import ControlPanel from './ui/ControlPanel';
import MetricsPanel from './ui/MetricsPanel';
import HeatmapView from './ui/HeatmapView';
import GoCodeViewer from './ui/GoCodeViewer';
import TechnicalDocs from './ui/TechnicalDocs';

export default function App() {
  const engineRef = useRef<CauchyStressEngine | null>(null);
  if (!engineRef.current) engineRef.current = new CauchyStressEngine();
  const engine = engineRef.current;

  const collectorRef = useRef(new MetricsCollector(60));
  const collector = collectorRef.current;

  const [running, setRunning] = useState(true);
  const [geometry, setGeometry] = useState<GeometryKind>('plate');
  const [damping, setDamping] = useState(engine.currentConfig.integration.dampingCoefficient);
  const [impulse, setImpulse] = useState(8);
  const [metrics, setMetrics] = useState<SimulationMetrics | null>(null);
  const [rollingLatency, setRollingLatency] = useState(0);

  const onMetrics = useCallback(
    (m: SimulationMetrics) => {
      collector.push(m);
      setMetrics(m);
      setRollingLatency(collector.rollingStepLatencyMs);
    },
    [collector],
  );

  const handleGeometry = (g: GeometryKind) => {
    setGeometry(g);
    engine.regenerateMesh(g);
    collector.reset();
    setMetrics(null);
  };
  const handleDamping = (v: number) => {
    setDamping(v);
    engine.setDampingCoefficient(v);
  };
  const handleReset = () => {
    engine.reset();
    collector.reset();
    setMetrics(null);
  };

  const layout = useMemo(
    () => (
      <div className="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-4 h-full p-4">
        <div className="relative rounded-xl overflow-hidden border border-neutral-800 bg-neutral-950 min-h-[480px]">
          <ThreeCanvas
            engine={engine}
            running={running}
            impulseMagnitude={impulse}
            onMetrics={onMetrics}
          />
          <div className="absolute top-3 left-3 text-[10px] text-neutral-400 bg-neutral-900/70 px-2 py-1 rounded">
            Clic en la malla para inyectar impulso
          </div>
        </div>
        <div className="flex flex-col gap-4 overflow-auto">
          <ControlPanel
            running={running}
            onToggleRunning={() => setRunning((r) => !r)}
            onReset={handleReset}
            geometry={geometry}
            onGeometryChange={handleGeometry}
            damping={damping}
            onDampingChange={handleDamping}
            impulse={impulse}
            onImpulseChange={setImpulse}
          />
          <MetricsPanel metrics={metrics} rollingLatencyMs={rollingLatency} />
          <HeatmapView engine={engine} running={running} />
          <GoCodeViewer />
          <TechnicalDocs />
        </div>
      </div>
    ),
    [engine, running, geometry, damping, impulse, metrics, rollingLatency, onMetrics],
  );

  return (
    <div className="h-full bg-neutral-950">
      <header className="px-4 py-3 border-b border-neutral-800 flex items-center justify-between">
        <div>
          <h1 className="text-sm font-semibold text-neutral-100">Cauchy Sandbox</h1>
          <p className="text-[11px] text-neutral-500">
            6-DoF Cauchy stress tensor · amortiguación analítica · Three.js
          </p>
        </div>
        <div className="text-[10px] text-neutral-500">
          Javier Alberto Abreu Molina · Apache-2.0
        </div>
      </header>
      {layout}
    </div>
  );
}
```

