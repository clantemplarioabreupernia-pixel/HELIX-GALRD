### 🎨 T10 — 2D Heatmap Renderer

**Uso:** dibujar la malla como heatmap en un canvas 2D.
**Fines:** vista complementaria de magnitudes sin cargar Three.js.
**Archivo:** `src/rendering/heatmap-renderer.ts`

```ts
// src/rendering/heatmap-renderer.ts
import type { MeshNode } from '../core/stress-types';
import { frobeniusNormInPlane } from '../core/stress-magnitude';

export interface HeatmapOptions {
  size?: number;
}

export class HeatmapRenderer {
  private ctx: CanvasRenderingContext2D;
  private size: number;

  constructor(canvas: HTMLCanvasElement, options: HeatmapOptions = {}) {
    const size = options.size ?? 256;
    canvas.width = size;
    canvas.height = size;
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('HeatmapRenderer: 2D context unavailable');
    this.ctx = ctx;
    this.size = size;
  }

  render(nodes: ReadonlyArray<MeshNode>, gridSize: number): void {
    const cell = this.size / gridSize;
    let maxStress = 1e-6;
    for (const n of nodes) {
      const s = frobeniusNormInPlane(n.stress);
      if (s > maxStress) maxStress = s;
    }

    for (let j = 0; j < gridSize; j++) {
      for (let i = 0; i < gridSize; i++) {
        const s = frobeniusNormInPlane(nodes[j * gridSize + i].stress);
        const t = Math.min(1, s / maxStress);
        const hue = 220 * (1 - t);
        this.ctx.fillStyle = `hsl(${hue}, 85%, ${20 + t * 45}%)`;
        this.ctx.fillRect(i * cell, j * cell, cell + 1, cell + 1);
      }
    }
  }
}
```

