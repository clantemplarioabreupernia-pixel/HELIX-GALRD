// src/telemetry/metrics-collector.ts
import type { SimulationMetrics } from '../core/stress-types';

export class MetricsCollector {
  private last: SimulationMetrics | null = null;
  private latencies: number[] = [];
  private windowSize: number;

  constructor(windowSize = 60) {
    this.windowSize = windowSize;
  }

  push(metrics: SimulationMetrics): void {
    this.last = metrics;
    this.latencies.push(metrics.stepLatencyMs);
    if (this.latencies.length > this.windowSize) this.latencies.shift();
  }

  get latest(): SimulationMetrics | null {
    return this.last;
  }

  get rollingStepLatencyMs(): number {
    if (this.latencies.length === 0) return 0;
    return this.latencies.reduce((a, b) => a + b, 0) / this.latencies.length;
  }

  reset(): void {
    this.last = null;
    this.latencies = [];
  }
}
