### 🔧 T03 — Stress Magnitude

**Uso:** convertir un tensor en un escalar para color y telemetría.
**Fines:** evitar duplicar la fórmula de la norma en múltiples componentes UI.
**Archivo:** `src/core/stress-magnitude.ts`

```ts
// src/core/stress-magnitude.ts
import type { SymmetricTensor6 } from './stress-types';

/**
 * Frobenius norm of the in-plane stress components:
 *   |σ| = √(σxx² + σyy² + σxy²)
 * Used for visualization and max-stress reporting.
 */
export function frobeniusNormInPlane(s: SymmetricTensor6): number {
  return Math.sqrt(s.xx * s.xx + s.yy * s.yy + s.xy * s.xy);
}

/** Full Frobenius norm over all 6 components. */
export function frobeniusNormFull(s: SymmetricTensor6): number {
  return Math.sqrt(
    s.xx * s.xx +
      s.yy * s.yy +
      s.zz * s.zz +
      s.xy * s.xy +
      s.yz * s.yz +
      s.xz * s.xz,
  );
}

/** Von Mises equivalent stress (3D). */
export function vonMisesStress(s: SymmetricTensor6): number {
  const d1 = s.xx - s.yy;
  const d2 = s.yy - s.zz;
  const d3 = s.zz - s.xx;
  return Math.sqrt(
    0.5 * (d1 * d1 + d2 * d2 + d3 * d3) +
      3 * (s.xy * s.xy + s.yz * s.yz + s.xz * s.xz),
  );
}
```

