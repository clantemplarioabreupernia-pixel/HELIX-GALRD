### 🔧 T02 — Tensor Types

**Uso:** tipos de dominio del tensor de Cauchy y del estado del nodo.
**Fines:** contrato único entre motor, render y telemetría. Nomenclatura tomada de mecánica del continuo.
**Archivo:** `src/core/stress-types.ts`

```ts
// src/core/stress-types.ts
import type { Vec3 } from './vector-math';

export type { Vec3 };

/**
 * 6 independent components of a symmetric 2nd-order tensor.
 * Used for the Cauchy stress tensor σ and the small-strain tensor ε:
 *
 *   σ = ⎡ σxx  σxy  σxz ⎤
 *       ⎢ σxy  σyy  σyz ⎥
 *       ⎣ σxz  σyz  σzz ⎦
 */
export interface SymmetricTensor6 {
  xx: number;
  yy: number;
  zz: number;
  xy: number;
  yz: number;
  xz: number;
}

export const createZeroTensor6 = (): SymmetricTensor6 => ({
  xx: 0,
  yy: 0,
  zz: 0,
  xy: 0,
  yz: 0,
  xz: 0,
});

/** A single node of the simulated membrane. */
export interface MeshNode {
  readonly id: number;
  readonly rest: Vec3;
  position: Vec3;
  velocity: Vec3;
  force: Vec3;
  stress: SymmetricTensor6;
  energy: number;
}

export type GeometryKind = 'plate' | 'torus' | 'heart';

export interface MaterialProperties {
  /** Young's modulus E (Pa). */
  youngsModulus: number;
  /** Poisson's ratio ν (−1 < ν < 0.5). */
  poissonRatio: number;
  /** Mass per node (kg). */
  nodeMass: number;
}

export interface IntegrationConfig {
  /** Damping coefficient λ (1/s) in E(t) = E₀·exp(−λ·t). */
  dampingCoefficient: number;
}

export interface MeshConfig {
  /** Number of nodes per side (gridSize² total nodes). */
  gridSize: number;
  /** Node spacing (m). */
  spacing: number;
}

export interface EngineConfig {
  mesh: MeshConfig;
  material: MaterialProperties;
  integration: IntegrationConfig;
}

/** Real, runtime-measured metrics reported after each step. */
export interface SimulationMetrics {
  stepCount: number;
  elapsedTimeSec: number;
  /** Wall-clock latency of the last step (ms). */
  stepLatencyMs: number;
  /** Sum of ½·m·v² across all nodes (J). */
  totalKineticEnergy: number;
  /** max |σ|_F over all nodes (in-plane components). */
  maxStressMagnitude: number;
  /** Mean displacement magnitude from rest position (m). */
  avgDisplacement: number;
}
```

