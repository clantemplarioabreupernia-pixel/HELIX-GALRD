### 🎨 T09 — Three Scene Factory

**Uso:** crear escena, cámara, luces y renderer WebGL listos para usar.
**Fines:** eliminación de bootstrap duplicado.
**Archivo:** `src/rendering/three-scene.ts`

```ts
// src/rendering/three-scene.ts
import * as THREE from 'three';

export interface ThreeSceneBundle {
  scene: THREE.Scene;
  camera: THREE.PerspectiveCamera;
  renderer: THREE.WebGLRenderer;
  resize: (width: number, height: number) => void;
  dispose: () => void;
}

export interface ThreeSceneOptions {
  cameraPosition?: [number, number, number];
  backgroundColor?: number;
  fov?: number;
}

/**
 * Bootstrap a Three.js scene with lighting and a perspective camera.
 * Appends the WebGL canvas to `mount`.
 */
export function createThreeScene(
  mount: HTMLElement,
  options: ThreeSceneOptions = {},
): ThreeSceneBundle {
  const {
    cameraPosition = [18, 14, 22],
    backgroundColor = 0x0a0a0a,
    fov = 55,
  } = options;

  const scene = new THREE.Scene();
  scene.background = new THREE.Color(backgroundColor);

  const camera = new THREE.PerspectiveCamera(
    fov,
    mount.clientWidth / Math.max(1, mount.clientHeight),
    0.1,
    500,
  );
  camera.position.set(...cameraPosition);

  const renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(mount.clientWidth, mount.clientHeight);
  mount.appendChild(renderer.domElement);

  scene.add(new THREE.AmbientLight(0xffffff, 0.6));
  const dir = new THREE.DirectionalLight(0xffffff, 0.9);
  dir.position.set(10, 20, 10);
  scene.add(dir);

  const resize = (w: number, h: number) => {
    camera.aspect = w / Math.max(1, h);
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
  };

  const dispose = () => {
    renderer.dispose();
    if (renderer.domElement.parentNode === mount) {
      mount.removeChild(renderer.domElement);
    }
  };

  return { scene, camera, renderer, resize, dispose };
}
```

