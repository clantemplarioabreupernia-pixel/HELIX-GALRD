### ⚙️ T06 — Impulse Injector

**Uso:** aplicar un impulso con caída radial a un subconjunto de nodos.
**Fines:** función pura sobre cualquier array de `MeshNode`, reutilizable sin el motor.
**Archivo:** `src/physics/impulse-injector.ts`

```ts
// src/physics/impulse-injector.ts
import type { MeshNode, Vec3 } from '../core/stress-types';
import { distanceSqVec3 } from '../core/vector-math';

/**
 * Inject a linear-falloff impulse into all nodes within `radius` of `center`.
 * Returns the number of affected nodes.
 */
export function injectImpulse(
  nodes: ReadonlyArray<MeshNode>,
  center: Vec3,
  impulse: Vec3,
  radius: number,
): number {
  const r2 = radius * radius;
  let affected = 0;

  for (const node of nodes) {
    const d2 = distanceSqVec3(node.position, center);
    if (d2 > r2) continue;
    const falloff = 1 - Math.sqrt(d2) / radius;
    node.velocity.x += impulse.x * falloff;
    node.velocity.y += impulse.y * falloff;
    node.velocity.z += impulse.z * falloff;
    affected++;
  }

  return affected;
}
```

