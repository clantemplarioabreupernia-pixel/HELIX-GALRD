## FASE 1 — NÚCLEO MATEMÁTICO

### 🔧 T01 — Vector Math

**Uso:** operaciones básicas de vectores 3D.
**Fines:** base compartida por física y render, sin dependencias de Three.js en el motor.
**Archivo:** `src/core/vector-math.ts`

```ts
// src/core/vector-math.ts
/**
 * Vector3 primitives.
 * Mutable for hot paths (engine loop), plus pure helpers for math.
 * Vectors are plain objects to avoid THREE.js dependency in the physics core.
 */
export interface Vec3 {
  x: number;
  y: number;
  z: number;
}

export function createVec3(x = 0, y = 0, z = 0): Vec3 {
  return { x, y, z };
}

export function cloneVec3(v: Vec3): Vec3 {
  return { x: v.x, y: v.y, z: v.z };
}

export function addVec3(a: Vec3, b: Vec3): Vec3 {
  return { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z };
}

export function subVec3(a: Vec3, b: Vec3): Vec3 {
  return { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z };
}

export function scaleVec3(v: Vec3, s: number): Vec3 {
  return { x: v.x * s, y: v.y * s, z: v.z * s };
}

export function dotVec3(a: Vec3, b: Vec3): number {
  return a.x * b.x + a.y * b.y + a.z * b.z;
}

export function lengthSqVec3(v: Vec3): number {
  return v.x * v.x + v.y * v.y + v.z * v.z;
}

export function lengthVec3(v: Vec3): number {
  return Math.sqrt(lengthSqVec3(v));
}

export function distanceSqVec3(a: Vec3, b: Vec3): number {
  const dx = a.x - b.x;
  const dy = a.y - b.y;
  const dz = a.z - b.z;
  return dx * dx + dy * dy + dz * dz;
}

export function setVec3(target: Vec3, source: Vec3): void {
  target.x = source.x;
  target.y = source.y;
  target.z = source.z;
}

export function addScaledVec3(target: Vec3, source: Vec3, s: number): void {
  target.x += source.x * s;
  target.y += source.y * s;
  target.z += source.z * s;
}
```

