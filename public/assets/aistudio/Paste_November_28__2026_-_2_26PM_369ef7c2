### E.15 — `WorldScatter` (Colocación procedural)

**Uso:** poblar un `HeightMap` con props según bioma.
**Fin:** unificar placement (árboles, rocas) con reglas por pendiente.

```ts
// src/lib/worldScatter.ts
import type { HeightMap } from "./heightMap.ts";
import { Prng } from "./prng.ts";
import { BiomeRegistry, type BiomeId } from "./biomeRegistry.ts";
import { PropFactory } from "./propFactory.ts";
import type { SceneNode } from "../types.ts";

export interface ScatterOptions {
  densityMultiplier?: number;
  maxAttemptsRatio?: number;
}

export function scatterBiomeProps(
  heightMap: HeightMap,
  biome: BiomeId,
  seed: number,
  opts: ScatterOptions = {}
): SceneNode[] {
  const rule = BiomeRegistry.get(biome);
  const prng = new Prng(seed ^ 0x9e3779b9);
  const density = opts.densityMultiplier ?? 1;
  const area = heightMap.size * heightMap.size;
  const targetCount = Math.floor(area * (rule.treeDensity + rule.rockDensity) * 0.0009 * density);
  const maxAttempts = Math.ceil(targetCount * (opts.maxAttemptsRatio ?? 4));
  const rockProb = rule.rockDensity / (rule.treeDensity + rule.rockDensity);

  const nodes: SceneNode[] = [];
  let attempts = 0;
  while (nodes.length < targetCount && attempts < maxAttempts) {
    attempts++;
    const { x, z } = heightMap.randomPointXZ(prng);
    if (heightMap.slopeAt(x, z) > rule.maxSlope) continue;
    const y = heightMap.heightAt(x, z);
    nodes.push(
      prng.chance(rockProb)
        ? PropFactory.rock(x, y, z, prng, rule.rockColor)
        : PropFactory.tree(x, y, z, prng, rule.treeColor)
    );
  }
  return nodes;
}
```

