// src/store/editorReducer.ts
import type {
  CameraKeyframe,
  ProjectDocument,
  SceneNode,
} from "../types.ts";

export interface EditorState {
  project: ProjectDocument;
  selectedId: string | null;
  playhead: number;
  playing: boolean;
  status: string | null;
}

export type EditorAction =
  | { type: "SET_PROJECT"; project: ProjectDocument }
  | { type: "SET_NAME"; name: string }
  | { type: "SET_BIOME"; biome: ProjectDocument["biome"] }
  | { type: "ADD_NODE"; node: SceneNode }
  | { type: "ADD_NODES"; nodes: SceneNode[] }
  | { type: "REMOVE_NODE"; id: string }
  | { type: "UPDATE_NODE"; id: string; patch: Partial<SceneNode> }
  | { type: "CLEAR_NODES" }
  | { type: "SELECT"; id: string | null }
  | { type: "SET_TERRAIN"; patch: Partial<ProjectDocument["terrain"]> }
  | { type: "ADD_KEYFRAME"; keyframe: CameraKeyframe }
  | { type: "REMOVE_KEYFRAME"; id: string }
  | { type: "SET_PLAYHEAD"; time: number }
  | { type: "SET_PLAYING"; playing: boolean }
  | { type: "SET_STATUS"; status: string | null };

const touch = (p: ProjectDocument): ProjectDocument => ({ ...p, updatedAt: Date.now() });

export function editorReducer(state: EditorState, action: EditorAction): EditorState {
  switch (action.type) {
    case "SET_PROJECT":
      return { ...state, project: action.project, selectedId: null, playhead: 0, playing: false };
    case "SET_NAME":
      return { ...state, project: touch({ ...state.project, name: action.name }) };
    case "SET_BIOME":
      return { ...state, project: touch({ ...state.project, biome: action.biome }) };
    case "ADD_NODE":
      return {
        ...state,
        project: touch({ ...state.project, objects: [...state.project.objects, action.node] }),
      };
    case "ADD_NODES":
      return {
        ...state,
        project: touch({ ...state.project, objects: [...state.project.objects, ...action.nodes] }),
      };
    case "REMOVE_NODE":
      return {
        ...state,
        project: touch({
          ...state.project,
          objects: state.project.objects.filter((n) => n.id !== action.id),
        }),
        selectedId: state.selectedId === action.id ? null : state.selectedId,
      };
    case "UPDATE_NODE":
      return {
        ...state,
        project: touch({
          ...state.project,
          objects: state.project.objects.map((n) =>
            n.id === action.id ? { ...n, ...action.patch } : n
          ),
        }),
      };
    case "CLEAR_NODES":
      return { ...state, project: touch({ ...state.project, objects: [] }), selectedId: null };
    case "SELECT":
      return { ...state, selectedId: action.id };
    case "SET_TERRAIN":
      return {
        ...state,
        project: touch({
          ...state.project,
          terrain: { ...state.project.terrain, ...action.patch },
        }),
      };
    case "ADD_KEYFRAME":
      return {
        ...state,
        project: touch({
          ...state.project,
          track: {
            ...state.project.track,
            keyframes: [...state.project.track.keyframes, action.keyframe].sort(
              (a, b) => a.time - b.time
            ),
          },
        }),
      };
    case "REMOVE_KEYFRAME":
      return {
        ...state,
        project: touch({
          ...state.project,
          track: {
            ...state.project.track,
            keyframes: state.project.track.keyframes.filter((k) => k.id !== action.id),
          },
        }),
      };
    case "SET_PLAYHEAD":
      return { ...state, playhead: action.time };
    case "SET_PLAYING":
      return { ...state, playing: action.playing };
    case "SET_STATUS":
      return { ...state, status: action.status };
    default:
      return state;
  }
}
