// src/lib/projectSerializer.ts
import type { ProjectDocument } from "../types.ts";

const FORMAT_VERSION = 1;

export interface SerializedProject {
  format: "plataforma-de-juegos";
  version: number;
  document: ProjectDocument;
}

export function serializeProject(doc: ProjectDocument): string {
  const payload: SerializedProject = {
    format: "plataforma-de-juegos",
    version: FORMAT_VERSION,
    document: doc,
  };
  return JSON.stringify(payload, null, 2);
}

export function deserializeProject(text: string): ProjectDocument {
  const parsed = JSON.parse(text) as Partial<SerializedProject>;
  if (parsed.format !== "plataforma-de-juegos") {
    throw new Error("Formato no reconocido");
  }
  if (parsed.version !== FORMAT_VERSION) {
    throw new Error(`Versión incompatible: ${parsed.version} (esperada ${FORMAT_VERSION})`);
  }
  if (!parsed.document) throw new Error("Documento ausente");
  return parsed.document;
}
