### A.04 — `Easing` (Curvas de interpolación)

**Uso:** animación de cámara, playhead, transiciones de UI.
**Fin:** desacoplar de `cameraDirector` y reutilizable en cualquier animación.

```ts
// src/lib/easing.ts
export type Easing = "linear" | "easeIn" | "easeOut" | "easeInOut" | "smooth";

const fns: Record<Easing, (t: number) => number> = {
  linear: (t) => t,
  easeIn: (t) => t * t,
  easeOut: (t) => 1 - (1 - t) * (1 - t),
  easeInOut: (t) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2),
  smooth: (t) => t * t * (3 - 2 * t),
};

export function ease(kind: Easing, t: number): number {
  return fns[kind](Math.max(0, Math.min(1, t)));
}

export const EASING_KINDS: Easing[] = ["linear", "easeIn", "easeOut", "easeInOut", "smooth"];
```

