// src/lib/vec3.ts
export interface Vec3 {
  x: number;
  y: number;
  z: number;
}

export const vec3 = {
  zero: (): Vec3 => ({ x: 0, y: 0, z: 0 }),
  one: (): Vec3 => ({ x: 1, y: 1, z: 1 }),
  from: (x: number, y: number, z: number): Vec3 => ({ x, y, z }),
  fromArray: (a: readonly [number, number, number]): Vec3 => ({ x: a[0], y: a[1], z: a[2] }),
  toArray: (v: Vec3): [number, number, number] => [v.x, v.y, v.z],

  add: (a: Vec3, b: Vec3): Vec3 => ({ x: a.x + b.x, y: a.y + b.y, z: a.z + b.z }),
  sub: (a: Vec3, b: Vec3): Vec3 => ({ x: a.x - b.x, y: a.y - b.y, z: a.z - b.z }),
  scale: (v: Vec3, s: number): Vec3 => ({ x: v.x * s, y: v.y * s, z: v.z * s }),
  dot: (a: Vec3, b: Vec3): number => a.x * b.x + a.y * b.y + a.z * b.z,
  length: (v: Vec3): number => Math.hypot(v.x, v.y, v.z),
  distance: (a: Vec3, b: Vec3): number => Math.hypot(a.x - b.x, a.y - b.y, a.z - b.z),
  normalize: (v: Vec3): Vec3 => {
    const len = Math.hypot(v.x, v.y, v.z) || 1;
    return { x: v.x / len, y: v.y / len, z: v.z / len };
  },
  lerp: (a: Vec3, b: Vec3, t: number): Vec3 => ({
    x: a.x + (b.x - a.x) * t,
    y: a.y + (b.y - a.y) * t,
    z: a.z + (b.z - a.z) * t,
  }),
} as const;
