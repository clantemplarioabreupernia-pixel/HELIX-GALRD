### A.02 — `Noise` (Ruido 2D)

**Uso:** FBM y ridged noise para terreno, humedad, distribución de biomas.
**Fin:** generar variación espacial continua y coherente.
**Dependencias:** ninguna (usa hash propio).

```ts
// src/lib/noise.ts
function hash2(xi: number, yi: number, seed: number): number {
  let n = (xi * 374761393 + yi * 668265263 + seed * 1013904223) | 0;
  n = (n ^ (n >>> 13)) * 1274126177;
  return ((n ^ (n >>> 16)) >>> 0) / 0xffffffff;
}

export function valueNoise2D(x: number, y: number, seed: number): number {
  const xi = Math.floor(x);
  const yi = Math.floor(y);
  const xf = x - xi;
  const yf = y - yi;
  const u = xf * xf * (3 - 2 * xf);
  const v = yf * yf * (3 - 2 * yf);
  const a = hash2(xi, yi, seed);
  const b = hash2(xi + 1, yi, seed);
  const c = hash2(xi, yi + 1, seed);
  const d = hash2(xi + 1, yi + 1, seed);
  return a * (1 - u) * (1 - v) + b * u * (1 - v) + c * (1 - u) * v + d * u * v;
}

export interface FbmOptions {
  octaves: number;
  persistence: number;
  lacunarity: number;
}

export function fbm2D(x: number, y: number, seed: number, opts: FbmOptions): number {
  let amp = 1;
  let freq = 1;
  let sum = 0;
  let norm = 0;
  for (let i = 0; i < opts.octaves; i++) {
    sum += amp * valueNoise2D(x * freq, y * freq, seed + i * 1013);
    norm += amp;
    amp *= opts.persistence;
    freq *= opts.lacunarity;
  }
  return norm === 0 ? 0 : sum / norm;
}

export function ridged2D(x: number, y: number, seed: number, opts: FbmOptions): number {
  let amp = 1;
  let freq = 1;
  let sum = 0;
  let norm = 0;
  for (let i = 0; i < opts.octaves; i++) {
    const n = valueNoise2D(x * freq, y * freq, seed + i * 7919);
    const r = 1 - Math.abs(n * 2 - 1);
    sum += amp * r * r;
    norm += amp;
    amp *= opts.persistence;
    freq *= opts.lacunarity;
  }
  return norm === 0 ? 0 : sum / norm;
}
```

