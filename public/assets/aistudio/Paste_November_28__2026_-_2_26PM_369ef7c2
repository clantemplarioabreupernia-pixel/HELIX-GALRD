### B.07 — `TerrainMeshBuilder` (Mesh Three.js)

**Uso:** convertir un `HeightMap` en `PlaneGeometry` deformada.
**Fin:** desacoplar la creación de mesh del componente `Viewport`.

```ts
// src/lib/terrainMesh.ts
import * as THREE from "three";
import type { HeightMap } from "./heightMap.ts";

export interface TerrainMaterialOptions {
  color?: number;
  roughness?: number;
  metalness?: number;
  flatShading?: boolean;
}

export function buildTerrainMesh(
  heightMap: HeightMap,
  materialOpts: TerrainMaterialOptions = {}
): THREE.Mesh {
  const { size, resolution, heights } = heightMap;
  const geometry = new THREE.PlaneGeometry(size, size, resolution, resolution);
  geometry.rotateX(-Math.PI / 2);

  const position = geometry.attributes.position as THREE.BufferAttribute;
  const width = resolution + 1;
  for (let j = 0; j < width; j++) {
    for (let i = 0; i < width; i++) {
      position.setY(j * width + i, heights[j * width + i]);
    }
  }
  position.needsUpdate = true;
  geometry.computeVertexNormals();

  const material = new THREE.MeshStandardMaterial({
    color: materialOpts.color ?? 0x4b5563,
    roughness: materialOpts.roughness ?? 0.95,
    metalness: materialOpts.metalness ?? 0.05,
    flatShading: materialOpts.flatShading ?? false,
  });

  const mesh = new THREE.Mesh(geometry, material);
  mesh.receiveShadow = true;
  mesh.castShadow = true;
  return mesh;
}
```

