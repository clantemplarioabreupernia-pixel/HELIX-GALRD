## 🅳 CAPA CÁMARA CINEMATOGRÁFICA

### D.10 — `CameraTrack` (Interpolación de keyframes)

**Uso:** muestrear la cámara en un instante `t`.
**Fin:** desacoplar lógica de track del objeto Three.js.

```ts
// src/lib/cameraTrack.ts
import type { Easing } from "./easing.ts";
import { ease } from "./easing.ts";
import type { Vec3 } from "./vec3.ts";
import { vec3 } from "./vec3.ts";

export interface CameraKeyframe {
  id: string;
  time: number;
  position: Vec3;
  target: Vec3;
  fov: number;
  easing: Easing;
}

export interface CameraTrackData {
  id: string;
  name: string;
  duration: number;
  keyframes: CameraKeyframe[];
}

export interface CameraSample {
  position: Vec3;
  target: Vec3;
  fov: number;
}

function sortKeyframes(kfs: CameraKeyframe[]): CameraKeyframe[] {
  return [...kfs].sort((a, b) => a.time - b.time);
}

export function sampleTrack(track: CameraTrackData, time: number): CameraSample | null {
  const kfs = sortKeyframes(track.keyframes);
  if (kfs.length === 0) return null;
  if (time <= kfs[0].time) return fromKeyframe(kfs[0]);
  if (time >= kfs[kfs.length - 1].time) return fromKeyframe(kfs[kfs.length - 1]);

  for (let i = 0; i < kfs.length - 1; i++) {
    const a = kfs[i];
    const b = kfs[i + 1];
    if (time >= a.time && time <= b.time) {
      const span = Math.max(1e-6, b.time - a.time);
      const raw = (time - a.time) / span;
      const t = ease(b.easing, raw);
      return {
        position: vec3.lerp(a.position, b.position, t),
        target: vec3.lerp(a.target, b.target, t),
        fov: a.fov + (b.fov - a.fov) * t,
      };
    }
  }
  return null;
}

function fromKeyframe(kf: CameraKeyframe): CameraSample {
  return { position: { ...kf.position }, target: { ...kf.target }, fov: kf.fov };
}
```

