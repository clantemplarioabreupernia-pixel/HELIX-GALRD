### D.11 — `CameraDirector` (Aplicar a Three.js)

**Uso:** aplicar `CameraSample` a `PerspectiveCamera`.
**Fin:** adaptador Three.js del `CameraTrack`.

```ts
// src/lib/cameraDirector.ts
import * as THREE from "three";
import type { CameraTrackData } from "./cameraTrack.ts";
import { sampleTrack } from "./cameraTrack.ts";

export class CameraDirector {
  private readonly lookAt = new THREE.Vector3();

  apply(
    track: CameraTrackData,
    time: number,
    camera: THREE.PerspectiveCamera
  ): void {
    const sample = sampleTrack(track, time);
    if (!sample) return;

    camera.position.set(sample.position.x, sample.position.y, sample.position.z);
    if (camera.fov !== sample.fov) {
      camera.fov = sample.fov;
      camera.updateProjectionMatrix();
    }
    this.lookAt.set(sample.target.x, sample.target.y, sample.target.z);
    camera.lookAt(this.lookAt);
  }
}
```

