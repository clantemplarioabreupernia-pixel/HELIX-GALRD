## 🅻 CAPA HOOKS

### L.30 — `useAnimatedPlayhead`

**Uso:** avanzar el playhead en tiempo real cuando `playing = true`.
**Fin:** desacoplar la animación del componente `Viewport`.

```ts
// src/ui/hooks/useAnimatedPlayhead.ts
import { useEffect } from "react";
import { useEditor } from "../../store/editorContext.tsx";

export function useAnimatedPlayhead(): void {
  const { state, dispatch } = useEditor();

  useEffect(() => {
    if (!state.playing) return;
    const start = performance.now();
    const base = state.playhead;
    let raf = 0;

    const tick = () => {
      const elapsed = (performance.now() - start) / 1000;
      const next = base + elapsed;
      if (next >= state.project.track.duration) {
        dispatch({ type: "SET_PLAYHEAD", time: state.project.track.duration });
        dispatch({ type: "SET_PLAYING", playing: false });
        return;
      }
      dispatch({ type: "SET_PLAYHEAD", time: next });
      raf = requestAnimationFrame(tick);
    };

    raf = requestAnimationFrame(tick);
    return () => cancelAnimationFrame(raf);
  }, [state.playing, state.project.track.duration]);
}
```

