```ts
// src/lib/projectValidator.ts
import type { ProjectDocument } from "../types.ts";
import { BiomeRegistry } from "./biomeRegistry.ts";

export interface ValidationIssue {
  path: string;
  message: string;
}

export function validateProject(doc: unknown): { ok: boolean; issues: ValidationIssue[] } {
  const issues: ValidationIssue[] = [];
  if (typeof doc !== "object" || doc === null) {
    return { ok: false, issues: [{ path: "$", message: "no es un objeto" }] };
  }
  const d = doc as Partial<ProjectDocument>;

  if (typeof d.id !== "string") issues.push({ path: "$.id", message: "requerido" });
  if (typeof d.name !== "string") issues.push({ path: "$.name", message: "requerido" });
  if (!BiomeRegistry.isBiome(d.biome)) issues.push({ path: "$.biome", message: "bioma inválido" });
  if (!d.terrain || typeof d.terrain.seed !== "number") {
    issues.push({ path: "$.terrain", message: "config requerida" });
  }
  if (!Array.isArray(d.objects)) issues.push({ path: "$.objects", message: "array requerido" });
  if (!d.track || !Array.isArray(d.track.keyframes)) {
    issues.push({ path: "$.track", message: "track requerido" });
  }
  return { ok: issues.length === 0, issues };
}
