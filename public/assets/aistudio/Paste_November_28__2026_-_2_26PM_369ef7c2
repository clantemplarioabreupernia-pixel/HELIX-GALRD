### A.05 — `Uuid` (IDs únicos)

**Uso:** identificar nodos, keyframes, proyectos.
**Fin:** reemplazar duplicación de `crypto.randomUUID` esparcida.

```ts
// src/lib/uuid.ts
let counter = 0;

export function createId(prefix = "id"): string {
  if (typeof crypto !== "undefined" && "randomUUID" in crypto) {
    return `${prefix}_${crypto.randomUUID()}`;
  }
  const rand = Math.floor(Math.random() * 0xffffffff).toString(36);
  counter = (counter + 1) & 0xffffff;
  return `${prefix}_${Date.now().toString(36)}_${rand}_${counter.toString(36)}`;
}
```

