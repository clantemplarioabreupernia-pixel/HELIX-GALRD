### F.17 — `WorldPromptSchema` (Validación de respuesta IA)

**Uso:** sanear la respuesta de Gemini a un `WorldPromptResult` seguro.
**Fin:** nunca confiar en la salida de un LLM.

```ts
// src/ai/worldPromptSchema.ts
import { BiomeRegistry, type BiomeId } from "../lib/biomeRegistry.ts";

export type GeometryId = "box" | "sphere" | "cylinder" | "plane" | "cone";

const VALID_GEOMETRY: GeometryId[] = ["box", "sphere", "cylinder", "plane", "cone"];

export interface WorldPromptResult {
  biome: BiomeId;
  amplitude: number;
  objects: Array<{
    kind: GeometryId;
    position: [number, number, number];
    scale: [number, number, number];
  }>;
}

const SYSTEM_PROMPT = `Eres un diseñador de mundos 3D.
Devuelve EXCLUSIVAMENTE JSON válido (sin markdown) con este esquema:
{
  "biome": "plains" | "forest" | "desert" | "mountain" | "coast" | "tundra",
  "amplitude": number entre 5 y 60,
  "objects": [
    { "kind": "box"|"sphere"|"cylinder"|"plane"|"cone",
      "position": [x, y, z],
      "scale": [sx, sy, sz] }
  ]
}
Máximo 24 objetos. Coordenadas en [-80, 80].`;

export function buildWorldPrompt(userPrompt: string): string {
  return `${SYSTEM_PROMPT}\n\nPrompt del usuario: ${userPrompt}`;
}

export function validateWorldPromptResult(raw: unknown): WorldPromptResult {
  const obj = (raw ?? {}) as Partial<WorldPromptResult> & { objects?: unknown };
  const biome = BiomeRegistry.isBiome(obj.biome) ? obj.biome : "plains";
  const amplitude =
    typeof obj.amplitude === "number" && obj.amplitude >= 5 && obj.amplitude <= 60
      ? obj.amplitude
      : 20;

  const objects: WorldPromptResult["objects"] = [];
  if (Array.isArray(obj.objects)) {
    for (const entry of obj.objects as Array<Record<string, unknown>>) {
      if (objects.length >= 24) break;
      const kind = isValidGeometry(entry.kind) ? entry.kind : "box";
      const position = sanitizeTuple(entry.position, [-80, 80], [0, 0, 0]);
      const scale = sanitizeTuple(entry.scale, [0.1, 10], [1, 1, 1]);
      objects.push({ kind, position, scale });
    }
  }
  return { biome, amplitude, objects };
}

function isValidGeometry(x: unknown): x is GeometryId {
  return typeof x === "string" && (VALID_GEOMETRY as string[]).includes(x);
}

function sanitizeTuple(
  value: unknown,
  [min, max]: [number, number],
  fallback: [number, number, number]
): [number, number, number] {
  if (!Array.isArray(value) || value.length !== 3) return fallback;
  return value.map((n) => clamp(Number(n) || 0, min, max)) as [number, number, number];
}

function clamp(n: number, min: number, max: number): number {
  return Math.min(max, Math.max(min, n));
}
```

