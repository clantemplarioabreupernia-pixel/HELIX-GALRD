### C.09 — `PhysicsWorld` (Simulación)

**Uso:** integrar gravedad, drag, fricción y colisión con `HeightMap`.
**Dependencias:** `HeightMap`, `RigidBody`.

```ts
// src/lib/physicsWorld.ts
import type { HeightMap } from "./heightMap.ts";
import type { RigidBody } from "./rigidBody.ts";

export interface PhysicsOptions {
  gravity?: number;
  airDrag?: number;
  groundFriction?: number;
}

export class PhysicsWorld {
  readonly gravity: number;
  readonly airDrag: number;
  readonly groundFriction: number;

  constructor(
    public readonly heightMap: HeightMap,
    opts: PhysicsOptions = {}
  ) {
    this.gravity = opts.gravity ?? -9.81;
    this.airDrag = opts.airDrag ?? 0.02;
    this.groundFriction = opts.groundFriction ?? 0.85;
  }

  step(body: RigidBody, dt: number): void {
    body.velocity.y += this.gravity * dt;
    const drag = 1 - this.airDrag;
    body.velocity.x *= drag;
    body.velocity.z *= drag;

    body.position.x += body.velocity.x * dt;
    body.position.y += body.velocity.y * dt;
    body.position.z += body.velocity.z * dt;

    const groundY = this.heightMap.heightAt(body.position.x, body.position.z) + body.radius;
    if (body.position.y <= groundY) {
      body.position.y = groundY;
      if (body.velocity.y < 0) {
        body.velocity.y = -body.velocity.y * body.restitution;
        if (Math.abs(body.velocity.y) < 0.5) body.velocity.y = 0;
      }
      body.velocity.x *= this.groundFriction;
      body.velocity.z *= this.groundFriction;
      body.grounded = true;
    } else {
      body.grounded = false;
    }
  }
}
```

