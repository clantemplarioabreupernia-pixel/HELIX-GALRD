## 🅱️ CAPA TERRENO

### B.06 — `HeightMap` (Heightfield)

**Uso:** almacenar y muestrear alturas de terreno.
**Fin:** desacoplar **datos** (heightmap) de **representación** (mesh).
**Dependencias:** `noise`, `prng`.

```ts
// src/lib/heightMap.ts
import { Prng } from "./prng.ts";
import { fbm2D, ridged2D } from "./noise.ts";

export interface HeightMapConfig {
  seed: number;
  size: number;
  resolution: number;
  amplitude: number;
  octaves: number;
  persistence: number;
  lacunarity: number;
}

export class HeightMap {
  readonly config: HeightMapConfig;
  readonly size: number;
  readonly resolution: number;
  readonly heights: Float32Array;

  constructor(config: HeightMapConfig) {
    this.config = config;
    this.size = config.size;
    this.resolution = config.resolution;
    this.heights = new Float32Array((this.resolution + 1) ** 2);
    this.build();
  }

  private build(): void {
    const { seed, amplitude, octaves, persistence, lacunarity } = this.config;
    const step = this.size / this.resolution;
    const half = this.size / 2;
    const width = this.resolution + 1;
    const opts = { octaves, persistence, lacunarity };

    for (let j = 0; j <= this.resolution; j++) {
      for (let i = 0; i <= this.resolution; i++) {
        const x = i * step - half;
        const z = j * step - half;
        const base = fbm2D(x * 0.02, z * 0.02, seed, opts);
        const ridge = ridged2D(x * 0.015, z * 0.015, seed + 4242, opts);
        this.heights[j * width + i] = (base * 0.65 + ridge * 0.35) * amplitude - amplitude * 0.25;
      }
    }
  }

  /** Bilinear sample en coordenadas mundo */
  heightAt(x: number, z: number): number {
    const half = this.size / 2;
    const step = this.size / this.resolution;
    const width = this.resolution + 1;
    const fi = (x + half) / step;
    const fj = (z + half) / step;
    const i0 = Math.max(0, Math.min(this.resolution - 1, Math.floor(fi)));
    const j0 = Math.max(0, Math.min(this.resolution - 1, Math.floor(fj)));
    const tx = fi - i0;
    const tz = fj - j0;

    const h00 = this.heights[j0 * width + i0];
    const h10 = this.heights[j0 * width + i0 + 1];
    const h01 = this.heights[(j0 + 1) * width + i0];
    const h11 = this.heights[(j0 + 1) * width + i0 + 1];
    const a = h00 * (1 - tx) + h10 * tx;
    const b = h01 * (1 - tx) + h11 * tx;
    return a * (1 - tz) + b * tz;
  }

  /** Pendiente local (delta entre vecinos) */
  slopeAt(x: number, z: number): number {
    const d = this.size / this.resolution;
    const dx = this.heightAt(x + d, z) - this.heightAt(x - d, z);
    const dz = this.heightAt(x, z + d) - this.heightAt(x, z - d);
    return Math.hypot(dx, dz) / (2 * d);
  }

  /** Coordenadas XZ aleatorias dentro del mapa */
  randomPointXZ(prng: Prng): { x: number; z: number } {
    const half = this.size / 2;
    return { x: prng.range(-half, half), z: prng.range(-half, half) };
  }
}
```

