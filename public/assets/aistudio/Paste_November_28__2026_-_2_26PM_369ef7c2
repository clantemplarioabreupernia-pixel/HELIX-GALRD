## 🅰️ CAPA NÚCLEO MATEMÁTICO

### A.01 — `Prng` (Random determinista)

**Uso:** generación reproducible de terreno, props, muestreo.
**Fin:** eliminar `Math.random()` de todo el código. Misma semilla → mismos resultados.
**Dependencias:** ninguna.

```ts
// src/lib/prng.ts
/**
 * PRNG xorshift128 — ciclo 2^128 - 1, distribución uniforme [0, 1).
 * Determinista: misma semilla → misma secuencia.
 */
export class Prng {
  private s0: number;
  private s1: number;
  private s2: number;
  private s3: number;

  constructor(seed: number) {
    const h = Prng.mix32(seed);
    this.s0 = h ^ 0x9e3779b9;
    this.s1 = (h * 0x85ebca6b) >>> 0;
    this.s2 = (h * 0xc2b2ae35) >>> 0;
    this.s3 = (h + 0x165667b1) >>> 0;
    if ((this.s0 | this.s1 | this.s2 | this.s3) === 0) this.s0 = 1;
  }

  private static mix32(n: number): number {
    n = (n ^ (n >>> 16)) * 0x85ebca6b;
    n = (n ^ (n >>> 13)) * 0xc2b2ae35;
    return (n ^ (n >>> 16)) >>> 0;
  }

  /** Uniforme en [0, 1) */
  next(): number {
    const t = (this.s0 ^ (this.s0 << 11)) >>> 0;
    this.s0 = this.s1;
    this.s1 = this.s2;
    this.s2 = this.s3;
    this.s3 = ((this.s3 ^ (this.s3 >>> 19)) ^ (t ^ (t >>> 8))) >>> 0;
    return this.s3 / 0x100000000;
  }

  /** Uniforme en [min, max) */
  range(min: number, max: number): number {
    return min + (max - min) * this.next();
  }

  /** Entero en [min, max] */
  int(min: number, max: number): number {
    return Math.floor(this.range(min, max + 1));
  }

  /** Elemento aleatorio de un array */
  pick<T>(arr: readonly T[]): T {
    return arr[Math.floor(this.next() * arr.length)];
  }

  /** Bernoulli con probabilidad p */
  chance(p: number): boolean {
    return this.next() < p;
  }
}
```

