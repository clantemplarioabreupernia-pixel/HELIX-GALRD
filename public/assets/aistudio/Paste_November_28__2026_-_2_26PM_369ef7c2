// src/ui/primitives/numberField.tsx
interface Props {
  label: string;
  value: number;
  onChange: (v: number) => void;
  step?: number;
  min?: number;
  max?: number;
}

export function NumberField({ label, value, onChange, step = 1, min, max }: Props) {
  return (
    <label className="block">
      <span className="text-xs text-slate-500">{label}</span>
      <input
