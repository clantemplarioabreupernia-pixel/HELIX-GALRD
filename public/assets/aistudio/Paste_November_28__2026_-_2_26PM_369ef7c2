// src/server/apiRouter.ts
import { Router } from "express";
import { generateJsonResponse } from "../ai/geminiClient.ts";
import { buildWorldPrompt, validateWorldPromptResult } from "../ai/worldPromptSchema.ts";
import { solveCameraSpacing, type Point2D } from "../lib/cameraSpacingSolver.ts";
import { logger } from "../lib/logger.ts";
import { Config } from "../config.ts";

export function createApiRouter(): Router {
  const router = Router();

  router.get("/health", (_req, res) => {
    res.json({ ok: true, service: "plataforma-de-juegos", ts: Date.now() });
  });

  router.post("/ai/generate-world", async (req, res) => {
    const prompt = typeof req.body?.prompt === "string" ? req.body.prompt.trim() : "";
    if (!prompt) return res.status(400).json({ error: "prompt requerido" });
    if (prompt.length > Config.ai.maxPromptLength) {
      return res.status(413).json({ error: "prompt demasiado largo" });
    }
    try {
      const raw = await generateJsonResponse({
        system: buildWorldPrompt(prompt).split("\n\n")[0],
        user: prompt,
      });
      res.json(validateWorldPromptResult(raw));
    } catch (err) {
      logger.error("/api/ai/generate-world", err);
      res.status(502).json({ error: err instanceof Error ? err.message : "error IA" });
    }
  });

  router.post("/ai/camera-path", async (req, res) => {
    const points = Array.isArray(req.body?.points) ? (req.body.points as Point2D[]) : [];
    const minDistance = Number(req.body?.minDistance ?? Config.camera.minSpacing);
    if (points.length < 2) return res.status(400).json({ error: "≥2 puntos requeridos" });
    const result = await solveCameraSpacing(points, minDistance);
    if (!result.ok) return res.status(422).json({ error: result.reason ?? "insatisfacible" });
    res.json({ points: result.points });
  });

  return router;
}
