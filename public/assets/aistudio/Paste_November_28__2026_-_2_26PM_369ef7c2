### D.12 — `CameraSpacingSolver` (Z3)

**Uso:** validar que keyframes de cámara respeten distancia mínima.
**Fin:** garantizar spacing cinematográfico verificable.

```ts
// src/lib/cameraSpacingSolver.ts
export interface Point2D {
  x: number;
  z: number;
}

export interface SpacingResult {
  ok: boolean;
  points?: Point2D[];
  reason?: string;
}

export async function solveCameraSpacing(
  points: Point2D[],
  minDistance: number,
  tolerance = 3
): Promise<SpacingResult> {
  if (points.length < 2) return { ok: true, points };

  try {
    const { init } = await import("z3-solver");
    const { Context } = await init();
    const ctx = new Context("camera-spacing");
    const { Solver, Real } = ctx;

    const solver = new Solver();
    const vars = points.map((_, i) => ({
      x: Real.const(`x_${i}`),
      z: Real.const(`z_${i}`),
    }));

    points.forEach((p, i) => {
      solver.add(vars[i].x.ge(p.x - tolerance), vars[i].x.le(p.x + tolerance));
      solver.add(vars[i].z.ge(p.z - tolerance), vars[i].z.le(p.z + tolerance));
    });

    for (let i = 0; i < vars.length; i++) {
      for (let j = i + 1; j < vars.length; j++) {
        const dx = vars[i].x.sub(vars[j].x);
        const dz = vars[i].z.sub(vars[j].z);
        solver.add(dx.mul(dx).add(dz.mul(dz)).ge(minDistance * minDistance));
      }
    }

    const res = await solver.check();
    if (res !== "sat") return { ok: false, reason: `insatisfacible (${res})` };

    const model = solver.model();
    return {
      ok: true,
      points: vars.map((v) => ({
        x: Number(model.eval(v.x).toString()),
        z: Number(model.eval(v.z).toString()),
      })),
    };
  } catch (err) {
    return { ok: false, reason: err instanceof Error ? err.message : "z3 error" };
  }
}
```

