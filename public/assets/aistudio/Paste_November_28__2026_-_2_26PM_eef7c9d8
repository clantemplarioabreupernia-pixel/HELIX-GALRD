import { AppShell } from '@/components/layout/AppShell';
import { useTheme } from '@/hooks/useTheme';
import { useNavigation } from './router';
import { HomePage } from '@/pages/HomePage';
import { ChatPage } from '@/pages/ChatPage';
import { SettingsPage } from '@/pages/SettingsPage';

export function App() {
  useTheme();
  const { route, navigate } = useNavigation();

  return (
    <AppShell active={route} onNavigate={navigate}>
      {route === 'home' && <HomePage onStart={() => navigate('chat')} />}
      {route === 'chat' && <ChatPage />}
      {route === 'settings' && <SettingsPage />}
    </AppShell>
  );
}
```

### B4 — `src/app/router.tsx` *(NUEVO)*

**Uso:** Navegación tipada. **Propósito:** Centralizar el control de rutas sin librería externa.

```tsx
import { useCallback, useState } from 'react';
import type { NavKey } from '@/components/layout/NavigationRail';

const DEFAULT_ROUTE: NavKey = 'home';

export interface UseNavigationResult {
  route: NavKey;
  navigate: (next: NavKey) => void;
}

export function useNavigation(initial: NavKey = DEFAULT_ROUTE): UseNavigationResult {
  const [route, setRoute] = useState<NavKey>(initial);
  const navigate = useCallback((next: NavKey) => setRoute(next), []);
  return { route, navigate };
}
```

