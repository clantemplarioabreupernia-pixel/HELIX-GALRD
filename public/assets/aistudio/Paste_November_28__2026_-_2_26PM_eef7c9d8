import { useCallback, useEffect, useState } from 'react';

export type UseLocalStorageResult<T> = [T, (next: T) => void, () => void];

export function useLocalStorage<T>(key: string, initial: T): UseLocalStorageResult<T> {
  const [value, setValue] = useState<T>(() => {
    if (typeof localStorage === 'undefined') return initial;
    try {
      const raw = localStorage.getItem(key);
      return raw === null ? initial : (JSON.parse(raw) as T);
    } catch {
      return initial;
    }
  });

  useEffect(() => {
    try {
      localStorage.setItem(key, JSON.stringify(value));
    } catch {
      /* quota exceeded — no-op */
    }
  }, [key, value]);

  const reset = useCallback(() => setValue(initial), [initial]);

  return [value, setValue, reset];
}
```

### F3 — `src/hooks/useStreamingCompletion.ts`

**Uso:** Ejecutar streaming IA con abort. **Propósito:** Encapsular ciclo de vida de una generación.

```ts
import { useCallback, useRef, useState } from 'react';
import { generateCompletionStream } from '@/services/ai/gemini';
import type { Message } from '@/types/chat';

export interface StreamingCompletionState {
  isStreaming: boolean;
  error: string | null;
  stream: (messages: Message[], onChunk: (delta: string) => void) => Promise<string | null>;
  abort: () => void;
}

export function useStreamingCompletion(): StreamingCompletionState {
  const [isStreaming, setIsStreaming] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const abortRef = useRef<AbortController | null>(null);

  const stream = useCallback(
    async (messages: Message[], onChunk: (delta: string) => void): Promise<string | null> => {
      setIsStreaming(true);
      setError(null);
      abortRef.current = new AbortController();

      try {
        return await generateCompletionStream(messages, {
          signal: abortRef.current.signal,
          onChunk,
        });
      } catch (cause) {
        if (cause instanceof DOMException && cause.name === 'AbortError') return null;
        setError(cause instanceof Error ? cause.message : 'Error desconocido');
        return null;
      } finally {
        setIsStreaming(false);
        abortRef.current = null;
      }
    },
    []
  );

  const abort = useCallback(() => abortRef.current?.abort(), []);

  return { isStreaming, error, stream, abort };
}
```

