```ts
import type { RequestHandler } from 'express';
import type { ChatRequest } from '../types';

const VALID_ROLES = new Set(['user', 'model', 'system']);

export const validateChatBody: RequestHandler = (req, res, next) => {
  const body = req.body as Partial<ChatRequest> | undefined;

  if (!body || !Array.isArray(body.messages) || body.messages.length === 0) {
    res.status(400).json({ error: 'messages es requerido y no puede estar vacío' });
    return;
  }

  for (const msg of body.messages) {
    if (!VALID_ROLES.has(msg.role) || typeof msg.content !== 'string') {
      res.status(400).json({ error: 'message inválido: role o content incorrecto' });
      return;
    }
  }

  if (body.temperature !== undefined && (body.temperature < 0 || body.temperature > 2)) {
    res.status(400).json({ error: 'temperature debe estar entre 0 y 2' });
    return;
  }

  next();
};
```

### L6 — `server/services/gemini.ts`

```ts
import { GoogleGenAI } from '@google/genai';
import type { ChatRequest } from '../types';

const API_KEY = process.env.GEMINI_API_KEY;
const DEFAULT_MODEL = process.env.DEFAULT_MODEL ?? 'gemini-2.0-flash';

const ai = API_KEY ? new GoogleGenAI({ apiKey: API_KEY }) : null;

if (!ai) {
  console.warn('[gemini] GEMINI_API_KEY no definida — /api/chat fallará');
}

export function isAIReady(): boolean {
  return ai !== null;
}

export async function streamChatCompletion(
  request: ChatRequest,
  onDelta: (delta: string) => void
): Promise<void> {
  if (!ai) {
    throw new Error('GEMINI_API_KEY no configurada');
  }

  const { model = DEFAULT_MODEL, temperature = 0.7, messages } = request;

  const contents = messages
    .filter((m) => m.role !== 'system')
    .map((m) => ({
      role: m.role === 'user' ? 'user' : 'model',
      parts: [{ text: m.content }],
    }));

  const stream = await ai.models.generateContentStream({
    model,
    contents,
    config: { temperature },
  });

  for await (const chunk of stream) {
    const text = chunk.text;
    if (text) onDelta(text);
  }
}
```

