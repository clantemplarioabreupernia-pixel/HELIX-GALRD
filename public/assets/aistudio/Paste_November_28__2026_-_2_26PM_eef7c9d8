```ts
import { useCallback, useState } from 'react';
import { useStreamingCompletion } from './useStreamingCompletion';
import { generateId } from '@/lib/id';
import type { Message } from '@/types/chat';

export interface UseChatResult {
  messages: Message[];
  isStreaming: boolean;
  error: string | null;
  send: (text: string) => Promise<void>;
  abort: () => void;
  clear: () => void;
}

export function useChat(): UseChatResult {
  const [messages, setMessages] = useState<Message[]>([]);
  const { isStreaming, error, stream, abort } = useStreamingCompletion();

  const send = useCallback(
    async (text: string) => {
      const trimmed = text.trim();
      if (!trimmed || isStreaming) return;

      const userMsg: Message = {
        id: generateId(),
        role: 'user',
        content: trimmed,
        timestamp: Date.now(),
      };
      const assistantId = generateId();
      const assistantMsg: Message = {
        id: assistantId,
        role: 'model',
        content: '',
        timestamp: Date.now(),
        pending: true,
      };

      const history = [...messages, userMsg];
      setMessages([...history, assistantMsg]);

      await stream(history, (delta) => {
        setMessages((prev) =>
          prev.map((m) => (m.id === assistantId ? { ...m, content: m.content + delta } : m))
        );
      });

      setMessages((prev) =>
        prev.map((m) => (m.id === assistantId ? { ...m, pending: false } : m))
      );
    },
    [messages, isStreaming, stream]
  );

  const clear = useCallback(() => setMessages([]), []);

  return { messages, isStreaming, error, send, abort, clear };
}
```

