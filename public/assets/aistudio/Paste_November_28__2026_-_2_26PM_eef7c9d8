import { Router } from 'express';
import { validateChatBody } from '../middleware/validateChatBody';
import { streamChatCompletion } from '../services/gemini';
import type { ChatRequest } from '../types';

export const chatRouter = Router();

chatRouter.post('/', validateChatBody, async (req, res, next) => {
  try {
    const body = req.body as ChatRequest;

    res.setHeader('Content-Type', 'text/plain; charset=utf-8');
    res.setHeader('Cache-Control', 'no-cache');
    res.setHeader('X-Accel-Buffering', 'no');

    await streamChatCompletion(body, (delta) => res.write(delta));
    res.end();
  } catch (cause) {
    if (res.headersSent) {
      res.end();
      return;
    }
    next(cause);
  }
});
