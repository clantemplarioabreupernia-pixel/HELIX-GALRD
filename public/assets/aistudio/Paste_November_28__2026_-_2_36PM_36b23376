```typescript
// Criptografía real vía Web Crypto API.
// SHA-256, SHA-512, HMAC-SHA256, Ed25519.
// Sin simulaciones, sin constantes mágicas.

// ---------- helpers ----------

export function bufToHex(buf: ArrayBuffer): string {
  return Array.from(new Uint8Array(buf))
    .map((b) => b.toString(16).padStart(2, '0'))
    .join('');
}

export function hexToBuf(hex: string): ArrayBuffer {
  if (hex.length % 2 !== 0) throw new Error('hex impar');
  const bytes = new Uint8Array(hex.length / 2);
  for (let i = 0; i < bytes.length; i++) {
    bytes[i] = parseInt(hex.substr(i * 2, 2), 16);
  }
  return bytes.buffer;
}

// ---------- hash ----------

export async function sha256Hex(input: string): Promise<string> {
  const data = new TextEncoder().encode(input);
  const digest = await crypto.subtle.digest('SHA-256', data);
  return bufToHex(digest);
}

export async function sha512Hex(input: string): Promise<string> {
  const data = new TextEncoder().encode(input);
  const digest = await crypto.subtle.digest('SHA-512', data);
  return bufToHex(digest);
}

// ---------- HMAC ----------

export async function hmacSha256(key: string, message: string): Promise<string> {
  const cryptoKey = await crypto.subtle.importKey(
    'raw',
    new TextEncoder().encode(key),
    { name: 'HMAC', hash: 'SHA-256' },
    false,
    ['sign', 'verify'],
  );
  const sig = await crypto.subtle.sign(
    'HMAC',
    cryptoKey,
    new TextEncoder().encode(message),
  );
  return bufToHex(sig);
}

export async function verifyHmacSha256(
  key: string,
  message: string,
  expectedHex: string,
): Promise<boolean> {
  const computed = await hmacSha256(key, message);
  // comparación en tiempo constante
  if (computed.length !== expectedHex.length) return false;
  let diff = 0;
  for (let i = 0; i < computed.length; i++) {
    diff |= computed.charCodeAt(i) ^ expectedHex.charCodeAt(i);
  }
  return diff === 0;
}

// ---------- Ed25519 ----------

export async function generateEd25519KeyPair(): Promise<CryptoKeyPair> {
  return crypto.subtle.generateKey({ name: 'Ed25519' }, true, [
    'sign',
    'verify',
  ]) as Promise<CryptoKeyPair>;
}

export async function exportPublicKeyHex(key: CryptoKey): Promise<string> {
  const raw = await crypto.subtle.exportKey('raw', key);
  return bufToHex(raw);
}

export async function signEd25519(
  privateKey: CryptoKey,
  message: string,
): Promise<string> {
  const sig = await crypto.subtle.sign(
    'Ed25519',
    privateKey,
    new TextEncoder().encode(message),
  );
  return bufToHex(sig);
}

export async function verifyEd25519(
  publicKey: CryptoKey,
  message: string,
  signatureHex: string,
): Promise<boolean> {
  try {
    return await crypto.subtle.verify(
      'Ed25519',
      publicKey,
      hexToBuf(signatureHex),
      new TextEncoder().encode(message),
    );
  } catch {
    return false;
  }
}

export async function importPublicKeyHex(hex: string): Promise<CryptoKey> {
  return crypto.subtle.importKey(
    'raw',
    hexToBuf(hex),
    { name: 'Ed25519' },
    true,
    ['verify'],
  );
}
```

### 2.4 `src/utils/merkle.ts` — Merkle Tree real

```typescript
// Merkle Tree real con SHA-256.
// Construye niveles, genera pruebas y verifica pertenencia.

import { sha256Hex } from './crypto';
import type { MerkleProofStep } from '../types';

export interface MerkleTree {
  levels: string[][]; // levels[0] = hojas hasheadas, última = raíz única
  root: string;
  leaves: string[]; // contenido original de las hojas
}

/**
 * Construye un Merkle Tree.
 * Si el número de nodos en un nivel es impar, el último se duplica.
 */
export async function buildMerkleTree(leaves: string[]): Promise<MerkleTree> {
  if (leaves.length === 0) {
    const empty = await sha256Hex('');
    return { levels: [[empty]], root: empty, leaves: [] };
  }

  const hashedLeaves = await Promise.all(leaves.map((l) => sha256Hex(l)));
  const levels: string[][] = [hashedLeaves];

  let current = hashedLeaves;
  while (current.length > 1) {
    const next: string[] = [];
    for (let i = 0; i < current.length; i += 2) {
      const left = current[i];
      const right = current[i + 1] ?? current[i]; // duplica si impar
      next.push(await sha256Hex(left + right));
    }
    levels.push(next);
    current = next;
  }

  return { levels, root: current[0], leaves };
}

/**
 * Genera la prueba de pertenencia para la hoja en `index`.
 * Devuelve los hashes hermanos con su posición (izquierda/derecha).
 */
export function getMerkleProof(tree: MerkleTree, index: number): MerkleProofStep[] {
  if (index < 0 || index >= tree.levels[0].length) {
    throw new Error(`Índice ${index} fuera de rango`);
  }
  const proof: MerkleProofStep[] = [];
  let idx = index;

  for (let level = 0; level < tree.levels.length - 1; level++) {
    const nodes = tree.levels[level];
    const isRight = idx % 2 === 1;
    const siblingIdx = isRight ? idx - 1 : idx + 1;
    const sibling = nodes[siblingIdx] ?? nodes[idx];
    proof.push({ hash: sibling, position: isRight ? 'left' : 'right' });
    idx = Math.floor(idx / 2);
  }

  return proof;
}

/** Verifica que `leaf` pertenece al árbol con raíz `root`. */
export async function verifyMerkleProof(
  leaf: string,
  proof: MerkleProofStep[],
  root: string,
): Promise<boolean> {
  let current = await sha256Hex(leaf);
  for (const step of proof) {
    current =
      step.position === 'left'
        ? await sha256Hex(step.hash + current)
        : await sha256Hex(current + step.hash);
  }
  return current === root;
}
```

### 2.5 `src/utils/timestamp.ts` — sellos de tiempo

```typescript
// Sello de tiempo: contenido + timestamp + hash + firma opcional.
// Uso educativo. No es un TSA RFC 3161 real.

import { sha256Hex, signEd25519, verifyEd25519 } from './crypto';
import type { TimestampedRecord } from '../types';

export async function createTimestamp(
  content: string,
  privateKey?: CryptoKey,
): Promise<TimestampedRecord> {
  const timestamp = new Date().toISOString();
  const hash = await sha256Hex(`${timestamp}|${content}`);
  const record: TimestampedRecord = { content, timestamp, hash };
  if (privateKey) {
    record.signatureHex = await signEd25519(privateKey, hash);
  }
  return record;
}

export async function verifyTimestamp(
  record: TimestampedRecord,
  publicKey?: CryptoKey,
): Promise<{ hashOk: boolean; signatureOk: boolean | null }> {
  const expected = await sha256Hex(`${record.timestamp}|${record.content}`);
  const hashOk = expected === record.hash;

  let signatureOk: boolean | null = null;
  if (publicKey && record.signatureHex) {
    signatureOk = await verifyEd25519(publicKey, record.hash, record.signatureHex);
  }

  return { hashOk, signatureOk };
}
