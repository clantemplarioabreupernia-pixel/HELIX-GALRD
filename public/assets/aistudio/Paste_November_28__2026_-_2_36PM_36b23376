import { useState } from 'react';
import {
  sha256Hex,
  sha512Hex,
  hmacSha256,
  generateEd25519KeyPair,
  exportPublicKeyHex,
  signEd25519,
  importPublicKeyHex,
  verifyEd25519,
} from '../utils/crypto';
import { buildMerkleTree, getMerkleProof, verifyMerkleProof } from '../utils/merkle';
import type { MerkleTree, MerkleProofStep } from '../types';

type Tab = 'hash' | 'hmac' | 'sign' | 'merkle';

export default function CryptoLab() {
  const [tab, setTab] = useState<Tab>('hash');

  return (
    <section>
      <h2>Crypto Playground</h2>
      <p style={{ color: '#555', marginTop: 0 }}>
        Todo se ejecuta con Web Crypto API real. Sin simulaciones.
      </p>

      <nav style={{ display: 'flex', gap: 8, marginBottom: 16 }}>
        <TabBtn active={tab === 'hash'} onClick={() => setTab('hash')}>Hash</TabBtn>
        <TabBtn active={tab === 'hmac'} onClick={() => setTab('hmac')}>HMAC</TabBtn>
        <TabBtn active={tab === 'sign'} onClick={() => setTab('sign')}>Ed25519</TabBtn>
        <TabBtn active={tab === 'merkle'} onClick={() => setTab('merkle')}>Merkle</TabBtn>
      </nav>

      {tab === 'hash' && <HashDemo />}
      {tab === 'hmac' && <HmacDemo />}
      {tab === 'sign' && <SignDemo />}
      {tab === 'merkle' && <MerkleDemo />}
    </section>
  );
}

function HashDemo() {
  const [input, setInput] = useState('crypto');
  const [sha256, setSha256] = useState('');
  const [sha512, setSha512] = useState('');

  const run = async () => {
    setSha256(await sha256Hex(input));
    setSha512(await sha512Hex(input));
  };

  return (
    <div>
      <input value={input} onChange={(e) => setInput(e.target.value)} style={inputStyle} />
      <button onClick={run} style={btnPrimary}>Hashear</button>
      {sha256 && <p style={mono}><strong>SHA-256:</strong> {sha256}</p>}
      {sha512 && <p style={mono}><strong>SHA-512:</strong> {sha512}</p>}
    </div>
  );
}

function HmacDemo() {
  const [key, setKey] = useState('lab-key');
  const [msg, setMsg] = useState('mensaje');
  const [mac, setMac] = useState('');

  const run = async () => setMac(await hmacSha256(key, msg));

  return (
    <div>
      <input value={key} onChange={(e) => setKey(e.target.value)} placeholder="clave" style={inputStyle} />
      <input value={msg} onChange={(e) => setMsg(e.target.value)} placeholder="mensaje" style={inputStyle} />
      <button onClick={run} style={btnPrimary}>Calcular HMAC</button>
      {mac && <p style={mono}><strong>HMAC-SHA256:</strong> {mac}</p>}
    </div>
  );
}

function SignDemo() {
  const [msg, setMsg] = useState('contrato v1');
  const [pubHex, setPubHex] = useState('');
  const [sigHex, setSigHex] = useState('');
  const [ok, setOk] = useState<boolean | null>(null);
  const [keys, setKeys] = useState<CryptoKeyPair | null>(null);

  const gen = async () => {
    const kp = await generateEd25519KeyPair();
    setKeys(kp);
    setPubHex(await exportPublicKeyHex(kp.publicKey));
    setSigHex('');
    setOk(null);
  };

  const sign = async () => {
    if (!keys) return;
    setSigHex(await signEd25519(keys.privateKey, msg));
    setOk(null);
  };

  const verify = async () => {
    if (!pubHex || !sigHex) return;
    const pub = await importPublicKeyHex(pubHex);
    setOk(await verifyEd25519(pub, msg, sigHex));
  };

  return (
    <div>
      <button onClick={gen} style={btnPrimary}>Generar par Ed25519</button>
      <input value={msg} onChange={(e) => setMsg(e.target.value)} style={inputStyle} />
      <button onClick={sign} disabled={!keys} style={btnPrimary}>Firmar</button>
      <button onClick={verify} disabled={!pubHex || !sigHex} style={btnPrimary}>Verificar</button>

      {pubHex && <p style={mono}><strong>pub:</strong> {pubHex}</p>}
      {sigHex && <p style={mono}><strong>sig:</strong> {sigHex}</p>}
