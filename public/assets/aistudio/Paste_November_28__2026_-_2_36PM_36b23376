import type { Progress } from '../types';

const KEY = 'crypto-audit-lab-progress-v1';

export function loadProgress(): Progress {
  try {
    const raw = localStorage.getItem(KEY);
    if (!raw) return { completedLessons: [], completedExercises: [] };
    const p = JSON.parse(raw) as Progress;
    return {
      completedLessons: p.completedLessons ?? [],
      completedExercises: p.completedExercises ?? [],
    };
  } catch {
    return { completedLessons: [], completedExercises: [] };
  }
}

export function saveProgress(p: Progress): void {
  localStorage.setItem(KEY, JSON.stringify(p));
}

export function markLesson(p: Progress, id: string): Progress {
  const s = new Set(p.completedLessons);
  s.add(id);
  return { ...p, completedLessons: [...s] };
}

export function markExercise(p: Progress, id: string): Progress {
  const s = new Set(p.completedExercises);
  s.add(id);
  return { ...p, completedExercises: [...s] };
}
