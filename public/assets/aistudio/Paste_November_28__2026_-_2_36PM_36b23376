interface Props {
  lesson: Lesson;
  exercises: Exercise[];
  completedExercises: string[];
  onCompleteLesson: () => void;
  onCompleteExercise: (id: string) => void;
}

function renderTheory(text: string) {
  return text.split('\n\n').map((p, i) => {
    const html = p
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\n/g, '<br/>');
    return <p key={i} style={{ lineHeight: 1.6 }} dangerouslySetInnerHTML={{ __html: html }} />;
  });
}

export default function LessonView({
  lesson, exercises, completedExercises, onCompleteLesson, onCompleteExercise,
