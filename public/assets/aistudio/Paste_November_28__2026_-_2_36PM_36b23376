function MerkleDemo() {
  const [leavesText, setLeavesText] = useState('tx1\ntx2\ntx3\ntx4');
  const [tree, setTree] = useState<MerkleTree | null>(null);
  const [proof, setProof] = useState<MerkleProofStep[] | null>(null);
  const [index, setIndex] = useState(0);
  const [verified, setVerified] = useState<boolean | null>(null);

  const build = async () => {
    const leaves = leavesText.split('\n').filter((l) => l.trim().length > 0);
    const t = await buildMerkleTree(leaves);
    setTree(t);
    setProof(null);
    setVerified(null);
  };

  const proveAndVerify = async () => {
    if (!tree) return;
    const p = getMerkleProof(tree, index);
    setProof(p);
    setVerified(await verifyMerkleProof(tree.leaves[index], p, tree.root));
  };

  return (
    <div>
      <p style={{ marginTop: 0 }}>Hojas (una por línea):</p>
      <textarea
        value={leavesText}
        onChange={(e) => setLeavesText(e.target.value)}
        rows={5}
        style={{ width: '100%', fontFamily: 'monospace' }}
      />
      <button onClick={build} style={btnPrimary}>Construir árbol</button>

      {tree && (
        <>
          <p style={mono}><strong>Raíz:</strong> {tree.root}</p>
          <p style={mono}><strong>Niveles:</strong> {tree.levels.length}</p>
          <label>
            Índice a probar:
            <input
              type="number"
              min={0}
              max={tree.leaves.length - 1}
              value={index}
              onChange={(e) => setIndex(Number(e.target.value))}
              style={{ width: 60, marginLeft: 8 }}
            />
          </label>
          <button onClick={proveAndVerify} style={{ ...btnPrimary, marginLeft: 8 }}>
            Probar pertenencia
          </button>
        </>
      )}

      {proof && (
        <>
          <p style={mono}><strong>Prueba ({proof.length} pasos):</strong></p>
          <ul style={mono}>
            {proof.map((p, i) => (
              <li key={i}>{p.position}: {p.hash.slice(0, 16)}…</li>
            ))}
          </ul>
          {verified !== null && (
            <p style={{ color: verified ? '#0a7' : '#c33', fontWeight: 600 }}>
              {verified ? '✓ Pertenencia verificada' : '✗ No pertenece'}
            </p>
          )}
        </>
      )}
    </div>
  );
}

