```tsx
import { useState } from 'react';
import type { Exercise } from '../types';
import { hmacSha256 } from '../utils/crypto';

interface Props {
  exercise: Exercise;
  done: boolean;
  onCorrect: () => void;
}

export default function ExerciseView({ exercise, done, onCorrect }: Props) {
  const [selected, setSelected] = useState<number | null>(null);
  const [code, setCode] = useState(exercise.kind === 'code' ? exercise.starter : '');
  const [results, setResults] = useState<{ input: string; ok: boolean }[] | null>(null);
  const [error, setError] = useState<string | null>(null);

  if (exercise.kind === 'multiple-choice') {
    const correct = selected === exercise.correctIndex;
    return (
      <div style={card}>
        <p><strong>[{exercise.id}]</strong> {exercise.prompt}</p>
        {exercise.options.map((opt, i) => (
          <label key={i} style={{ display: 'block', marginBottom: 4 }}>
            <input
              type="radio"
              name={exercise.id}
              checked={selected === i}
              onChange={() => setSelected(i)}
              disabled={done}
            />{' '}{opt}
          </label>
        ))}
        {!done && (
          <button
            disabled={selected === null}
            onClick={() => { if (correct) onCorrect(); }}
          >
            Comprobar
          </button>
        )}
        {done && <p style={{ color: '#0a7' }}>✓ Correcto. {exercise.explanation}</p>}
        {!done && selected !== null && !correct && (
          <p style={{ color: '#c33' }}>Incorrecto.</p>
        )}
      </div>
    );
  }

  const run = async () => {
    setError(null);
    setResults(null);
    try {
      // eslint-disable-next-line no-new-func
      const fn = new Function(
        'hmacSha256',
        `"use strict"; return (${code});`,
      )(hmacSha256) as (input: string) => Promise<string>;

      const rows: { input: string; ok: boolean }[] = [];
      let allOk = true;
      for (const t of exercise.tests) {
        const expected = t.expected ?? (await hmacSha256('lab-key', t.input));
        const got = await fn(t.input);
        const ok = got === expected;
        if (!ok) allOk = false;
        rows.push({ input: t.input, ok });
      }
      setResults(rows);
      if (allOk) onCorrect();
    } catch (e) {
      setError(e instanceof Error ? e.message : String(e));
    }
  };

  return (
    <div style={card}>
      <p><strong>[{exercise.id}]</strong> {exercise.prompt}</p>
      <textarea
        value={code}
        onChange={(e) => setCode(e.target.value)}
        rows={8}
        disabled={done}
        style={{ width: '100%', fontFamily: 'monospace', fontSize: 12 }}
      />
      {!done && <button onClick={run}>Ejecutar pruebas</button>}
      {done && <p style={{ color: '#0a7' }}>✓ Superado. {exercise.explanation}</p>}
      {error && <p style={{ color: '#c33' }}>Error: {error}</p>}
      {results && (
        <ul style={{ fontSize: 12 }}>
          {results.map((r, i) => (
            <li key={i} style={{ color: r.ok ? '#0a7' : '#c33' }}>
              {JSON.stringify(r.input)}: {r.ok ? 'OK' : 'FALLO'}
            </li>
          ))}
        </ul>
      )}
    </div>
  );
}

const card: React.CSSProperties = {
  border: '1px solid #eee', borderRadius: 6, padding: 12,
  marginBottom: 12, background: '#fafafa',
};
