// src/components/SatelliteLinkPanel.tsx
import { useMemo, useState } from "react";
import {
  LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer,
} from "recharts";
import { calculateSatelliteAttenuation, sweepElevation } from "../utils/ituP676";

export function SatelliteLinkPanel() {
  const [frequencyGHz, setFrequencyGHz] = useState(22);
  const [elevationDeg, setElevationDeg] = useState(30);
  const [stationAltitudeKm, setStationAltitudeKm] = useState(0);
  const [temperatureC, setTemperatureC] = useState(15);
  const [pressureHPa, setPressureHPa] = useState(1013.25);
  const [waterVapor, setWaterVapor] = useState(7.5);

  const result = useMemo(
    () => calculateSatelliteAttenuation({
      frequencyGHz, elevationDeg, stationAltitudeKm,
      surfaceTemperatureC: temperatureC, surfacePressureHPa: pressureHPa,
      waterVaporDensityGm3: waterVapor,
    }),
    [frequencyGHz, elevationDeg, stationAltitudeKm, temperatureC, pressureHPa, waterVapor]
  );

  const sweep = useMemo(
    () => sweepElevation(
      { frequencyGHz, stationAltitudeKm, surfaceTemperatureC: temperatureC,
        surfacePressureHPa: pressureHPa, waterVaporDensityGm3: waterVapor },
      90
    ),
    [frequencyGHz, stationAltitudeKm, temperatureC, pressureHPa, waterVapor]
  );

  return (
    <div>
      <h2>Enlace Satelital — ITU-R P.676</h2>

      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))", gap: 12 }}>
        <Num label="Frecuencia (GHz)" v={frequencyGHz} s={0.5} on={setFrequencyGHz} />
        <Num label="Elevación (°)" v={elevationDeg} s={1} on={setElevationDeg} />
        <Num label="Altitud estación (km)" v={stationAltitudeKm} s={0.1} on={setStationAltitudeKm} />
        <Num label="Temperatura (°C)" v={temperatureC} s={1} on={setTemperatureC} />
        <Num label="Presión (hPa)" v={pressureHPa} s={1} on={setPressureHPa} />
        <Num label="Vapor H₂O (g/m³)" v={waterVapor} s={0.5} on={setWaterVapor} />
      </div>

      <div style={{ border: "1px solid #ddd", borderRadius: 8, padding: 16, marginTop: 16 }}>
        <Row k="γ O₂" v={`${result.oxygenSpecificDbPerKm.toExponential(3)} dB/km`} />
        <Row k="γ H₂O" v={`${result.waterVaporSpecificDbPerKm.toExponential(3)} dB/km`} />
        <Row k="h O₂" v={`${result.oxygenEquivalentHeightKm.toFixed(2)} km`} />
        <Row k="h H₂O" v={`${result.waterVaporEquivalentHeightKm.toFixed(2)} km`} />
        <Row k="A cenital" v={`${result.zenithAttenuationDb.toFixed(3)} dB`} />
        <Row k="A slant" v={`${result.slantAttenuationDb.toFixed(3)} dB`} />
      </div>

      <h3 style={{ marginTop: 24 }}>Atenuación slant vs elevación</h3>
      <ResponsiveContainer width="100%" height={300}>
        <LineChart data={sweep} margin={{ top: 8, right: 16, left: 8, bottom: 24 }}>
          <CartesianGrid strokeDasharray="3 3" />
          <XAxis dataKey="elevationDeg"
            label={{ value: "Elevación (°)", position: "insideBottom", offset: -12 }} />
          <YAxis label={{ value: "A_slant (dB)", angle: -90, position: "insideLeft" }} />
          <Tooltip formatter={(v: number) => `${v.toFixed(3)} dB`} />
          <Line type="monotone" dataKey="slantAttenuationDb" stroke="#2563eb" dot={false} strokeWidth={2} />
        </LineChart>
      </ResponsiveContainer>
    </div>
  );
}

function Num({ label, v, s, on }: { label: string; v: number; s: number; on: (n: number) => void }) {
  return (
    <label style={{ display: "flex", flexDirection: "column", fontSize: 14 }}>
      <span>{label}</span>
      <input type="number" value={v} step={s} onChange={(e) => on(Number(e.target.value))}
        style={{ padding: 6, marginTop: 4 }} />
    </label>
  );
}
function Row({ k, v }: { k: string; v: string }) {
  return (
    <div style={{ display: "flex", justifyContent: "space-between", padding: "2px 0" }}>
      <span style={{ color: "#555" }}>{k}</span><strong>{v}</strong>
    </div>
  );
}
