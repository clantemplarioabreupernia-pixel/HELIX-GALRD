  const [targets, setTargets] = useState<RadarTarget[]>(DEFAULT_TARGETS);
  const [pfa, setPfa] = useState(1e-4);

  const { rd, detections } = useMemo(
    () => runFmcwPipeline(DEFAULT_PARAMS, targets, pfa),
    [targets, pfa]
  );

  const eq = useMemo(
    () => calculateRadarEquation({
      txPowerDbm: 10,
      txGainDbi: 20,
      rxGainDbi: 20,
      frequencyGHz: DEFAULT_PARAMS.carrierGHz,
      targetRcsM2: 1,
      rangeM: 30,
      systemLossDb: 3,
      bandwidthHz: DEFAULT_PARAMS.sampleRateHz,
      noiseFigureDb: 10,
      atmosphericLossDbPerKm: 0.4,
    }),
    []
  );

  // Perfil de rango: tomar la fila Doppler central
  const central = Math.floor(rd.matrix.length / 2);
  const rangeProfile = rd.rangeAxisM.map((r, i) => ({
    rangeM: r,
    magnitudeDb: rd.matrix[central][i],
  }));

  return (
    <div>
      <h2>Radar Automotriz 77 GHz — FMCW</h2>

      <div style={{ border: "1px solid #ddd", borderRadius: 8, padding: 16 }}>
        <div style={{ display: "flex", justifyContent: "space-between" }}>
          <span style={{ color: "#555" }}>λ</span>
          <strong>{(eq.wavelengthM * 1000).toFixed(3)} mm</strong>
        </div>
        <div style={{ display: "flex", justifyContent: "space-between" }}>
          <span style={{ color: "#555" }}>Pr @ 30 m (RCS 1 m²)</span>
          <strong>{eq.receivedPowerDbm.toFixed(2)} dBm</strong>
        </div>
        <div style={{ display: "flex", justifyContent: "space-between" }}>
          <span style={{ color: "#555" }}>SNR @ 30 m</span>
          <strong>{eq.snrDb.toFixed(2)} dB</strong>
        </div>
        <div style={{ display: "flex", justifyContent: "space-between" }}>
          <span style={{ color: "#555" }}>Rango máx (SNR ≥ 13 dB)</span>
          <strong>{eq.maxRangeM.toFixed(1)} m</strong>
        </div>
      </div>

      <h3 style={{ marginTop: 24 }}>Perfil de rango (Doppler central)</h3>
      <ResponsiveContainer width="100%" height={280}>
        <LineChart data={rangeProfile} margin={{ top: 8, right: 16, left: 8, bottom: 24 }}>
          <CartesianGrid strokeDasharray="3 3" />
          <XAxis dataKey="rangeM"
            label={{ value: "Rango (m)", position: "insideBottom", offset: -12 }} />
          <YAxis label={{ value: "Magnitud (dB)", angle: -90, position: "insideLeft" }} />
          <Tooltip formatter={(v: number) => `${v.toFixed(2)} dB`} />
          <Line type="monotone" dataKey="magnitudeDb" stroke="#2563eb" dot={false} strokeWidth={2} />
        </LineChart>
      </ResponsiveContainer>

      <h3 style={{ marginTop: 24 }}>Detecciones CFAR ({detections.length})</h3>
      <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 14 }}>
        <thead>
          <tr style={{ borderBottom: "1px solid #ddd" }}>
            <th style={{ textAlign: "left", padding: 6 }}>Rango (m)</th>
            <th style={{ textAlign: "left", padding: 6 }}>Velocidad (m/s)</th>
            <th style={{ textAlign: "left", padding: 6 }}>Magnitud (dB)</th>
          </tr>
        </thead>
        <tbody>
          {detections.slice(0, 12).map((d, i) => (
            <tr key={i} style={{ borderBottom: "1px solid #f0f0f0" }}>
              <td style={{ padding: 6 }}>{d.rangeM.toFixed(2)}</td>
              <td style={{ padding: 6 }}>{d.velocityMps.toFixed(2)}</td>
              <td style={{ padding: 6 }}>{d.magnitudeDb.toFixed(2)}</td>
            </tr>
          ))}
          {detections.length === 0 && (
            <tr><td colSpan={3} style={{ padding: 6, color: "#888" }}>Sin detecciones</td></tr>
          )}
        </tbody>
      </table>

      <h3 style={{ marginTop: 24 }}>PFA (prob. falsa alarma)</h3>
      <input type="range" min={-6} max={-1} step={0.1}
        value={Math.log10(pfa)}
        onChange={(e) => setPfa(Math.pow(10, Number(e.target.value)))}
        style={{ width: "100%" }} />
      <div style={{ color: "#555" }}>PFA = {pfa.toExponential(1)}</div>

      <h3 style={{ marginTop: 24 }}>Objetivos simulados</h3>
      {targets.map((t, i) => (
        <div key={i} style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 8, marginBottom: 6 }}>
          <Num label={`Rango #${i + 1} (m)`} v={t.rangeM}
            on={(v) => setTargets((p) => p.map((x, j) => j === i ? { ...x, rangeM: v } : x))} />
          <Num label="Vel (m/s)" v={t.velocityMps}
            on={(v) => setTargets((p) => p.map((x, j) => j === i ? { ...x, velocityMps: v } : x))} />
          <Num label="RCS (m²)" v={t.rcsM2}
            on={(v) => setTargets((p) => p.map((x, j) => j === i ? { ...x, rcsM2: v } : x))} />
        </div>
      ))}
    </div>
  );
}

function Num({ label, v, on }: { label: string; v: number; on: (n: number) => void }) {
  return (
    <label style={{ display: "flex", flexDirection: "column", fontSize: 13 }}>
      <span>{label}</span>
      <input type="number" value={v} step={1} onChange={(e) => on(Number(e.target.value))}
        style={{ padding: 4, marginTop: 2 }} />
    </label>
  );
}
