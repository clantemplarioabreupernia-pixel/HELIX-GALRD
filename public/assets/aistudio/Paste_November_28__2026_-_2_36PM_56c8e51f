## 📁 ARCHIVO 3 — `src/utils/fft.ts` (UTILIDAD)

FFT radix-2 iterativa (Cooley–Tukey), sin dependencias.

```typescript
// src/utils/fft.ts
// FFT/IFFT radix-2 iterativa (Cooley–Tukey). Solo longitudes potencia de 2.

export interface ComplexArray {
  re: Float64Array;
  im: Float64Array;
}

export function isPowerOfTwo(n: number): boolean {
  return n > 0 && (n & (n - 1)) === 0;
}

export function nextPowerOfTwo(n: number): number {
  let p = 1;
  while (p < n) p <<= 1;
  return p;
}

export function fft(input: ComplexArray): ComplexArray {
  const n = input.re.length;
  if (!isPowerOfTwo(n)) throw new Error("FFT: tamaño debe ser potencia de 2");

  const re = new Float64Array(input.re);
  const im = new Float64Array(input.im);

  // Bit-reversal permutation
  for (let i = 1, j = 0; i < n; i++) {
    let bit = n >> 1;
    for (; j & bit; bit >>= 1) j ^= bit;
    j ^= bit;
    if (i < j) {
      [re[i], re[j]] = [re[j], re[i]];
      [im[i], im[j]] = [im[j], im[i]];
    }
  }

  for (let len = 2; len <= n; len <<= 1) {
    const ang = (-2 * Math.PI) / len;
    const wRe = Math.cos(ang);
    const wIm = Math.sin(ang);
    for (let i = 0; i < n; i += len) {
      let curRe = 1;
      let curIm = 0;
      for (let k = 0; k < len / 2; k++) {
        const uRe = re[i + k];
        const uIm = im[i + k];
        const vRe = re[i + k + len / 2] * curRe - im[i + k + len / 2] * curIm;
        const vIm = re[i + k + len / 2] * curIm + im[i + k + len / 2] * curRe;
        re[i + k] = uRe + vRe;
        im[i + k] = uIm + vIm;
        re[i + k + len / 2] = uRe - vRe;
        im[i + k + len / 2] = uIm - vIm;
        const tmpRe = curRe * wRe - curIm * wIm;
        curIm = curRe * wIm + curIm * wRe;
        curRe = tmpRe;
      }
    }
  }

  return { re, im };
}

export function magnitudeDb(c: ComplexArray, floor = -120): Float64Array {
  const n = c.re.length;
  const out = new Float64Array(n);
  for (let i = 0; i < n; i++) {
    const mag = Math.sqrt(c.re[i] * c.re[i] + c.im[i] * c.im[i]);
    out[i] = Math.max(20 * Math.log10(mag + 1e-12), floor);
  }
  return out;
}

export function fftshift(arr: Float64Array): Float64Array {
  const n = arr.length;
  const half = n >> 1;
  const out = new Float64Array(n);
  for (let i = 0; i < n; i++) {
    out[i] = arr[(i + half) % n];
  }
  return out;
}

// FFT a lo largo de cada fila de una matriz (2D FFT por filas → columnas)
export function fft2d(rows: ComplexArray[]): ComplexArray[] {
  const rowTransformed = rows.map((r) => fft(r));
  const nRows = rows.length;
  const nCols = rows[0].re.length;

  // Transponer → FFT por columnas → transponer de vuelta
  const cols: ComplexArray[] = [];
  for (let c = 0; c < nCols; c++) {
    const re = new Float64Array(nRows);
    const im = new Float64Array(nRows);
    for (let r = 0; r < nRows; r++) {
      re[r] = rowTransformed[r].re[c];
      im[r] = rowTransformed[r].im[c];
    }
    cols.push(fft({ re, im }));
  }

  const out: ComplexArray[] = [];
  for (let r = 0; r < nRows; r++) {
    const re = new Float64Array(nCols);
    const im = new Float64Array(nCols);
    for (let c = 0; c < nCols; c++) {
      re[c] = cols[c].re[r];
      im[c] = cols[c].im[r];
    }
    out.push({ re, im });
  }
  return out;
}
