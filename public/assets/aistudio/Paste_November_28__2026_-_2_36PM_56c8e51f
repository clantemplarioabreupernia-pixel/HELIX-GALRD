// 3. Alturas equivalentes (P.676 §2.1)
// ─────────────────────────────────────────────────────────────
export function equivalentHeights(
  frequencyGHz: number,
  pressureHPa: number,
  temperatureC: number,
  waterVaporDensityGm3: number
): { hOxygenKm: number; hWaterVaporKm: number } {
  const rp = pressureHPa / 1013.25;
  const hOxygenKm = 6.1 / (1 + 0.17 * Math.pow(rp, -1.1)) *
    (1 + 0.0 * frequencyGHz); // Ajuste dependiente de frecuencia omitido por brevedad
  const hWaterVaporKm = 1.6 / (1 + 0.1 * Math.pow(rp, -1.1)) *
    (1 + 0.0 * frequencyGHz);
  return { hOxygenKm, hWaterVaporKm };
}

// ─────────────────────────────────────────────────────────────
// 4. Atenuación total cenital y slant path
// ─────────────────────────────────────────────────────────────
export function calculateSatelliteAttenuation(
  p: SatelliteParams
): SatelliteAttenuationResult {
  const gammaO = specificAttenuationOxygen(
    p.frequencyGHz, p.surfacePressureHPa, p.surfaceTemperatureC, p.waterVaporDensityGm3
  );
  const gammaW = specificAttenuationWaterVapor(
    p.frequencyGHz, p.surfacePressureHPa, p.surfaceTemperatureC, p.waterVaporDensityGm3
  );

  const { hOxygenKm, hWaterVaporKm } = equivalentHeights(
    p.frequencyGHz, p.surfacePressureHPa, p.surfaceTemperatureC, p.waterVaporDensityGm3
  );

  // Reducción por altitud de la estación (P.676 §2.2)
  const rO = Math.exp(-p.stationAltitudeKm / hOxygenKm);
  const rW = Math.exp(-p.stationAltitudeKm / hWaterVaporKm);

  const zenithDb = gammaO * hOxygenKm * rO + gammaW * hWaterVaporKm * rW;

  // Slant path: A_slant ≈ A_zenith / sin(el)
  const el = Math.max(p.elevationDeg, 5);
  const slantDb = zenithDb / Math.sin((el * Math.PI) / 180);

  return {
    oxygenSpecificDbPerKm: gammaO,
    waterVaporSpecificDbPerKm: gammaW,
    oxygenEquivalentHeightKm: hOxygenKm,
    waterVaporEquivalentHeightKm: hWaterVaporKm,
    zenithAttenuationDb: zenithDb,
    slantAttenuationDb: slantDb,
  };
}

// ─────────────────────────────────────────────────────────────
// 5. Barrido de atenuación vs elevación
// ─────────────────────────────────────────────────────────────
export function sweepElevation(
  base: Omit<SatelliteParams, "elevationDeg">,
  steps: number = 90
): SatelliteSweepPoint[] {
  const out: SatelliteSweepPoint[] = [];
  for (let i = 0; i < steps; i++) {
    const el = 5 + (i * (90 - 5)) / Math.max(1, steps - 1);
    const r = calculateSatelliteAttenuation({ ...base, elevationDeg: el });
    out.push({ elevationDeg: el, slantAttenuationDb: r.slantAttenuationDb });
  }
  return out;
}
