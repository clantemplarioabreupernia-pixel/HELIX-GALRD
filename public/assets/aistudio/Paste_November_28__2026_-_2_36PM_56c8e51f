## 📁 ARCHIVO 5 — `src/utils/fmcwRadar.ts` (FASE 2)

Pipeline FMCW completo: chirps → beat signal → FFT 1D (rango) → FFT 2D (Range-Doppler) → CA-CFAR.

```typescript
// src/utils/fmcwRadar.ts
// Radar FMCW completo: generación de chirps, simulación de eco,
// Range-Doppler 2D y detección CA-CFAR.

import { fft, fftshift, magnitudeDb, type ComplexArray } from "./fft";
import type {
  FmcwParams,
  RadarTarget,
  RangeDopplerMatrix,
  CfarDetection,
} from "../types";

const C_M_S = 299_792_458;

// ─────────────────────────────────────────────────────────────
// 1. Simular beat signal (mezcla Tx·Rx) para un objetivo
//    f_beat = (2·B·R)/(c·T_c) + (2·v·fc)/c
// ─────────────────────────────────────────────────────────────
export function simulateBeatSignal(
  params: FmcwParams,
  targets: RadarTarget[]
): ComplexArray[] {
  const { numChirps, numSamplesPerChirp, chirpTimeS, bandwidthHz, sampleRateHz, carrierGHz } = params;
  const slope = bandwidthHz / chirpTimeS; // Hz/s
  const fc = carrierGHz * 1e9;
  const lambda = C_M_S / fc;

  const chirps: ComplexArray[] = [];
  for (let chirp = 0; chirp < numChirps; chirp++) {
    const re = new Float64Array(numSamplesPerChirp);
    const im = new Float64Array(numSamplesPerChirp);
    const slowTime = chirp * chirpTimeS;

    for (let n = 0; n < numSamplesPerChirp; n++) {
      const t = n / sampleRateHz;
      let sumRe = 0;
      let sumIm = 0;

      for (const tgt of targets) {
        const tau = (2 * tgt.rangeM) / C_M_S;
        const fBeat = slope * tau;
        const fDop = (2 * tgt.velocityMps) / lambda;
        // Amplitud proporcional a sqrt(RCS) / R²
        const amp = Math.sqrt(tgt.rcsM2) / Math.max(tgt.rangeM * tgt.rangeM, 1);
        const phase = 2 * Math.PI * ((fBeat + fDop) * t + fDop * slowTime);
        sumRe += amp * Math.cos(phase);
        sumIm += amp * Math.sin(phase);
      }

      // Ruido térmico gaussiano (aproximado con Box-Muller)
      const [nRe, nIm] = gaussianPair();
      re[n] = sumRe + 1e-4 * nRe;
      im[n] = sumIm + 1e-4 * nIm;
    }

    chirps.push({ re, im });
  }
  return chirps;
}

function gaussianPair(): [number, number] {
  const u1 = Math.random() || 1e-12;
  const u2 = Math.random();
  const mag = Math.sqrt(-2 * Math.log(u1));
  return [mag * Math.cos(2 * Math.PI * u2), mag * Math.sin(2 * Math.PI * u2)];
}

// ─────────────────────────────────────────────────────────────
// 2. Range-Doppler 2D (FFT rango → FFT Doppler → fftshift)
// ─────────────────────────────────────────────────────────────
export function computeRangeDoppler(
  params: FmcwParams,
  chirps: ComplexArray[]
): RangeDopplerMatrix {
  const { numSamplesPerChirp, numChirps, sampleRateHz, chirpTimeS, bandwidthHz } = params;

  // FFT por chirp (eje rápido → rango)
  const rangeFfts = chirps.map((c) => fft(c));

  // Transponer a columnas por índice de rango y hacer FFT Doppler
  const rdMatrix: number[][] = [];
  for (let d = 0; d < numChirps; d++) {
    rdMatrix.push(new Array(numSamplesPerChirp).fill(-120));
  }

  for (let r = 0; r < numSamplesPerChirp; r++) {
    const re = new Float64Array(numChirps);
    const im = new Float64Array(numChirps);
    for (let c = 0; c < numChirps; c++) {
      re[c] = rangeFfts[c].re[r];
      im[c] = rangeFfts[c].im[r];
    }
    const dopFft = fft({ re, im });
    const dopMagDb = fftshift(magnitudeDb(dopFft, -120));
    for (let d = 0; d < numChirps; d++) {
      rdMatrix[d][r] = dopMagDb[d];
    }
  }

  // Ejes físicos
  const rangeResolution = C_M_S / (2 * bandwidthHz);
  const rangeAxisM: number[] = [];
  for (let r = 0; r < numSamplesPerChirp; r++) {
    rangeAxisM.push(r * rangeResolution);
  }

  const lambda = C_M_S / (params.carrierGHz * 1e9);
  const dopplerRes = lambda / (2 * numChirps * chirpTimeS);
  const velocityAxisMps: number[] = [];
  for (let d = 0; d < numChirps; d++) {
    velocityAxisMps.push((d - numChirps / 2) * dopplerRes);
  }

  return { matrix: rdMatrix, rangeAxisM, velocityAxisMps };
}

// ─────────────────────────────────────────────────────────────
// 3. CA-CFAR 2D (Cell-Averaging CFAR)
//    Para cada celda, promedia celdas vecinas (training) excluyendo
//    la celda bajo prueba y las guard cells. Umbral = α·noise.
// ─────────────────────────────────────────────────────────────
export function cfar2d(
  rd: RangeDopplerMatrix,
  guardCells: number = 2,
  trainingCells: number = 6,
  pfa: number = 1e-4
): CfarDetection[] {
  const { matrix, rangeAxisM, velocityAxisMps } = rd;
  const nD = matrix.length;
  const nR = matrix[0].length;
  const detections: CfarDetection[] = [];

  const N = Math.pow(2 * (guardCells + trainingCells) + 1, 2) - Math.pow(2 * guardCells + 1, 2);
  const alpha = N * (Math.pow(pfa, -1 / N) - 1);

  for (let d = guardCells + trainingCells; d < nD - guardCells - trainingCells; d++) {
    for (let r = guardCells + trainingCells; r < nR - guardCells - trainingCells; r++) {
      const cut = matrix[d][r];
      let sum = 0;
      let count = 0;
      for (let dd = -trainingCells - guardCells; dd <= trainingCells + guardCells; dd++) {
        for (let rr = -trainingCells - guardCells; rr <= trainingCells + guardCells; rr++) {
          if (Math.abs(dd) <= guardCells && Math.abs(rr) <= guardCells) continue;
          sum += Math.pow(10, matrix[d + dd][r + rr] / 10);
          count++;
        }
      }
      const noise = sum / count;
      const thresholdLin = alpha * noise;
      const cutLin = Math.pow(10, cut / 10);
      if (cutLin > thresholdLin) {
        detections.push({
          dopplerIdx: d,
          rangeIdx: r,
          rangeM: rangeAxisM[r],
          velocityMps: velocityAxisMps[d],
          magnitudeDb: cut,
        });
      }
    }
  }
  return detections;
}

// ─────────────────────────────────────────────────────────────
// 4. Pipeline completo
// ─────────────────────────────────────────────────────────────
export function runFmcwPipeline(
  params: FmcwParams,
  targets: RadarTarget[],
  pfa: number = 1e-4
): { rd: RangeDopplerMatrix; detections: CfarDetection[] } {
  const chirps = simulateBeatSignal(params, targets);
  const rd = computeRangeDoppler(params, chirps);
  const detections = cfar2d(rd, 2, 6, pfa);
  return { rd, detections };
}
