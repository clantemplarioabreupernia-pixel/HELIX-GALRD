// src/utils/radarEquation.ts
// Ecuación de radar clásica aplicada a 77 GHz (radar automotriz).
// Pr = Pt·G²·λ²·σ / ((4π)³·R⁴·L)

const C_M_S = 299_792_458;
const BOLTZMANN = 1.380649e-23;
const T0_K = 290;

export interface RadarEquationParams {
  txPowerDbm: number;
  txGainDbi: number;
  rxGainDbi: number;
  frequencyGHz: number;
  targetRcsM2: number;
  rangeM: number;
  systemLossDb: number;
  bandwidthHz: number;
  noiseFigureDb: number;
  atmosphericLossDbPerKm: number;
}

export interface RadarEquationResult {
  wavelengthM: number;
  receivedPowerDbm: number;
  noiseFloorDbm: number;
  snrDb: number;
  maxRangeM: number;
}

export function wavelength(frequencyGHz: number): number {
  return C_M_S / (frequencyGHz * 1e9);
}

export function calculateRadarEquation(
  p: RadarEquationParams
): RadarEquationResult {
  const lambda = wavelength(p.frequencyGHz);
  const Pt_W = Math.pow(10, p.txPowerDbm / 10) / 1000;
  const Gt = Math.pow(10, p.txGainDbi / 10);
  const Gr = Math.pow(10, p.rxGainDbi / 10);

  // Atenuación atmosférica (ida y vuelta)
  const atmDb = 2 * p.atmosphericLossDbPerKm * (p.rangeM / 1000);
  const atmFactor = Math.pow(10, -atmDb / 10);
  const sysFactor = Math.pow(10, -p.systemLossDb / 10);

  // Pr en W
  const Pr_W =
    (Pt_W * Gt * Gr * lambda * lambda * p.targetRcsM2) /
    (Math.pow(4 * Math.PI, 3) * Math.pow(p.rangeM, 4)) *
    atmFactor *
    sysFactor;

  const Pr_dBm = 10 * Math.log10(Pr_W * 1000);

  // Ruido
  const kTB_W = BOLTZMANN * T0_K * p.bandwidthHz;
  const noiseFloorDbm = 10 * Math.log10(kTB_W * 1000) + p.noiseFigureDb;

  const snr = Pr_dBm - noiseFloorDbm;

  // Rango máximo teórico para SNR mínima (asumimos SNR_min = 13 dB para detección)
  const snrMin = 13;
  const maxRangeM = Math.pow(
    (Pt_W * Gt * Gr * lambda * lambda * p.targetRcsM2 * atmFactor * sysFactor) /
      (Math.pow(4 * Math.PI, 3) *
        Math.pow(10, (noiseFloorDbm + snrMin) / 10) / 1000),
    0.25
  );

  return {
    wavelengthM: lambda,
    receivedPowerDbm: Pr_dBm,
    noiseFloorDbm,
    snrDb: snr,
    maxRangeM,
  };
}
