## 📁 ARCHIVO 2 — `src/utils/mmWavePathLoss.ts` (FASE 1)

**Modelos 3GPP TR 38.901 (Tabla 7.4.1-1)** para UMi, InH y RMa. Validados contra el documento de NYU Wireless.

```typescript
// src/utils/mmWavePathLoss.ts
// Modelos de path loss 3GPP TR 38.901 para 5G FR2 (mmWave).
// Referencia: 3GPP TR 38.901 V17.0.0, Tabla 7.4.1-1.
// Validación: NYU Wireless mmWave channel model.

import type {
  MmWaveParams,
  MmWavePathLossResult,
  MmWaveScenario,
  MmWavePoint,
} from "../types";

const C_M_S = 299_792_458;

// ─────────────────────────────────────────────────────────────
// FSPL a 1 m: 32.4 + 20·log10(fc_GHz)
// ─────────────────────────────────────────────────────────────
export function fsplAt1m(frequencyGHz: number): number {
  return 32.4 + 20 * Math.log10(frequencyGHz);
}

// ─────────────────────────────────────────────────────────────
// Distancia de breakpoint: d_BP' = 4·hBS'·hUT'·fc/c
// ─────────────────────────────────────────────────────────────
export function breakpointDistance(
  frequencyGHz: number,
  bsHeightM: number,
  utHeightM: number
): number {
  const fc_Hz = frequencyGHz * 1e9;
  const hBS = bsHeightM - 1.0;
  const hUT = utHeightM - 1.0;
  return (4 * hBS * hUT * fc_Hz) / C_M_S;
}

// ─────────────────────────────────────────────────────────────
// Modelos por escenario (3GPP TR 38.901, Tabla 7.4.1-1)
// ─────────────────────────────────────────────────────────────
export function calculateMmWavePathLoss(
  p: MmWaveParams
): MmWavePathLossResult {
  const d = Math.max(p.distanceM, 1); // clamp mínimo 1 m
  const fc = p.frequencyGHz;
  const fspl1m = fsplAt1m(fc);
  const log10 = Math.log10;

  let pl = 0;
  let bp: number | null = null;
  let sigma = 0;

  switch (p.scenario) {
    case "UMi-LoS": {
      // PL = 32.4 + 21·log10(d) + 20·log10(fc)     (10 ≤ d ≤ d_BP')
      // PL = 32.4 + 40·log10(d) + 20·log10(fc)
      //      - 9.5·log10(d_BP'² + (hBS-hUT)²)       (d_BP' ≤ d ≤ 5 km)
      bp = breakpointDistance(fc, p.bsHeightM, p.utHeightM);
      if (d <= bp) {
        pl = 32.4 + 21 * log10(d) + 20 * log10(fc);
      } else {
        const dh = p.bsHeightM - p.utHeightM;
        pl =
          32.4 +
          40 * log10(d) +
          20 * log10(fc) -
          9.5 * log10(bp * bp + dh * dh);
      }
      sigma = 4.0;
      break;
    }
    case "UMi-NLoS": {
      // PL = 35.3·log10(d) + 22.4 + 21.3·log10(fc) - 0.3·(hUT - 1.5)
      pl =
        35.3 * log10(d) +
        22.4 +
        21.3 * log10(fc) -
        0.3 * (p.utHeightM - 1.5);
      sigma = 7.82;
      break;
    }
    case "InH-LoS": {
      // PL = 32.4 + 17.3·log10(d) + 20·log10(fc)
      pl = 32.4 + 17.3 * log10(d) + 20 * log10(fc);
      sigma = 3.0;
      break;
    }
    case "InH-NLoS": {
      // PL = 38.3·log10(d) + 17.30 + 24.9·log10(fc)
      pl = 38.3 * log10(d) + 17.3 + 24.9 * log10(fc);
      sigma = 8.03;
      break;
    }
    case "RMa-LoS": {
      // PL = 20·log10(40π·d·fc/3)
      //      + min(0.03·h^1.72, 10)·log10(d)
      //      - min(0.044·h^1.72, 14.77)
      //      + 0.002·log10(h)·d
      const h = p.bsHeightM;
      const hPow = Math.pow(h, 1.72);
      const fc_Hz = fc * 1e9;
      pl =
        20 * log10((40 * Math.PI * d * fc_Hz) / 3) +
        Math.min(0.03 * hPow, 10) * log10(d) -
        Math.min(0.044 * hPow, 14.77) +
        0.002 * log10(h) * d;
      sigma = 4.0;
      break;
    }
  }

  const appliedSigma = p.shadowingSigmaDb ?? sigma;

  return {
    fspl1mDb: fspl1m,
    pathLossDb: pl,
    breakpointDistanceM: bp,
    appliedSigmaDb: appliedSigma,
  };
}

// ─────────────────────────────────────────────────────────────
// Barrido path loss vs distancia
// ─────────────────────────────────────────────────────────────
export function sweepMmWavePathLoss(
  base: Omit<MmWaveParams, "distanceM">,
  dMinM: number,
  dMaxM: number,
  steps: number
): MmWavePoint[] {
  const out: MmWavePoint[] = [];
  const ratio = Math.pow(dMaxM / dMinM, 1 / Math.max(1, steps - 1));
  let d = dMinM;
  for (let i = 0; i < steps; i++) {
    const r = calculateMmWavePathLoss({ ...base, distanceM: d });
    out.push({ distanceM: d, pathLossDb: r.pathLossDb });
    d *= ratio;
  }
  return out;
}

// ─────────────────────────────────────────────────────────────
// Path loss con margen de shadowing (percentil)
// Asume distribución log-normal: PL_p = PL_media + Q(p)·σ
// ─────────────────────────────────────────────────────────────
export function pathLossWithShadowing(
  p: MmWaveParams,
  exceedanceProbability: number
): number {
  const r = calculateMmWavePathLoss(p);
  const q = inverseNormalCdf(1 - exceedanceProbability);
  return r.pathLossDb + q * r.appliedSigmaDb;
}

// Aproximación de Acklam para la inversa de la normal estándar
function inverseNormalCdf(p: number): number {
  const a = [
    -3.969683028665376e1, 2.209460984245205e2, -2.759285104469687e2,
    1.38357751867269e2, -3.066479806614716e1, 2.506628277459239,
  ];
  const b = [
    -5.447609879822406e1, 1.615858368580409e2, -1.556989798598866e2,
    6.680131188771972e1, -1.328068155288572e1,
  ];
  const c = [
    -7.784894002430293e-3, -3.223964580411365e-1, -2.400758277161838,
    -2.549732539343734, 4.374664141464968, 2.938163982698783,
  ];
  const d = [
    7.784695709041462e-3, 3.224671290700398e-1, 2.445134137142996,
    3.754408661907416,
  ];
  const pLow = 0.02425;
  const pHigh = 1 - pLow;

  if (p < pLow) {
    const q = Math.sqrt(-2 * Math.log(p));
    return (
      (((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5]) /
      ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1)
    );
  }
  if (p <= pHigh) {
    const q = p - 0.5;
    const r = q * q;
    return (
      ((((((a[0] * r + a[1]) * r + a[2]) * r + a[3]) * r + a[4]) * r + a[5]) *
        q) /
      (((((b[0] * r + b[1]) * r + b[2]) * r + b[3]) * r + b[4]) * r + 1)
    );
  }
  const q = Math.sqrt(-2 * Math.log(1 - p));
  return -(
    (((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5]) /
    ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1)
  );
}

// Utilidad: banda FR2 sugerida por frecuencia
export function classifyMmWaveBand(fcGHz: number): string {
  if (fcGHz >= 24.25 && fcGHz <= 29.5) return "n257 / n258 (28 GHz)";
  if (fcGHz >= 37 && fcGHz <= 40) return "n260 (39 GHz)";
  if (fcGHz >= 57 && fcGHz <= 71) return "n261 / V-Band (60 GHz)";
  return "FR2 fuera de rango típico";
}
```

