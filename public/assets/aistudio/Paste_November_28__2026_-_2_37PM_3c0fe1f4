// backend/mintSBT.js (Node.js + ethers v6)
const { ethers } = require("ethers");

const SBT_ABI = [
  "function mint(address to, string memory uri) external returns (uint256)"
];

async function mintSBT(providerUrl, privateKey, sbtAddress, userAddress, metadataUri) {
  const provider = new ethers.JsonRpcProvider(providerUrl);
  const wallet = new ethers.Wallet(privateKey, provider);
  const sbt = new ethers.Contract(sbtAddress, SBT_ABI, wallet);

  const tx = await sbt.mint(userAddress, metadataUri);
  const receipt = await tx.wait();
  return receipt.hash;
}

module.exports = { mintSBT };
