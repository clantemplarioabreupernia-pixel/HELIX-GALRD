contract TortugaEscrowTest is Test {
    TortugaEscrow escrow;
    MockUSDC usdc;

    address cliente    = address(0xA11CE);
    address developer  = address(0xB0B);
    address tesoreria  = address(0x7E50);
    address arbitro    = address(0xA2B);

    uint256 constant MONTO = 1_000e6;

    function setUp() public {
        usdc = new MockUSDC();
        escrow = new TortugaEscrow(tesoreria, arbitro);
        usdc.mint(cliente, 10_000e6);
        vm.prank(cliente);
        usdc.approve(address(escrow), type(uint256).max);
