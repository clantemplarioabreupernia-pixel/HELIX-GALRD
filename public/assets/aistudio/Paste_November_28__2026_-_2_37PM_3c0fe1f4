### 4.4 `TortugaEscrow.sol`

```solidity
// SPDX-License-Identifier: Apache-2.0
pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

/**
 * @title TortugaEscrow
 * @dev Depósito en garantía para trabajos freelance.
 *      Comisión configurable entre 5% y 15%.
 *      No custodia fiat. No es un exchange. No es un banco.
 */
contract TortugaEscrow is Ownable, ReentrancyGuard {
    using SafeERC20 for IERC20;

    enum Estado { Creado, Financiado, Entregado, Liberado, Reembolsado, EnDisputa, Resuelto }

    struct Trabajo {
        address cliente;
        address developer;
        address token;
        uint256 monto;
        uint256 comisionBps;
        uint256 deadline;
        Estado estado;
        string  metadataUri;
    }

    uint256 public constant MAX_BPS = 10_000;
    uint256 public constant COMISION_MIN_BPS = 500;
    uint256 public constant COMISION_MAX_BPS = 1_500;

    address public tesoreria;
    address public arbitro;
    uint256 public siguienteId;

    mapping(uint256 => Trabajo) public trabajos;
    mapping(uint256 => uint256) public saldoPendiente;

    event TrabajoCreado(uint256 indexed id, address indexed cliente, address indexed developer, uint256 monto, uint256 comisionBps);
    event TrabajoFinanciado(uint256 indexed id, uint256 monto);
    event EntregaMarcada(uint256 indexed id);
    event PagoLiberado(uint256 indexed id, uint256 pagoDeveloper, uint256 comisionPlataforma);
    event Reembolsado(uint256 indexed id, uint256 monto);
    event DisputaAbierta(uint256 indexed id, address iniciador);
    event DisputaResuelta(uint256 indexed id, uint256 pagoDeveloper, uint256 pagoCliente, uint256 comisionPlataforma);
    event TesoreriaActualizada(address indexed nueva);
    event ArbitroActualizado(address indexed nuevo);

    modifier soloArbitro() {
        require(msg.sender == arbitro, "Escrow: no es arbitro");
        _;
    }

    constructor(address _tesoreria, address _arbitro) Ownable(msg.sender) {
        require(_tesoreria != address(0), "Escrow: tesoreria cero");
        require(_arbitro != address(0), "Escrow: arbitro cero");
        tesoreria = _tesoreria;
        arbitro = _arbitro;
    }

    function setTesoreria(address _tesoreria) external onlyOwner {
        require(_tesoreria != address(0), "Escrow: tesoreria cero");
        tesoreria = _tesoreria;
        emit TesoreriaActualizada(_tesoreria);
    }

    function setArbitro(address _arbitro) external onlyOwner {
        require(_arbitro != address(0), "Escrow: arbitro cero");
        arbitro = _arbitro;
        emit ArbitroActualizado(_arbitro);
    }

    function crearTrabajo(
        address developer,
        address token,
        uint256 monto,
        uint256 comisionBps,
        uint256 deadline,
        string calldata metadataUri
    ) external returns (uint256 id) {
        require(developer != address(0), "Escrow: developer cero");
        require(token != address(0), "Escrow: token cero");
        require(monto > 0, "Escrow: monto cero");
        require(comisionBps >= COMISION_MIN_BPS && comisionBps <= COMISION_MAX_BPS, "Escrow: comision fuera de rango");
        require(deadline > block.timestamp, "Escrow: deadline pasado");

        id = siguienteId++;
        trabajos[id] = Trabajo({
            cliente: msg.sender,
            developer: developer,
            token: token,
            monto: monto,
            comisionBps: comisionBps,
            deadline: deadline,
            estado: Estado.Creado,
            metadataUri: metadataUri
        });

        emit TrabajoCreado(id, msg.sender, developer, monto, comisionBps);
    }

    function financiar(uint256 id) external nonReentrant {
        Trabajo storage t = trabajos[id];
        require(t.estado == Estado.Creado, "Escrow: estado invalido");
        require(msg.sender == t.cliente, "Escrow: solo cliente");

        t.estado = Estado.Financiado;
        IERC20(t.token).safeTransferFrom(msg.sender, address(this), t.monto);

        emit TrabajoFinanciado(id, t.monto);
    }

    function marcarEntrega(uint256 id) external {
        Trabajo storage t = trabajos[id];
        require(t.estado == Estado.Financiado, "Escrow: estado invalido");
        require(msg.sender == t.developer, "Escrow: solo developer");
        t.estado = Estado.Entregado;
        emit EntregaMarcada(id);
    }

    function aprobarYLiberar(uint256 id) external nonReentrant {
        Trabajo storage t = trabajos[id];
        require(t.estado == Estado.Entregado, "Escrow: estado invalido");
        require(msg.sender == t.cliente, "Escrow: solo cliente");

        uint256 comision = (t.monto * t.comisionBps) / MAX_BPS;
        uint256 pago = t.monto - comision;

        t.estado = Estado.Liberado;
        IERC20(t.token).safeTransfer(t.developer, pago);
        if (comision > 0) {
            IERC20(t.token).safeTransfer(tesoreria, comision);
        }

        emit PagoLiberado(id, pago, comision);
    }

    function reembolsarPorDeadline(uint256 id) external nonReentrant {
        Trabajo storage t = trabajos[id];
        require(t.estado == Estado.Financiado, "Escrow: estado invalido");
        require(msg.sender == t.cliente, "Escrow: solo cliente");
        require(block.timestamp > t.deadline, "Escrow: deadline no vencido");

        t.estado = Estado.Reembolsado;
        IERC20(t.token).safeTransfer(t.cliente, t.monto);
        emit Reembolsado(id, t.monto);
    }

    function abrirDisputa(uint256 id) external {
        Trabajo storage t = trabajos[id];
        require(t.estado == Estado.Entregado || t.estado == Estado.Financiado, "Escrow: estado invalido");
        require(msg.sender == t.cliente || msg.sender == t.developer, "Escrow: no participante");
        t.estado = Estado.EnDisputa;
        emit DisputaAbierta(id, msg.sender);
    }

    function resolverDisputa(
        uint256 id,
        uint256 pagoDeveloper,
        uint256 pagoCliente,
        uint256 comisionPlataforma
    ) external soloArbitro nonReentrant {
        Trabajo storage t = trabajos[id];
        require(t.estado == Estado.EnDisputa, "Escrow: estado invalido");
        require(pagoDeveloper + pagoCliente + comisionPlataforma == t.monto, "Escrow: suma invalida");

        t.estado = Estado.Resuelto;
        if (pagoDeveloper > 0) IERC20(t.token).safeTransfer(t.developer, pagoDeveloper);
        if (pagoCliente > 0)   IERC20(t.token).safeTransfer(t.cliente, pagoCliente);
        if (comisionPlataforma > 0) IERC20(t.token).safeTransfer(tesoreria, comisionPlataforma);

        emit DisputaResuelta(id, pagoDeveloper, pagoCliente, comisionPlataforma);
    }

    function obtenerTrabajo(uint256 id) external view returns (Trabajo memory) {
        return trabajos[id];
    }
}
```

