### 4.3 `MeritoBridge.sol`

```solidity
// SPDX-License-Identifier: Apache-2.0
pragma solidity ^0.8.20;

import "@openzeppelin/contracts/access/Ownable.sol";
import "./MeritoSBT.sol";
import "./MeritoToken.sol";

/**
 * @title MeritoBridge
 * @dev Puente de redención: quema un SBT y emite ERC-20.
 */
contract MeritoBridge is Ownable {
    MeritoSBT public sbt;
    MeritoToken public token;

    mapping(uint256 => bool) public redeemed;
    mapping(uint256 => uint256) public redemptionAmount;

    event Redeemed(address indexed user, uint256 indexed tokenId, uint256 amount);
    event RedemptionAmountSet(uint256 indexed tokenId, uint256 amount);

    constructor(address _sbt, address _token) Ownable(msg.sender) {
        sbt = MeritoSBT(_sbt);
        token = MeritoToken(_token);
    }

    function setRedemptionAmount(uint256 tokenId, uint256 amount) external onlyOwner {
        redemptionAmount[tokenId] = amount;
        emit RedemptionAmountSet(tokenId, amount);
    }

    function redeem(uint256 tokenId) external {
        require(sbt.ownerOf(tokenId) == msg.sender, "Bridge: not token owner");
        require(!redeemed[tokenId], "Bridge: already redeemed");
        uint256 amount = redemptionAmount[tokenId];
        require(amount > 0, "Bridge: amount not set");

        redeemed[tokenId] = true;
        sbt.burnForRedemption(tokenId);
        token.mint(msg.sender, amount);

        emit Redeemed(msg.sender, tokenId, amount);
    }
}
