#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
api.py - Backend mínimo del marketplace MeritoOmega.
"""

import subprocess
import sys
from datetime import datetime, timezone
from typing import Any, Optional

from fastapi import FastAPI, HTTPException
from pydantic import BaseModel, Field

app = FastAPI(title="MeritoOmega API", version="0.1.0")

class Aporte(BaseModel):
    id: str
    tipo: str
    autor: str
    fecha: str
    descripcion: str
    evidencia: dict[str, Any] = Field(default_factory=dict)
    metadata_extra: dict[str, Any] = Field(default_factory=dict)

class ResultadoAporte(BaseModel):
    id: str
    autor: str
    tipo: str
    puntos: int
    nivel_sbt: str
    erc20_a_canjear: float
    fecha_verificacion: str

class SolicitudVerificacion(BaseModel):
    tipo: str
    codigo: Optional[str] = None

PUNTOS_BASE = {
    "pull_request": 50, "documentacion": 20, "mentoria": 30,
    "revision_pr": 15, "bug": 10, "diseno": 25,
}

NIVELES = [(1000, "Platino"), (500, "Oro"), (200, "Plata"), (50, "Bronce"), (0, "Iniciado")]

def nivel_por_puntos(p: int) -> str:
    for u, n in NIVELES:
        if p >= u:
            return n
    return "Iniciado"

def calcular_puntos(aporte: Aporte) -> int:
    p = PUNTOS_BASE.get(aporte.tipo, 0)
    ev = aporte.evidencia or {}
    ex = aporte.metadata_extra or {}
    if aporte.tipo == "pull_request":
        if ev.get("tests_pasan"): p += 50
        if isinstance(ev.get("revisores"), list) and len(ev["revisores"]) >= 2: p += 30
        if ev.get("documentado"): p += 20
    elif aporte.tipo == "documentacion":
        if ex.get("tutorial"): p += 10
        if ev.get("ejemplos_verificables"): p += 15
    elif aporte.tipo == "mentoria":
        if ex.get("sesiones_extra", 0) > 1: p += 10
        if ev.get("mentorado_contribuyo"): p += 20
    elif aporte.tipo == "revision_pr":
        if ev.get("bug_critico"): p += 10
        if ev.get("mejora_aceptada"): p += 5
    elif aporte.tipo == "bug":
        if ev.get("critico_reproducible"): p += 20
        if ev.get("parche_incluido"): p += 10
    elif aporte.tipo == "diseno":
        if ev.get("adoptado_produccion"): p += 15
        if ev.get("guia_estilo"): p += 10
    return p

@app.post("/aporte", response_model=ResultadoAporte)
def verificar_aporte(aporte: Aporte):
    if aporte.tipo not in PUNTOS_BASE:
        raise HTTPException(400, f"Tipo desconocido: {aporte.tipo}")
    puntos = calcular_puntos(aporte)
    return ResultadoAporte(
        id=aporte.id, autor=aporte.autor, tipo=aporte.tipo,
        puntos=puntos, nivel_sbt=nivel_por_puntos(puntos),
        erc20_a_canjear=round(puntos * 0.1, 2),
        fecha_verificacion=datetime.now(timezone.utc).isoformat(),
    )

@app.post("/verificar")
def verificar_formal(sol: SolicitudVerificacion):
    try:
        proc = subprocess.run(
            [sys.executable, "verificador_z3.py"],
            capture_output=True, text=True, timeout=60,
        )
    except subprocess.TimeoutExpired:
        raise HTTPException(504, "Timeout en verificación Z3")
    return {
        "tipo": sol.tipo,
        "stdout": proc.stdout,
        "stderr": proc.stderr,
        "returncode": proc.returncode,
    }

@app.get("/reputacion/{address}")
def reputacion(address: str):
    return {
        "address": address,
        "sbt_count": 0,
        "nivel": "Iniciado",
        "nota": "En producción: consultar MeritoSBT vía ethers.js",
    }

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="127.0.0.1", port=8000)
