### 5.1 `verificador_z3.py`

```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
verificador_z3.py
Capa de verificación formal para el marketplace MeritoOmega.
Comprueba invariantes de los contratos de token y propiedades
de soluciones enviadas a bounties (bounded model checking).
"""

from z3 import *

# ---------- Invariantes de los contratos ----------

def check_transfer_preserves_supply():
    """transfer(b1 -> b2, amount) no altera el suministro total."""
    b1, b2, total, amount = Ints('b1 b2 total amount')
    s = Solver()
    s.add(b1 >= 0, b2 >= 0, total >= 0, amount >= 0)
    s.add(b1 + b2 == total)
    s.add(amount <= b1)
    b1n, b2n, totaln = b1 - amount, b2 + amount, total
    s.add(Not(And(totaln == total, b1n + b2n == totaln)))
    return s.check() == unsat

def check_burn_reduces_supply():
    """burn(b, amount) reduce el suministro exactamente en amount."""
    b, total, amount = Ints('b total amount')
    s = Solver()
    s.add(b >= 0, total >= 0, amount >= 0, amount <= b, b <= total)
    totaln = total - amount
    s.add(totaln != total - amount)
    return s.check() == unsat

def check_mint_increases_supply():
    """mint(to, amount) aumenta el suministro exactamente en amount."""
    b, total, amount = Ints('b total amount')
    s = Solver()
    s.add(b >= 0, total >= 0, amount >= 0)
    totaln = total + amount
    s.add(totaln != total + amount)
    return s.check() == unsat

def check_mint_overflow_guard():
    """Si se exige total + amount <= 2^256-1, no hay overflow."""
    MAX = 2**256 - 1
    total, amount = Ints('total amount')
    s = Solver()
    s.add(total >= 0, total <= MAX)
    s.add(amount >= 0, amount <= MAX)
    s.add(total + amount <= MAX)
    s.add(Not(total + amount <= MAX))
    return s.check() == unsat

# ---------- Verificación de soluciones a bounties ----------

def verify_sum_solution(candidate, max_n=4, max_val=100):
    """
    Verifica que candidate(arr) == sum(arr) para toda lista
    de longitud <= max_n con valores enteros en [0, max_val].
    """
    for n in range(max_n + 1):
        arr = [Int(f'a_{i}') for i in range(n)]
        s = Solver()
        for x in arr:
            s.add(x >= 0, x <= max_val)
        result = candidate(arr)
        spec = Sum(arr) if n > 0 else IntVal(0)
        s.add(result != spec)
        if s.check() == sat:
            return False, s.model()
    return True, None

def verify_max_solution(candidate, max_n=4, max_val=100):
    """Verifica que candidate(arr) == max(arr) para listas no vacías."""
    for n in range(1, max_n + 1):
        arr = [Int(f'b_{i}') for i in range(n)]
        s = Solver()
        for x in arr:
            s.add(x >= 0, x <= max_val)
        result = candidate(arr)
        spec = arr[0]
        for x in arr[1:]:
            spec = If(x > spec, x, spec)
        s.add(result != spec)
        if s.check() == sat:
            return False, s.model()
    return True, None

# ---------- Suite ----------

def run_suite():
    print("=== Invariantes de contratos ===")
    tests = [
        ("transfer preserva suministro", check_transfer_preserves_supply),
        ("burn reduce suministro",       check_burn_reduces_supply),
        ("mint aumenta suministro",      check_mint_increases_supply),
        ("mint con guard anti-overflow", check_mint_overflow_guard),
    ]
    for nombre, fn in tests:
        ok = fn()
        print(f"[{'OK' if ok else 'FALLO'}] {nombre}")

    print("\n=== Soluciones a bounties (bounded) ===")

    def sum_correct(arr):
        acc = IntVal(0)
        for x in arr:
            acc = acc + x
        return acc

    ok, model = verify_sum_solution(sum_correct, max_n=4, max_val=100)
    print(f"[{'OK' if ok else 'FALLO'}] suma correcta")

    def sum_wrong(arr):
        acc = IntVal(0)
        for x in arr:
            acc = acc - x
        return acc

    ok, model = verify_sum_solution(sum_wrong, max_n=3, max_val=10)
    print(f"[{'OK' if ok else 'FALLO'}] suma incorrecta detectada")
    if not ok:
        print("  Contraejemplo:", model)

    def max_correct(arr):
        m = arr[0]
        for x in arr[1:]:
            m = If(x > m, x, m)
        return m

    ok, model = verify_max_solution(max_correct, max_n=4, max_val=100)
    print(f"[{'OK' if ok else 'FALLO'}] máximo correcto")

if __name__ == "__main__":
    run_suite()
```

