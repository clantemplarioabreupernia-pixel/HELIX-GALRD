        escrow.financiar(id);

        vm.warp(block.timestamp + 2 days);
        vm.prank(cliente);
        escrow.reembolsarPorDeadline(id);

        assertEq(usdc.balanceOf(cliente), 10_000e6);
        assertEq(usdc.balanceOf(address(escrow)), 0);
