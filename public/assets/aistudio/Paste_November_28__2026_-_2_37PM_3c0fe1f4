```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Verificador de aportes para el sistema MeritoOmega.
Recibe un JSON por stdin, valida reglas y devuelve puntos, nivel y ERC-20.
"""

import json
import sys
from datetime import datetime

PUNTOS_BASE = {
    "pull_request": 50,
    "documentacion": 20,
    "mentoria": 30,
    "revision_pr": 15,
    "bug": 10,
    "diseno": 25,
}

MODIFICADORES = {
    "pull_request": [
        ("tests_pasan", 50),
        ("revisores", 30, lambda v: len(v) >= 2),
        ("documentado", 20),
    ],
    "documentacion": [
        ("tutorial", 10),
        ("ejemplos_verificables", 15),
    ],
    "mentoria": [
        ("sesiones_extra", 10, lambda v: v > 1),
        ("mentorado_contribuyo", 20),
    ],
    "revision_pr": [
        ("bug_critico", 10),
        ("mejora_aceptada", 5),
    ],
    "bug": [
        ("critico_reproducible", 20),
        ("parche_incluido", 10),
    ],
    "diseno": [
        ("adoptado_produccion", 15),
        ("guia_estilo", 10),
    ],
}

NIVELES = [
    (1000, "Platino"),
    (500, "Oro"),
    (200, "Plata"),
    (50, "Bronce"),
    (0, "Iniciado"),
]

def calcular_puntos(aporte: dict) -> int:
    tipo = aporte["tipo"]
    puntos = PUNTOS_BASE.get(tipo, 0)
    ev = aporte.get("evidencia", {})
    extra = aporte.get("metadata_extra", {})

    for mod in MODIFICADORES.get(tipo, []):
        if len(mod) == 2:
            campo, valor = mod
            if ev.get(campo) or extra.get(campo):
                puntos += valor
        elif len(mod) == 3:
            campo, valor, cond = mod
            if campo in ev:
                if cond(ev[campo]):
                    puntos += valor
    return puntos

def nivel_por_puntos(puntos: int) -> str:
    for umbral, nombre in NIVELES:
        if puntos >= umbral:
            return nombre
    return "Iniciado"

def main():
    try:
        aporte = json.load(sys.stdin)
    except json.JSONDecodeError as e:
        print(json.dumps({"error": f"JSON inválido: {e}"}))
        sys.exit(1)

    requeridos = ["id", "tipo", "autor", "fecha", "descripcion", "evidencia"]
    for campo in requeridos:
        if campo not in aporte:
            print(json.dumps({"error": f"Falta campo requerido: {campo}"}))
            sys.exit(1)

    if aporte["tipo"] not in PUNTOS_BASE:
        print(json.dumps({"error": f"Tipo desconocido: {aporte['tipo']}"}))
        sys.exit(1)

    puntos = calcular_puntos(aporte)
    nivel = nivel_por_puntos(puntos)
    erc20 = round(puntos * 0.1, 2)

    resultado = {
        "id": aporte["id"],
        "autor": aporte["autor"],
        "tipo": aporte["tipo"],
        "puntos": puntos,
        "nivel_sbt": nivel,
        "erc20_a_canjear": erc20,
        "fecha_verificacion": datetime.utcnow().isoformat() + "Z",
    }
    print(json.dumps(resultado, indent=2))

if __name__ == "__main__":
    main()
```

