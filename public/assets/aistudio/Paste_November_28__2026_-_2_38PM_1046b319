# 🗂️ D. Composiciones

## D.1 · `SiteHeader` (antes `Nav`)

**Uso:** navegación sticky con brand + enlaces de sección.
**Fin:** orientación constante. Consume `useScrollSpy` para marcar sección activa.
**Dependencias:** `Container`, `useScrollSpy`, `contracts`.

### `src/sections/SiteHeader.tsx`

```tsx
import { useMemo } from "react";
import { Container } from "../ui/Container";
import { useScrollSpy } from "../hooks/useScrollSpy";
import { cx } from "../utils/cx";
import type { NavLink } from "../contracts";

const NAV_LINKS: readonly NavLink[] = [
  { id: "leyes", label: "Leyes" },
  { id: "productos", label: "Productos" },
  { id: "casos", label: "Casos de uso" },
  { id: "sobre", label: "Sobre" },
  { id: "contacto", label: "Contacto" },
] as const;

export interface SiteHeaderProps {
  brandName: string;
}

export function SiteHeader({ brandName }: SiteHeaderProps) {
  const ids = useMemo(() => NAV_LINKS.map((l) => l.id), []);
  const activeId = useScrollSpy(ids, { offset: 80 });

  return (
    <header className="site-header">
      <Container className="site-header__inner">
        <a href="#hero" className="site-header__brand" aria-label={`${brandName}, inicio`}>
          <span className="site-header__mark" aria-hidden="true">Ω</span>
          <span className="site-header__name">{brandName}</span>
        </a>
        <nav aria-label="Principal">
          <ul className="site-header__links">
            {NAV_LINKS.map((link) => (
              <li key={link.id}>
                <a
                  href={`#${link.id}`}
                  className={cx("site-header__link", activeId === link.id && "is-active")}
                  aria-current={activeId === link.id ? "location" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </Container>
    </header>
  );
}
```

