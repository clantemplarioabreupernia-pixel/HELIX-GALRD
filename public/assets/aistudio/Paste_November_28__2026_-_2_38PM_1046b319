## C.3 · `Button`

**Uso:** acción primaria o secundaria; renderiza `<a>` si recibe `href`, `<button>` en caso contrario.
**Fin:** unificar comportamiento visual + accesible.
**API:** `variant`, `href`, `onClick`, `type`.

### `src/ui/Button.tsx`

```tsx
import type { ButtonHTMLAttributes, ReactNode } from "react";
import { cx } from "../utils/cx";

type ButtonVariant = "primary" | "ghost";

interface BaseProps {
  children: ReactNode;
  variant?: ButtonVariant;
  className?: string;
}

interface AsLink extends BaseProps {
  href: string;
  external?: boolean;
}

interface AsButton extends BaseProps {
  href?: undefined;
  onClick?: ButtonHTMLAttributes<HTMLButtonElement>["onClick"];
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
}

export type ButtonProps = AsLink | AsButton;

function isLink(props: ButtonProps): props is AsLink {
  return typeof (props as AsLink).href === "string";
}

export function Button(props: ButtonProps) {
  const classes = cx(
    "btn",
    props.variant === "ghost" ? "btn--ghost" : "btn--primary",
    props.className,
  );

  if (isLink(props)) {
    const { href, external, children } = props;
    const externalProps = external
      ? { target: "_blank", rel: "noreferrer noopener" as const }
      : {};
    return (
      <a href={href} className={classes} {...externalProps}>
        {children}
      </a>
    );
  }

  const { children, onClick, type = "button", disabled } = props;
  return (
    <button type={type} className={classes} onClick={onClick} disabled={disabled}>
      {children}
    </button>
  );
}
```

