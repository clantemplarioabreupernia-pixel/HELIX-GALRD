import { useEffect, useRef } from 'react';
import type { LatticePoint } from '../types';
import { createRng } from '../lib/math';

const GRID = 32;
const CANVAS = 480;

function buildLattice(seed: number): LatticePoint[] {
  const rng = createRng(seed);
  const step = CANVAS / GRID;
  const points: LatticePoint[] = [];
  for (let y = 0; y < GRID; y++) {
    for (let x = 0; x < GRID; x++) {
      const re = rng() * 2 - 1;
      const im = rng() * 2 - 1;
      points.push({
        x: x * step + step / 2,
        y: y * step + step / 2,
        state: { re, im },
        magnitude: Math.hypot(re, im),
      });
    }
  }
  return points;
}

export function StateLatticeCanvas() {
  const canvasRef = useRef<HTMLCanvasElement | null>(null);
  const points = useRef<LatticePoint[]>(buildLattice(42));

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    ctx.fillStyle = '#020617';
    ctx.fillRect(0, 0, CANVAS, CANVAS);

    for (const p of points.current) {
      const hue = 200 + p.state.im * 80;
      const sat = 60 + p.magnitude * 30;
      const light = 30 + p.magnitude * 40;
      ctx.fillStyle = `hsl(${hue}, ${sat}%, ${light}%)`;
      ctx.beginPath();
      ctx.arc(p.x, p.y, 1 + p.magnitude * 2, 0, Math.PI * 2);
      ctx.fill();
    }
  }, []);

  return (
    <section className="rounded-xl border border-slate-800 bg-slate-950 p-4">
      <h2 className="mb-3 text-sm font-semibold text-slate-200">Complex-state lattice</h2>
      <p className="mb-3 text-xs text-slate-400">
        Deterministic {GRID}×{GRID} lattice of complex state samples. Hue maps
        the imaginary part; lightness maps magnitude. Seeded (42).
      </p>
      <canvas
        ref={canvasRef}
        width={CANVAS}
        height={CANVAS}
        className="mx-auto block rounded-lg border border-slate-800"
      />
    </section>
  );
}
