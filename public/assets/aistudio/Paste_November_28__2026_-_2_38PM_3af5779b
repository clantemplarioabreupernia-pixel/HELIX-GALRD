import { useMemo, useState } from 'react';
import { Slider } from './ui/Slider';
import { createRng } from '../lib/math';

const SAMPLES = 256;

function buildSignal(seed: number, amplitude: number, noise: number): number[] {
  const rng = createRng(seed);
  const out: number[] = [];
  for (let i = 0; i < SAMPLES; i++) {
    const t = i / SAMPLES;
    const s = amplitude * Math.sin(2 * Math.PI * 4 * t);
    out.push(s + (rng() - 0.5) * 2 * noise);
  }
  return out;
}

function movingAverage(xs: number[], window: number): number[] {
  const out: number[] = [];
  for (let i = 0; i < xs.length; i++) {
    let sum = 0;
    let n = 0;
    for (let j = Math.max(0, i - window + 1); j <= i; j++) {
      sum += xs[j];
      n++;
    }
    out.push(sum / n);
  }
  return out;
}

export function SignalProcessingLab() {
  const [amplitude, setAmplitude] = useState(1);
  const [noise, setNoise] = useState(0.2);
  const [window, setWindow] = useState(5);

  const raw = useMemo(() => buildSignal(13, amplitude, noise), [amplitude, noise]);
  const filtered = useMemo(() => movingAverage(raw, window), [raw, window]);

  return (
    <section className="rounded-xl border border-slate-800 bg-slate-950 p-4">
      <h2 className="mb-3 text-sm font-semibold text-slate-200">Signal processing lab</h2>
      <p className="mb-3 text-xs text-slate-400">
        Deterministic synthetic signal (seeded) with configurable noise and a
        moving-average filter.
      </p>
      <div className="grid gap-3 md:grid-cols-3">
        <Slider label="Amplitude" value={amplitude} min={0.1} max={2} step={0.1} onChange={setAmplitude} format={v => v.toFixed(2)} />
        <Slider label="Noise"     value={noise}     min={0}   max={1} step={0.05} onChange={setNoise}     format={v => v.toFixed(2)} />
        <Slider label="Window"    value={window}    min={1}   max={31} step={1}   onChange={setWindow} />
      </div>
      <Plot raw={raw} filtered={filtered} />
    </section>
  );
}

function Plot({ raw, filtered }: { raw: number[]; filtered: number[] }) {
  const W = 480, H = 140;
  const toPoly = (xs: number[]) =>
    xs
