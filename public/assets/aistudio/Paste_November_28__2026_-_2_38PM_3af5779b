```typescript
/**
 * Web Audio engine for aether-sim.
 * Converts SignalSample[] to a PCM buffer and plays it.
 */
import type { SignalSample } from '../types';

export interface AudioEngineOptions {
  sampleRate?: number;
}

export interface AudioEngine {
  play(samples: SignalSample[]): Promise<void>;
  stop(): void;
  dispose(): void;
}

export function createAudioEngine(options: AudioEngineOptions = {}): AudioEngine {
  const sampleRate = options.sampleRate ?? 44_100;
  let context: AudioContext | null = null;
  let source: AudioBufferSourceNode | null = null;

  const ensureContext = (): AudioContext => {
    if (!context) {
      const Ctor =
        window.AudioContext ??
        (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      context = new Ctor({ sampleRate });
    }
    return context;
  };

  const play = async (samples: SignalSample[]): Promise<void> => {
    const ctx = ensureContext();
    if (ctx.state === 'suspended') await ctx.resume();
    stop();
    const buffer = ctx.createBuffer(1, samples.length, ctx.sampleRate);
    const channel = buffer.getChannelData(0);
    for (let i = 0; i < samples.length; i++) {
      channel[i] = samples[i].amplitude + samples[i].noise;
    }
    source = ctx.createBufferSource();
    source.buffer = buffer;
    source.connect(ctx.destination);
    source.start();
  };

  const stop = () => {
    if (!source) return;
    try { source.stop(); } catch { /* already stopped */ }
    source.disconnect();
    source = null;
  };

  const dispose = () => {
    stop();
    if (context) {
      void context.close();
      context = null;
    }
  };

  return { play, stop, dispose };
}
