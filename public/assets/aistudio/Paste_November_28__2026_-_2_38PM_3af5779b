#### E.3 `src/components/CombinatorialOptimizer.tsx`
```tsx
import { useRef, useState } from 'react';
import { createRng } from '../lib/math';

const SIDE = 16;
const ITERATIONS = 1000;
const SEED = 7;

function energyOf(grid: number[]): number {
  const sum = grid.reduce((a, b) => a + b, 0);
  return Math.abs(sum - grid.length / 2);
}

export function CombinatorialOptimizer() {
  const [history, setHistory] = useState<number[]>([]);
  const [best, setBest] = useState<number | null>(null);
  const running = useRef(false);

  const run = () => {
    if (running.current) return;
    running.current = true;
    setHistory([]);
    setBest(null);

    const rng = createRng(SEED);
    const grid = Array.from({ length: SIDE * SIDE }, () => (rng() > 0.5 ? 1 : 0));
    let currentCost = energyOf(grid);
    let bestCost = currentCost;
    const trail: number[] = [];

    const step = (i: number) => {
      if (i >= ITERATIONS) {
        running.current = false;
        return;
      }
      const idx = Math.floor(rng() * grid.length);
      grid[idx] = 1 - grid[idx];
      const next = energyOf(grid);
      const temp = 1 - i / ITERATIONS;
      const accept = next <= currentCost
        || rng() < Math.exp((currentCost - next) / Math.max(temp, 1e-3));
      if (accept) currentCost = next;
      else grid[idx] = 1 - grid[idx];
      if (currentCost < bestCost) bestCost = currentCost;
      trail.push(bestCost);

      if (i % 10 === 0) {
        setHistory([...trail]);
        setBest(bestCost);
      }
      requestAnimationFrame(() => step(i + 1));
    };
    step(0);
  };

  return (
    <section className="rounded-xl border border-slate-800 bg-slate-950 p-4">
      <h2 className="mb-3 text-sm font-semibold text-slate-200">Combinatorial optimizer</h2>
      <p className="mb-3 text-xs text-slate-400">
        Simulated annealing over a {SIDE}×{SIDE} binary lattice. Deterministic
        seeded run (seed={SEED}), {ITERATIONS} iterations.
      </p>
      <button
        type="button"
        onClick={run}
        className="mb-3 rounded-lg bg-sky-600 px-3 py-2 text-sm text-white hover:bg-sky-500"
      >
        Run optimizer
      </button>
      <div className="text-xs text-slate-300">
        Best energy: <span className="font-mono text-sky-400">{best ?? '—'}</span>
      </div>
      <Sparkline values={history} />
    </section>
  );
}

function Sparkline({ values }: { values: number[] }) {
  if (values.length === 0) return <div className="mt-3 h-24 rounded bg-slate-900" />;
  const W = 480, H = 96;
  const max = Math.max(...values, 1);
  const points = values
    .map((v, i) => {
      const x = (i / Math.max(values.length - 1, 1)) * W;
      const y = H - (v / max) * H;
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
  return (
    <svg viewBox={`0 0 ${W} ${H}`} className="mt-3 w-full rounded bg-slate-900">
      <polyline fill="none" stroke="#38bdf8" strokeWidth="2" points={points} />
    </svg>
  );
}
