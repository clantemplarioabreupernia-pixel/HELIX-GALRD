import { useEffect, useState } from 'react';

export function SimulationCube3D() {
  const [angle, setAngle] = useState(0);

  useEffect(() => {
    let raf = 0;
    const tick = () => {
      setAngle(a => (a + 0.006) % (Math.PI * 2));
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
    return () => cancelAnimationFrame(raf);
  }, []);

  const size = 60;
  const cx = 160;
  const cy = 160;

  const project = (x: number, y: number, z: number) => {
    const cosA = Math.cos(angle), sinA = Math.sin(angle);
    const rx = x * cosA - z * sinA;
    const rz = x * sinA + z * cosA;
    const cosB = Math.cos(angle * 0.7), sinB = Math.sin(angle * 0.7);
    const ry = y * cosB - rz * sinB;
    return { x: cx + rx, y: cy + ry };
  };

  const vertices: Array<[number, number, number]> = [
    [-size, -size, -size], [size, -size, -size], [size, size, -size], [-size, size, -size],
    [-size, -size, size],  [size, -size, size],  [size, size, size],  [-size, size, size],
  ];
  const edges: Array<[number, number]> = [
    [0, 1], [1, 2], [2, 3], [3, 0],
    [4, 5], [5, 6], [6, 7], [7, 4],
    [0, 4], [1, 5], [2, 6], [3, 7],
  ];

  const pts = vertices.map(([x, y, z]) => project(x, y, z));

  return (
    <section className="rounded-xl border border-slate-800 bg-slate-950 p-4">
      <h2 className="mb-3 text-sm font-semibold text-slate-200">Cube projection</h2>
      <p className="mb-3 text-xs text-slate-400">
        Isometric projection of a rotating cube driven by requestAnimationFrame.
      </p>
      <svg viewBox="0 0 320 320" className="mx-auto block rounded bg-slate-900">
        {edges.map(([a, b], i) => (
          <line
            key={i}
            x1={pts[a].x}
            y1={pts[a].y}
            x2={pts[b].x}
            y2={pts[b].y}
            stroke="#38bdf8"
            strokeWidth="1.5"
          />
        ))}
        {pts.map((p, i) => (
          <circle key={i} cx={p.x} cy={p.y} r={3} fill="#0ea5e9" />
        ))}
      </svg>
    </section>
  );
}
