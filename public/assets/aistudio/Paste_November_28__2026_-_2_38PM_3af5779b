import { useEffect, useRef } from 'react';
import { createRng } from '../lib/math';

const W = 64;
const H = 64;
const SCALE = 6;
const MAX_FRAMES = 400;

export function BioPixelEngine() {
  const ref = useRef<HTMLCanvasElement | null>(null);

  useEffect(() => {
    const canvas = ref.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const rng = createRng(123);
    let state = new Uint8Array(W * H);
    for (let i = 0; i < W * H; i++) state[i] = rng() > 0.7 ? 1 : 0;

    let raf = 0;
    let frame = 0;

    const draw = () => {
      ctx.fillStyle = '#020617';
      ctx.fillRect(0, 0, W * SCALE, H * SCALE);
      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          if (state[y * W + x]) {
            ctx.fillStyle = '#22d3ee';
            ctx.fillRect(x * SCALE, y * SCALE, SCALE, SCALE);
          }
        }
      }
    };

    const step = () => {
      const next = new Uint8Array(W * H);
      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          let n = 0;
          for (let dy = -1; dy <= 1; dy++) {
            for (let dx = -1; dx <= 1; dx++) {
              if (dx === 0 && dy === 0) continue;
              const nx = (x + dx + W) % W;
              const ny = (y + dy + H) % H;
              n += state[ny * W + nx];
            }
          }
          const alive = state[y * W + x];
          next[y * W + x] = alive
            ? (n === 2 || n === 3 ? 1 : 0)
            : (n === 3 ? 1 : 0);
        }
      }
      state = next;
      draw();
      frame++;
      if (frame < MAX_FRAMES) raf = requestAnimationFrame(step);
    };

    draw();
    raf = requestAnimationFrame(step);
    return () => cancelAnimationFrame(raf);
  }, []);

  return (
    <section className="rounded-xl border border-slate-800 bg-slate-950 p-4">
      <h2 className="mb-3 text-sm font-semibold text-slate-200">Bio pixel engine</h2>
      <p className="mb-3 text-xs text-slate-400">
        Conway-style cellular automaton on a {W}×{H} lattice. Deterministic seed
        (123). Runs {MAX_FRAMES} frames.
      </p>
      <canvas
        ref={ref}
        width={W * SCALE}
        height={H * SCALE}
        className="mx-auto block rounded border border-slate-800"
      />
    </section>
  );
}
