/**
 * Mathematical utilities for aether-sim.
 * Provides complex arithmetic and a deterministic seeded PRNG
 * (avoids Math.random in metrics and simulations).
 */
import type { ComplexState } from '../types';

export function add(a: ComplexState, b: ComplexState): ComplexState {
  return { re: a.re + b.re, im: a.im + b.im };
}

export function mul(a: ComplexState, b: ComplexState): ComplexState {
  return {
    re: a.re * b.re - a.im * b.im,
    im: a.re * b.im + a.im * b.re,
  };
}

export function magnitude(a: ComplexState): number {
  return Math.hypot(a.re, a.im);
}

/** Mulberry32 PRNG — deterministic, fast, adequate for simulation. */
export function createRng(seed: number): () => number {
  let s = seed >>> 0;
  return () => {
    s = (s + 0x6D2B79F5) >>> 0;
    let t = s;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

export function clamp(x: number, lo: number, hi: number): number {
  return Math.min(hi, Math.max(lo, x));
}
