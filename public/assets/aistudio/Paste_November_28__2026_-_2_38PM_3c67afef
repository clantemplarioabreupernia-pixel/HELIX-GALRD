export const DEFAULT_SEED = 0xc0ffee;

export function normalizeSeed(seed: number | undefined): number {
  const s = (seed ?? DEFAULT_SEED) >>> 0;
  return s === 0 ? DEFAULT_SEED : s;
}
```

