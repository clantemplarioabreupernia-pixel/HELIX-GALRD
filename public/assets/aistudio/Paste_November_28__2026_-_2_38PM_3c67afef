### Sub-herramienta `orderParameter.ts`

```typescript
export interface PhaseState { amplitude: number; phase: number }

/** Coherencia = |Σ e^{iφ}| / N. Rango [0,1]. */
export function orderParameter(states: PhaseState[]): number {
  if (states.length === 0) return 0;
  let sc = 0, ss = 0;
  for (const s of states) {
    sc += Math.cos(s.phase);
    ss += Math.sin(s.phase);
  }
  return Math.sqrt(sc * sc + ss * ss) / states.length;
}
```

