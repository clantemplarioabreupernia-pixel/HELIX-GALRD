```typescript
/** Normaliza amplitudes a una distribución de probabilidad. */
export function toProbabilities(amplitudes: number[]): number[] {
  const total = amplitudes.reduce((a, b) => a + Math.abs(b), 0);
  if (total === 0) return amplitudes.map(() => 0);
  return amplitudes.map((a) => Math.abs(a) / total);
}
```

### Sub-herramienta `shannonEntropy.ts`

```typescript
import { toProbabilities } from './toProbabilities.js';

/** Entropía de Shannon en bits (sin normalizar). */
export function shannonEntropy(amplitudes: number[]): number {
  const probs = toProbabilities(amplitudes);
  let h = 0;
  for (const p of probs) {
    if (p > 0) h -= p * Math.log2(p);
  }
  return h;
}
```

### Sub-herramienta `normalizedEntropy.ts`

```typescript
import { shannonEntropy } from './shannonEntropy.js';

/** Entropía normalizada [0,1] respecto al máximo log2(N). */
export function normalizedEntropy(amplitudes: number[]): number {
  if (amplitudes.length <= 1) return 0;
  const h = shannonEntropy(amplitudes);
  const hMax = Math.log2(amplitudes.length);
  return hMax > 0 ? h / hMax : 0;
}
```

