import { useEffect } from 'react';
import type * as THREE from 'three';

export function useResize(
  mount: React.RefObject<HTMLDivElement>,
  camera: THREE.PerspectiveCamera | null,
  renderer: THREE.WebGLRenderer | null,
): void {
  useEffect(() => {
    if (!camera || !renderer) return;
    const onResize = () => {
      if (!mount.current) return;
      const w = mount.current.clientWidth;
      const h = mount.current.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    };
    window.addEventListener('resize', onResize);
    return () => window.removeEventListener('resize', onResize);
  }, [mount, camera, renderer]);
}
```

### Componente `PhaseCanvas.tsx`

```tsx
import { useEffect, useRef, useState } from 'react';
import * as THREE from 'three';
import { buildPointCloud, type PointInput } from './buildPointCloud.js';
import { buildGrid } from './buildGrid.js';
import { setupCamera } from './setupCamera.js';
import { setupRenderer } from './setupRenderer.js';
import { useResize } from './useResize.js';

export function PhaseCanvas({ states }: { states: PointInput[] }) {
  const mount = useRef<HTMLDivElement>(null);
  const [camera, setCamera] = useState<THREE.PerspectiveCamera | null>(null);
  const [renderer, setRenderer] = useState<THREE.WebGLRenderer | null>(null);

  useEffect(() => {
    const el = mount.current;
    if (!el) return;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0a0a12);

    const cam = setupCamera(el.clientWidth, el.clientHeight);
    const rend = setupRenderer(el);
    setCamera(cam);
    setRenderer(rend);

    const { object, dispose } = buildPointCloud(states);
    const grid = buildGrid();
    scene.add(object, grid);

    let raf = 0;
    const loop = () => {
      object.rotation.y += 0.002;
      rend.render(scene, cam);
      raf = requestAnimationFrame(loop);
    };
    loop();

    return () => {
      cancelAnimationFrame(raf);
      dispose();
      grid.dispose();
      el.removeChild(rend.domElement);
      rend.dispose();
    };
  }, [states]);

  useResize(mount, camera, renderer);

  return <div ref={mount} style={{ width: '100%', height: '70vh' }} />;
}
```

