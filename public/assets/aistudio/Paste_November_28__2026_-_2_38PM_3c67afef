import express from 'express';
import { PhaseEngine } from '@phase-core/phase-engine';
import { stateRoute } from './routes/state.js';
import { entropyRoute } from './routes/entropy.js';
import { coherenceRoute } from './routes/coherence.js';
import { evolveRoute } from './routes/evolve.js';
import { purgeRoute } from './routes/purge.js';

export interface ServerConfig { dimension?: number; seed?: number; port?: number }

export function createServer(config: ServerConfig = {}) {
  const app = express();
  app.use(express.json());

  const engine = new PhaseEngine({
    dimension: config.dimension ?? 64,
    seed: config.seed ?? 0xc0ffee,
  });

  const router = express.Router();
  stateRoute(router, engine);
  entropyRoute(router, engine);
  coherenceRoute(router, engine);
  evolveRoute(router, engine);
  purgeRoute(router, engine);

  app.use('/api', router);
  return { app, engine, port: config.port ?? 3001 };
}
