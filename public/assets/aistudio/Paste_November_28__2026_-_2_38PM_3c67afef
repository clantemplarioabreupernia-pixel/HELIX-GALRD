### Sub-herramienta `initStates.ts`

```typescript
import { createXorshift32, nextXorshift32, normalizeSeed } from '@phase-core/prng';
import type { ComplexState } from './types.js';

export function initStates(dimension: number, seed?: number): ComplexState[] {
  let state = createXorshift32(normalizeSeed(seed));
  const out: ComplexState[] = [];
  for (let i = 0; i < dimension; i++) {
    const [s1, r1] = nextXorshift32(state);
    const [s2, r2] = nextXorshift32(s1);
    state = s2;
    out.push({ amplitude: r1 * 2 - 1, phase: r2 * Math.PI * 2 });
  }
  return out;
}
```

### Sub-herramienta `evolveStep.ts`

```typescript
import type { ComplexState } from './types.js';

/** Un paso de evolución: acoplamiento local determinista. */
export function evolveStep(states: ComplexState[]): ComplexState[] {
  const n = states.length;
  return states.map((cur, i) => {
    const prev = states[(i - 1 + n) % n];
    const next = states[(i + 1) % n];
    const phase = (cur.phase + 0.01 * (prev.phase - next.phase)) % (Math.PI * 2);
    const amplitude =
      0.98 * cur.amplitude +
      0.01 * (prev.amplitude + next.amplitude) * Math.cos(phase);
    return { amplitude, phase };
  });
}
```

