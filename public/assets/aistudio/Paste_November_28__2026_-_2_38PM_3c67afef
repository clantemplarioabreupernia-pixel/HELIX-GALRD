### Sub-herramienta `buildPointCloud.ts`

```typescript
import * as THREE from 'three';

export interface PointInput { amplitude: number; phase: number }

export function buildPointCloud(states: PointInput[]): {
  object: THREE.Points;
  dispose: () => void;
} {
  const n = states.length;
  const pos = new Float32Array(n * 3);
  const col = new Float32Array(n * 3);
  const color = new THREE.Color();

  states.forEach((s, i) => {
    pos[i * 3] = (i - n / 2) * 1.2;
    pos[i * 3 + 1] = s.amplitude * 20;
    pos[i * 3 + 2] = Math.sin(s.phase) * 15;
    const hue = (s.phase / (Math.PI * 2)) % 1;
    color.setHSL(hue, 0.85, 0.55);
    col[i * 3] = color.r;
    col[i * 3 + 1] = color.g;
    col[i * 3 + 2] = color.b;
  });

  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
  const mat = new THREE.PointsMaterial({ size: 1.4, vertexColors: true });
  const points = new THREE.Points(geo, mat);

  return {
    object: points,
    dispose: () => { geo.dispose(); mat.dispose(); },
  };
}
```

