### Composición `PhaseEngine.ts`

```typescript
import type { ComplexState, PhaseEngineConfig } from './types.js';
import { initStates } from './initStates.js';
import { evolveStep } from './evolveStep.js';
import { snapshot } from './snapshot.js';
import { secureMemoryPurge } from './secureMemoryPurge.js';

export class PhaseEngine {
  public readonly dimension: number;
  public readonly coherenceThreshold: number;
  public tick = 0;

  private initialSeed: number;
  private states: ComplexState[];

  constructor(config: PhaseEngineConfig) {
    this.dimension = config.dimension;
    this.coherenceThreshold = config.coherenceThreshold ?? 0.35;
    this.initialSeed = config.seed ?? 0xc0ffee;
    this.states = initStates(this.dimension, this.initialSeed);
  }

  public evolve(steps: number): void {
    for (let s = 0; s < steps; s++) {
      this.states = evolveStep(this.states);
      this.tick++;
    }
  }

  public snapshot(): ComplexState[] { return snapshot(this.states); }
  public amplitudes(): number[] { return this.states.map((s) => Math.abs(s.amplitude)); }

  public secureMemoryPurge(): void {
    this.states = secureMemoryPurge(this.states);
    this.tick = 0;
  }
}
```

