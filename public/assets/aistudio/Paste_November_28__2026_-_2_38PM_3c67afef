### Sub-herramienta `xorshift32.ts`

```typescript
export interface Xorshift32State { seed: number }

/** Crea el estado inicial. Rechaza semilla 0 (estado degenerado). */
export function createXorshift32(seed: number): Xorshift32State {
  const s = seed >>> 0;
  if (s === 0) throw new Error('seed must be non-zero');
  return { seed: s };
}

/** Avanza un paso. Retorna [state, value ∈ [0,1)]. */
export function nextXorshift32(state: Xorshift32State): [Xorshift32State, number] {
  let x = state.seed;
  x ^= x << 13;
  x ^= x >>> 17;
  x ^= x << 5;
  const next = x >>> 0;
  return [{ seed: next }, next / 0xffffffff];
}
```

### Sub-herramienta `seedGuard.ts`

