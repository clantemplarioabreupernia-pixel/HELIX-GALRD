### Sub-herramienta `buildReport.ts`

```typescript
import { normalizedEntropy } from '@phase-core/entropy';
import { orderParameter, type PhaseState } from './orderParameter.js';
import { belowThreshold, DEFAULT_THRESHOLD } from './thresholdCheck.js';

export interface CoherenceReport {
  coherence: number;
  entropy: number;
  defensiveCollapse: boolean;
  threshold: number;
  size: number;
}

export function buildReport(states: PhaseState[], threshold = DEFAULT_THRESHOLD): CoherenceReport {
  const coherence = orderParameter(states);
  const entropy = normalizedEntropy(states.map((s) => Math.abs(s.amplitude)));
  return {
    coherence,
    entropy,
    defensiveCollapse: belowThreshold(coherence, threshold),
    threshold,
    size: states.length,
  };
}
```

