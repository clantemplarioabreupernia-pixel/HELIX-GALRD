```tsx
import { useCallback, useEffect, useState } from 'react';
import { PhaseCanvas } from '@phase-core/three-renderer';
import { ProgressBar, StatBlock, ActionButton, DangerButton } from '@phase-core/ui-kit';

interface State { amplitude: number; phase: number }
interface Report {
  coherence: number; entropy: number;
  defensiveCollapse: boolean; threshold: number; size: number; tick: number;
}

export default function App() {
  const [states, setStates] = useState<State[]>([]);
  const [report, setReport] = useState<Report | null>(null);
  const [entropy, setEntropy] = useState(0);
  const [tick, setTick] = useState(0);

  const refresh = useCallback(async () => {
    const [s, c, e] = await Promise.all([
      fetch('/api/state').then((r) => r.json()),
      fetch('/api/coherence').then((r) => r.json()),
      fetch('/api/entropy').then((r) => r.json()),
    ]);
    setStates(s.states); setReport(c); setEntropy(e.entropy); setTick(s.tick);
  }, []);

  const evolve = useCallback(async (n: number) => {
    await fetch('/api/evolve', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ steps: n }),
    });
    await refresh();
  }, [refresh]);

  const purge = useCallback(async () => {
    await fetch('/api/purge', { method: 'POST' });
    await refresh();
  }, [refresh]);

  useEffect(() => { refresh(); }, [refresh]);

  return (
    <div style={{ minHeight: '100vh', background: '#0a0a12', color: '#e6e6f0', fontFamily: 'monospace' }}>
      <header style={{ padding: 16, borderBottom: '1px solid #1a1a22' }}>
        <h1 style={{ margin: 0, fontSize: 18 }}>Omega Phase Coherence Core</h1>
      </header>
      <main style={{ padding: 16, display: 'grid', gap: 16 }}>
        <PhaseCanvas states={states} />
        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>
          {report && (
            <StatBlock
              label="COHERENCE"
              value={`${Math.round(report.coherence * 100)}%`}
              color={report.defensiveCollapse ? '#e5484d' : '#46a758'}
              hint={`threshold: ${report.threshold} · size: ${report.size}`}
            />
          )}
          <StatBlock label="ENTROPY" value={entropy.toFixed(4)} hint={`tick: ${tick}`} />
        </div>
        {report && <ProgressBar value={report.coherence * 100} color={report.defensiveCollapse ? '#e5484d' : '#46a758'} />}
        <div style={{ display: 'flex', gap: 8 }}>
          <ActionButton onClick={() => evolve(1)}>+1</ActionButton>
          <ActionButton onClick={() => evolve(10)}>+10</ActionButton>
          <ActionButton onClick={() => evolve(100)}>+100</ActionButton>
          <DangerButton onClick={purge}>Purga segura</DangerButton>
        </div>
      </main>
    </div>
  );
}
```

