## B. AUDIO

### B.1. `audio-analyser` — Analizador de frecuencias

| Campo | Detalle |
|---|---|
| **Propósito** | Envolver `AnalyserNode` y exponer bandas normalizadas (0..1). |
| **Uso** | Lo consultan el motor 3D y el inspector para reaccionar al audio. |
| **Dependencias** | `AudioContext` del navegador |

```ts
// src/audio/audio-analyser.ts

export interface FrequencyBands {
  readonly bass: number;
  readonly mid: number;
  readonly treble: number;
  readonly average: number;
}

export class AudioAnalyser {
  private readonly node: AnalyserNode;
  private readonly buffer: Uint8Array;
  private readonly bassEnd: number;
  private readonly midEnd: number;

  constructor(node: AnalyserNode) {
    this.node = node;
    this.buffer = new Uint8Array(node.frequencyBinCount);
    const len = this.buffer.length;
    this.bassEnd = Math.floor(len * 0.1);
    this.midEnd = Math.floor(len * 0.4);
  }

  read(): FrequencyBands {
    this.node.getByteFrequencyData(this.buffer);
    const len = this.buffer.length;

    let b = 0, m = 0, t = 0;
    for (let i = 0; i < this.bassEnd; i++) b += this.buffer[i];
    for (let i = this.bassEnd; i < this.midEnd; i++) m += this.buffer[i];
    for (let i = this.midEnd; i < len; i++) t += this.buffer[i];

    const bass = b / (this.bassEnd * 255) || 0;
    const mid = m / ((this.midEnd - this.bassEnd) * 255) || 0;
    const treble = t / ((len - this.midEnd) * 255) || 0;

    return { bass, mid, treble, average: (bass + mid + treble) / 3 };
  }
}
```

