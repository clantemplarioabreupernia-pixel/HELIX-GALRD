### E.3. `job-queue` — Cola de trabajos de render

| Campo | Detalle |
|---|---|
| **Propósito** | Estado thread-safe de trabajos (pending/rendering/done/error). |
| **Uso** | Backend lo consulta y actualiza. |
| **Dependencias** | `node:crypto` |

```ts
// server/lib/job-queue.ts

import { randomUUID } from 'node:crypto';

export type JobStatus = 'pending' | 'rendering' | 'done' | 'error';

export interface RenderJob {
  readonly id: string;
  status: JobStatus;
  totalFrames: number;
  currentFrame: number;
  fps: number;
  outputPath?: string;
  error?: string;
  readonly createdAt: number;
}

export class JobQueue {
  private readonly jobs = new Map<string, RenderJob>();

  create(input: { totalFrames: number; fps: number }): RenderJob {
    const job: RenderJob = {
      id: `job_${randomUUID()}`,
      status: 'pending',
      totalFrames: input.totalFrames,
      currentFrame: 0,
      fps: input.fps,
      createdAt: Date.now(),
    };
    this.jobs.set(job.id, job);
    return job;
  }

  get(id: string): RenderJob | undefined {
    return this.jobs.get(id);
  }

  advance(id: string): void {
    const job = this.jobs.get(id);
    if (!job) return;
    job.currentFrame++;
    job.status = 'rendering';
  }

  complete(id: string, outputPath: string): void {
    const job = this.jobs.get(id);
    if (!job) return;
    job.status = 'done';
    job.outputPath = outputPath;
  }

  fail(id: string, error: string): void {
    const job = this.jobs.get(id);
    if (!job) return;
    job.status = 'error';
    job.error = error;
  }

  list(): RenderJob[] {
    return Array.from(this.jobs.values());
  }
}
```

