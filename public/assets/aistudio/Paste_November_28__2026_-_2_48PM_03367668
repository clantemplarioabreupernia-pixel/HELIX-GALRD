## C. RENDER Y CAPTURA

### C.1. `multi-pass-renderer` — Render de 3 pases (RGB/Depth/Normals)

| Campo | Detalle |
|---|---|
| **Propósito** | Capturar color, profundidad y normales de la escena por frame. |
| **Uso** | Alimenta el pipeline híbrido con ControlNet. |
| **Dependencias** | `three` |

```ts
// src/render/multi-pass-renderer.ts

import * as THREE from 'three';

export interface FramePasses {
  readonly rgb: Blob;
  readonly depth: Blob;
  readonly normals: Blob;
}

export class MultiPassRenderer {
  private readonly renderer: THREE.WebGLRenderer;
  private readonly scene: THREE.Scene;
  private readonly camera: THREE.Camera;

  constructor(scene: THREE.Scene, camera: THREE.Camera, width: number, height: number) {
    this.scene = scene;
    this.camera = camera;
    this.renderer = new THREE.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true });
    this.renderer.setSize(width, height);
    this.renderer.setPixelRatio(1);
  }

  private capture(): Promise<Blob> {
    return new Promise((resolve, reject) => {
      this.renderer.domElement.toBlob((blob) => (blob ? resolve(blob) : reject(new Error('empty canvas'))), 'image/png');
    });
  }

  private swapMaterials(factory: () => THREE.Material): Map<THREE.Mesh, THREE.Material | THREE.Material[]> {
    const backups = new Map<THREE.Mesh, THREE.Material | THREE.Material[]>();
    this.scene.traverse((obj) => {
      const mesh = obj as THREE.Mesh;
      if (mesh.isMesh) {
        backups.set(mesh, mesh.material);
        mesh.material = factory();
      }
    });
    return backups;
  }

  private restoreMaterials(backups: Map<THREE.Mesh, THREE.Material | THREE.Material[]>): void {
    this.scene.traverse((obj) => {
      const mesh = obj as THREE.Mesh;
      if (mesh.isMesh && backups.has(mesh)) mesh.material = backups.get(mesh)!;
    });
  }

  async renderRGB(): Promise<Blob> {
    this.renderer.render(this.scene, this.camera);
    return this.capture();
  }

  async renderDepth(): Promise<Blob> {
    const backups = this.swapMaterials(() => new THREE.MeshDepthMaterial({ depthPacking: THREE.BasicDepthPacking }));
    const oldBg = this.scene.background;
    this.scene.background = new THREE.Color(0x000000);
    this.renderer.render(this.scene, this.camera);
    const blob = await this.capture();
    this.scene.background = oldBg;
    this.restoreMaterials(backups);
    return blob;
  }

  async renderNormals(): Promise<Blob> {
    const backups = this.swapMaterials(() => new THREE.MeshNormalMaterial());
    const oldBg = this.scene.background;
    this.scene.background = new THREE.Color(0x8080ff);
    this.renderer.render(this.scene, this.camera);
    const blob = await this.capture();
    this.scene.background = oldBg;
    this.restoreMaterials(backups);
    return blob;
  }

  async renderFrame(): Promise<FramePasses> {
    const [rgb, depth, normals] = await Promise.all([
      this.renderRGB(),
      this.renderDepth(),
      this.renderNormals(),
    ]);
    return { rgb, depth, normals };
  }

  dispose(): void {
    this.renderer.dispose();
  }
}
```

