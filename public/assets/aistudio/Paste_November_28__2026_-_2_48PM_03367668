### C.2. `frame-recorder` — Grabación WebM vía MediaRecorder

| Campo | Detalle |
|---|---|
| **Propósito** | Grabar el canvas + audio a WebM en tiempo real. Rápido, sin backend. |
| **Uso** | Modo "grabación rápida" del estudio. |
| **Dependencias** | `MediaRecorder` del navegador |

```ts
// src/render/frame-recorder.ts

export interface RecorderOptions {
  canvas: HTMLCanvasElement;
  audioElement: HTMLAudioElement;
  fps?: number;
  mimeType?: string;
}

export class FrameRecorder {
  private recorder: MediaRecorder | null = null;
  private chunks: Blob[] = [];
  private readonly opts: Required<RecorderOptions>;

  constructor(options: RecorderOptions) {
    this.opts = {
      fps: 30,
      mimeType: 'video/webm;codecs=vp9,opus',
      ...options,
    } as Required<RecorderOptions>;
  }

  start(): void {
    const videoStream = this.opts.canvas.captureStream(this.opts.fps);
    const audioStream = (this.opts.audioElement as any).captureStream?.() as MediaStream | null;

    if (audioStream) {
      audioStream.getAudioTracks().forEach((t) => videoStream.addTrack(t));
    }

    this.chunks = [];
    this.recorder = new MediaRecorder(videoStream, { mimeType: this.opts.mimeType });
    this.recorder.ondataavailable = (e) => e.data.size > 0 && this.chunks.push(e.data);
    this.recorder.start(1000); // chunk de 1 segundo
  }

  stop(): Promise<Blob> {
    return new Promise((resolve, reject) => {
      if (!this.recorder) return reject(new Error('recorder not started'));
      this.recorder.onstop = () => resolve(new Blob(this.chunks, { type: this.opts.mimeType }));
      this.recorder.stop();
    });
  }
}
```

