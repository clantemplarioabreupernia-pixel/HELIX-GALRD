### E.2. `ffmpeg-wrapper` — Wrapper de ffmpeg

| Campo | Detalle |
|---|---|
| **Propósito** | Encapsular llamadas a ffmpeg para secuencia→video y mux de audio. |
| **Uso** | Finalización de cualquier render. |
| **Dependencias** | `node:child_process` |

```ts
// server/lib/ffmpeg-wrapper.ts

import { exec } from 'node:child_process';
import { promisify } from 'node:util';

const execAsync = promisify(exec);

export class FfmpegWrapper {
  constructor(private readonly binary = 'ffmpeg') {}

  async framesToVideo(framesDir: string, outputPath: string, fps: number): Promise<void> {
    const cmd =
      `${this.binary} -y -framerate ${fps} -i "${framesDir}/frame_%06d.png" ` +
      `-c:v libx264 -pix_fmt yuv420p -crf 18 "${outputPath}"`;
    await execAsync(cmd);
  }

  async muxAudio(videoPath: string, audioPath: string, outputPath: string): Promise<void> {
    const cmd =
      `${this.binary} -y -i "${videoPath}" -i "${audioPath}" ` +
      `-c:v copy -c:a aac -shortest "${outputPath}"`;
    await execAsync(cmd);
  }

  async version(): Promise<string> {
    try {
      const { stdout } = await execAsync(`${this.binary} -version`);
      return stdout.split('\n')[0];
    } catch {
      return 'ffmpeg not available';
    }
  }
}
