### D.3. `ai-client` — Cliente IA (OpenAI/Gemini) con contrato

| Campo | Detalle |
|---|---|
| **Propósito** | Llamar a un proveedor IA y devolver un `StoryboardDTO` validado. |
| **Uso** | Modo "IA real" del generador. |
| **Dependencias** | `openai` o `@google/genai`, `storyboard-contract` |

```ts
// src/storyboard/ai-client.ts

import { StoryboardSchema, type StoryboardDTO } from './storyboard-contract';

export type AiProvider = 'openai' | 'gemini';

export interface AiClientOptions {
  provider: AiProvider;
  apiKey: string;
  model?: string;
}

const SYSTEM_PROMPT = `Eres un director de video clips para música Dark Country.
Devuelve SOLO JSON válido con un array de escenas con esta forma:
{ "startSec": number, "endSec": number, "kind": "orb"|"particles"|"terrain"|"tunnel"|"grid",
  "palette": "fire"|"ice"|"forest"|"neon"|"desert",
  "intensity": 0..1, "camera": "static"|"orbit"|"zoom"|"pan", "label": string }`;

export class AiClient {
  constructor(private readonly opts: AiClientOptions) {}

  async generateStoryboard(userPrompt: string, totalDurationSec: number): Promise<StoryboardDTO> {
    const payload = await this.callProvider(userPrompt, totalDurationSec);
    return StoryboardSchema.parse(payload);
  }

  private async callProvider(userPrompt: string, totalDurationSec: number): Promise<unknown> {
    const prompt = `${SYSTEM_PROMPT}\nDuración total: ${totalDurationSec}s.\nBrief: ${userPrompt}`;

    if (this.opts.provider === 'openai') {
      const res = await fetch('https://api.openai.com/v1/chat/completions', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${this.opts.apiKey}`,
        },
        body: JSON.stringify({
          model: this.opts.model ?? 'gpt-4o-mini',
          response_format: { type: 'json_object' },
          messages: [{ role: 'system', content: prompt }],
        }),
      });
      const json = await res.json();
      const content = json.choices?.[0]?.message?.content ?? '[]';
      const parsed = JSON.parse(content);
      return Array.isArray(parsed) ? parsed : parsed.scenes ?? [];
    }

    // gemini
    const res = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/${this.opts.model ?? 'gemini-1.5-flash'}:generateContent?key=${this.opts.apiKey}`,
      {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] }),
      },
    );
    const json = await res.json();
    const text = json.candidates?.[0]?.content?.parts?.[0]?.text ?? '[]';
    const clean = text.replace(/```json|```/g, '').trim();
    return JSON.parse(clean);
  }
}
```

