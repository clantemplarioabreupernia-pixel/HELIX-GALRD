## F. BACKEND

### F.1. `render-orchestrator` — Orquestador del pipeline

| Campo | Detalle |
|---|---|
| **Propósito** | Recibir depth map + prompt, invocar ComfyUI, escribir frame final. |
| **Uso** | Núcleo del endpoint `/api/render/frame/:jobId`. |
| **Dependencias** | `comfyui-client`, `frame-sequence-writer` |

```ts
// server/lib/render-orchestrator.ts

import { ComfyUIClient } from './comfyui-client';
import { FrameSequenceWriter } from './frame-sequence-writer';

export interface OrchestratorDeps {
  comfy: ComfyUIClient;
  writer: FrameSequenceWriter;
}

export interface RenderFrameInput {
  depthBuffer: Buffer;
  prompt: string;
  seed: number;
}

export class RenderOrchestrator {
  constructor(private readonly deps: OrchestratorDeps) {}

  async renderFrame(input: RenderFrameInput): Promise<string> {
    const { comfy, writer } = this.deps;

    const depthName = await comfy.uploadImage(input.depthBuffer, `depth_${Date.now()}.png`);
    const promptId = await comfy.enqueue(this.buildWorkflow(depthName, input.prompt, input.seed));
    const result = await comfy.waitForResult(promptId);

    // Descarga la primera imagen producida por ComfyUI
    const firstOutput = Object.values(result.outputs)[0];
    const imageName = firstOutput?.images?.[0]?.filename;
    if (!imageName) throw new Error('ComfyUI no devolvió imagen');

    const imageRes = await fetch(
      `${(comfy as any).baseUrl}/view?filename=${encodeURIComponent(imageName)}&type=output`,
    );
    const buffer = Buffer.from(await imageRes.arrayBuffer());
    return writer.write(buffer);
  }

  private buildWorkflow(depthImageName: string, prompt: string, seed: number): unknown {
    // Carga el JSON estático (workflows/comfyui_depth_controlnet.json) y sustituye placeholders.
    return {
      ...require('../../../workflows/comfyui_depth_controlnet.json'),
      // placeholders reemplazados en tiempo de build en producción
      _depth: depthImageName,
      _prompt: prompt,
      _seed: seed,
    };
  }
}
```

