### G.1. `project-store` — Store central del frontend

| Campo | Detalle |
|---|---|
| **Propósito** | Estado único de escenas + selección + playback. |
| **Uso** | Consumido por `App`, `ScenePanel`, `Inspector`. |
| **Dependencias** | `react`, `scene-types`, `audio-sync` |

```ts
// src/state/project-store.ts

import { useCallback, useMemo, useState } from 'react';
import type { Scene } from '../core/scene-types';
import { resolveSceneAt, totalDuration } from '../audio/audio-sync';

export interface ProjectState {
  scenes: Scene[];
  selectedId: string | null;
  timeSec: number;
  isPlaying: boolean;
}

export function useProjectStore(initial: Scene[] = []) {
  const [scenes, setScenes] = useState<Scene[]>(initial);
  const [selectedId, setSelectedId] = useState<string | null>(initial[0]?.id ?? null);
  const [timeSec, setTimeSec] = useState(0);
  const [isPlaying, setIsPlaying] = useState(false);

  const updateScene = useCallback((id: string, patch: Partial<Scene>) => {
    setScenes((prev) => prev.map((s) => (s.id === id ? { ...s, ...patch } : s)));
  }, []);

  const replaceScenes = useCallback((next: Scene[]) => {
    setScenes(next);
    setSelectedId(next[0]?.id ?? null);
  }, []);

  const current = useMemo(() => resolveSceneAt(scenes, timeSec), [scenes, timeSec]);
  const duration = useMemo(() => totalDuration(scenes), [scenes]);

  return {
    scenes, selectedId, timeSec, isPlaying,
    setSelectedId, setTimeSec, setIsPlaying,
    updateScene, replaceScenes,
    current, duration,
  };
}
