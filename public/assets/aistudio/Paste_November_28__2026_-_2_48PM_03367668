### B.2. `audio-sync` — Sincronización audio-escena

| Campo | Detalle |
|---|---|
| **Propósito** | Dado un tiempo `t`, devolver la escena activa y progreso dentro de ella. |
| **Uso** | Motor de playback para mantener video y audio alineados. |
| **Dependencias** | `scene-types` |

```ts
// src/audio/audio-sync.ts

import type { Scene } from '../core/scene-types';

export interface SceneAtTime {
  readonly scene: Scene;
  readonly progress: number; // 0..1 dentro de la escena
}

export function resolveSceneAt(scenes: readonly Scene[], timeSec: number): SceneAtTime | null {
  if (scenes.length === 0) return null;
  const active = scenes.find((s) => timeSec >= s.startSec && timeSec < s.endSec) ?? scenes[0];
  const span = Math.max(active.endSec - active.startSec, 1e-6);
  const progress = Math.min(Math.max((timeSec - active.startSec) / span, 0), 1);
  return { scene: active, progress };
}

export function totalDuration(scenes: readonly Scene[]): number {
  return scenes.reduce((max, s) => Math.max(max, s.endSec), 0);
}
```

