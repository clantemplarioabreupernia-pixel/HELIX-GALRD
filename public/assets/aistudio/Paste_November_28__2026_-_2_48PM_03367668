### A.2. `palette-system` — Paletas de color

| Campo | Detalle |
|---|---|
| **Propósito** | Paletas inmutables que garantizan coherencia visual por escena. |
| **Uso** | Lookup por `PaletteId` en el motor de escena. |
| **Dependencias** | `scene-types` |

```ts
// src/core/palette-system.ts

import type { PaletteId } from './scene-types';

export interface PaletteColors {
  readonly bg: string;
  readonly primary: string;
  readonly secondary: string;
  readonly accent: string;
}

export const PALETTES: Readonly<Record<PaletteId, PaletteColors>> = Object.freeze({
  fire:    { bg: '#1a0a05', primary: '#ff4d00', secondary: '#ffaa00', accent: '#ff2200' },
  ice:     { bg: '#05101a', primary: '#00aaff', secondary: '#aaddff', accent: '#ffffff' },
  forest:  { bg: '#0a1a0a', primary: '#00cc44', secondary: '#88ff88', accent: '#004400' },
  neon:    { bg: '#0a001a', primary: '#ff00ff', secondary: '#00ffff', accent: '#ffff00' },
  desert:  { bg: '#1a1005', primary: '#ffaa44', secondary: '#ffdd88', accent: '#cc6600' },
});

export const getPalette = (id: PaletteId): PaletteColors => PALETTES[id];
```

