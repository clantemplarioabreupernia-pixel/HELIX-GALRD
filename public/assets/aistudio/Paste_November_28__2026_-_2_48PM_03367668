### D.2. `storyboard-generator` — Generador heurístico local

| Campo | Detalle |
|---|---|
| **Propósito** | Generar storyboards sin depender de API externa. |
| **Uso** | Fallback y modo offline. |
| **Dependencias** | `scene-types`, `storyboard-contract` |

```ts
// src/storyboard/storyboard-generator.ts

import { StoryboardSchema } from './storyboard-contract';
import type { Scene } from '../core/scene-types';

export async function generateStoryboard(totalDurationSec: number, _prompt: string): Promise<Scene[]> {
  const blocks = 5;
  const span = totalDurationSec / blocks;

  const raw = Array.from({ length: blocks }).map((_, i) => ({
    startSec: i * span,
    endSec: (i + 1) * span,
    kind: (['orb', 'particles', 'terrain', 'tunnel', 'grid'] as const)[i],
    palette: (['fire', 'neon', 'desert', 'ice', 'forest'] as const)[i],
    intensity: 0.5 + (i % 3) * 0.15,
    camera: (['zoom', 'orbit', 'pan', 'zoom', 'static'] as const)[i],
    label: ['Intro', 'Verso 1', 'Coro', 'Puente', 'Outro'][i],
  }));

  const parsed = StoryboardSchema.parse(raw);
  return parsed.map((s, i) => ({ id: `scene_${Date.now()}_${i}`, ...s })) as Scene[];
}
```

