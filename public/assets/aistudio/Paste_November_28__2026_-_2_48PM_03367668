### A.3. `three-viewport` — Componente de viewport 3D

| Campo | Detalle |
|---|---|
| **Propósito** | Renderizar la escena activa y animarla en función del audio. |
| **Uso** | Componente React montado en `App`. Consume `Scene` y `AudioAnalyser`. |
| **Dependencias** | `@react-three/fiber`, `@react-three/drei`, `three`, `scene-types`, `palette-system`, `audio-analyser` |

```tsx
// src/components/three-viewport.tsx

import { useMemo, useRef } from 'react';
import { Canvas, useFrame, useThree } from '@react-three/fiber';
import { OrbitControls, Sphere, Box, Torus, Grid, Points, PointMaterial, Stars } from '@react-three/drei';
import * as THREE from 'three';
import type { Scene } from '../core/scene-types';
import { getPalette } from '../core/palette-system';
import type { AudioAnalyser } from '../audio/audio-analyser';

interface SceneLayerProps {
  scene: Scene;
  analyser: AudioAnalyser | null;
}

function SceneLayer({ scene, analyser }: SceneLayerProps) {
  const meshRef = useRef<THREE.Mesh>(null);
  const pointsRef = useRef<THREE.Points>(null);
  const { camera } = useThree();
  const palette = getPalette(scene.palette);

  useFrame((state) => {
    const t = state.clock.elapsedTime;
    const a = analyser?.read() ?? { bass: 0, mid: 0, treble: 0, average: 0 };
    const energy = (a.bass * 0.6 + a.mid * 0.3 + a.treble * 0.1) * scene.intensity;

    // Movimiento de cámara determinista
    switch (scene.camera) {
      case 'orbit':
        camera.position.set(Math.sin(t * 0.2) * 8, 3 + Math.sin(t * 0.3) * 2, Math.cos(t * 0.2) * 8);
        break;
      case 'zoom':
        camera.position.set(0, 3, 5 + Math.sin(t * 0.5) * 3);
        break;
      case 'pan':
        camera.position.set(Math.sin(t * 0.15) * 6, 3, 8);
        break;
      default:
        camera.position.set(0, 3, 8);
    }
    camera.lookAt(0, 0, 0);

    if (meshRef.current) {
      switch (scene.kind) {
        case 'orb':
          meshRef.current.scale.setScalar(1 + energy * 1.5);
          meshRef.current.rotation.y += 0.01 + a.treble * 0.05;
          break;
        case 'tunnel':
          meshRef.current.rotation.z += 0.01;
          meshRef.current.scale.setScalar(1 + a.mid * 0.5);
          break;
        case 'terrain':
          meshRef.current.rotation.y += 0.002;
          meshRef.current.position.y = -1 + a.bass * 0.5;
          break;
      }
    }
    if (pointsRef.current) {
      pointsRef.current.rotation.y += 0.002 + a.treble * 0.01;
      pointsRef.current.scale.setScalar(1 + energy * 0.8);
    }
  });

  const layer = useMemo(() => {
    switch (scene.kind) {
      case 'orb':
        return (
          <Sphere ref={meshRef} args={[1.5, 64, 64]}>
            <meshStandardMaterial
              color={palette.primary}
              emissive={palette.accent}
              emissiveIntensity={0.5 + scene.intensity}
              roughness={0.2}
              metalness={0.8}
            />
          </Sphere>
        );
      case 'particles':
        return (
          <Points
            ref={pointsRef}
            positions={new Float32Array(5000 * 3).map(() => (Math.random() - 0.5) * 20)}
          >
            <PointMaterial color={palette.primary} size={0.05} sizeAttenuation transparent opacity={0.8} />
          </Points>
        );
      case 'terrain':
        return (
          <Box ref={meshRef} args={[10, 0.5, 10]} position={[0, -2, 0]}>
            <meshStandardMaterial color={palette.secondary} wireframe />
          </Box>
        );
      case 'tunnel':
        return (
          <Torus ref={meshRef} args={[3, 0.5, 16, 100]} rotation={[Math.PI / 2, 0, 0]}>
            <meshStandardMaterial color={palette.primary} emissive={palette.accent} emissiveIntensity={0.8} wireframe />
          </Torus>
        );
      case 'grid':
        return (
          <Grid
            args={[20, 20]}
            cellSize={0.5}
            cellThickness={0.5}
            cellColor={palette.primary}
            sectionSize={2}
            sectionThickness={1}
            sectionColor={palette.secondary}
            fadeDistance={30}
            fadeStrength={1}
            position={[0, -2, 0]}
          />
        );
    }
  }, [scene, palette]);

  return (
    <>
      <color attach="background" args={[palette.bg]} />
      <ambientLight intensity={0.3} />
      <pointLight position={[5, 5, 5]} color={palette.primary} intensity={1 + scene.intensity * 2} />
      <pointLight position={[-5, 3, -5]} color={palette.secondary} intensity={0.5 + scene.intensity} />
      {layer}
      <Stars radius={100} depth={50} count={2000} factor={4} saturation={0} fade speed={1} />
    </>
  );
}

interface ThreeViewportProps {
  scene: Scene;
  analyser: AudioAnalyser | null;
  canvasRef?: React.Ref<HTMLCanvasElement>;
}

export function ThreeViewport({ scene, analyser, canvasRef }: ThreeViewportProps) {
  return (
    <Canvas
      ref={canvasRef as any}
      camera={{ position: [0, 3, 8], fov: 60 }}
      gl={{ preserveDrawingBuffer: true, antialias: true }}
      style={{ position: 'absolute', inset: 0 }}
    >
      <SceneLayer scene={scene} analyser={analyser} />
      <OrbitControls enablePan={false} />
    </Canvas>
  );
}
```

