### F.2. `express-server` — Servidor HTTP

| Campo | Detalle |
|---|---|
| **Propósito** | Exponer endpoints REST para start/frame/status/finalize. |
| **Uso** | Punto de entrada backend. |
| **Dependencias** | `express`, `multer`, `job-queue`, `ffmpeg-wrapper` |

```ts
// server/express-server.ts

import express from 'express';
import multer from 'multer';
import path from 'node:path';
import { JobQueue } from './lib/job-queue';
import { FfmpegWrapper } from './lib/ffmpeg-wrapper';
import { ComfyUIClient } from './lib/comfyui-client';
import { FrameSequenceWriter } from './lib/frame-sequence-writer';
import { RenderOrchestrator } from './lib/render-orchestrator';

export function createServer(deps: { scratchDir: string; comfyUrl: string; port: number }) {
  const app = express();
  const upload = multer({ dest: path.join(deps.scratchDir, 'uploads') });
  const queue = new JobQueue();
  const ffmpeg = new FfmpegWrapper();
  const comfy = new ComfyUIClient({ baseUrl: deps.comfyUrl });

  app.use(express.json({ limit: '50mb' }));

  app.post('/api/render/start', (req, res) => {
    const { totalFrames, fps } = req.body as { totalFrames: number; fps: number };
    const job = queue.create({ totalFrames, fps });
    res.json({ jobId: job.id });
  });

  app.post('/api/render/frame/:jobId', upload.single('depth'), async (req, res) => {
    const job = queue.get(req.params.jobId);
    if (!job) return res.status(404).json({ error: 'job not found' });

    try {
      const writer = new FrameSequenceWriter(path.join(deps.scratchDir, job.id, 'frames'));
      await writer.ensureDir();
      const orch = new RenderOrchestrator({ comfy, writer });
      await orch.renderFrame({
        depthBuffer: await import('node:fs/promises').then((fs) => fs.readFile(req.file!.path)),
        prompt: req.body.prompt ?? '',
        seed: Number(req.body.seed) || 42,
      });
      queue.advance(job.id);
      res.json({ ok: true, frame: job.currentFrame });
    } catch (e: any) {
      queue.fail(job.id, e.message);
      res.status(500).json({ error: e.message });
    }
  });

  app.get('/api/render/status/:jobId', (req, res) => {
    const job = queue.get(req.params.jobId);
    if (!job) return res.status(404).json({ error: 'not found' });
    res.json(job);
  });

  app.post('/api/render/finalize/:jobId', async (req, res) => {
    const job = queue.get(req.params.jobId);
    if (!job) return res.status(404).json({ error: 'not found' });

    const { audioPath } = req.body as { audioPath: string };
    const framesDir = path.join(deps.scratchDir, job.id, 'frames');
    const silent = path.join(deps.scratchDir, job.id, 'silent.mp4');
    const output = path.join(deps.scratchDir, job.id, 'output.mp4');

    try {
      await ffmpeg.framesToVideo(framesDir, silent, job.fps);
      await ffmpeg.muxAudio(silent, audioPath, output);
      queue.complete(job.id, output);
      res.json({ ok: true, outputPath: output });
    } catch (e: any) {
      queue.fail(job.id, e.message);
      res.status(500).json({ error: e.message });
    }
  });

  return { app, listen: () => app.listen(deps.port, () => console.log(`🎬 backend http://localhost:${deps.port}`)) };
}
```

