## H-26 · `src/services/gemini.service.ts`

**Uso:** Servicio de dominio del chat
**Fin:** Combina cliente + prompt + `Result`

```ts
import { geminiClient } from "./gemini.client";
import { GEMINI_SYSTEM_PROMPT } from "@/config/prompts";
import { LIMITS } from "@/config/constants";
import { err, ok, type Result } from "@/lib/result";
import { isAppError } from "@/lib/errors";

export interface AskGeminiInput {
  readonly prompt: string;
}

export const geminiService = {
  async ask({ prompt }: AskGeminiInput): Promise<Result<string>> {
    const trimmed = prompt.trim().slice(0, LIMITS.chatMaxInputChars);
    if (!trimmed) return err(new Error("Prompt vacío"));

    try {
      const text = await geminiClient.generate({
        prompt: trimmed,
        systemInstruction: GEMINI_SYSTEM_PROMPT,
        temperature: LIMITS.geminiTemperature,
        maxOutputTokens: LIMITS.geminiMaxTokens,
      });
      return ok(text || "[Sin respuesta]");
    } catch (e) {
      if (isAppError(e)) return err(e);
      return err(new Error("Error desconocido"));
    }
  },
};
```

