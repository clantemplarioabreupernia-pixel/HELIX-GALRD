import { useCallback } from "react";
import { useLocalStorage } from "./useLocalStorage";
import { STORAGE_KEYS } from "@/config/constants";
import type { ProgressMap, ReadingProgress } from "@/types";

export const useProgress = () => {
  const [progress, setProgress] = useLocalStorage<ProgressMap>(
    STORAGE_KEYS.progress,
    {}
  );

  const save = useCallback(
    (chapterSlug: string, scrollPercent: number) => {
      const entry: ReadingProgress = {
        chapterSlug,
        scrollPercent: Math.max(0, Math.min(100, scrollPercent)),
        updatedAt: new Date().toISOString(),
      };
      setProgress((prev) => ({ ...prev, [chapterSlug]: entry }));
    },
    [setProgress]
  );

  return { progress, save };
};
```

