.spinner svg { animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
.skeleton { background: linear-gradient(90deg, #1a1a1a, #252525, #1a1a1a); border-radius: 6px; background-size: 200% 100%; animation: pulse 1.5s infinite; }
@keyframes pulse { to { background-position: -200% 0; } }
.error-fallback { padding: 2rem; text-align: center; }
