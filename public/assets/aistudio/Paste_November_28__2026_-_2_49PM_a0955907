import type { Chapter, ChapterSummary } from "@/types";
import { chaptersSeed } from "@/data/chapters.seed";
import { err, ok, type Result } from "@/lib/result";
import { AppError } from "@/lib/errors";

const toSummary = ({ body: _body, ...rest }: Chapter): ChapterSummary => rest;

export const chaptersRepository = {
  list(): readonly ChapterSummary[] {
    return chaptersSeed.map(toSummary);
  },

  findBySlug(slug: string): Result<Chapter, AppError> {
    const chapter = chaptersSeed.find((c) => c.slug === slug);
    return chapter
      ? ok(chapter)
      : err(new AppError("CHAPTER_NOT_FOUND", `Capítulo '${slug}' no existe`));
  },

  count(): number {
    return chaptersSeed.length;
  },
};
```

