export const padChapter = (n: number): string =>
  String(n).padStart(2, "0");

export const truncate = (s: string, max = 120): string =>
  s.length <= max ? s : `${s.slice(0, max).trimEnd()}…`;

export const slugify = (s: string): string =>
  s
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
