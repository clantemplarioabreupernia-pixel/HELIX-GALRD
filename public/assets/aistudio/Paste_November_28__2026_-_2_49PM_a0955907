## H-25 · `src/services/gemini.client.ts`

**Uso:** Cliente de bajo nivel Gemini
**Fin:** Aislar `@google/genai` detrás de un contrato

```ts
import { GoogleGenAI } from "@google/genai";
import { env } from "@/config/env";
import { AppError } from "@/lib/errors";
import { logger } from "@/lib/logger";

let client: GoogleGenAI | null = null;

const getClient = (): GoogleGenAI => {
  if (!env.isGeminiEnabled) {
    throw new AppError("ENV_MISSING", "VITE_GEMINI_API_KEY no definida");
  }
  if (!client) {
    client = new GoogleGenAI({ apiKey: env.geminiApiKey! });
  }
  return client;
};

export interface GeminiGenerateInput {
  readonly prompt: string;
  readonly systemInstruction?: string;
  readonly temperature?: number;
  readonly maxOutputTokens?: number;
}

export const geminiClient = {
  async generate(input: GeminiGenerateInput): Promise<string> {
    const ai = getClient();
    try {
      const response = await ai.models.generateContent({
        model: env.geminiModel,
        contents: [{ role: "user", parts: [{ text: input.prompt }] }],
        config: {
          systemInstruction: input.systemInstruction,
          temperature: input.temperature,
          maxOutputTokens: input.maxOutputTokens,
        },
      });
      return response.text ?? "";
    } catch (e) {
      logger.error("gemini.client", "generate failed", e);
      throw new AppError("GEMINI_FAILED", "Error al invocar Géminis", e);
    }
  },
};
```

