interface AppEnv {
  readonly geminiApiKey: string | null;
  readonly geminiModel: string;
  readonly appEnv: "development" | "production" | "test";
  readonly isGeminiEnabled: boolean;
}

const readEnv = (): AppEnv => {
  const key = import.meta.env.VITE_GEMINI_API_KEY?.trim() || null;
  const model = import.meta.env.VITE_GEMINI_MODEL?.trim() || "gemini-2.0-flash";
  const mode = (import.meta.env.VITE_APP_ENV ?? import.meta.env.MODE) as AppEnv["appEnv"];

  return Object.freeze({
    geminiApiKey: key,
    geminiModel: model,
    appEnv: mode,
    isGeminiEnabled: Boolean(key),
  });
};

export const env: AppEnv = readEnv();
