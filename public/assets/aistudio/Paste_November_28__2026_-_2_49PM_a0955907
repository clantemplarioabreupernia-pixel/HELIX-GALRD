## H-32 · `src/hooks/useGeminiChat.ts`

**Uso:** Estado del chat con Géminis
**Fin:** Encapsular mensajes, loading y error

```ts
import { useCallback, useState } from "react";
import type { GeminiMessage, GeminiChatState } from "@/types";
import { geminiService } from "@/services/gemini.service";
import { createId } from "@/lib/id";
import { LIMITS } from "@/config/constants";

const initialState: GeminiChatState = {
  messages: [],
  status: "idle",
  error: null,
};

export const useGeminiChat = () => {
  const [state, setState] = useState<GeminiChatState>(initialState);

  const send = useCallback(async (content: string) => {
    const trimmed = content.trim().slice(0, LIMITS.chatMaxInputChars);
    if (!trimmed) return;

    const userMessage: GeminiMessage = {
      id: createId(),
      role: "user",
      content: trimmed,
      createdAt: new Date().toISOString(),
    };

    setState((prev) => ({
      ...prev,
      messages: [...prev.messages, userMessage].slice(-LIMITS.chatMaxMessages),
      status: "loading",
      error: null,
    }));

    const result = await geminiService.ask({ prompt: trimmed });

    setState((prev) => {
      if (!result.ok) {
        return { ...prev, status: "error", error: result.error.message };
      }
      const modelMessage: GeminiMessage = {
        id: createId(),
        role: "model",
        content: result.value,
        createdAt: new Date().toISOString(),
      };
      return {
        ...prev,
        messages: [...prev.messages, modelMessage].slice(-LIMITS.chatMaxMessages),
        status: "ready",
        error: null,
      };
    });
  }, []);

  const reset = useCallback(() => setState(initialState), []);

  return { ...state, send, reset };
};
```

