      </p>
    );
  }

  return (
    <section className="chat">
      <div className="chat-log">
        {messages.length === 0 && <p className="chat-empty">Habla con Géminis.</p>}
        {messages.map((m) => (
          <div key={m.id} className={`chat-msg chat-msg--${m.role}`}>
            <strong>{m.role === "user" ? "Tú" : "Géminis"}</strong>
            <p>{m.content}</p>
          </div>
