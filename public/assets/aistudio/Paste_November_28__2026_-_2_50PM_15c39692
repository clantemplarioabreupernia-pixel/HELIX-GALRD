### `src/engine/terrain/Noise.ts`
```ts
import { createPrng } from "../../lib/utils/prng";

/**
 * Ruido de valor con interpolación smoothstep. Determinista por semilla.
 * Reemplaza Math.random() para que el mismo seed produzca el mismo mundo.
 */
export class ValueNoise {
  private readonly perm: Uint16Array;

  constructor(seed: number) {
    const rng = createPrng(seed);
    const table = new Uint16Array(256);
    for (let i = 0; i < 256; i++) table[i] = i;
    for (let i = 255; i > 0; i--) {
      const j = Math.floor(rng() * (i + 1));
      [table[i], table[j]] = [table[j], table[i]];
    }
    this.perm = new Uint16Array(512);
    for (let i = 0; i < 512; i++) this.perm[i] = table[i & 255];
  }

  private hash(x: number, y: number): number {
    return this.perm[(this.perm[x & 255] + y) & 255] / 255;
  }

  sample(x: number, y: number): number {
    const xi = Math.floor(x);
    const yi = Math.floor(y);
    const xf = x - xi;
    const yf = y - yi;
    const u = xf * xf * (3 - 2 * xf);
    const v = yf * yf * (3 - 2 * yf);
    const a = this.hash(xi, yi);
    const b = this.hash(xi + 1, yi);
    const c = this.hash(xi, yi + 1);
    const d = this.hash(xi + 1, yi + 1);
    return a * (1 - u) * (1 - v) + b * u * (1 - v) + c * (1 - u) * v + d * u * v;
  }
}
```

### `src/engine/terrain/TerrainGenerator.ts`
```ts
import * as THREE from "three";
import type { BiomeId, TerrainSpec } from "../../types/world";
import { WORLD_LIMITS } from "../../config/constants";
import { ValueNoise } from "./Noise";

const BIOME_COLORS: Record<BiomeId, number> = {
  plains:   0x4a7c59,
  forest:   0x2f5d3a,
  desert:   0xc2a878,
  mountain: 0x8a8a8a,
  tundra:   0xc9d6d9,
  volcanic: 0x3a2a2a,
};

export class TerrainGenerator {
  private mesh: THREE.Mesh | null = null;

  constructor(
    private readonly spec: TerrainSpec,
    private readonly biomes: readonly BiomeId[],
  ) {}

  attach(scene: THREE.Scene): void {
    const res = WORLD_LIMITS.TERRAIN_RESOLUTION;
    const geometry = new THREE.PlaneGeometry(200, 200, res, res);
    geometry.rotateX(-Math.PI / 2);

    const noise = new ValueNoise(this.spec.seed);
    const positions = geometry.attributes.position as THREE.BufferAttribute;

    for (let i = 0; i < positions.count; i++) {
      const x = positions.getX(i);
      const z = positions.getZ(i);
      let y = 0;
      let amp = this.spec.amplitude * 20;
      let freq = this.spec.frequency;

      for (let o = 0; o < this.spec.octaves; o++) {
        y += noise.sample(x * freq * 0.05, z * freq * 0.05) * amp;
        amp *= this.spec.persistence;
        freq *= 2;
      }
      positions.setY(i, y);
    }

    positions.needsUpdate = true;
    geometry.computeVertexNormals();

    const material = new THREE.MeshStandardMaterial({
      color: BIOME_COLORS[this.biomes[0] ?? "plains"],
      roughness: 0.9,
      metalness: 0.05,
      flatShading: false,
    });

    this.mesh = new THREE.Mesh(geometry, material);
    this.mesh.receiveShadow = true;
    scene.add(this.mesh);
  }

  dispose(scene: THREE.Scene): void {
    if (!this.mesh) return;
    scene.remove(this.mesh);
    this.mesh.geometry.dispose();
    (this.mesh.material as THREE.Material).dispose();
    this.mesh = null;
  }
}
```

### `src/engine/camera/CinematicCamera.ts`
```ts
import * as THREE from "three";
import type { CameraKeyframe } from "../../types/world";
import { lerp } from "../../lib/utils/math";

export class CinematicCamera {
  private keyframes: readonly CameraKeyframe[] = [];
  private index = 0;
  private elapsed = 0;
  private lastTime = 0;

  constructor(private readonly camera: THREE.PerspectiveCamera) {}

  loadKeyframes(frames: readonly CameraKeyframe[]): void {
    this.keyframes = frames;
    this.index = 0;
    this.elapsed = 0;
    this.lastTime = 0;
    if (frames.length > 0) this.applyStatic(frames[0]);
  }

  tick(): void {
    if (this.keyframes.length < 2) return;
    const now = performance.now();
    if (this.lastTime === 0) { this.lastTime = now; return; }
    const dt = now - this.lastTime;
    this.lastTime = now;
    this.elapsed += dt;

    const a = this.keyframes[this.index];
    const b = this.keyframes[(this.index + 1) % this.keyframes.length];
    const t = Math.min(this.elapsed / a.duration, 1);

    this.camera.position.set(
      lerp(a.position[0], b.position[0], t),
      lerp(a.position[1], b.position[1], t),
      lerp(a.position[2], b.position[2], t),
    );
    this.camera.lookAt(
      lerp(a.target[0], b.target[0], t),
      lerp(a.target[1], b.target[1], t),
      lerp(a.target[2], b.target[2], t),
    );

    if (t >= 1) {
      this.index = (this.index + 1) % this.keyframes.length;
      this.elapsed = 0;
    }
  }

  private applyStatic(frame: CameraKeyframe): void {
    this.camera.position.set(...frame.position);
    this.camera.lookAt(...frame.target);
  }
}
