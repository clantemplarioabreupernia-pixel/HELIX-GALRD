### `src/lib/ai/schema.ts`
```ts
import type { BiomeId, CameraKeyframe, TerrainSpec, WorldSpec } from "../../types/world";
import { WORLD_LIMITS } from "../../config/constants";
import { clamp } from "../utils/math";

const VALID_BIOMES: readonly BiomeId[] = [
  "plains", "forest", "desert", "mountain", "tundra", "volcanic",
];

type RawSpec = {
  biomes?: unknown;
  terrain?: Record<string, unknown>;
  camera?: unknown;
};

function parseTerrain(raw: unknown): TerrainSpec {
  const t = (raw ?? {}) as Record<string, number | undefined>;
  return {
    seed: Number.isFinite(t.seed) ? Number(t.seed) : 42,
    amplitude: clamp(Number(t.amplitude ?? 0.5), WORLD_LIMITS.MIN_AMPLITUDE, WORLD_LIMITS.MAX_AMPLITUDE),
    octaves: Math.round(clamp(Number(t.octaves ?? 4), WORLD_LIMITS.MIN_OCTAVES, WORLD_LIMITS.MAX_OCTAVES)),
    frequency: Math.max(0.001, Number(t.frequency ?? 1)),
    persistence: clamp(Number(t.persistence ?? 0.5), 0.01, 0.99),
  };
}

function parseCamera(raw: unknown): CameraKeyframe[] {
  if (!Array.isArray(raw)) return [];
  return raw.slice(0, 20).map((k): CameraKeyframe => {
    const obj = (k ?? {}) as Record<string, unknown>;
    const pos = Array.isArray(obj.position) ? obj.position : [0, 10, 20];
    const tgt = Array.isArray(obj.target) ? obj.target : [0, 0, 0];
    return {
      position: [Number(pos[0] ?? 0), Number(pos[1] ?? 10), Number(pos[2] ?? 20)],
      target: [Number(tgt[0] ?? 0), Number(tgt[1] ?? 0), Number(tgt[2] ?? 0)],
      duration: Math.max(500, Number(obj.duration ?? 3000)),
    };
  });
}

function parseBiomes(raw: unknown): BiomeId[] {
  if (!Array.isArray(raw)) return ["plains"];
  const set = new Set<BiomeId>();
  for (const b of raw) {
    if (typeof b === "string" && VALID_BIOMES.includes(b as BiomeId)) {
      set.add(b as BiomeId);
      if (set.size >= WORLD_LIMITS.MAX_BIOMES) break;
    }
  }
  return set.size ? Array.from(set) : ["plains"];
}

export function parseWorldSpec(raw: RawSpec, originalPrompt: string): WorldSpec {
  return {
    prompt: originalPrompt,
    biomes: parseBiomes(raw.biomes),
    terrain: parseTerrain(raw.terrain),
    camera: parseCamera(raw.camera),
    createdAt: Date.now(),
  };
}
```

### `src/lib/ai/world-generator.ts`
```ts
import { GoogleGenAI } from "@google/genai";
import { SERVER_ENV } from "../../config/env";
import { WORLD_SYSTEM_PROMPT, buildWorldPrompt } from "./prompts";
import { parseWorldSpec } from "./schema";
import type { WorldSpec } from "../../types/world";

let client: GoogleGenAI | null = null;

function getClient(): GoogleGenAI {
  if (!client) {
    if (!SERVER_ENV.geminiApiKey) throw new Error("GEMINI_API_KEY ausente");
    client = new GoogleGenAI({ apiKey: SERVER_ENV.geminiApiKey });
  }
  return client;
}

export async function generateWorldSpec(prompt: string): Promise<WorldSpec> {
  const ai = getClient();
  const res = await ai.models.generateContent({
    model: "gemini-2.0-flash",
    contents: [
      { role: "user", parts: [{ text: WORLD_SYSTEM_PROMPT }] },
      { role: "user", parts: [{ text: buildWorldPrompt(prompt) }] },
    ],
    config: { responseMimeType: "application/json", temperature: 0.7 },
  });
  const text = res.text ?? "{}";
  const raw = JSON.parse(text) as Record<string, unknown>;
  return parseWorldSpec(raw, prompt);
}
```

