# 08 — MÓDULO MOTOR 3D

**Uso:** aislar Three.js del árbol React. React monta un `<canvas>`, el motor hace el resto.

### `src/engine/Scene.ts`
```ts
import * as THREE from "three";
import { CAMERA_LIMITS } from "../config/constants";
import type { WorldSpec } from "../types/world";
import { TerrainGenerator } from "./terrain/TerrainGenerator";
import { CinematicCamera } from "./camera/CinematicCamera";
import { SceneLighting } from "./lighting/SceneLighting";

export class Scene {
  private readonly renderer: THREE.WebGLRenderer;
  private readonly scene: THREE.Scene;
  private readonly camera: THREE.PerspectiveCamera;
  private readonly lighting: SceneLighting;
  private readonly cinematic: CinematicCamera;
  private terrain: TerrainGenerator | null = null;
  private animId: number | null = null;
  private resizeHandler: () => void;

  constructor(private readonly canvas: HTMLCanvasElement) {
    this.renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    this.scene = new THREE.Scene();
    this.scene.background = new THREE.Color(0x020617);
    this.scene.fog = new THREE.Fog(0x020617, 100, 900);

    this.camera = new THREE.PerspectiveCamera(
      CAMERA_LIMITS.FOV,
      canvas.clientWidth / canvas.clientHeight,
      CAMERA_LIMITS.NEAR,
      CAMERA_LIMITS.FAR,
    );
    this.camera.position.set(0, 30, 60);

    this.lighting = new SceneLighting();
    this.lighting.attach(this.scene);

    this.cinematic = new CinematicCamera(this.camera);

    this.resizeHandler = () => this.onResize();
    window.addEventListener("resize", this.resizeHandler);
    this.onResize();
  }

  loadWorld(spec: WorldSpec): void {
    if (this.terrain) this.terrain.dispose(this.scene);
    this.terrain = new TerrainGenerator(spec.terrain, spec.biomes);
    this.terrain.attach(this.scene);
    this.cinematic.loadKeyframes(spec.camera);
  }

  start(): void {
    const loop = () => {
      this.cinematic.tick();
      this.renderer.render(this.scene, this.camera);
      this.animId = requestAnimationFrame(loop);
    };
    loop();
  }

  dispose(): void {
    if (this.animId !== null) cancelAnimationFrame(this.animId);
    window.removeEventListener("resize", this.resizeHandler);
    this.terrain?.dispose(this.scene);
    this.lighting.dispose(this.scene);
    this.renderer.dispose();
  }

  private onResize(): void {
    const w = this.canvas.clientWidth || 1;
    const h = this.canvas.clientHeight || 1;
    this.renderer.setSize(w, h, false);
    this.camera.aspect = w / h;
    this.camera.updateProjectionMatrix();
  }
}
