# 05 — MÓDULO VALIDACIÓN FORMAL (Z3)

**Uso:** verificar con solver SMT que la especificación es físicamente coherente antes de renderizar.

### `src/server/validation/terrain-validator.ts`
```ts
import { init } from "z3-solver";
import type { TerrainSpec } from "../../types/world";
import { WORLD_LIMITS } from "../../config/constants";

export interface TerrainVerdict {
  satisfiable: boolean;
  violations: string[];
}

export async function validateTerrain(spec: TerrainSpec): Promise<TerrainVerdict> {
  const { Context } = await init();
  const { Solver, Real } = Context("terrain");
  const s = new Solver();

  const amp = Real.const("amplitude");
  const oct = Real.const("octaves");
  const per = Real.const("persistence");
  const freq = Real.const("frequency");

  s.add(amp.ge(WORLD_LIMITS.MIN_AMPLITUDE), amp.le(WORLD_LIMITS.MAX_AMPLITUDE));
  s.add(oct.ge(WORLD_LIMITS.MIN_OCTAVES), oct.le(WORLD_LIMITS.MAX_OCTAVES));
  s.add(per.gt(0), per.lt(1));
  s.add(freq.gt(0));

  s.add(amp.eq(spec.amplitude));
  s.add(oct.eq(spec.octaves));
  s.add(per.eq(spec.persistence));
  s.add(freq.eq(spec.frequency));

  const verdict = await s.check();
  const violations: string[] = [];

  if (verdict !== "sat") {
    if (spec.amplitude < WORLD_LIMITS.MIN_AMPLITUDE || spec.amplitude > WORLD_LIMITS.MAX_AMPLITUDE) {
      violations.push(`amplitude fuera de rango: ${spec.amplitude}`);
    }
    if (spec.octaves < WORLD_LIMITS.MIN_OCTAVES || spec.octaves > WORLD_LIMITS.MAX_OCTAVES) {
      violations.push(`octaves fuera de rango: ${spec.octaves}`);
    }
    if (spec.persistence <= 0 || spec.persistence >= 1) {
      violations.push(`persistence fuera de rango: ${spec.persistence}`);
    }
    if (spec.frequency <= 0) {
      violations.push(`frequency debe ser > 0: ${spec.frequency}`);
    }
  }

  return { satisfiable: verdict === "sat", violations };
}
```

### `src/server/validation/world-validator.ts`
```ts
import type { WorldSpec } from "../../types/world";
import { validateTerrain } from "./terrain-validator";

export interface WorldVerdict {
  satisfiable: boolean;
  violations: string[];
}

export async function validateWorldSpec(spec: WorldSpec): Promise<WorldVerdict> {
  const violations: string[] = [];

  const terrainVerdict = await validateTerrain(spec.terrain);
  violations.push(...terrainVerdict.violations);

  if (!spec.biomes.length) {
    violations.push("biomes vacío");
  }

  if (!spec.camera.length) {
    violations.push("camera sin keyframes");
  }

  return {
    satisfiable: violations.length === 0 && terrainVerdict.satisfiable,
    violations,
  };
}
```

