### `src/hooks/useWorldGeneration.ts`
```ts
import { useCallback } from "react";
import { postJson } from "../lib/utils/http";
import { useWorldStore } from "../store/world-store";
import { API_ROUTES } from "../config/constants";
import type { GenerateRequest, GenerateResponse } from "../types/api";

export function useWorldGeneration() {
  const { status, spec, error, setLoading, setSpec, setError, reset } = useWorldStore();

  const generate = useCallback(
    async (prompt: string) => {
      if (!prompt.trim()) return;
      setLoading();
      const result = await postJson<GenerateRequest, GenerateResponse>(
        API_ROUTES.GENERATE,
        { prompt },
      );
      if (result.ok && result.data.ok && result.data.spec) {
        setSpec(result.data.spec);
      } else {
        setError(result.ok ? (result.data.error ?? "generation_failed") : result.error);
      }
    },
    [setLoading, setSpec, setError],
  );

  return { status, spec, error, generate, reset };
}
```

### `src/hooks/useWorldValidation.ts`
```ts
import { useCallback, useState } from "react";
import { postJson } from "../lib/utils/http";
import { API_ROUTES } from "../config/constants";
import type { ValidateRequest, ValidateResponse } from "../types/api";
import type { WorldSpec } from "../types/world";

export function useWorldValidation() {
  const [verdict, setVerdict] = useState<ValidateResponse | null>(null);

  const validate = useCallback(async (spec: WorldSpec) => {
    const result = await postJson<ValidateRequest, ValidateResponse>(
      API_ROUTES.VALIDATE,
      { spec },
    );
    setVerdict(result.ok ? result.data : { ok: false, satisfiable: false, violations: [result.error] });
  }, []);

  return { verdict, validate };
}
