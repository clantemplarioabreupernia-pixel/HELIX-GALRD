```go
// Package api exposes the HTTP API of the microservice.
package api

import (
	"encoding/json"
	"log/slog"
	"net/http"
	"time"

	"github.com/JavierAbreu/aether-thermal/internal/alerts"
	"github.com/JavierAbreu/aether-thermal/internal/config"
	"github.com/JavierAbreu/aether-thermal/internal/history"
	"github.com/JavierAbreu/aether-thermal/internal/metrics"
	"github.com/JavierAbreu/aether-thermal/internal/middleware"
	"github.com/JavierAbreu/aether-thermal/internal/ratelimit"
	"github.com/JavierAbreu/aether-thermal/internal/snapshot"
	"github.com/JavierAbreu/aether-thermal/internal/version"
)

// Server bundles all dependencies of the HTTP layer.
type Server struct {
	cfg      config.Config
	provider *snapshot.Provider
	alerts   *alerts.Evaluator
	history  *history.Buffer
	logger   *slog.Logger
	limiter  *ratelimit.Limiter
	start    time.Time
}

// NewServer builds a Server. All dependencies must be non-nil except history.
func NewServer(
	cfg config.Config,
	provider *snapshot.Provider,
	evaluator *alerts.Evaluator,
	buf *history.Buffer,
	logger *slog.Logger,
) *Server {
	return &Server{
		cfg:      cfg,
		provider: provider,
		alerts:   evaluator,
		history:  buf,
		logger:   logger,
		limiter:  ratelimit.New(50, 100),
		start:    time.Now(),
	}
}

// Handler returns the fully wrapped handler with middlewares applied.
func (s *Server) Handler() http.Handler {
	mux := http.NewServeMux()

	mux.HandleFunc("GET /health", s.handleHealth)
	mux.HandleFunc("GET /version", s.handleVersion)
	mux.HandleFunc("GET /v1/topology", s.handleTopology)
	mux.HandleFunc("GET /v1/thermal", s.handleThermal)
	mux.HandleFunc("GET /v1/snapshot", s.handleSnapshot)
	mux.HandleFunc("GET /v1/alerts", s.handleAlerts)
	mux.HandleFunc("GET /v1/history", s.handleHistory)
	mux.HandleFunc("GET /metrics", s.handleMetrics)

	return middleware.Chain(mux,
		middleware.RequestID,
		middleware.CORS,
		func(h http.Handler) http.Handler { return middleware.Recovery(s.logger, h) },
		func(h http.Handler) http.Handler { return middleware.Logging(s.logger, h) },
	)
}

func (s *Server) handleHealth(w http.ResponseWriter, _ *http.Request) {
	writeJSON(w, http.StatusOK, map[string]any{
		"status":         "ok",
		"uptime_seconds": time.Since(s.start).Seconds(),
	})
}

func (s *Server) handleVersion(w http.ResponseWriter, _ *http.Request) {
	writeJSON(w, http.StatusOK, version.Info())
}

func (s *Server) handleTopology(w http.ResponseWriter, r *http.Request) {
	snap, err := s.provider.Get(r.Context())
	if err != nil {
		writeProblem(w, http.StatusInternalServerError, err.Error())
		return
	}
	writeJSON(w, http.StatusOK, snap.Topology)
}

func (s *Server) handleThermal(w http.ResponseWriter, r *http.Request) {
	snap, err := s.provider.Get(r.Context())
	if err != nil {
		writeProblem(w, http.StatusInternalServerError, err.Error())
		return
	}
	writeJSON(w, http.StatusOK, snap.Thermal)
}

func (s *Server) handleSnapshot(w http.ResponseWriter, r *http.Request) {
	snap, err := s.provider.Get(r.Context())
	if err != nil {
		writeProblem(w, http.StatusInternalServerError, err.Error())
		return
	}
	writeJSON(w, http.StatusOK, snap)
}

func (s *Server) handleAlerts(w http.ResponseWriter, r *http.Request) {
	snap, err := s.provider.Get(r.Context())
	if err != nil {
		writeProblem(w, http.StatusInternalServerError, err.Error())
		return
	}
	writeJSON(w, http.StatusOK, map[string]any{
		"timestamp": snap.Timestamp,
		"alerts":    s.alerts.Evaluate(snap),
	})
}

func (s *Server) handleHistory(w http.ResponseWriter, _ *http.Request) {
	if s.history == nil {
		writeJSON(w, http.StatusOK, map[string]any{"samples": []any{}, "stats": history.Stats{}})
		return
	}
	writeJSON(w, http.StatusOK, map[string]any{
		"samples": s.history.Snapshot(),
		"stats":   s.history.Stats(),
	})
}

func (s *Server) handleMetrics(w http.ResponseWriter, r *http.Request) {
	if !s.limiter.Allow() {
		http.Error(w, "rate limited", http.StatusTooManyRequests)
		return
	}
	snap, err := s.provider.Get(r.Context())
	if err != nil {
		http.Error(w, err.Error(), http.StatusInternalServerError)
		return
	}
	w.Header().Set("Content-Type", "text/plain; version=0.0.4; charset=utf-8")
	_, _ = w.Write([]byte(metrics.Render(snap)))
}

func writeJSON(w http.ResponseWriter, code int, v any) {
	w.Header().Set("Content-Type", "application/json; charset=utf-8")
	w.WriteHeader(code)
	enc := json.NewEncoder(w)
	enc.SetIndent("", "  ")
	_ = enc.Encode(v)
}

func writeProblem(w http.ResponseWriter, code int, msg string) {
	writeJSON(w, code, map[string]string{"error": msg})
}
