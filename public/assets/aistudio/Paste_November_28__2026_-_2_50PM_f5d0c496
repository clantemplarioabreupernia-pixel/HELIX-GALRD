## 2. Pieza 1 — `sysfs`

**Propósito:** lectura tolerante de entradas `sysfs` (`ErrNotFound` en lugar de pánico cuando la entrada no existe o no es Linux).
**Consumidores:** `topology`, `thermal`, `pressure`.

```go
// Package sysfs provides safe, tolerant readers for Linux sysfs entries.
//
// Reads never panic: missing entries return ErrNotFound so callers can
// degrade gracefully on non-Linux hosts or sandboxed containers.
package sysfs

import (
	"errors"
	"os"
	"path/filepath"
	"strconv"
	"strings"
)

// Root is the sysfs mount point. Overridable for tests.
var Root = "/sys"

// ErrNotFound indicates the requested sysfs entry is absent.
var ErrNotFound = errors.New("sysfs: entry not found")

// ReadString reads a sysfs file and trims surrounding whitespace.
func ReadString(parts ...string) (string, error) {
	b, err := os.ReadFile(filepath.Join(append([]string{Root}, parts...)...))
	if err != nil {
		if os.IsNotExist(err) {
			return "", ErrNotFound
		}
		return "", err
	}
	return strings.TrimSpace(string(b)), nil
}

// ReadInt reads a sysfs file as int64.
func ReadInt(parts ...string) (int64, error) {
	s, err := ReadString(parts...)
	if err != nil {
		return 0, err
	}
	return strconv.ParseInt(s, 10, 64)
}

// ReadFloat reads a sysfs file as float64.
func ReadFloat(parts ...string) (float64, error) {
	s, err := ReadString(parts...)
	if err != nil {
		return 0, err
	}
	return strconv.ParseFloat(s, 64)
}

// Exists reports whether a sysfs entry exists.
func Exists(parts ...string) bool {
	_, err := os.Stat(filepath.Join(append([]string{Root}, parts...)...))
	return err == nil
}

// List returns the names of entries directly under a sysfs directory.
func List(parts ...string) ([]string, error) {
	dir := filepath.Join(append([]string{Root}, parts...)...)
	entries, err := os.ReadDir(dir)
	if err != nil {
		if os.IsNotExist(err) {
			return nil, ErrNotFound
		}
		return nil, err
	}
	out := make([]string, 0, len(entries))
	for _, e := range entries {
		out = append(out, e.Name())
	}
	return out, nil
}
