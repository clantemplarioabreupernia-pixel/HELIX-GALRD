## 3. Pieza 2 — `topology`

**Propósito:** descubrir CPUs lógicas, núcleos físicos, sockets, siblings e hiperfrecuencia.
**Consumidores:** `snapshot`, `api`, `metrics`.

```go
// Package topology discovers the CPU topology exposed by Linux sysfs.
package topology

import (
	"path/filepath"
	"sort"
	"strconv"
	"strings"

	"github.com/JavierAbreu/aether-thermal/internal/sysfs"
)

// Core describes one logical CPU.
type Core struct {
	CPU            int   `json:"cpu"`
	CoreID         int   `json:"core_id"`
	PackageID      int   `json:"package_id"`
	ThreadSiblings []int `json:"thread_siblings,omitempty"`
	Online         bool  `json:"online"`
	CurrentFreqMHz int64 `json:"current_freq_mhz,omitempty"`
}

// Topology is the aggregated CPU topology.
type Topology struct {
	Cores        []Core `json:"cores"`
	LogicalCPUs  int    `json:"logical_cpus"`
	PhysicalCPUs int    `json:"physical_cores"`
	Sockets      int    `json:"sockets"`
}

// Discover walks /sys/devices/system/cpu and returns the current topology.
func Discover() (*Topology, error) {
	names, err := sysfs.List("devices", "system", "cpu")
	if err != nil {
		return nil, err
	}

	var cpus []int
	for _, n := range names {
		if !strings.HasPrefix(n, "cpu") {
			continue
		}
		id, err := strconv.Atoi(strings.TrimPrefix(n, "cpu"))
		if err != nil {
			continue
		}
		cpus = append(cpus, id)
	}
	sort.Ints(cpus)

	t := &Topology{}
	phys := make(map[[2]int]struct{})
	sockets := make(map[int]struct{})

	for _, id := range cpus {
		dir := filepath.Join("devices", "system", "cpu", "cpu"+strconv.Itoa(id))
		coreID, err := sysfs.ReadInt(dir, "topology", "core_id")
		if err != nil {
			continue
		}
		pkgID, err := sysfs.ReadInt(dir, "topology", "physical_package_id")
		if err != nil {
			continue
		}

		online := true
		if v, err := sysfs.ReadInt(dir, "online"); err == nil {
			online = v == 1
		}

		sibStr, _ := sysfs.ReadString(dir, "topology", "thread_siblings_list")
		siblings := ParseCPUList(sibStr)

		var freq int64
		if v, err := sysfs.ReadInt(dir, "cpufreq", "scaling_cur_freq"); err == nil {
			freq = v / 1000 // kHz → MHz
		}

		t.Cores = append(t.Cores, Core{
			CPU:            id,
			CoreID:         int(coreID),
			PackageID:      int(pkgID),
			ThreadSiblings: siblings,
			Online:         online,
			CurrentFreqMHz: freq,
		})
		phys[[2]int{int(pkgID), int(coreID)}] = struct{}{}
		sockets[int(pkgID)] = struct{}{}
	}

	t.LogicalCPUs = len(t.Cores)
	t.PhysicalCPUs = len(phys)
	t.Sockets = len(sockets)
	return t, nil
}

// ParseCPUList parses a Linux CPU list such as "0-3,5,7-9".
func ParseCPUList(s string) []int {
	if s == "" {
		return nil
	}
	var out []int
	for _, part := range strings.Split(s, ",") {
		part = strings.TrimSpace(part)
		if part == "" {
			continue
		}
		if a, b, ok := strings.Cut(part, "-"); ok {
			lo, err1 := strconv.Atoi(strings.TrimSpace(a))
			hi, err2 := strconv.Atoi(strings.TrimSpace(b))
			if err1 != nil || err2 != nil || lo > hi {
				continue
			}
			for i := lo; i <= hi; i++ {
				out = append(out, i)
			}
		} else if n, err := strconv.Atoi(part); err == nil {
			out = append(out, n)
		}
	}
	return out
}
