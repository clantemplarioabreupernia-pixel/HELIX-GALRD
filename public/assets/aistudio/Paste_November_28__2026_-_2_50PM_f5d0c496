## 9. Pieza 8 — `history` *(nueva)*

**Propósito:** ring buffer en memoria para tendencias (¿sube la temperatura durante un build?). Sin `math/rand`.
**Consumidores:** `api` (`/v1/history`), dashboards, Omega Music.

```go
// Package history keeps an in-memory ring buffer of recent samples.
package history

import (
	"sync"
	"time"
)

// Sample is one point of thermal history.
type Sample struct {
	Time   time.Time `json:"time"`
	MaxC   float64   `json:"max_c"`
	AvgC   float64   `json:"avg_c"`
	CPUs   int       `json:"cpus"`
}

// Stats summarizes the buffer contents.
type Stats struct {
	Count   int     `json:"count"`
	MinC    float64 `json:"min_c"`
	MaxC    float64 `json:"max_c"`
	AvgC    float64 `json:"avg_c"`
}

// Buffer is a fixed-size, thread-safe ring buffer.
type Buffer struct {
	mu   sync.RWMutex
	data []Sample
	next int
	full bool
}

// New creates a Buffer with the given capacity. capacity <= 0 panics.
func New(capacity int) *Buffer {
	if capacity <= 0 {
		panic("history: capacity must be > 0")
	}
	return &Buffer{data: make([]Sample, capacity)}
}

// Add appends a sample, overwriting the oldest when full.
func (b *Buffer) Add(s Sample) {
	b.mu.Lock()
	b.data[b.next] = s
	b.next = (b.next + 1) % len(b.data)
	if b.next == 0 {
		b.full = true
	}
	b.mu.Unlock()
}

// Snapshot returns samples in chronological order.
func (b *Buffer) Snapshot() []Sample {
	b.mu.RLock()
	defer b.mu.RUnlock()

	if !b.full && b.next == 0 {
		return nil
	}
	out := make([]Sample, 0, b.sizeLocked())
	if b.full {
		out = append(out, b.data[b.next:]...)
	}
	out = append(out, b.data[:b.next]...)
	return out
}

// Stats returns aggregate stats over the buffer.
func (b *Buffer) Stats() Stats {
	samples := b.Snapshot()
	st := Stats{Count: len(samples)}
	if st.Count == 0 {
		return st
	}
	st.MinC, st.MaxC = samples[0].MaxC, samples[0].MaxC
	var sum float64
	for _, s := range samples {
		sum += s.MaxC
		if s.MaxC < st.MinC {
			st.MinC = s.MaxC
		}
		if s.MaxC > st.MaxC {
			st.MaxC = s.MaxC
		}
	}
	st.AvgC = sum / float64(st.Count)
	return st
}

func (b *Buffer) sizeLocked() int {
	if b.full {
		return len(b.data)
	}
	return b.next
}
