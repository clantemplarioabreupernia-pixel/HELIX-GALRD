// Load parses CLI flags and merges environment defaults.
func Load(args []string) (Config, error) {
	fs := flag.NewFlagSet("aether-thermal", flag.ContinueOnError)

	cfg := Config{}

	fs.StringVar(&cfg.Addr, "addr", env("AETHER_ADDR", ":8090"), "HTTP listen address")
	fs.StringVar(&cfg.LogLevel, "log", env("AETHER_LOG", "info"), "log level: debug|info|warn|error")
	fs.DurationVar(&cfg.CacheTTL, "cache-ttl", envDuration("AETHER_CACHE_TTL", 1*time.Second), "snapshot cache TTL")
	fs.DurationVar(&cfg.SampleEvery, "sample-every", envDuration("AETHER_SAMPLE_EVERY", 2*time.Second), "history sample interval")
	fs.IntVar(&cfg.HistorySize, "history", envInt("AETHER_HISTORY", 180), "history buffer size (samples)")

	warn := fs.Float64("alert-warn", envFloat("AETHER_ALERT_WARN", 80), "global warning threshold °C")
	crit := fs.Float64("alert-crit", envFloat("AETHER_ALERT_CRIT", 95), "global critical threshold °C")

	if err := fs.Parse(args); err != nil {
		return cfg, err
	}
	cfg.AlertRules = []alerts.Rule{{Zone: "", Warn: *warn, Crit: *crit}}
	return cfg, nil
}

func env(k, d string) string {
	if v, ok := os.LookupEnv(k); ok && v != "" {
