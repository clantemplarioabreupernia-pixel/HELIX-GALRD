```go
// Package cli implements the command-line interface of aether-thermal.
package cli

import (
	"context"
	"encoding/json"
	"fmt"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/JavierAbreu/aether-thermal/internal/config"
	"github.com/JavierAbreu/aether-thermal/internal/history"
	"github.com/JavierAbreu/aether-thermal/internal/logging"
	"github.com/JavierAbreu/aether-thermal/internal/metrics"
	"github.com/JavierAbreu/aether-thermal/internal/snapshot"
	"github.com/JavierAbreu/aether-thermal/internal/version"
)

// Run executes the CLI and returns an exit code.
//
//	aether-thermal read      one-shot JSON snapshot
//	aether-thermal metrics   one-shot Prometheus text
//	aether-thermal watch     newline-delimited JSON stream
//	aether-thermal version   build info
func Run(args []string) int {
	if len(args) < 1 {
		usage()
		return 2
	}
	switch args[0] {
	case "read":
		return cmdRead(args[1:])
	case "metrics":
		return cmdMetrics(args[1:])
	case "watch":
		return cmdWatch(args[1:])
	case "version":
		_ = json.NewEncoder(os.Stdout).Encode(version.Info())
		return 0
	default:
		usage()
		return 2
	}
}

func cmdRead(args []string) int {
	cfg, err := config.Load(args)
	if err != nil {
		return 1
	}
	_ = logging.New(cfg.LogLevel)
	snap, err := snapshot.New(0).Get(context.Background())
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	return encode(os.Stdout, snap)
}

func cmdMetrics(args []string) int {
	cfg, err := config.Load(args)
	if err != nil {
		return 1
	}
	snap, err := snapshot.New(cfg.CacheTTL).Get(context.Background())
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	fmt.Print(metrics.Render(snap))
	return 0
}

func cmdWatch(args []string) int {
	cfg, err := config.Load(args)
	if err != nil {
		return 1
	}
	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	provider := snapshot.New(0)
	enc := json.NewEncoder(os.Stdout)
	buf := history.New(16)

	tick := time.NewTicker(cfg.SampleEvery)
	defer tick.Stop()

	for {
		snap, err := provider.Get(ctx)
		if err != nil {
			fmt.Fprintln(os.Stderr, err)
			return 1
		}
		if err := enc.Encode(snap); err != nil {
			return 1
		}
		buf.Add(history.Sample{
			Time: snap.Timestamp,
			MaxC: snap.Thermal.MaxCelsius,
			AvgC: snap.Thermal.AvgCelsius,
			CPUs: snap.Topology.LogicalCPUs,
		})
		select {
		case <-ctx.Done():
			return 0
		case <-tick.C:
		}
	}
}

func encode(f *os.File, v any) int {
	enc := json.NewEncoder(f)
	enc.SetIndent("", "  ")
	if err := enc.Encode(v); err != nil {
		return 1
	}
	return 0
}

func usage() {
	fmt.Fprintln(os.Stderr, `Usage: aether-thermal <command> [flags]

Commands:
  read       Print one JSON snapshot and exit
  metrics    Print Prometheus text and exit
  watch      Stream newline-delimited JSON snapshots
  version    Print build information`)
}
