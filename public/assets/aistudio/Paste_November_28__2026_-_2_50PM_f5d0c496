## 5. Pieza 4 — `pressure` *(nueva)*

**Propósito:** leer `/proc/pressure/*` (PSI). Correlaciona la presión de CPU/IO/memoria con picos térmicos — clave para Q-Omega (compilación) y Omega Music (renders).
**Consumidores:** `snapshot`, `metrics`, `alerts`.

```go
// Package pressure reads Linux PSI (Pressure Stall Information) from
// /proc/pressure/{cpu,memory,io}.
package pressure

import (
	"os"
	"path/filepath"
	"strconv"
	"strings"
)

// Root is the procfs mount point. Overridable for tests.
var Root = "/proc"

// Resource is the metric set for one pressure resource.
type Resource struct {
	SomeAvg10  float64 `json:"some_avg10"`
	SomeAvg60  float64 `json:"some_avg60"`
	SomeAvg300 float64 `json:"some_avg300"`
	FullAvg10  float64 `json:"full_avg10,omitempty"`
	FullAvg60  float64 `json:"full_avg60,omitempty"`
	FullAvg300 float64 `json:"full_avg300,omitempty"`
	Total      uint64  `json:"total_usec"`
}

// Snapshot is the pressure state for all resources.
type Snapshot struct {
	CPU    *Resource `json:"cpu,omitempty"`
	Memory *Resource `json:"memory,omitempty"`
	IO     *Resource `json:"io,omitempty"`
}

// Read returns the current PSI state. Missing files are reported as nil.
func Read() *Snapshot {
	s := &Snapshot{}
	if r, err := readOne("cpu"); err == nil {
		s.CPU = r
	}
	if r, err := readOne("memory"); err == nil {
		s.Memory = r
	}
	if r, err := readOne("io"); err == nil {
		s.IO = r
	}
	return s
}

func readOne(resource string) (*Resource, error) {
	b, err := os.ReadFile(filepath.Join(Root, "pressure", resource))
	if err != nil {
		return nil, err
	}
	r := &Resource{}
	for _, line := range strings.Split(strings.TrimSpace(string(b)), "\n") {
		kind, rest, ok := strings.Cut(line, " ")
		if !ok {
			continue
		}
		fields := parseFields(rest)
		switch kind {
		case "some":
			r.SomeAvg10 = fields["avg10"]
			r.SomeAvg60 = fields["avg60"]
			r.SomeAvg300 = fields["avg300"]
			r.Total = uint64(fields["total"])
		case "full":
			r.FullAvg10 = fields["avg10"]
			r.FullAvg60 = fields["avg60"]
			r.FullAvg300 = fields["avg300"]
		}
	}
	return r, nil
}

func parseFields(s string) map[string]float64 {
	out := make(map[string]float64, 4)
	for _, kv := range strings.Fields(s) {
		k, v, ok := strings.Cut(kv, "=")
		if !ok {
			continue
		}
		if f, err := strconv.ParseFloat(v, 64); err == nil {
			out[k] = f
		}
	}
	return out
}
