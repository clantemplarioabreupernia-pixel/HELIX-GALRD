## 17. Ensamblaje — `cmd/aether-thermal/main.go`

**Propósito:** cablear todas las piezas y arrancar el servidor (o delegar a CLI si el primer argumento es un comando).

```go
// Command aether-thermal runs the microservice (HTTP server) or a CLI command.
package main

import (
	"context"
	"errors"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/JavierAbreu/aether-thermal/internal/alerts"
	"github.com/JavierAbreu/aether-thermal/internal/api"
	"github.com/JavierAbreu/aether-thermal/internal/cli"
	"github.com/JavierAbreu/aether-thermal/internal/config"
	"github.com/JavierAbreu/aether-thermal/internal/history"
	"github.com/JavierAbreu/aether-thermal/internal/logging"
	"github.com/JavierAbreu/aether-thermal/internal/snapshot"
)

func main() {
	// CLI dispatch when the first arg is a known command.
	if len(os.Args) > 1 {
		switch os.Args[1] {
		case "read", "metrics", "watch", "version":
			os.Exit(cli.Run(os.Args[1:]))
		}
	}

	cfg, err := config.Load(os.Args[1:])
	if err != nil {
		slog.Error("config", "err", err)
		os.Exit(2)
	}
	logger := logging.New(cfg.LogLevel)
	slog.SetDefault(logger)

	provider := snapshot.New(cfg.CacheTTL)
	evaluator := alerts.New(cfg.AlertRules)
	buf := history.New(cfg.HistorySize)

	// Background sampler for history.
	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()
	go sampleLoop(ctx, provider, buf, cfg.SampleEvery, logger)

	server := api.NewServer(cfg, provider, evaluator, buf, logger)
	httpSrv := &http.Server{
		Addr:              cfg.Addr,
		Handler:           server.Handler(),
		ReadHeaderTimeout: 5 * time.Second,
		ReadTimeout:       10 * time.Second,
		WriteTimeout:      15 * time.Second,
		IdleTimeout:       60 * time.Second,
	}

	go func() {
		logger.Info("aether-thermal listening", "addr", cfg.Addr)
		if err := httpSrv.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			logger.Error("server", "err", err)
			os.Exit(1)
		}
	}()

	<-ctx.Done()
	shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	if err := httpSrv.Shutdown(shutdownCtx); err != nil {
		logger.Error("shutdown", "err", err)
	}
	logger.Info("shutdown complete")
}

func sampleLoop(ctx context.Context, p *snapshot.Provider, buf *history.Buffer, every time.Duration, l *slog.Logger) {
	tick := time.NewTicker(every)
	defer tick.Stop()
	for {
		select {
		case <-ctx.Done():
			return
		case <-tick.C:
			snap, err := p.Get(ctx)
			if err != nil {
				l.Warn("sample", "err", err)
				continue
			}
			buf.Add(history.Sample{
				Time: snap.Timestamp,
				MaxC: snap.Thermal.MaxCelsius,
				AvgC: snap.Thermal.AvgCelsius,
				CPUs: snap.Topology.LogicalCPUs,
			})
		}
	}
}
