## 8. Pieza 7 — `alerts` *(nueva)*

**Propósito:** evaluar umbrales configurables (`warning` / `critical`) por zona térmica o cualquier zona.
**Consumidores:** `api` (endpoint `/v1/alerts`), Cristal TV (bloquear grabación), Q-Omega (frenar builds).

```go
// Package alerts evaluates thermal thresholds against a Snapshot.
package alerts

import (
	"fmt"
	"sort"

	"github.com/JavierAbreu/aether-thermal/internal/snapshot"
)

// Severity levels ordered from least to most urgent.
type Severity int

const (
	SeverityOK Severity = iota
	SeverityWarning
	SeverityCritical
)

func (s Severity) String() string {
	switch s {
	case SeverityWarning:
		return "warning"
	case SeverityCritical:
		return "critical"
	default:
		return "ok"
	}
}

// Rule applies to a single zone. Empty Zone means "any zone".
type Rule struct {
	Zone  string
	Warn  float64 // °C
	Crit  float64 // °C
}

// Alert is one active alert.
type Alert struct {
	Zone     string   `json:"zone"`
	Type     string   `json:"type"`
	TempC    float64  `json:"temp_c"`
	Severity Severity `json:"-"`
	Level    string   `json:"level"`
	Message  string   `json:"message"`
}

// Evaluator applies rules to snapshots.
type Evaluator struct {
	rules []Rule
}

// New builds an Evaluator. Rules are copied; the slice is not retained.
func New(rules []Rule) *Evaluator {
	out := make([]Rule, len(rules))
	copy(out, rules)
	return &Evaluator{rules: out}
}

// Evaluate returns the alerts triggered by s (may be empty).
func (e *Evaluator) Evaluate(s *snapshot.Snapshot) []Alert {
	var out []Alert
	for _, z := range s.Thermal.Zones {
		for _, r := range e.rules {
			if r.Zone != "" && r.Zone != z.Name {
				continue
			}
			sev := SeverityOK
			switch {
			case r.Crit > 0 && z.TempCelsius >= r.Crit:
				sev = SeverityCritical
			case r.Warn > 0 && z.TempCelsius >= r.Warn:
				sev = SeverityWarning
			}
			if sev == SeverityOK {
				continue
			}
			out = append(out, Alert{
				Zone:     z.Name,
				Type:     z.Type,
				TempC:    z.TempCelsius,
				Severity: sev,
				Level:    sev.String(),
				Message: fmt.Sprintf("%s %s: %.1f°C (warn=%.1f crit=%.1f)",
					z.Name, z.Type, z.TempCelsius, r.Warn, r.Crit),
			})
		}
	}
	sort.Slice(out, func(i, j int) bool {
		if out[i].Severity != out[j].Severity {
			return out[i].Severity > out[j].Severity
		}
		return out[i].Zone < out[j].Zone
	})
	return out
}
