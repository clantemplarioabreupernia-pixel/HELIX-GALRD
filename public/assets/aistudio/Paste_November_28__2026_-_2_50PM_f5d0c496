## 7. Pieza 6 — `metrics`

**Propósito:** renderizar Prometheus/OpenMetrics sin dependencias.
**Consumidores:** Prometheus, Grafana, `/metrics`.

```go
// Package metrics renders a Prometheus-compatible text exposition.
package metrics

import (
	"fmt"
	"strings"

	"github.com/JavierAbreu/aether-thermal/internal/snapshot"
)

// Render produces the Prometheus text exposition for s.
func Render(s *snapshot.Snapshot) string {
	var b strings.Builder
	b.Grow(2048)

	writeGauge(&b, "aether_thermal_cpu_count", "Number of logical CPUs", float64(s.Topology.LogicalCPUs))
	writeGauge(&b, "aether_thermal_physical_core_count", "Number of physical cores", float64(s.Topology.PhysicalCPUs))
	writeGauge(&b, "aether_thermal_socket_count", "Number of CPU sockets", float64(s.Topology.Sockets))
	writeGauge(&b, "aether_thermal_max_temp_celsius", "Maximum temperature across zones", s.Thermal.MaxCelsius)
	writeGauge(&b, "aether_thermal_avg_temp_celsius", "Average temperature across zones", s.Thermal.AvgCelsius)

	b.WriteString("# HELP aether_thermal_zone_temp_celsius Thermal zone temperature in Celsius.\n")
	b.WriteString("# TYPE aether_thermal_zone_temp_celsius gauge\n")
	for _, z := range s.Thermal.Zones {
		fmt.Fprintf(&b, "aether_thermal_zone_temp_celsius{zone=%q,type=%q} %.3f\n",
			z.Name, z.Type, z.TempCelsius)
	}

	b.WriteString("# HELP aether_thermal_cpu_freq_mhz Current CPU frequency in MHz.\n")
	b.WriteString("# TYPE aether_thermal_cpu_freq_mhz gauge\n")
	for _, c := range s.Topology.Cores {
		if c.CurrentFreqMHz == 0 {
			continue
		}
		fmt.Fprintf(&b, "aether_thermal_cpu_freq_mhz{cpu=\"%d\",core=\"%d\",package=\"%d\"} %d\n",
			c.CPU, c.CoreID, c.PackageID, c.CurrentFreqMHz)
	}

	if s.Pressure != nil {
		if s.Pressure.CPU != nil {
			writeGauge(&b, "aether_thermal_pressure_cpu_some_avg10", "PSI cpu some avg10", s.Pressure.CPU.SomeAvg10)
			writeGauge(&b, "aether_thermal_pressure_cpu_full_avg10", "PSI cpu full avg10", s.Pressure.CPU.FullAvg10)
		}
		if s.Pressure.Memory != nil {
			writeGauge(&b, "aether_thermal_pressure_memory_some_avg10", "PSI memory some avg10", s.Pressure.Memory.SomeAvg10)
			writeGauge(&b, "aether_thermal_pressure_memory_full_avg10", "PSI memory full avg10", s.Pressure.Memory.FullAvg10)
		}
		if s.Pressure.IO != nil {
			writeGauge(&b, "aether_thermal_pressure_io_some_avg10", "PSI io some avg10", s.Pressure.IO.SomeAvg10)
			writeGauge(&b, "aether_thermal_pressure_io_full_avg10", "PSI io full avg10", s.Pressure.IO.FullAvg10)
		}
	}

	return b.String()
}

func writeGauge(b *strings.Builder, name, help string, v float64) {
	fmt.Fprintf(b, "# HELP %s %s.\n# TYPE %s gauge\n%s %.3f\n", name, help, name, name, v)
}
