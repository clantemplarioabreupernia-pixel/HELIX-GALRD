## 4. Pieza 3 — `thermal`

**Propósito:** leer todas las zonas térmicas, temperaturas, máximos y críticos.
**Consumidores:** `snapshot`, `alerts`, `metrics`, `api`.

```go
// Package thermal reads /sys/class/thermal thermal zones.
package thermal

import (
	"path/filepath"
	"sort"
	"strings"

	"github.com/JavierAbreu/aether-thermal/internal/sysfs"
)

// Zone is one thermal zone reported by the kernel.
type Zone struct {
	Name        string  `json:"name"`
	Type        string  `json:"type"`
	TempCelsius float64 `json:"temp_celsius"`
	MaxCelsius  float64 `json:"max_celsius,omitempty"`
	CritCelsius float64 `json:"crit_celsius,omitempty"`
}

// Snapshot is the thermal state at a point in time.
type Snapshot struct {
	Zones      []Zone  `json:"zones"`
	MaxCelsius float64 `json:"max_celsius"`
	AvgCelsius float64 `json:"avg_celsius"`
	Count      int     `json:"count"`
}

// Read returns the current thermal state.
func Read() (*Snapshot, error) {
	names, err := sysfs.List("class", "thermal")
	if err != nil {
		return nil, err
	}

	var zones []Zone
	for _, n := range names {
		if !strings.HasPrefix(n, "thermal_zone") {
			continue
		}
		dir := filepath.Join("class", "thermal", n)
		z := Zone{Name: n}

		if v, err := sysfs.ReadString(dir, "type"); err == nil {
			z.Type = v
		}
		if v, err := sysfs.ReadInt(dir, "temp"); err == nil {
			z.TempCelsius = float64(v) / 1000.0
		}
		if v, err := sysfs.ReadInt(dir, "max"); err == nil {
			z.MaxCelsius = float64(v) / 1000.0
		}
		if v, err := sysfs.ReadInt(dir, "crit"); err == nil {
			z.CritCelsius = float64(v) / 1000.0
		}
		zones = append(zones, z)
	}
	sort.Slice(zones, func(i, j int) bool { return zones[i].Name < zones[j].Name })

	s := &Snapshot{Zones: zones, Count: len(zones)}
	if len(zones) == 0 {
		return s, nil
	}
	var sum float64
	for _, z := range zones {
		sum += z.TempCelsius
		if z.TempCelsius > s.MaxCelsius {
			s.MaxCelsius = z.TempCelsius
		}
	}
	s.AvgCelsius = sum / float64(len(zones))
	return s, nil
}
