## 6. Pieza 5 — `snapshot`

**Propósito:** agregar `topology + thermal + pressure` en una sola llamada con **caché TTL** para proteger `sysfs` de lecturas repetidas.
**Consumidores:** `api`, `cli`, `alerts`, `metrics`.

```go
// Package snapshot aggregates topology, thermal and pressure readings
// under a short TTL to protect sysfs from redundant reads.
package snapshot

import (
	"context"
	"sync"
	"time"

	"github.com/JavierAbreu/aether-thermal/internal/pressure"
	"github.com/JavierAbreu/aether-thermal/internal/thermal"
	"github.com/JavierAbreu/aether-thermal/internal/topology"
)

// Snapshot is the combined state at a point in time.
type Snapshot struct {
	Timestamp time.Time          `json:"timestamp"`
	Topology  *topology.Topology `json:"topology"`
	Thermal   *thermal.Snapshot  `json:"thermal"`
	Pressure  *pressure.Snapshot `json:"pressure,omitempty"`
}

// Provider caches a Snapshot for TTL duration.
type Provider struct {
	ttl time.Duration

	mu       sync.Mutex
	cached   *Snapshot
	cachedAt time.Time
}

// New returns a Provider with the given TTL. TTL <= 0 disables caching.
func New(ttl time.Duration) *Provider {
	return &Provider{ttl: ttl}
}

// Get returns a Snapshot, reusing the cache when fresh.
func (p *Provider) Get(ctx context.Context) (*Snapshot, error) {
	if p.ttl > 0 {
		p.mu.Lock()
		if p.cached != nil && time.Since(p.cachedAt) < p.ttl {
			out := p.cached
			p.mu.Unlock()
			return out, nil
		}
		p.mu.Unlock()
	}

	select {
	case <-ctx.Done():
		return nil, ctx.Err()
	default:
	}

	topo, err := topology.Discover()
	if err != nil {
		return nil, err
	}
	therm, err := thermal.Read()
	if err != nil {
		return nil, err
	}
	s := &Snapshot{
		Timestamp: time.Now().UTC(),
		Topology:  topo,
		Thermal:   therm,
		Pressure:  pressure.Read(),
	}

	if p.ttl > 0 {
		p.mu.Lock()
		p.cached = s
		p.cachedAt = time.Now()
		p.mu.Unlock()
	}
	return s, nil
}
