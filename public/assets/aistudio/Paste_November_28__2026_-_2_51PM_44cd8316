import type { BodyState, SimulationParams } from '../../shared/types';
import {
  specificOrbitalEnergy,
  specificAngularMomentum,
} from '../physics/orbital';
import { magnitude } from '../physics/vector';

export interface Invariant {
  readonly id: string;
  readonly description: string;
  readonly unit: string;
  readonly tolerance: number;
  readonly evaluate: (
    state: BodyState,
    params: SimulationParams,
    reference: BodyState,
  ) => number;
}

export const DEFAULT_INVARIANTS: readonly Invariant[] = [
  {
    id: 'energy_conservation',
    description: 'Energía orbital específica constante',
    unit: 'J/kg',
    tolerance: 1e-3,
    evaluate: (s, p, ref) => {
      const E0 = specificOrbitalEnergy(ref, p.central);
      const E = specificOrbitalEnergy(s, p.central);
      return Math.abs(E - E0);
    },
  },
  {
    id: 'angular_momentum_conservation',
    description: 'Momento angular específico constante',
    unit: 'm²/s',
    tolerance: 1e-6,
    evaluate: (s, _p, ref) => {
      const a = specificAngularMomentum(ref);
      const b = specificAngularMomentum(s);
      return Math.hypot(b.x - a.x, b.y - a.y, b.z - a.z);
    },
  },
  {
    id: 'no_surface_impact',
    description: 'La nave permanece fuera de la superficie central',
    unit: 'm',
    tolerance: 0,
    evaluate: (s, p) => {
      const r = magnitude(s.position);
      return Math.max(0, p.central.radius - r);
    },
  },
  {
    id: 'finite_state',
    description: 'Estado numérico finito (sin NaN/Infinity)',
    unit: '—',
    tolerance: 0,
    evaluate: (s) => {
      const v = [
        s.position.x, s.position.y, s.position.z,
        s.velocity.x, s.velocity.y, s.velocity.z,
      ];
      return v.some((n) => !Number.isFinite(n)) ? 1 : 0;
    },
  },
];
