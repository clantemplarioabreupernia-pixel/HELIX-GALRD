```ts
import type { BodyState, SimulationParams } from '../../shared/types';
import { stepState } from '../physics/integrators';

/**
 * Propaga `params.steps` pasos desde `initial` y devuelve la trayectoria completa.
 * El primer elemento es siempre el estado inicial.
 */
export function propagateTrajectory(
  initial: BodyState,
  params: SimulationParams,
): BodyState[] {
  const trajectory: BodyState[] = [initial];
  let current = initial;

  for (let i = 0; i < params.steps; i++) {
    current = stepState(current, params);
    trajectory.push(current);
    // Abortar si el estado diverge (evita bucles infinitos en NaN)
    if (!Number.isFinite(current.position.x)) break;
  }

  return trajectory;
}
```

