```ts
import type { BodyState, SimulationParams, Vec3 } from '../../shared/types';
import { gravitationalAcceleration } from './gravity';

/** Euler semi-implícito. Menos preciso, útil como referencia. */
export function eulerStep(
  state: BodyState,
  params: SimulationParams,
): BodyState {
  const { dt, central } = params;
  const a = gravitationalAcceleration(state.position, central);

  const v: Vec3 = {
    x: state.velocity.x + a.x * dt,
    y: state.velocity.y + a.y * dt,
    z: state.velocity.z + a.z * dt,
  };

  return {
    position: {
      x: state.position.x + v.x * dt,
      y: state.position.y + v.y * dt,
      z: state.position.z + v.z * dt,
    },
    velocity: v,
    time: state.time + dt,
  };
}

/**
 * Velocity Verlet (simpléctico, orden 2).
 * Conserva la energía con error acotado — ideal para órbitas largas.
 */
export function verletStep(
  state: BodyState,
  params: SimulationParams,
): BodyState {
  const { dt, central } = params;
  const p0 = state.position;
  const v0 = state.velocity;

  const a0 = gravitationalAcceleration(p0, central);

  const p1: Vec3 = {
    x: p0.x + v0.x * dt + 0.5 * a0.x * dt * dt,
    y: p0.y + v0.y * dt + 0.5 * a0.y * dt * dt,
    z: p0.z + v0.z * dt + 0.5 * a0.z * dt * dt,
  };

  const a1 = gravitationalAcceleration(p1, central);

  const v1: Vec3 = {
    x: v0.x + 0.5 * (a0.x + a1.x) * dt,
    y: v0.y + 0.5 * (a0.y + a1.y) * dt,
    z: v0.z + 0.5 * (a0.z + a1.z) * dt,
  };

  return { position: p1, velocity: v1, time: state.time + dt };
}

export function stepState(
  state: BodyState,
  params: SimulationParams,
): BodyState {
  return params.integrator === 'verlet'
    ? verletStep(state, params)
    : eulerStep(state, params);
}
