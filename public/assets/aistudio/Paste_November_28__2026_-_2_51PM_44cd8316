import type { CelestialBody, Vec3 } from '../../shared/types';
import { G } from '../../shared/constants/physical.constants';
import { magnitude } from './vector';

/**
 * Aceleración gravitatoria newtoniana:
 *   a = -G·M · r / |r|³
 */
export function gravitationalAcceleration(
  r: Vec3,
  central: CelestialBody,
): Vec3 {
  const rMag = magnitude(r);
  if (rMag === 0) {
    throw new Error('Posición cero: aceleración indefinida');
  }
  const factor = -G * central.mass / (rMag * rMag * rMag);
  return { x: factor * r.x, y: factor * r.y, z: factor * r.z };
}
