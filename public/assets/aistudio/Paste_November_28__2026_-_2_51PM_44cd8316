```ts
import type { BodyState, CelestialBody, Vec3 } from '../../shared/types';
import { G } from '../../shared/constants/physical.constants';
import { magnitude, cross } from './vector';

/** Energía orbital específica: ε = v²/2 − G·M/r  (J/kg) */
export function specificOrbitalEnergy(
  state: BodyState,
  central: CelestialBody,
): number {
  const r = magnitude(state.position);
  const v2 =
    state.velocity.x ** 2 +
    state.velocity.y ** 2 +
    state.velocity.z ** 2;
  return 0.5 * v2 - (G * central.mass) / r;
}

/** Momento angular específico: h = r × v  (m²/s) */
export function specificAngularMomentum(state: BodyState): Vec3 {
  return cross(state.position, state.velocity);
}

/** Velocidad orbital circular a una altitud dada (m/s) */
export function circularOrbitVelocity(
  altitude: number,
  central: CelestialBody,
): number {
  const r = central.radius + altitude;
  return Math.sqrt((G * central.mass) / r);
}

/** Velocidad de escape a una altitud dada (m/s) */
export function escapeVelocity(
  altitude: number,
  central: CelestialBody,
): number {
  const r = central.radius + altitude;
  return Math.sqrt((2 * G * central.mass) / r);
}

/** Tercera ley de Kepler: T = 2π·√(a³/(G·M))  (s) */
export function orbitalPeriod(
  semiMajorAxis: number,
  central: CelestialBody,
): number {
  return 2 * Math.PI * Math.sqrt(semiMajorAxis ** 3 / (G * central.mass));
}

/** Estado inicial en órbita circular (plano XY, cuerpo en origen) */
export function circularOrbitState(
  altitude: number,
  central: CelestialBody,
): BodyState {
  const r = central.radius + altitude;
  const v = circularOrbitVelocity(altitude, central);
  return {
    position: { x: r, y: 0, z: 0 },
    velocity: { x: 0, y: v, z: 0 },
    time: 0,
  };
}
