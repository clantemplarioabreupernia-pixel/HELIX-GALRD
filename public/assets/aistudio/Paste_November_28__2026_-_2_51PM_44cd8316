```ts
import type { BodyState, SimulationParams } from '../../shared/types';
import { DEFAULT_INVARIANTS, type Invariant } from './invariants';

export interface Violation {
  invariantId: string;
  step: number;
  value: number;
  tolerance: number;
  timeSeconds: number;
}

export interface VerificationReport {
  passed: boolean;
  steps: number;
  durationSeconds: number;
  violations: Violation[];
  maxViolations: Record<string, number>;
  invariants: readonly Invariant[];
}

export function verifyTrajectory(
  trajectory: readonly BodyState[],
  params: SimulationParams,
  invariants: readonly Invariant[] = DEFAULT_INVARIANTS,
): VerificationReport {
  if (trajectory.length === 0) {
    return {
      passed: true,
      steps: 0,
      durationSeconds: 0,
      violations: [],
      maxViolations: {},
      invariants,
    };
  }

  const reference = trajectory[0];
  const violations: Violation[] = [];
  const maxViolations: Record<string, number> = {};
  invariants.forEach((inv) => (maxViolations[inv.id] = 0));

  let lastTime = 0;
  trajectory.forEach((state, step) => {
    lastTime = state.time;
    for (const inv of invariants) {
      const value = inv.evaluate(state, params, reference);
      if (value > maxViolations[inv.id]) {
        maxViolations[inv.id] = value;
      }
      if (value > inv.tolerance) {
        violations.push({
          invariantId: inv.id,
          step,
          value,
          tolerance: inv.tolerance,
          timeSeconds: state.time,
        });
      }
    }
  });

  return {
    passed: violations.length === 0,
    steps: trajectory.length,
    durationSeconds: lastTime,
    violations,
    maxViolations,
    invariants,
  };
}
