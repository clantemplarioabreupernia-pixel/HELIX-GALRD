const SYSTEM_INSTRUCTION = `Eres el asistente técnico de Omega Zero-G, un IDE de física aeroespacial.
Reglas estrictas:
1. Responde SIEMPRE en español, salvo que el usuario pida otro idioma.
2. Usa unidades del Sistema Internacional y muestra las fórmulas.
3. Nunca inventes constantes físicas ni datos. Si no estás seguro, dilo.
4. No uses lenguaje publicitario ni términos pseudocientíficos.
5. Cuando el usuario plantee un cálculo, muestra los pasos y verifica dimensiones.
6. Si el usuario pide algo fuera de física/ingeniería aeroespacial, redirige brevemente.`;

let cachedClient: GoogleGenAI | null = null;
let cachedKey: string | null = null;

function getClient(apiKey?: string): GoogleGenAI {
  const key = apiKey ?? process.env.GEMINI_API_KEY ?? '';
  if (!key) {
    throw new Error(
      'GEMINI_API_KEY no configurada. Añádela a .env',
    );
  }
  if (!cachedClient || cachedKey !== key) {
    cachedClient = new GoogleGenAI({ apiKey: key });
    cachedKey = key;
  }
  return cachedClient;
}

export interface AssistantReply {
  text: string;
  model: string;
}

export async function askAssistant(prompt: string): Promise<AssistantReply> {
  const ai = getClient();
  const response = await ai.models.generateContent({
    model: MODEL,
    contents: prompt,
    config: {
      systemInstruction: SYSTEM_INSTRUCTION,
      temperature: 0.2,
    },
  });

  const text = response.text ?? '';
  if (!text) throw new Error('Respuesta vacía del modelo');
  return { text, model: MODEL };
}
