          <h2 className="mb-4 text-lg font-medium">Consulta a Gemini</h2>
          <ChatComposer disabled={loading} onSubmit={send} />
        </Card>

        {loading && (
          <Card className="flex items-center gap-3">
            <Spinner />
            <span className="text-on-surface-variant">Generando respuesta…</span>
          </Card>
        )}

        {error && (
          <Card className="border border-error/40">
            <p className="text-error">{error}</p>
          </Card>
        )}

        {response && (
          <Card>
            <h3 className="mb-2 text-base font-medium">Respuesta</h3>
            <p className="whitespace-pre-wrap text-on-surface-variant">{response}</p>
          </Card>
        )}
      </main>
    </div>
  );
}
