```typescript
import { Room, type Client } from "colyseus";
import { PlayerState } from "./state/player-state";
import { RoomState } from "./state/room-state";

const MAX_CLIENTS = 20;

export class OmegaRoom extends Room<RoomState> {
  maxClients = MAX_CLIENTS;

  onCreate(): void {
    this.setState(new RoomState());

    this.onMessage(
      "move",
      (client, data: { x: number; z: number; rotation: number }) => {
        const player = this.state.players.get(client.sessionId);
        if (!player) return;
        player.x = data.x;
        player.z = data.z;
        player.rotation = data.rotation;
      },
    );
  }

  onJoin(client: Client, options: { username?: string }): void {
    const player = new PlayerState();
    player.id = client.sessionId;
    player.x = 0;
    player.y = 0;
    player.z = 0;
    player.color = deterministicColor(client.sessionId);
    player.username = options.username ?? `Player_${client.sessionId.slice(0, 4)}`;

    this.state.players.set(client.sessionId, player);
    console.warn(`[OmegaRoom] ${player.username} se unió (${client.sessionId})`);
  }

  onLeave(client: Client): void {
    this.state.players.delete(client.sessionId);
    console.warn(`[OmegaRoom] ${client.sessionId} salió`);
  }

  onDispose(): void {
    console.warn(`[OmegaRoom] Sala destruida: ${this.roomId}`);
  }
}

function deterministicColor(seed: string): string {
  let hash = 0;
  for (let i = 0; i < seed.length; i++) {
    hash = seed.charCodeAt(i) + ((hash << 5) - hash);
  }
  const hue = Math.abs(hash) % 360;
  return `hsl(${hue}, 70%, 60%)`;
}
```

