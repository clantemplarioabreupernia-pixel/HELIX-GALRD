import { OrbitControls } from "@react-three/drei";

export function CameraRig() {
  return (
    <OrbitControls
      enablePan={false}
      minPolarAngle={Math.PI / 6}
      maxPolarAngle={Math.PI / 2.2}
      minDistance={4}
      maxDistance={20}
      enableDamping
      dampingFactor={0.08}
    />
  );
}
```

