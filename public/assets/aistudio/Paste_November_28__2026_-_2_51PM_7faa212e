```typescript
import type { Track } from "@types/audio";
import { noteToFrequency } from "./note-utils";
import { renderMelody } from "./synth";

export class AudioEngine {
  private ctx: AudioContext | null = null;
  private masterGain: GainNode | null = null;
  private activeSources = new Map<string, AudioBufferSourceNode>();

  async ensureContext(): Promise<AudioContext> {
    if (!this.ctx) {
      this.ctx = new AudioContext();
      this.masterGain = this.ctx.createGain();
      this.masterGain.gain.value = 0.8;
      this.masterGain.connect(this.ctx.destination);
    }
    if (this.ctx.state === "suspended") await this.ctx.resume();
    return this.ctx;
  }

  setMasterVolume(volume: number): void {
    if (this.masterGain && this.ctx) {
      this.masterGain.gain.setTargetAtTime(
        Math.max(0, Math.min(1, volume)),
        this.ctx.currentTime,
        0.02,
      );
    }
  }

  async playTrack(track: Track): Promise<void> {
    if (track.muted || track.notes.length === 0) return;
    const ctx = await this.ensureContext();
    if (!this.masterGain) return;

    const buffer = renderMelody(ctx, track.notes, noteToFrequency);
    const source = ctx.createBufferSource();
    source.buffer = buffer;

    const trackGain = ctx.createGain();
    trackGain.gain.value = track.volume;
    source.connect(trackGain).connect(this.masterGain);

    source.start();
    source.onended = () => this.activeSources.delete(track.id);
    this.activeSources.set(track.id, source);
  }

  stopTrack(trackId: string): void {
    const src = this.activeSources.get(trackId);
    if (src) {
      try { src.stop(); } catch { /* already stopped */ }
      this.activeSources.delete(trackId);
    }
  }

  stopAll(): void {
    this.activeSources.forEach((src) => {
      try { src.stop(); } catch { /* noop */ }
    });
    this.activeSources.clear();
  }

  dispose(): void {
    this.stopAll();
    this.ctx?.close();
    this.ctx = null;
    this.masterGain = null;
  }
}

export const audioEngine = new AudioEngine();
```

