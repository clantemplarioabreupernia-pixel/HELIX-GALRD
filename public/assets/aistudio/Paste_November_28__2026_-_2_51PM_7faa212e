```typescript
const NOTE_OFFSETS: Record<string, number> = {
  C: 0, "C#": 1, D: 2, "D#": 3, E: 4, F: 5,
  "F#": 6, G: 7, "G#": 8, A: 9, "A#": 10, B: 11,
};

const A4_FREQ = 440;
const A4_MIDI = 69;

export function noteToFrequency(note: string): number {
  const match = /^([A-G]#?)(-?\d+)$/.exec(note);
  if (!match) return A4_FREQ;
  const [, name, octaveStr] = match;
  const octave = Number.parseInt(octaveStr, 10);
  const semitone = NOTE_OFFSETS[name] ?? 0;
  const midi = (octave + 1) * 12 + semitone;
  return A4_FREQ * Math.pow(2, (midi - A4_MIDI) / 12);
}
```

#### D3 — `src/audio/synth.ts`

```typescript
import type { MelodyNote } from "@types/audio";

type FreqFn = (note: string) => number;

export function renderMelody(
  ctx: AudioContext,
  notes: MelodyNote[],
  freq: FreqFn,
): AudioBuffer {
  const totalDuration = Math.max(...notes.map((n) => n.time + n.duration), 0.1);
  const length = Math.ceil(ctx.sampleRate * (totalDuration + 0.5));
  const buffer = ctx.createBuffer(1, length, ctx.sampleRate);
  const data = buffer.getChannelData(0);

  for (const note of notes) {
    const start = Math.floor(note.time * ctx.sampleRate);
    const end = Math.min(
      start + Math.floor(note.duration * ctx.sampleRate),
      length,
    );
    const freqHz = freq(note.note);
    const attack = Math.floor(ctx.sampleRate * 0.01);
    const release = Math.floor(ctx.sampleRate * 0.08);

    for (let i = start; i < end; i++) {
      const t = (i - start) / ctx.sampleRate;
      const env = envelope(i - start, end - start, attack, release);
      data[i] += Math.sin(2 * Math.PI * freqHz * t) * 0.25 * env;
    }
  }
  return buffer;
}

function envelope(
  pos: number,
  total: number,
  attack: number,
  release: number,
): number {
  if (pos < attack) return pos / attack;
  if (pos > total - release) return (total - pos) / release;
  return 1;
}
