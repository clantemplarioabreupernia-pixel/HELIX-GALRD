### T-PAG-002 · `ChatPage`

| Campo | Valor |
|-------|-------|
| **Uso** | Interfaz de chat con GenAI |
| **Fines** | Enviar/recibir mensajes con scroll automático |
| **Archivo** | `src/pages/ChatPage.tsx` |

```tsx
import React, { useEffect, useRef, useState } from "react";
import { Send } from "lucide-react";
import { Button, Card, TextField, ProgressIndicator } from "@/components/ui";
import { useGenAI } from "@/hooks/useGenAI";

export function ChatPage() {
  const [input, setInput] = useState("");
  const { messages, send, loading, error } = useGenAI();
  const scrollRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    scrollRef.current?.scrollTo({ top: scrollRef.current.scrollHeight, behavior: "smooth" });
  }, [messages]);

  const onSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!input.trim() || loading) return;
    const text = input.trim();
    setInput("");
    await send(text);
  };

  return (
    <div className="flex flex-col h-[calc(100dvh-9rem)] max-w-3xl mx-auto p-4 gap-4">
      <div ref={scrollRef} className="flex-1 overflow-y-auto flex flex-col gap-3">
        {messages.length === 0 && (
          <Card variant="filled" className="text-center m3-body-md text-[var(--color-on-surface-variant)]">
            Escribe un mensaje para comenzar.
          </Card>
        )}
        {messages.map((m, i) => (
          <Card
            key={i}
            variant={m.role === "user" ? "filled" : "elevated"}
            className={m.role === "user" ? "self-end max-w-[80%]" : "self-start max-w-[80%]"}
          >
            <p className="m3-body-md whitespace-pre-wrap text-[var(--color-on-surface)]">{m.content}</p>
          </Card>
        ))}
        {loading && <Card variant="outlined" className="self-start"><ProgressIndicator /></Card>}
        {error && (
          <Card variant="outlined" className="self-start border-[var(--color-error)]">
            <p className="m3-body-md text-[var(--color-error)]">{error}</p>
          </Card>
        )}
      </div>

      <form onSubmit={onSubmit} className="flex items-end gap-2">
        <div className="flex-1">
          <TextField
            label="Mensaje"
            value={input}
            onChange={(e) => setInput(e.target.value)}
            placeholder="Escribe aquí…"
            disabled={loading}
          />
        </div>
        <Button type="submit" disabled={loading || !input.trim()} icon={<Send size={18} />}>Enviar</Button>
      </form>
    </div>
  );
}
```

