```ts
import type { Request, Response, NextFunction } from "express";

export function validateChatRequest(req: Request, res: Response, next: NextFunction) {
  const { messages } = req.body ?? {};
  if (!Array.isArray(messages) || messages.length === 0) {
    return res.status(400).json({ error: "messages debe ser un array no vacío" });
  }
  const valid = messages.every(
    (m) => m && typeof m.content === "string" && ["user", "assistant", "system"].includes(m.role)
  );
  if (!valid) {
    return res.status(400).json({ error: "Mensaje inválido: se espera { role, content }" });
  }
  next();
}
```

**`server/middleware/error.middleware.ts`**
