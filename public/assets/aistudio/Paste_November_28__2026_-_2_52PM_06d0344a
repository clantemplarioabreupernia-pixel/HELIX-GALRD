## VII.1 — `lib/api-client.ts`

**Uso:** Cliente del dominio.
**Fin:** Un solo lugar para hablar con `/api`.

```typescript
import { postJSON, getJSON } from "./http-client";
import type {
  ProcessNewsSuccess,
  HealthResponse,
} from "@/domain/api-contracts";
import type { NewsRequest } from "@/domain/news-types";

export const api = {
  processNews: (body: NewsRequest) =>
    postJSON<ProcessNewsSuccess, NewsRequest>("/api/process-news", body),
  health: () => getJSON<HealthResponse>("/api/health"),
};
```

