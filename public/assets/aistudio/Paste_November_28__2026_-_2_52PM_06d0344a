## VI.1 — `api/middleware/error-handler.ts`

**Uso:** Manejador central de errores.
**Fin:** Nunca filtrar stack traces ni `error.message` al cliente.

```typescript
import type { Request, Response, NextFunction } from "express";
import { isAppError, AppError } from "@/tools/errors";
import { createLogger } from "@/tools/logger";

const log = createLogger("error-handler");

export function errorHandler(
  err: Error,
  _req: Request,
  res: Response,
  _next: NextFunction
): void {
  if (isAppError(err)) {
    log.warn(err.code, { cause: err.internalCause });
    res.status(err.statusCode).json(err.toPublicJSON());
    return;
  }
  log.error("unhandled", { message: err.message, stack: err.stack });
  const fallback = AppError.internal();
  res.status(fallback.statusCode).json(fallback.toPublicJSON());
}
```

