## IV.3 — `tools/gemini-client.ts`

**Uso:** Wrapper del SDK Gemini con timeout.
**Fin:** Aislar `AbortController` y errores del proveedor.

```typescript
import { GoogleGenAI } from "@google/genai";
import { env } from "./env";
import { AppError } from "./errors";
import { GEMINI_NEWS_SCHEMA } from "./gemini-response-schema";
import { GEMINI_DEFAULTS } from "@/domain/constants";

const ai = new GoogleGenAI({ apiKey: env.GEMINI_API_KEY });

interface GenerateArgs {
  prompt: string;
  timeoutMs?: number;
}

export async function generateStructuredJSON(args: GenerateArgs): Promise<string> {
  const timeoutMs = args.timeoutMs ?? GEMINI_DEFAULTS.TIMEOUT_MS;
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);

  try {
    const response = await ai.models.generateContent({
      model: env.GEMINI_MODEL,
      contents: args.prompt,
      config: {
        responseMimeType: "application/json",
        responseSchema: GEMINI_NEWS_SCHEMA,
        temperature: GEMINI_DEFAULTS.TEMPERATURE,
        abortSignal: controller.signal,
      },
    });

    const text = response.text;
    if (!text) throw AppError.upstream("Respuesta vacía del modelo.");
    return text;
  } catch (err) {
    if ((err as Error).name === "AbortError") throw AppError.timeout();
    throw AppError.upstream("Fallo al contactar Gemini.");
  } finally {
    clearTimeout(timer);
  }
}
```

