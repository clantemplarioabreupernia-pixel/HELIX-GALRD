```typescript
import { z } from "zod";
import { NEWS_LIMITS } from "@/domain/constants";

export const NewsRequestSchema = z.object({
  rawNews: z
    .string()
    .trim()
    .min(
      NEWS_LIMITS.MIN_CHARS,
      `El cable debe tener al menos ${NEWS_LIMITS.MIN_CHARS} caracteres.`
    )
    .max(
      NEWS_LIMITS.MAX_CHARS,
      `El cable no puede exceder ${NEWS_LIMITS.MAX_CHARS} caracteres.`
    ),
  tone: z
    .enum(["neutral", "urgent", "analytical", "feature"])
    .optional()
    .default("neutral"),
  language: z
    .string()
    .regex(/^[a-z]{2}(-[A-Z]{2})?$/, "Código de idioma inválido.")
    .optional()
    .default("es"),
});

export type ValidatedNewsRequest = z.infer<typeof NewsRequestSchema>;
