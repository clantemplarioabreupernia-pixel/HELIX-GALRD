## VII.3 — `hooks/use-process-news.ts`

**Uso:** Hook de mutación.
**Fin:** Encapsular estado + call al API en una sola abstracción.

```typescript
import { useMutation } from "@tanstack/react-query";
import { api } from "@/lib/api-client";
import type { NewsRequest, NewsOutput } from "@/domain/news-types";

export function useProcessNews() {
  return useMutation<NewsOutput, Error, NewsRequest>({
    mutationFn: async (body) => {
      const res = await api.processNews(body);
      return res.data;
    },
  });
}
```

