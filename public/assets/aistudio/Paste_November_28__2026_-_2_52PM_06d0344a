## IX.3 — `ui/domain/NewsForm.tsx`

```tsx
import { useState } from "react";
import { Sparkles } from "lucide-react";
import { Button } from "@/ui/primitives/Button";
import { Textarea } from "@/ui/primitives/Textarea";
import { Select } from "@/ui/primitives/Select";
import { FormField } from "@/ui/primitives/FormField";
import { NEWS_TONES, NEWS_LIMITS } from "@/domain/constants";
import type { NewsTone, NewsRequest } from "@/domain/news-types";

interface NewsFormProps {
  onSubmit: (body: NewsRequest) => void;
  isPending: boolean;
  errorMessage?: string;
}

export function NewsForm({ onSubmit, isPending, errorMessage }: NewsFormProps) {
  const [rawNews, setRawNews] = useState("");
  const [tone, setTone] = useState<NewsTone>("neutral");

  const trimmedLength = rawNews.trim().length;
  const tooShort = trimmedLength < NEWS_LIMITS.MIN_CHARS;
  const tooLong = trimmedLength > NEWS_LIMITS.MAX_CHARS;

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (tooShort || tooLong) return;
    onSubmit({ rawNews, tone, language: "es" });
  };

  return (
    <form
      onSubmit={handleSubmit}
      className="space-y-4 rounded-lg border border-neutral-800 bg-neutral-900/50 p-5"
      noValidate
    >
      <FormField
        id="rawNews"
        label="Cable de noticias"
        hint={`${trimmedLength}/${NEWS_LIMITS.MAX_CHARS} caracteres`}
        error={
          tooShort && trimmedLength > 0
            ? `Mínimo ${NEWS_LIMITS.MIN_CHARS} caracteres.`
            : tooLong
            ? `Máximo ${NEWS_LIMITS.MAX_CHARS} caracteres.`
            : undefined
        }
      >
        <Textarea
          id="rawNews"
          rows={8}
          value={rawNews}
          onChange={(e) => setRawNews(e.target.value)}
          placeholder="Pega aquí el cable de noticias..."
        />
      </FormField>

      <div className="flex flex-wrap items-center gap-3">
        <label htmlFor="tone" className="text-sm text-neutral-400">
          Tono:
        </label>
        <Select
          id="tone"
          value={tone}
          onChange={(e) => setTone(e.target.value as NewsTone)}
        >
          {NEWS_TONES.map((t) => (
            <option key={t.value} value={t.value}>
              {t.label}
            </option>
          ))}
        </Select>

        <Button
          type="submit"
          loading={isPending}
          disabled={tooShort || tooLong}
          className="ml-auto"
        >
          {!isPending && <Sparkles className="h-4 w-4" />}
          {isPending ? "Procesando…" : "Generar contenido"}
        </Button>
      </div>

      {errorMessage && (
        <p role="alert" className="text-sm text-red-400">
          {errorMessage}
        </p>
      )}
    </form>
  );
}
```

