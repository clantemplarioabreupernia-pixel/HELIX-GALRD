## I.4 — `lib/http-client.ts`

**Uso:** Wrapper tipado sobre `fetch`.
**Fin:** Centralizar manejo de respuestas, errores y JSON parse.

```typescript
import type { ApiError } from "@/domain/api-contracts";

export class HttpError extends Error {
  readonly status: number;
  readonly code?: string;
  readonly details?: Array<{ path: string; message: string }>;

  constructor(status: number, payload: ApiError) {
    super(payload.error ?? `HTTP ${status}`);
    this.name = "HttpError";
    this.status = status;
    this.code = payload.code;
    this.details = payload.details;
  }
}

interface RequestOptions {
  signal?: AbortSignal;
  headers?: Record<string, string>;
  timeoutMs?: number;
}

export async function postJSON<TResponse, TBody>(
  url: string,
  body: TBody,
  options: RequestOptions = {}
): Promise<TResponse> {
  const { signal, headers = {}, timeoutMs = 30_000 } = options;
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), timeoutMs);

  if (signal) {
    signal.addEventListener("abort", () => controller.abort(), { once: true });
  }

  try {
    const res = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json", ...headers },
      body: JSON.stringify(body),
      signal: controller.signal,
    });

    const json = (await res.json()) as unknown;

    if (!res.ok) {
      throw new HttpError(res.status, json as ApiError);
    }
    return json as TResponse;
  } finally {
    clearTimeout(timeout);
  }
}

export async function getJSON<TResponse>(
  url: string,
  options: RequestOptions = {}
): Promise<TResponse> {
  const res = await fetch(url, {
    method: "GET",
    headers: options.headers,
    signal: options.signal,
  });
  const json = (await res.json()) as unknown;
  if (!res.ok) throw new HttpError(res.status, json as ApiError);
  return json as TResponse;
}
```

