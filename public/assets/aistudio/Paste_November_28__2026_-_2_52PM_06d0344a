## IV.4 — `tools/content-parser.ts`

**Uso:** Parseo + validación de la respuesta del modelo.
**Fin:** Garantizar `NewsOutput` íntegro o fallar ruidosamente.

```typescript
import { z } from "zod";
import type { NewsOutput } from "@/domain/news-types";
import { AppError } from "./errors";

const NewsOutputSchema = z.object({
  titular: z.string().min(1),
  lead: z.string().min(1),
  cuerpo: z.string().min(1),
  conclusion: z.string().min(1),
  teleprompter: z.string().min(1),
  newsletter: z.string().min(1),
  videoScript: z.string().min(1),
});

export function parseNewsOutput(raw: string): NewsOutput {
  let json: unknown;
  try {
    json = JSON.parse(raw);
  } catch {
    throw AppError.upstream("El modelo devolvió JSON inválido.");
  }

  const parsed = NewsOutputSchema.safeParse(json);
  if (!parsed.success) {
    throw AppError.upstream("El modelo devolvió una estructura inválida.");
  }
  return parsed.data;
}
```

