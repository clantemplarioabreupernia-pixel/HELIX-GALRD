## I.3 — `tools/errors.ts`

**Uso:** Jerarquía de errores de dominio.
**Fin:** Mapear errores internos a códigos HTTP sin filtrar detalles.

```typescript
export type AppErrorCode =
  | "VALIDATION_ERROR"
  | "UPSTREAM_ERROR"
  | "TIMEOUT_ERROR"
  | "RATE_LIMITED"
  | "NOT_FOUND"
  | "INTERNAL_ERROR";

export interface AppErrorPayload {
  code: AppErrorCode;
  publicMessage: string;
  statusCode: number;
}

export class AppError extends Error {
  readonly code: AppErrorCode;
  readonly publicMessage: string;
  readonly statusCode: number;
  readonly internalCause?: unknown;

  constructor(payload: AppErrorPayload, internalCause?: unknown) {
    super(payload.publicMessage);
    this.name = "AppError";
    this.code = payload.code;
    this.publicMessage = payload.publicMessage;
    this.statusCode = payload.statusCode;
    this.internalCause = internalCause;
  }

  toPublicJSON(): { error: string; code: AppErrorCode } {
    return { error: this.publicMessage, code: this.code };
  }

  static validation(message = "Input inválido."): AppError {
    return new AppError(
      { code: "VALIDATION_ERROR", publicMessage: message, statusCode: 400 }
    );
  }

  static timeout(message = "Tiempo de espera agotado."): AppError {
    return new AppError(
      { code: "TIMEOUT_ERROR", publicMessage: message, statusCode: 504 }
    );
  }

  static upstream(message = "Fallo del proveedor de IA."): AppError {
    return new AppError(
      { code: "UPSTREAM_ERROR", publicMessage: message, statusCode: 502 }
    );
  }

  static internal(message = "Error interno del servidor."): AppError {
    return new AppError(
      { code: "INTERNAL_ERROR", publicMessage: message, statusCode: 500 }
    );
  }
}

export function isAppError(err: unknown): err is AppError {
  return err instanceof AppError;
}
```

