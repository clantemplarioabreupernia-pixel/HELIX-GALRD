## V.2 — `services/news-processor.ts`

**Uso:** Orquestador del flujo completo.
**Fin:** Un único punto de entrada para "cable → 7 piezas".

```typescript
import type { NewsOutput } from "@/domain/news-types";
import type { ValidatedNewsRequest } from "@/tools/validation-schemas";
import { buildNewsPrompt } from "@/tools/prompt-builder";
import { generateStructuredJSON } from "@/tools/gemini-client";
import { parseNewsOutput } from "@/tools/content-parser";
import { createLogger } from "@/tools/logger";

const log = createLogger("news-processor");

export interface ProcessNewsResult {
  readonly output: NewsOutput;
  readonly elapsedMs: number;
}

export async function processNews(input: ValidatedNewsRequest): Promise<ProcessNewsResult> {
  const startedAt = Date.now();
  log.info("procesando cable", {
    chars: input.rawNews.length,
    tone: input.tone,
    language: input.language,
  });

  const prompt = buildNewsPrompt(input);
  const raw = await generateStructuredJSON({ prompt });
  const output = parseNewsOutput(raw);

  const elapsedMs = Date.now() - startedAt;
  log.info("cable procesado", { elapsedMs });
  return { output, elapsedMs };
}
```

