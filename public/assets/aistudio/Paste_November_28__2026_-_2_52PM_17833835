## `src/domain/LedgerRepository.ts`

**Uso:** CRUD del ledger.
**Fines:** patrón Repository con `Storage<T>` inyectado.

```ts
import type { Storage } from '@/storage/Storage';
import type { LedgerEntry } from '@/types/domain';
import type { EntryInput } from '@/lib/validation/entry';
import { NotFoundError } from '@/errors/DomainError';
import { createLedgerEntry } from './LedgerEntry';

export class LedgerRepository {
  constructor(private readonly storage: Storage<LedgerEntry[]>) {}

  getAll(): LedgerEntry[] {
    const list = this.storage.read() ?? [];
    return [...list].sort((a, b) => b.date.localeCompare(a.date));
  }

  add(input: EntryInput): LedgerEntry {
    const entry = createLedgerEntry(input);
    const list = this.storage.read() ?? [];
    this.storage.write([...list, entry]);
    return entry;
  }

  remove(id: string): void {
    const list = this.storage.read() ?? [];
    const next = list.filter((e) => e.id !== id);
    if (next.length === list.length) throw new NotFoundError('LedgerEntry', id);
    this.storage.write(next);
  }

  clear(): void {
    this.storage.clear();
  }
}
```

