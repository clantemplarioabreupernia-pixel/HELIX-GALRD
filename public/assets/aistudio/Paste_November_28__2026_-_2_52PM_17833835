## `src/lib/validation/entry.ts`

**Uso:** validación de input de entrada.
**Fines:** garantizar invariantes antes de tocar el repositorio.

```ts
import { ValidationError } from '@/errors/DomainError';
import type { EntryKind } from '@/types/domain';

export interface EntryInput {
  readonly date: string;
  readonly description: string;
  readonly category: string;
  readonly amount: number;
  readonly kind: EntryKind;
}

export function validateEntryInput(raw: unknown): EntryInput {
  if (!raw || typeof raw !== 'object') {
    throw new ValidationError('La entrada debe ser un objeto');
  }
  const r = raw as Record<string, unknown>;

  if (typeof r.description !== 'string' || r.description.trim().length === 0) {
    throw new ValidationError('Descripción requerida', 'description');
  }
  if (typeof r.category !== 'string' || r.category.trim().length === 0) {
    throw new ValidationError('Categoría requerida', 'category');
  }
  if (typeof r.amount !== 'number' || !Number.isFinite(r.amount) || r.amount <= 0) {
    throw new ValidationError('Importe debe ser mayor que 0', 'amount');
  }
  if (r.kind !== 'income' && r.kind !== 'expense') {
    throw new ValidationError('Tipo inválido', 'kind');
  }
  if (typeof r.date !== 'string' || Number.isNaN(Date.parse(r.date))) {
    throw new ValidationError('Fecha inválida', 'date');
  }

  return {
    date: new Date(r.date).toISOString(),
    description: r.description.trim(),
    category: r.category.trim(),
    amount: r.amount,
    kind: r.kind,
  };
}
```

