# 5️⃣ REACT STATE (HOOKS)

## `src/hooks/useLedger.ts`

**Uso:** estado del ledger para React.
**Fines:** sincroniza repositorio ↔ UI, memoiza summary.

```ts
import { useCallback, useMemo, useState } from 'react';
import type { LedgerRepository } from '@/domain/LedgerRepository';
import type { LedgerEntry, LedgerSummary } from '@/types/domain';
import type { EntryInput } from '@/lib/validation/entry';
import { computeSummary } from '@/domain/computeSummary';

export interface UseLedgerResult {
  readonly entries: LedgerEntry[];
  readonly summary: LedgerSummary;
  readonly addEntry: (input: EntryInput) => LedgerEntry;
  readonly removeEntry: (id: string) => void;
  readonly refresh: () => void;
}

export function useLedger(repository: LedgerRepository): UseLedgerResult {
  const [entries, setEntries] = useState<LedgerEntry[]>(() => repository.getAll());

  const refresh = useCallback(() => {
    setEntries(repository.getAll());
  }, [repository]);

  const addEntry = useCallback(
    (input: EntryInput) => {
      const entry = repository.add(input);
      refresh();
      return entry;
    },
    [repository, refresh],
  );

  const removeEntry = useCallback(
    (id: string) => {
      repository.remove(id);
      refresh();
    },
    [repository, refresh],
  );

  const summary = useMemo(() => computeSummary(entries), [entries]);

  return { entries, summary, addEntry, removeEntry, refresh };
}
```

