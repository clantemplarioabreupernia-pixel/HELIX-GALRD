## `server/routes/analyze.ts`

**Uso:** proxy a Gemini.
**Fines:** validar payload, delegar en `GeminiClient`.

```ts
import { Router } from 'express';
import type { GeminiClient } from '../../src/ai/GeminiClient';
import type { AnalysisRequest } from '../../src/types/domain';
import { GEMINI_MODEL } from '../../src/config/constants';

export function createAnalyzeRouter(client: GeminiClient | null): Router {
  const router = Router();

  router.post('/analyze', async (req, res, next) => {
    if (!client) return res.status(503).json({ error: 'GEMINI_API_KEY no configurada' });

    const payload = req.body as AnalysisRequest;
    if (!payload?.summary || !Array.isArray(payload.entries)) {
      return res.status(400).json({ error: 'payload inválido' });
    }

    try {
      const text = await client.analyze(payload);
      res.json({ text, model: GEMINI_MODEL });
    } catch (err) {
      next(err);
    }
  });

  return router;
}
