**Uso:** captura de errores React.
**Fines:** evitar pantalla blanca.

```tsx
import { Component, type ErrorInfo, type ReactNode } from 'react';

interface Props { readonly children: ReactNode; }
interface State { readonly error: Error | null; }

export class ErrorBoundary extends Component<Props, State> {
  state: State = { error: null };

  static getDerivedStateFromError(error: Error): State {
    return { error };
  }

  componentDidCatch(error: Error, info: ErrorInfo) {
    console.error('[ErrorBoundary]', error, info);
  }

  render() {
    if (this.state.error) {
      return (
        <div className="p-8 text-center">
          <h2 className="text-lg font-semibold text-rose-400">Algo se rompió</h2>
          <p className="text-sm text-white/60 mt-2">{this.state.error.message}</p>
        </div>
      );
    }
    return this.props.children;
  }
}
```

