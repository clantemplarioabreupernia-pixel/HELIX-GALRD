## `src/domain/computeSummary.ts`

**Uso:** cálculo de KPIs y breakdowns.
**Fines:** función **pura** testeable sin I/O.

```ts
import type { LedgerEntry, LedgerSummary } from '@/types/domain';
import { monthKey, formatMonthKey } from '@/lib/format/date';

export function computeSummary(entries: readonly LedgerEntry[]): LedgerSummary {
  let totalIncome = 0;
  let totalExpense = 0;
  const categoryAcc = new Map<string, { total: number; kind: LedgerEntry['kind'] }>();
  const monthlyAcc = new Map<string, { income: number; expense: number }>();

  for (const entry of entries) {
    if (entry.kind === 'income') totalIncome += entry.amount;
    else totalExpense += entry.amount;

    const cat = categoryAcc.get(entry.category) ?? { total: 0, kind: entry.kind };
    cat.total += entry.amount;
    categoryAcc.set(entry.category, cat);

    const key = monthKey(entry.date);
    const month = monthlyAcc.get(key) ?? { income: 0, expense: 0 };
    if (entry.kind === 'income') month.income += entry.amount;
    else month.expense += entry.amount;
    monthlyAcc.set(key, month);
  }

  const categoryBreakdown = Array.from(categoryAcc.entries())
    .map(([category, v]) => ({ category, total: v.total, kind: v.kind }))
    .sort((a, b) => b.total - a.total);

  const monthlyBreakdown = Array.from(monthlyAcc.entries())
    .map(([key, v]) => ({
      monthKey: key,
      label: formatMonthKey(key),
      income: v.income,
      expense: v.expense,
      balance: v.income - v.expense,
    }))
    .sort((a, b) => a.monthKey.localeCompare(b.monthKey));

  return {
    totalIncome,
    totalExpense,
    balance: totalIncome - totalExpense,
    entryCount: entries.length,
    categoryBreakdown,
    monthlyBreakdown,
  };
}
```

