import type { EntryInput } from '@/lib/validation/entry';

interface Props { readonly onSubmit: (input: EntryInput) => void; }

export function EntryForm({ onSubmit }: Props) {
  const [date, setDate] = useState(() => toISODate(new Date()));
  const [description, setDescription] = useState('');
  const [category, setCategory] = useState(DEFAULT_CATEGORY);
  const [amount, setAmount] = useState('');
  const [kind, setKind] = useState<EntryKind>('expense');

  const handleSubmit = (e: FormEvent) => {
    e.preventDefault();
    const numericAmount = Number(amount);
    if (!description.trim() || !Number.isFinite(numericAmount) || numericAmount <= 0) return;

    onSubmit({
      date: new Date(date).toISOString(),
      description: description.trim(),
      category: category.trim() || DEFAULT_CATEGORY,
      amount: numericAmount,
      kind,
    });

    setDescription('');
    setAmount('');
  };

  return (
    <form onSubmit={handleSubmit} className="crystal-card p-4 grid gap-3">
      <div className="grid grid-cols-2 gap-3">
        <label className="flex flex-col gap-1 text-xs text-white/60">
