```ts
import type { AnalysisRequest, AnalysisResponse } from '@/types/domain';

export async function requestAnalysis(request: AnalysisRequest): Promise<AnalysisResponse> {
  const res = await fetch('/api/analyze', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(request),
  });
  if (!res.ok) {
    const detail = await res.text().catch(() => '');
    throw new Error(`Error IA (${res.status}): ${detail || res.statusText}`);
  }
  return (await res.json()) as AnalysisResponse;
}
```

