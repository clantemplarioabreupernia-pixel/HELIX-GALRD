"""T39 — formatear_informe. L7. Deps: ninguna."""
from typing import Any, Mapping


def formatear_informe(informe: Mapping[str, Any]) -> str:
    lineas = ["=" * 60, "  INFORME OMEGA-VERIFY", "=" * 60]
    for nombre, valor in informe.items():
        lineas.append(f"\n[{nombre}]")
        if isinstance(valor, Mapping):
            for k, v in valor.items():
                lineas.append(f"  {k:20s} : {v}")
        else:
            lineas.append(f"  {valor}")
    lineas.append("=" * 60)
    return "\n".join(lineas)


