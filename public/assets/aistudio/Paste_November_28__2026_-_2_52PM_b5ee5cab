from ..l0.t01_eps import EPS
from ..l0.t02_intervalo import Intervalo
from ..l0.t04_contraejemplo import Contraejemplo


def predicado_dentro_marco(intervalos: Sequence[Intervalo],
                           inicio: float, fin: float) -> Optional[Contraejemplo]:
    for i in intervalos:
        if i.inicio < inicio - EPS:
            return Contraejemplo("dentro_marco", {
                "motivo": "antes", "inicio": i.inicio, "limite": inicio,
            })
        if i.fin > fin + EPS:
            return Contraejemplo("dentro_marco", {
                "motivo": "despues", "fin": i.fin, "limite": fin,
            })
    return None


def _self_test() -> None:
    assert predicado_dentro_marco([Intervalo(0, 2)], 0.0, 2.0) is None
    c = predicado_dentro_marco([Intervalo(-1, 1)], 0.0, 2.0)
    assert c is not None and c.datos["motivo"] == "antes"
    c = predicado_dentro_marco([Intervalo(1, 3)], 0.0, 2.0)
    assert c is not None and c.datos["motivo"] == "despues"


if __name__ == "__main__":
