"""T06 — predicado_no_solape. L1. Deps: T01, T02, T04."""
from __future__ import annotations
from typing import Optional, Sequence
from ..l0.t01_eps import EPS
from ..l0.t02_intervalo import Intervalo
from ..l0.t04_contraejemplo import Contraejemplo


def predicado_no_solape(intervalos: Sequence[Intervalo]) -> Optional[Contraejemplo]:
    if len(intervalos) < 2:
        return None
    orden = sorted(intervalos, key=lambda i: i.inicio)
    for a, b in zip(orden, orden[1:]):
        if b.inicio < a.fin - EPS:
            return Contraejemplo("sin_solapamiento", {
                "a": (a.inicio, a.fin), "b": (b.inicio, b.fin),
                "solape": a.fin - b.inicio,
            })
    return None


def _self_test() -> None:
    assert predicado_no_solape([]) is None
    assert predicado_no_solape([Intervalo(0, 1), Intervalo(1, 2)]) is None
    c = predicado_no_solape([Intervalo(0, 1.5), Intervalo(1.0, 2)])
    assert c is not None and c.regla == "sin_solapamiento"
    assert c.datos["solape"] == 0.5


if __name__ == "__main__":
    _self_test(); print("T06 OK")
```

