"""T02 — Intervalo. L0. Deps: T01."""
from __future__ import annotations
from dataclasses import dataclass
from .t01_eps import EPS


@dataclass(frozen=True)
class Intervalo:
    inicio: float
    fin: float

    def __post_init__(self) -> None:
        if self.fin < self.inicio - EPS:
            raise ValueError(f"fin ({self.fin}) < inicio ({self.inicio})")

    @property
    def duracion(self) -> float:
        return self.fin - self.inicio


def _self_test() -> None:
    i = Intervalo(0.0, 1.5)
    assert i.duracion == 1.5
    try:
        Intervalo(1.0, 0.5); assert False
    except ValueError:
        pass


if __name__ == "__main__":
    _self_test(); print("T02 OK")
