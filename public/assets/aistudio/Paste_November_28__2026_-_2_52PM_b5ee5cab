"""T30 — buscar_completacion. L4. Deps: T03, T05, T12, T13, T14-T25."""
from __future__ import annotations
from typing import Any, Mapping, Optional, Sequence
from z3 import Or, sat
from ..l0.t05_resultado import Resultado
from ..l2.t12_predicado_suma_duraciones import predicado_suma_duraciones
from ..l2.t13_predicado_cuotas_factibles import predicado_cuotas_factibles
from ..l3.t14_crear_solver import crear_solver
from ..l3.t15_var_inicio import var_inicio
from ..l3.t17_fijar_var import fijar_var
from ..l3.t19_restriccion_no_solape import restriccion_no_solape
from ..l3.t20_restriccion_orden import restriccion_orden
from ..l3.t21_restriccion_ventana import restriccion_ventana
from ..l3.t22_z3_a_float import z3_a_float
from ..l3.t24_ejecutar_solver import ejecutar_solver


def buscar_completacion(programas: Sequence[Mapping[str, Any]],
                        duracion: float,
                        topes: Optional[Mapping[str, float]] = None,
                        orden: Optional[Sequence[str]] = None,
                        ventanas: Optional[Mapping[str, tuple]] = None,
                        timeout_ms: int = 5000) -> Resultado:
    topes = topes or {}; ventanas = ventanas or {}
    if not programas:
        return Resultado(ok=False, regla="buscar_completacion", detalle="sin programas")
    ce = predicado_suma_duraciones(programas, duracion)
    if ce: return Resultado(ok=False, regla="buscar_completacion",
                            contraejemplo=ce, detalle="suma excede marco")
    ce = predicado_cuotas_factibles(programas, topes)
    if ce: return Resultado(ok=False, regla="buscar_completacion",
                            contraejemplo=ce, detalle="cuota infactible")

    s = crear_solver(timeout_ms)
    inicios = {p["id"]: var_inicio(p["id"]) for p in programas}
    dur = {p["id"]: float(p["duracion"]) for p in programas}
    fins = {p["id"]: inicios[p["id"]] + dur[p["id"]] for p in programas}

    for p in programas:
        i = inicios[p["id"]]
        s.add(i >= 0); s.add(i + dur[p["id"]] <= duracion)
        if p["id"] in ventanas:
            lo, hi = ventanas[p["id"]]
            restriccion_ventana(s, i, lo, hi)

    if orden:
        for a in range(len(orden) - 1):
            restriccion_orden(s, inicios[orden[a]],
                              fins[orden[a]], inicios[orden[a + 1]])

    ids = list(inicios)
    for a in range(len(ids)):
        for b in range(a + 1, len(ids)):
            restriccion_no_solape(s, inicios[ids[a]], fins[ids[a]],
                                  inicios[ids[b]], fins[ids[b]])

    if ejecutar_solver(s) != sat:
        return Resultado(ok=False, regla="buscar_completacion",
                         detalle="sin asignación válida")
    m = s.model()
    asignacion = []
    for p in programas:
        ini = z3_a_float(m.eval(inicios[p["id"]], model_completion=True))
        asignacion.append({"id": p["id"], "inicio": ini,
                           "fin": ini + dur[p["id"]],
                           "patrocinador": p.get("patrocinador")})
    asignacion.sort(key=lambda x: x["inicio"])
    return Resultado(ok=True, regla="buscar_completacion",
                     modelo=asignacion,
                     detalle=f"{len(asignacion)} bloques")


def _self_test() -> None:
    progs = [{"id": "p1", "duracion": 2.0}, {"id": "p2", "duracion": 3.0}]
    r = buscar_completacion(progs, 5.0)
    assert r.ok and len(r.modelo) == 2
    r = buscar_completacion(progs, 3.0)
    assert not r.ok


if __name__ == "__main__":
    _self_test(); print("T30 OK")
```

