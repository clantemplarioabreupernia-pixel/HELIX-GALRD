"""T29 — verificar_invariante. L4. Deps: T03, T05, T14-T24."""
from __future__ import annotations
from typing import Sequence
from z3 import sat, unsat
from ..l0.t01_eps import EPS
from ..l0.t03_bloque import Bloque
from ..l0.t05_resultado import Resultado
from ..l3.t14_crear_solver import crear_solver
from ..l3.t15_var_inicio import var_inicio
from ..l3.t16_var_fin import var_fin
from ..l3.t17_fijar_var import fijar_var
from ..l3.t23_or_violaciones import or_violaciones
from ..l3.t24_ejecutar_solver import ejecutar_solver


def verificar_invariante(bloques: Sequence[Bloque], duracion: float,
                         inicio: float = 0.0,
                         timeout_ms: int = 5000) -> Resultado:
    if not bloques:
        return Resultado(ok=False, regla="verificar_invariante",
                         detalle="parrilla vacía")
    fin_total = inicio + duracion
    solver = crear_solver(timeout_ms)
    zvars = []
    for b in bloques:
        ini = var_inicio(b.id); fin = var_fin(b.id)
        fijar_var(solver, ini, b.intervalo.inicio)
        fijar_var(solver, fin, b.intervalo.fin)
        zvars.append((b.id, ini, fin))
    viol = []
    for _, ini, fin in zvars:
        viol.extend([ini < inicio - EPS, fin > fin_total + EPS, fin < ini - EPS])
    viol.append(zvars[0][1] > inicio + EPS)
    viol.append(zvars[-1][2] < fin_total - EPS)
    for k in range(len(zvars) - 1):
        _, _, fin_k = zvars[k]
        _, ini_k1, _ = zvars[k + 1]
        viol.append(ini_k1 - fin_k > EPS)
        viol.append(fin_k - ini_k1 > EPS)
    solver.add(or_violaciones(viol))
    r = ejecutar_solver(solver)
    if r == unsat:
        return Resultado(ok=True, regla="verificar_invariante",
                         detalle="UNSAT: invariantes probados")
    if r == sat:
        return Resultado(ok=False, regla="verificar_invariante",
                         detalle="SAT: contraejemplo")
    return Resultado(ok=False, regla="verificar_invariante",
                     detalle=f"unknown: {r}")


def _self_test() -> None:
    from ..l0.t02_intervalo import Intervalo
    ok = [Bloque("a", Intervalo(0, 1)), Bloque("b", Intervalo(1, 2))]
    assert verificar_invariante(ok, 2.0).ok
    bad = [Bloque("a", Intervalo(0, 1)), Bloque("b", Intervalo(1.5, 2))]
    assert not verificar_invariante(bad, 2.0).ok


if __name__ == "__main__":
    _self_test(); print("T29 OK")
```

