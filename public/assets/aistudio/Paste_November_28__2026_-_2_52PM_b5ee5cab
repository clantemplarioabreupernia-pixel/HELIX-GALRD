"""T13 — predicado_cuotas_factibles. L2. Deps: T11, T04."""
from __future__ import annotations
from typing import Any, Mapping, Optional, Sequence
from ..l0.t04_contraejemplo import Contraejemplo
from .t11_predicado_cuota_patrocinador import predicado_cuota_patrocinador


def predicado_cuotas_factibles(programas: Sequence[Mapping[str, Any]],
                               topes: Mapping[str, float]) -> Optional[Contraejemplo]:
    from ..l0.t03_bloque import Bloque
    from ..l0.t02_intervalo import Intervalo

    acumulado: dict[str, float] = {}
    for p in programas:
        pat = p.get("patrocinador")
        if not pat:
            continue
        acumulado[pat] = acumulado.get(pat, 0.0) + float(p["duracion"])
    for pat, total in acumulado.items():
        tope = topes.get(pat)
        if tope is not None and total > tope + 1e-9:
            return Contraejemplo("cuotas_factibles", {
                "patrocinador": pat, "total": total, "tope": tope,
                "exceso": total - tope,
            })
    return None


def _self_test() -> None:
    progs = [{"id": "a", "duracion": 1.0, "patrocinador": "X"},
             {"id": "b", "duracion": 1.5, "patrocinador": "X"}]
    assert predicado_cuotas_factibles(progs, {"X": 3.0}) is None
    c = predicado_cuotas_factibles(progs, {"X": 2.0})
    assert c is not None and c.datos["exceso"] == 0.5


if __name__ == "__main__":
