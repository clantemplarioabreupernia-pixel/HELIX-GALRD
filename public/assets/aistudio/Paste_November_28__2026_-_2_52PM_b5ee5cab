/**
 * T41 — Z3FormalVerifier. L8. Deps: T40, React.
 * UI pura de presentación. NO contiene lógica de dominio.
 */
import React, { useCallback, useState } from "react";
import { post_json } from "./t40_post_json";

export interface Resultado {
  ok: boolean;
  regla: string;
  contraejemplo?: unknown;
  detalle?: string;
  modelo?: Array<{ id: string; inicio: number; fin: number; patrocinador?: string | null }>;
}

export interface Props {
  endpoint?: string;
  onResult?: (r: Resultado) => void;
}

type Estado =
  | { fase: "idle" }
  | { fase: "capa1"; r: Resultado }
  | { fase: "capa2"; r: Resultado }
  | { fase: "error"; msg: string };

const PLANTILLA = JSON.stringify({
  duracion: 20, inicio: 0, topes: { A: 10, B: 10 },
  bloques: [
    { id: "intro", inicio: 0, fin: 5 },
    { id: "spot_a", inicio: 5, fin: 5.5, patrocinador: "A" },
    { id: "noticia", inicio: 5.5, fin: 15 },
    { id: "outro", inicio: 15, fin: 20 },
  ],
}, null, 2);

export const Z3FormalVerifier: React.FC<Props> = ({
  endpoint = "/api/omega-verify", onResult,
}) => {
  const [estado, setEstado] = useState<Estado>({ fase: "idle" });
  const [json, setJson] = useState(PLANTILLA);
  const [cargando, setCargando] = useState(false);

  const verificar = useCallback(async () => {
    setCargando(true); setEstado({ fase: "idle" });
    try {
      const payload = JSON.parse(json);
      const r1 = await post_json<Resultado>(`${endpoint}/capa1`, payload);
      setEstado({ fase: "capa1", r: r1 }); onResult?.(r1);
      if (!r1.ok) return;
      const r2 = await post_json<Resultado>(`${endpoint}/capa2`, payload);
      setEstado({ fase: "capa2", r: r2 }); onResult?.(r2);
    } catch (e) {
      setEstado({ fase: "error", msg: e instanceof Error ? e.message : String(e) });
    } finally { setCargando(false); }
  }, [endpoint, json, onResult]);

  return (
    <div className="omega-verifier">
      <h2>Omega Formal Verification</h2>
      <textarea value={json} onChange={(e) => setJson(e.target.value)}
                rows={16} spellCheck={false} />
      <button onClick={verificar} disabled={cargando}>
        {cargando ? "Verificando…" : "Verificar"}
      </button>
      {estado.fase === "capa1" && <Panel titulo="Capa 1" r={estado.r} />}
      {estado.fase === "capa2" && <Panel titulo="Capa 2" r={estado.r} />}
      {estado.fase === "error" && <div>Error: {estado.msg}</div>}
    </div>
  );
};

const Panel: React.FC<{ titulo: string; r: Resultado }> = ({ titulo, r }) => (
  <div className={r.ok ? "ok" : "fail"}>
    <h3>{titulo} — {r.ok ? "OK" : "FALLO"} · regla: {r.regla}</h3>
    {r.detalle && <p>{r.detalle}</p>}
    {r.contraejemplo != null && (
      <details><summary>Contraejemplo</summary>
        <pre>{JSON.stringify(r.contraejemplo, null, 2)}</pre></details>
    )}
    {r.modelo && (
      <details open><summary>Modelo</summary>
        <ul>{r.modelo.map((b) => (
          <li key={b.id}><code>{b.id}</code> · {b.inicio} → {b.fin}</li>
        ))}</ul></details>
    )}
  </div>
);

export default Z3FormalVerifier;
